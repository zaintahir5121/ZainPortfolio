          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Per-product weight note -->
        <mxCell id="weight-note" value="Per-Product Weights (set in TenantConfig)&#xa;────────────────────────────────&#xa;Learn:   Action 20%  Gen 50%  Chat 30%&#xa;Work:    Action 60%  Gen 20%  Chat 20%&#xa;Safe:    Action 30%  Gen 40%  Chat 30%&#xa;(Resolver uses these to bias classification)" style="text;fillColor=#fef9c3;strokeColor=#d97706;fontSize=10;rounded=1;align=left;fontStyle=2;" vertex="1" parent="1">
