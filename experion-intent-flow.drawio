        </mxCell>
        <mxCell id="pp-p5" value="Product 5&#xa;/action /context" style="rounded=1;fillColor=#fff;strokeColor=#d97706;fontSize=10;" vertex="1" parent="prod-row">
          <mxGeometry x="770" y="35" width="160" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="pp-p6" value="Product 6&#xa;/action /context" style="rounded=1;fillColor=#fff;strokeColor=#d97706;fontSize=10;" vertex="1" parent="prod-row">
