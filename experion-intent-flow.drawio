  <!-- PAGE 2 — Independent Team Flow vs Experion Integration Flow   -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <diagram id="page2" name="2 — Team Independence &amp; Integration Contract">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageWidth="1654" pageHeight="1169">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <!-- TITLE -->
        <mxCell id="t2" value="Product Team Independence &amp; Experion Integration Contract" style="text;fontSize=18;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="80" y="20" width="900" height="36" as="geometry"/>
        </mxCell>

        <!-- ══════════════════════════════════════════════════════ -->
        <!-- LEFT COLUMN: PRODUCT TEAM (independent)              -->
        <!-- ══════════════════════════════════════════════════════ -->
        <mxCell id="team-col" value="Product Team — Works 100% Independently" style="swimlane;startSize=36;fillColor=#fffbeb;strokeColor=#d97706;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="480" height="960" as="geometry"/>
        </mxCell>

        <!-- Team builds product -->
        <mxCell id="t1" value="1. Build Product (Learn / Work / Safe / …)&#xa;Own codebase, own DB, own UI&#xa;No dependency on Experion internals" style="rounded=1;fillColor=#fff;strokeColor=#d97706;fontSize=11;" vertex="1" parent="team-col">
          <mxGeometry x="20" y="55" width="440" height="65" as="geometry"/>
        </mxCell>

        <!-- Team defines KB -->
        <mxCell id="t2b" value="2. Define Knowledge Base Content&#xa;Product FAQs, pricing, policies,&#xa;workflows — plain text or structured JSON" style="rounded=1;fillColor=#fff;strokeColor=#d97706;fontSize=11;" vertex="1" parent="team-col">
          <mxGeometry x="20" y="150" width="440" height="65" as="geometry"/>
        </mxCell>

        <!-- Team registers actions -->
        <mxCell id="t3" value="3. Define Actions&#xa;For each action: actionKey, description,&#xa;phrases, targetEndpoint, enabled flag" style="rounded=1;fillColor=#fff;strokeColor=#d97706;fontSize=11;" vertex="1" parent="team-col">
          <mxGeometry x="20" y="245" width="440" height="65" as="geometry"/>
        </mxCell>

        <!-- Team sets weights -->
        <mxCell id="t4" value="4. Set Response Weights&#xa;How much to favour Action vs Generation&#xa;vs Chat for your product context" style="rounded=1;fillColor=#fff;strokeColor=#d97706;fontSize=11;" vertex="1" parent="team-col">
          <mxGeometry x="20" y="340" width="440" height="65" as="geometry"/>
        </mxCell>

        <!-- Hands to Experion team -->
        <mxCell id="t5" value="5. Hand Contract to Experion Team&#xa;Send: KB content + action definitions&#xa;+ weights + targetEndpoints + tenant name" style="rounded=1;fillColor=#fef3c7;strokeColor=#d97706;fontStyle=1;fontSize=11;" vertex="1" parent="team-col">
          <mxGeometry x="20" y="435" width="440" height="65" as="geometry"/>
        </mxCell>

        <!-- Drop script tag -->
        <mxCell id="t6" value="6. Drop One Script Tag in Product HTML&#xa;&lt;script src=&quot;experion.js&quot;&#xa;  data-tenant=&quot;learn&quot;&#xa;  data-api=&quot;https://api.experion.ai&quot;&#xa;  data-user-id=&quot;{{ userId }}&quot;&gt;" style="rounded=1;fillColor=#f0fdf4;strokeColor=#22c55e;fontSize=10;fontStyle=2;align=left;" vertex="1" parent="team-col">
          <mxGeometry x="20" y="530" width="440" height="80" as="geometry"/>
        </mxCell>

        <!-- DONE -->
        <mxCell id="t7" value="✓ Done — Product team never touches Experion again&#xa;Experion handles: tracking · chat · actions · nudges&#xa;Product team focuses on their own product only" style="rounded=1;fillColor=#dcfce7;strokeColor=#16a34a;fontStyle=1;fontSize=11;" vertex="1" parent="team-col">
          <mxGeometry x="20" y="640" width="440" height="65" as="geometry"/>
        </mxCell>

        <!-- Product exposes endpoints -->
        <mxCell id="t8-head" value="Product Exposes These Endpoints Only" style="text;fontStyle=1;fontSize=11;fillColor=none;strokeColor=none;" vertex="1" parent="team-col">
          <mxGeometry x="20" y="730" width="340" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="ep1" value="POST /action/{actionKey}&#xa;→ Executes the action&#xa;   Called by Experion ActionWorker" style="rounded=1;fillColor=#fff7ed;strokeColor=#ea580c;fontSize=10;align=left;" vertex="1" parent="team-col">
          <mxGeometry x="20" y="760" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="ep2" value="GET /context&#xa;→ Returns current page / session&#xa;   context for richer chat replies" style="rounded=1;fillColor=#faf5ff;strokeColor=#7c3aed;fontSize=10;align=left;" vertex="1" parent="team-col">
          <mxGeometry x="240" y="760" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="ep3" value="That's it. No other Experion integration&#xa;is required from the product team." style="text;fontSize=10;fontStyle=2;fillColor=none;strokeColor=none;align=left;" vertex="1" parent="team-col">
          <mxGeometry x="20" y="850" width="440" height="40" as="geometry"/>
        </mxCell>

        <!-- arrows inside team column -->
        <mxCell id="et1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#d97706;" edge="1" source="t1" target="t2b" parent="team-col"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="et2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#d97706;" edge="1" source="t2b" target="t3" parent="team-col"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="et3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#d97706;" edge="1" source="t3" target="t4" parent="team-col"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="et4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#d97706;" edge="1" source="t4" target="t5" parent="team-col"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="et5" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#22c55e;" edge="1" source="t5" target="t6" parent="team-col"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="et6" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#16a34a;" edge="1" source="t6" target="t7" parent="team-col"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ══════════════════════════════════════════════════════ -->
        <!-- CONTRACT ARROW IN MIDDLE                              -->
        <!-- ══════════════════════════════════════════════════════ -->
        <mxCell id="contract-arrow" value="Integration Contract&#xa;(one-time setup)" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1e40af;strokeWidth=3;fontStyle=1;fontSize=12;startArrow=none;endArrow=open;" edge="1" source="t5" target="exp-setup" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ══════════════════════════════════════════════════════ -->
        <!-- RIGHT COLUMN: EXPERION TEAM                          -->
        <!-- ══════════════════════════════════════════════════════ -->
        <mxCell id="exp-col" value="Experion Team — Sets Up &amp; Owns Platform" style="swimlane;startSize=36;fillColor=#eff6ff;strokeColor=#1d4ed8;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="700" y="80" width="480" height="960" as="geometry"/>
        </mxCell>

        <mxCell id="exp-setup" value="1. Receive Integration Contract from Product Team&#xa;KB content · actions · weights · endpoints" style="rounded=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontStyle=1;fontSize=11;" vertex="1" parent="exp-col">
          <mxGeometry x="20" y="55" width="440" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="exp-tenant" value="2. Insert TenantConfig Row&#xa;name, KbContent, idle threshold,&#xa;cooldown, action/gen/chat weights" style="rounded=1;fillColor=#fff;strokeColor=#1d4ed8;fontSize=11;" vertex="1" parent="exp-col">
          <mxGeometry x="20" y="150" width="440" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="exp-actions" value="3. Insert ActionMappings Rows&#xa;One row per action: actionKey, description,&#xa;phrases, embedding, targetEndpoint, enabled" style="rounded=1;fillColor=#fff;strokeColor=#1d4ed8;fontSize=11;" vertex="1" parent="exp-col">
          <mxGeometry x="20" y="245" width="440" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="exp-index" value="4. Index KB into Azure AI Search&#xa;Chunk + embed KB content&#xa;Ready for RAG retrieval on generation requests" style="rounded=1;fillColor=#fff;strokeColor=#1d4ed8;fontSize=11;" vertex="1" parent="exp-col">
          <mxGeometry x="20" y="340" width="440" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="exp-done" value="5. Platform Ready for This Product&#xa;No code change. Config-only onboarding." style="rounded=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontStyle=1;fontSize=11;" vertex="1" parent="exp-col">
          <mxGeometry x="20" y="435" width="440" height="55" as="geometry"/>
        </mxCell>

        <!-- Runtime flow -->
        <mxCell id="exp-rt-head" value="Runtime — How Experion Calls Back to Product" style="text;fontStyle=1;fontSize=12;fillColor=none;strokeColor=none;" vertex="1" parent="exp-col">
          <mxGeometry x="20" y="520" width="440" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="exp-rt1" value="Request arrives via JS SDK&#xa;POST /process {tenantId, userId, text}" style="rounded=1;fillColor=#fff;strokeColor=#1d4ed8;fontSize=10;" vertex="1" parent="exp-col">
          <mxGeometry x="20" y="550" width="440" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="exp-rt2" value="Intent Resolver runs (see Page 1)&#xa;Uses this tenant's weights from TenantConfig" style="rounded=1;fillColor=#fff;strokeColor=#1d4ed8;fontSize=10;" vertex="1" parent="exp-col">
          <mxGeometry x="20" y="620" width="440" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="exp-rt3a" value="If ACTION:&#xa;Experion calls product's&#xa;POST /action/{actionKey}&#xa;(targetEndpoint from ActionMappings)" style="rounded=1;fillColor=#fff7ed;strokeColor=#ea580c;fontSize=10;align=left;" vertex="1" parent="exp-col">
          <mxGeometry x="20" y="695" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="exp-rt3b" value="If GENERATION or CHAT:&#xa;Experion uses tenant KB from&#xa;AI Search + optional GET /context&#xa;from product (for richer replies)" style="rounded=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontSize=10;align=left;" vertex="1" parent="exp-col">
          <mxGeometry x="240" y="695" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="exp-rt4" value="Response returned to JS SDK via HTTP + SignalR&#xa;Product team sees result — no extra work needed" style="rounded=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontStyle=1;fontSize=10;" vertex="1" parent="exp-col">
          <mxGeometry x="20" y="800" width="440" height="50" as="geometry"/>
        </mxCell>

        <!-- Boundary box -->
        <mxCell id="boundary" value="Experion Internal — Product Team Has No Access" style="text;fontStyle=3;fontSize=10;fillColor=none;strokeColor=none;fontColor=#94a3b8;" vertex="1" parent="exp-col">
          <mxGeometry x="20" y="870" width="440" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="b1" value="Intent Resolver" style="rounded=1;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontSize=9;fontColor=#94a3b8;" vertex="1" parent="exp-col">
          <mxGeometry x="20" y="895" width="130" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="b2" value="SemanticCache" style="rounded=1;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontSize=9;fontColor=#94a3b8;" vertex="1" parent="exp-col">
          <mxGeometry x="165" y="895" width="130" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="b3" value="Blob / SQL / SignalR" style="rounded=1;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontSize=9;fontColor=#94a3b8;" vertex="1" parent="exp-col">
          <mxGeometry x="310" y="895" width="150" height="35" as="geometry"/>
        </mxCell>

        <!-- arrows inside exp-col -->
        <mxCell id="ex1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1d4ed8;" edge="1" source="exp-setup" target="exp-tenant" parent="exp-col"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ex2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1d4ed8;" edge="1" source="exp-tenant" target="exp-actions" parent="exp-col"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ex3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1d4ed8;" edge="1" source="exp-actions" target="exp-index" parent="exp-col"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ex4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1d4ed8;" edge="1" source="exp-index" target="exp-done" parent="exp-col"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ex5" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1d4ed8;" edge="1" source="exp-rt1" target="exp-rt2" parent="exp-col"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ex6" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1d4ed8;" edge="1" source="exp-rt2" target="exp-rt3a" parent="exp-col"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ex7" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1d4ed8;" edge="1" source="exp-rt2" target="exp-rt3b" parent="exp-col"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ex8" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1d4ed8;" edge="1" source="exp-rt3a" target="exp-rt4" parent="exp-col"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ex9" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1d4ed8;" edge="1" source="exp-rt3b" target="exp-rt4" parent="exp-col"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Callback arrows from exp-col to team-col endpoints -->
        <mxCell id="e-cb-act" value="calls POST /action/{key}" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#ea580c;dashed=1;fontStyle=2;fontSize=10;strokeWidth=2;" edge="1" source="exp-rt3a" target="ep1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-cb-ctx" value="calls GET /context" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#7c3aed;dashed=1;fontStyle=2;fontSize=10;strokeWidth=2;" edge="1" source="exp-rt3b" target="ep2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

</mxfile>
