        </mxCell>

        <!-- Action lane → product callback -->
        <mxCell id="e-act-prod" value="Experion calls back&#xa;product targetEndpoint" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#ea580c;dashed=1;fontStyle=2;fontSize=10;" edge="1" source="act-lane" target="prod-row" parent="1">
          <mxGeometry relative="1" as="geometry"/>
