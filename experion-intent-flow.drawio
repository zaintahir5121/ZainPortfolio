  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- PAGE 1 — Intent Resolver + Product Callback Flow              -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <diagram id="page1" name="1 — Intent Resolver &amp; Product Callback">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" page="1" pageWidth="1654" pageHeight="1169">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <!-- ─── TITLE ─── -->
        <mxCell id="title" value="Experion — Intent Resolver &amp; Product Callback Flow" style="text;fontSize=18;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="80" y="20" width="700" height="36" as="geometry"/>
        </mxCell>

        <!-- ─── INCOMING REQUEST ─── -->
        <mxCell id="req" value="Incoming Request&#xa;POST /process&#xa;(from any product via JS SDK)" style="rounded=1;fillColor=#1e40af;strokeColor=#1d4ed8;fontColor=#fff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="70" width="280" height="70" as="geometry"/>
        </mxCell>

        <!-- ─── STEP 1: EMBED ─── -->
        <mxCell id="embed" value="Step 1: Embed Query&#xa;text → vector (Azure OpenAI Embeddings)" style="rounded=1;fillColor=#f0fdf4;strokeColor=#22c55e;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="540" y="200" width="280" height="55" as="geometry"/>
        </mxCell>

        <!-- ─── STEP 2: CACHE ─── -->
        <mxCell id="cache" value="Step 2: Semantic Cache Check&#xa;cosine search over SemanticCache (SQL)" style="rhombus;fillColor=#fef9c3;strokeColor=#eab308;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="505" y="300" width="350" height="90" as="geometry"/>
        </mxCell>

        <!-- cache HIT -->
        <mxCell id="cache-hit" value="HIT — return cached answer&#xa;(&lt; 15 ms, no LLM)" style="rounded=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="880" y="320" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e-hit" value="HIT" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#16a34a;fontStyle=1;fontSize=10;" edge="1" source="cache" target="cache-hit" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ─── STEP 3: INTENT RESOLVER ─── -->
        <mxCell id="resolver-box" value="Step 3 — INTENT RESOLVER" style="swimlane;startSize=34;fillColor=#1e3a5f;strokeColor=#3b82f6;fontColor=#fff;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="340" y="450" width="680" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="r1" value="Embedding Cosine Score&#xa;(query vector vs ActionMapping&#xa;description+phrases vector)" style="rounded=1;fillColor=#1e293b;strokeColor=#60a5fa;fontColor=#e2e8f0;fontSize=10;" vertex="1" parent="resolver-box">
          <mxGeometry x="20" y="50" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="r2" value="Phrase Jaccard Score&#xa;(query words vs ActionMapping&#xa;pipe-separated phrases)" style="rounded=1;fillColor=#1e293b;strokeColor=#60a5fa;fontColor=#e2e8f0;fontSize=10;" vertex="1" parent="resolver-box">
          <mxGeometry x="240" y="50" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="r3" value="Hybrid Score + Per-Product Weights&#xa;→ Classify: ACTION / GENERATION / CHAT" style="rounded=1;fillColor=#2563eb;strokeColor=#93c5fd;fontColor=#fff;fontStyle=1;fontSize=10;" vertex="1" parent="resolver-box">
          <mxGeometry x="460" y="50" width="200" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="er1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#60a5fa;" edge="1" source="r1" target="r3" parent="resolver-box"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="er2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#60a5fa;" edge="1" source="r2" target="r3" parent="resolver-box"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ─── THREE OUTCOME LANES ─── -->

        <!-- ACTION LANE -->
        <mxCell id="act-lane" value="ACTION Path" style="swimlane;startSize=30;fillColor=#fff7ed;strokeColor=#ea580c;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="680" width="340" height="380" as="geometry"/>
        </mxCell>
        <mxCell id="act1" value="Identify matched ActionMapping&#xa;(actionKey + targetEndpoint)" style="rounded=1;fillColor=#fff;strokeColor=#ea580c;fontSize=10;" vertex="1" parent="act-lane">
          <mxGeometry x="20" y="45" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="act2" value="Dispatch ActionJob to Queue&#xa;(Service Bus — async)" style="rounded=1;fillColor=#fff;strokeColor=#ea580c;fontSize=10;" vertex="1" parent="act-lane">
          <mxGeometry x="20" y="115" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="act3" value="ActionWorker calls Product&#xa;targetEndpoint (registered by team)" style="rounded=1;fillColor=#ffedd5;strokeColor=#ea580c;fontStyle=1;fontSize=10;" vertex="1" parent="act-lane">
          <mxGeometry x="20" y="185" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="act4" value="Product executes action internally&#xa;(e.g. add_to_cart, checkout...)" style="rounded=1;fillColor=#fff;strokeColor=#ea580c;fontSize=10;" vertex="1" parent="act-lane">
          <mxGeometry x="20" y="255" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="act5" value="SignalR ACK pushed back to SDK" style="rounded=1;fillColor=#fff;strokeColor=#ea580c;fontSize=10;" vertex="1" parent="act-lane">
          <mxGeometry x="20" y="315" width="300" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="ea1-2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="act1" target="act2" parent="act-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea2-3" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="act2" target="act3" parent="act-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea3-4" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="act3" target="act4" parent="act-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea4-5" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="act4" target="act5" parent="act-lane"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- GENERATION LANE -->
        <mxCell id="gen-lane" value="GENERATION Path" style="swimlane;startSize=30;fillColor=#f0fdf4;strokeColor=#16a34a;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="680" width="340" height="380" as="geometry"/>
        </mxCell>
        <mxCell id="gen1" value="Load tenant KB config&#xa;(TenantConfig.KbContent or AI Search)" style="rounded=1;fillColor=#fff;strokeColor=#16a34a;fontSize=10;" vertex="1" parent="gen-lane">
          <mxGeometry x="20" y="45" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="gen2" value="Load conversation history from Blob&#xa;conversations/{tenant}/{userId}/..." style="rounded=1;fillColor=#fff;strokeColor=#16a34a;fontSize=10;" vertex="1" parent="gen-lane">
          <mxGeometry x="20" y="115" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="gen3" value="Retrieve KB chunks&#xa;(Azure AI Search — hybrid)" style="rounded=1;fillColor=#fff;strokeColor=#16a34a;fontSize=10;" vertex="1" parent="gen-lane">
          <mxGeometry x="20" y="185" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="gen4" value="Call Azure OpenAI GPT-4.1&#xa;(KB chunks + history as context)" style="rounded=1;fillColor=#dcfce7;strokeColor=#16a34a;fontStyle=1;fontSize=10;" vertex="1" parent="gen-lane">
          <mxGeometry x="20" y="255" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="gen5" value="Return answer + suggestion chips&#xa;Persist to Blob + SemanticCache" style="rounded=1;fillColor=#fff;strokeColor=#16a34a;fontSize=10;" vertex="1" parent="gen-lane">
          <mxGeometry x="20" y="315" width="300" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="eg1-2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="gen1" target="gen2" parent="gen-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eg2-3" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="gen2" target="gen3" parent="gen-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eg3-4" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="gen3" target="gen4" parent="gen-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eg4-5" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="gen4" target="gen5" parent="gen-lane"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- CHAT LANE -->
        <mxCell id="chat-lane" value="CHAT Path" style="swimlane;startSize=30;fillColor=#faf5ff;strokeColor=#7c3aed;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="680" width="340" height="380" as="geometry"/>
        </mxCell>
        <mxCell id="chat1" value="Load full session history from Blob&#xa;conversations/{tenant}/{userId}/..." style="rounded=1;fillColor=#fff;strokeColor=#7c3aed;fontSize=10;" vertex="1" parent="chat-lane">
          <mxGeometry x="20" y="45" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="chat2" value="Identify product context&#xa;(tenant + active product config)" style="rounded=1;fillColor=#fff;strokeColor=#7c3aed;fontSize=10;" vertex="1" parent="chat-lane">
          <mxGeometry x="20" y="115" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="chat3" value="Optional: call Product Chat Context API&#xa;(registered endpoint — product team owns)" style="rounded=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontStyle=1;fontSize=10;" vertex="1" parent="chat-lane">
          <mxGeometry x="20" y="185" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="chat4" value="Call Azure OpenAI with full context&#xa;(history + KB + product context)" style="rounded=1;fillColor=#fff;strokeColor=#7c3aed;fontSize=10;" vertex="1" parent="chat-lane">
          <mxGeometry x="20" y="255" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="chat5" value="Return reply + chips&#xa;Append to Blob conversation history" style="rounded=1;fillColor=#fff;strokeColor=#7c3aed;fontSize=10;" vertex="1" parent="chat-lane">
          <mxGeometry x="20" y="315" width="300" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="ec1-2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="chat1" target="chat2" parent="chat-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ec2-3" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="chat2" target="chat3" parent="chat-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ec3-4" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="chat3" target="chat4" parent="chat-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ec4-5" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="chat4" target="chat5" parent="chat-lane"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Resolver → Three lanes -->
        <mxCell id="e-res-act" value="ACTION" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#ea580c;fontStyle=1;fontSize=11;strokeWidth=2;" edge="1" source="resolver-box" target="act-lane" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-res-gen" value="GENERATION" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#16a34a;fontStyle=1;fontSize=11;strokeWidth=2;" edge="1" source="resolver-box" target="gen-lane" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-res-chat" value="CHAT" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#7c3aed;fontStyle=1;fontSize=11;strokeWidth=2;" edge="1" source="resolver-box" target="chat-lane" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- MISS arrow from cache to resolver -->
        <mxCell id="e-miss" value="MISS" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#dc2626;fontStyle=1;fontSize=10;" edge="1" source="cache" target="resolver-box" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- req → embed → cache -->
        <mxCell id="e-req-embed" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#374151;" edge="1" source="req" target="embed" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-embed-cache" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#374151;" edge="1" source="embed" target="cache" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ─── PRODUCT BOXES (callback targets) ─── -->
        <mxCell id="prod-row" value="Product Apps — Each Team Owns Their Endpoints" style="swimlane;startSize=28;fillColor=#fef9c3;strokeColor=#d97706;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="1110" width="1160" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="pp-learn" value="Product: Learn&#xa;/action /context" style="rounded=1;fillColor=#fff;strokeColor=#d97706;fontSize=10;fontStyle=1;" vertex="1" parent="prod-row">
