@{ ViewBag.Title = "Change Password"; }
<div style="max-width:520px;">
    <div class="card">
        <div class="card-head">
            <div>
                <h2>Change your password</h2>
                <p>Use at least 10 characters. This is the only administrator account.</p>
            </div>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-err">
                <i class="fas fa-circle-exclamation"></i>
                <div>
                    @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@e.ErrorMessage</div>
                    }
                </div>
            </div>
        }

        <form method="post">
            @Html.AntiForgeryToken()
            <div class="fg">
                <label for="currentPassword">Current password</label>
                <input type="password" id="currentPassword" name="currentPassword" required autocomplete="current-password">
            </div>
            <div class="fg">
                <label for="newPassword">New password</label>
                <input type="password" id="newPassword" name="newPassword" required minlength="10" autocomplete="new-password">
            </div>
            <div class="fg">
                <label for="confirmPassword">Confirm new password</label>
                <input type="password" id="confirmPassword" name="confirmPassword" required minlength="10" autocomplete="new-password">
            </div>
            <button type="submit" class="btn btn-p"><i class="fas fa-save"></i> Update password</button>
        </form>
    </div>
</div>
