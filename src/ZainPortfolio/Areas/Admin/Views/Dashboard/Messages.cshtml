@model List<ContactMessage>
@{ ViewBag.Title = "Contact Messages"; }
<div class="card">
    <div class="card-head">
        <div><h2>Inbox</h2><p>@Model.Count message(s), @ViewBag.UnreadCount unread</p></div>
    </div>
    @if (Model.Any())
    {
        @foreach (var m in Model)
        {
            <div class="card" style="background:var(--a-panel-2);margin-bottom:.8rem;">
                <div class="card-head" style="margin-bottom:.6rem;">
                    <div>
                        <h3>@m.Name @if (!m.IsRead) { <span class="chip chip-new">New</span> }</h3>
                        <p><a href="mailto:@m.Email" style="color:#a5b4fc;">@m.Email</a> &middot; @m.CreatedAt.ToString("dd MMM yyyy, HH:mm")</p>
                    </div>
                    <div class="t-actions">
                        <form method="post" action="/admin/messages/@m.Id/read">@Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-s btn-sm">@(m.IsRead ? "Mark unread" : "Mark read")</button></form>
                        <a href="mailto:@m.Email?subject=Re: @m.Subject" class="btn btn-p btn-sm"><i class="fas fa-reply"></i> Reply</a>
                        <form method="post" action="/admin/messages/@m.Id/delete" onsubmit="return confirm('Delete this message?');">@Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-d btn-sm"><i class="fas fa-trash"></i></button></form>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(m.Subject)) { <p style="font-weight:600;margin-bottom:.4rem;">@m.Subject</p> }
                <p style="color:var(--a-muted);white-space:pre-wrap;">@m.Message</p>
            </div>
        }
    }
    else { <div class="empty"><i class="fas fa-inbox"></i><p>No messages yet.</p></div> }
</div>
