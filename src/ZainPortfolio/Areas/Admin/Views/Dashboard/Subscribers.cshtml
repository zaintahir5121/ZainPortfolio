@model List<Subscriber>
@{ ViewBag.Title = "Subscribers"; }
@section Actions {
    <a href="/admin/subscribers/export" class="btn btn-s btn-sm"><i class="fas fa-download"></i> Export CSV</a>
}
<div class="stat-grid">
    <div class="stat-card"><div class="ico"><i class="fas fa-envelope-open-text"></i></div>
        <div class="num">@ViewBag.ActiveCount</div><div class="lbl">Active subscribers</div></div>
    <div class="stat-card"><div class="ico"><i class="fas fa-list"></i></div>
        <div class="num">@ViewBag.Total</div><div class="lbl">Total records</div></div>
</div>
<div class="card">
    <form method="get" class="card-head">
        <div style="flex:1;max-width:320px;">
            <input type="search" name="q" value="@ViewBag.Query" placeholder="Search by email or name..."
                   style="width:100%;padding:.55rem .85rem;border-radius:9px;background:var(--a-bg);border:1px solid var(--a-border);color:var(--a-text);">
        </div>
        <button type="submit" class="btn btn-s"><i class="fas fa-search"></i> Search</button>
    </form>
    @if (Model.Any())
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>Email</th><th>Name</th><th>Source</th><th>Status</th><th>Subscribed</th><th></th></tr></thead>
                <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>@s.Email</td>
                        <td>@(s.Name ?? "—")</td>
                        <td><span class="chip chip-off">@s.Source</span></td>
                        <td><span class="chip @(s.IsActive ? "chip-on" : "chip-off")">@(s.IsActive ? "Active" : "Unsubscribed")</span></td>
                        <td style="color:var(--a-muted);">@s.SubscribedAt.ToString("dd MMM yyyy")</td>
                        <td><div class="t-actions">
                            <form method="post" action="/admin/subscribers/@s.Id/toggle">@Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-s btn-sm">@(s.IsActive ? "Deactivate" : "Reactivate")</button></form>
                            <form method="post" action="/admin/subscribers/@s.Id/delete" onsubmit="return confirm('Delete this subscriber?');">@Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-d btn-sm"><i class="fas fa-trash"></i></button></form>
                        </div></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (ViewBag.TotalPages > 1)
        {
            <div class="pager">
                @for (var i = 1; i <= (int)ViewBag.TotalPages; i++)
                {
                    if (i == (int)ViewBag.Page) { <span class="cur">@i</span> }
                    else { <a href="/admin/subscribers?page=@i&q=@ViewBag.Query">@i</a> }
                }
            </div>
        }
    }
    else { <div class="empty"><i class="fas fa-envelope-open-text"></i><p>No subscribers yet.</p></div> }
</div>
