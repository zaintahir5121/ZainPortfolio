@model HomeViewModel
@inject ISeoService Seo
@{
    var s = Model.Settings;
    var baseUrl = Seo.BaseUrl(Context.Request, s);

    var faqs = new List<(string Q, string A)>
    {
        ("Do you take on RAG and LLM projects for companies in Malaysia?",
         $"Yes. I'm based in {s.Location} and work with clients across Malaysia, Singapore and the wider region on retrieval-augmented generation, LLM application design and agentic AI systems — from architecture through to production rollout."),
        ("What does an AI architecture engagement usually involve?",
         "It normally starts with a short discovery to understand the business problem, followed by a solution design covering retrieval, grounding, evaluation, guardrails and cost. Delivery then runs in phases with a working proof of concept before full production build."),
        ("Which cloud platform do you specialise in?",
         "Microsoft Azure — including Azure OpenAI, AI Foundry, Service Bus, Data Factory, Cosmos DB, Key Vault and Kubernetes, with infrastructure delivered as code through Bicep and ARM templates."),
        ("Can you lead an existing engineering team rather than just advise?",
         "Yes. I currently lead an engineering organisation of 40+ developers across three squads, covering architecture, delivery governance, hiring and performance management alongside hands-on technical direction."),
        ("How do you make sure an AI feature is actually reliable before it goes live?",
         "Every AI feature gets an evaluation suite built on a golden dataset agreed with the business, with metrics for accuracy, groundedness and refusal rate. It runs in the pipeline and blocks release on regression — 'it looked better when we tried it' is not evidence.")
    };

    ViewBag.Settings = s;
    ViewBag.Meta = new PageMeta
    {
        Title = s.MetaTitle ?? $"{s.OwnerName} | {s.Tagline}",
        Description = s.MetaDescription,
        Keywords = s.MetaKeywords,
        CanonicalPath = "/",
        JsonLd = new List<string>
        {
            Seo.ProfessionalServiceSchema(s, baseUrl),
            Seo.FaqSchema(faqs)
        }
    };
}

<!-- ===================================================== HERO -->
<section class="hero" id="home">
    <div class="hero-bg-grid"></div>
    <div class="hero-orb hero-orb-1"></div>
    <div class="hero-orb hero-orb-2"></div>
    <div class="hero-inner">
        <div class="hero-text">
            <div class="hero-badge"><span class="pulse-dot"></span>@s.HeroBadge</div>

            <div class="hero-roles">
                <span id="typewriter" data-roles="@s.TypewriterRoles"></span><span class="typewriter-cursor">|</span>
            </div>

            <h1 class="hero-h1">
                @{
                    var line1 = s.HeroHeadingLine1;
                    var hl = s.HeroHeadingHighlight;
                }
                @if (!string.IsNullOrWhiteSpace(hl) && line1.Contains(hl))
                {
                    var idx = line1.IndexOf(hl, StringComparison.Ordinal);
                    @line1.Substring(0, idx)<span class="grad-text">@hl</span>@line1.Substring(idx + hl.Length)
                }
                else
                {
                    @line1
                }
                <br />@s.HeroHeadingLine2
            </h1>

            <p class="hero-p">@s.HeroSubheading</p>

            <div class="hero-stats">
                <div class="stat"><span class="stat-n" data-count="@s.StatYears">0</span><sup>+</sup><small>@s.StatYearsLabel</small></div>
                <div class="stat"><span class="stat-n" data-count="@s.StatProjects">0</span><sup>+</sup><small>@s.StatProjectsLabel</small></div>
                <div class="stat"><span class="stat-n" data-count="@s.StatEnterprise">0</span><sup>+</sup><small>@s.StatEnterpriseLabel</small></div>
            </div>

            <div class="hero-actions">
                <a href="/projects" class="btn-primary">View Work <i class="fas fa-arrow-right"></i></a>
                <a href="#contact" class="btn-ghost">Let's Talk <i class="fas fa-paper-plane"></i></a>
            </div>

            <div class="hero-socials">
                @if (!string.IsNullOrWhiteSpace(s.LinkedInUrl)) { <a href="@s.LinkedInUrl" target="_blank" rel="noopener" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a> }
                @if (!string.IsNullOrWhiteSpace(s.GitHubUrl)) { <a href="@s.GitHubUrl" target="_blank" rel="noopener" aria-label="GitHub"><i class="fab fa-github"></i></a> }
                @if (!string.IsNullOrWhiteSpace(s.YouTubeUrl)) { <a href="@s.YouTubeUrl" target="_blank" rel="noopener" aria-label="YouTube"><i class="fab fa-youtube"></i></a> }
                @if (!string.IsNullOrWhiteSpace(s.UpworkUrl)) { <a href="@s.UpworkUrl" target="_blank" rel="noopener" aria-label="Upwork"><i class="fas fa-briefcase"></i></a> }
                <a href="mailto:@s.Email" aria-label="Email"><i class="fas fa-envelope"></i></a>
                @if (!string.IsNullOrWhiteSpace(s.WhatsAppNumber)) { <a href="https://wa.me/@s.WhatsAppNumber" target="_blank" rel="noopener" aria-label="WhatsApp"><i class="fab fa-whatsapp"></i></a> }
            </div>
        </div>

        <div class="hero-visual">
            @if (!string.IsNullOrWhiteSpace(s.IntroVideoId))
            {
                <div class="video-card">
                    <div class="code-bar">
                        <span class="cb r"></span><span class="cb y"></span><span class="cb g"></span>
                        <span class="code-file">intro.mp4</span>
                    </div>
                    <div class="video-embed" style="background-image:url('https://img.youtube.com/vi/@s.IntroVideoId/hqdefault.jpg')">
                        <iframe src="https://www.youtube.com/embed/@s.IntroVideoId?@(s.IntroVideoAutoplay ? "autoplay=1&mute=1&loop=1&playlist=" + s.IntroVideoId + "&" : "")playsinline=1&rel=0"
                                title="@s.OwnerName — Introduction"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
                    </div>
                </div>
            }
            <div class="tech-chips">
                <span><i class="fab fa-microsoft"></i> Azure</span>
                <span><i class="fas fa-robot"></i> RAG / LLMs</span>
                <span><i class="fab fa-docker"></i> Docker</span>
                <span><i class="fab fa-angular"></i> Angular</span>
                <span><i class="fas fa-layer-group"></i> .NET Core</span>
                <span><i class="fas fa-infinity"></i> CI/CD</span>
            </div>
        </div>
    </div>
    <a href="#about" class="scroll-hint" aria-label="Scroll to about"><i class="fas fa-chevron-down"></i></a>
</section>

<!-- ===================================================== ABOUT -->
<section class="section" id="about">
    <div class="container">
        <div class="sec-header reveal">
            <span class="sec-tag">About Me</span>
            <h2>
                @{
                    var at = s.AboutTitle; var ah = s.AboutTitleHighlight;
                }
                @if (!string.IsNullOrWhiteSpace(ah) && at.Contains(ah))
                {
                    var i2 = at.IndexOf(ah, StringComparison.Ordinal);
                    @at.Substring(0, i2)<span class="grad-text">@ah</span>@at.Substring(i2 + ah.Length)
                }
                else { @at }
            </h2>
        </div>

        <div class="about-grid">
            <div class="about-img-wrap reveal">
                <div class="about-img-frame">
                    @if (!string.IsNullOrWhiteSpace(s.ProfileImageUrl))
                    {
                        <img src="@s.ProfileImageUrl" alt="@s.OwnerName — @s.Tagline" loading="lazy">
                    }
                    else
                    {
                        <div class="proj-img-bg" style="background:var(--grad)"><i class="fas fa-user proj-img-icon"></i></div>
                    }
                </div>
                <div class="exp-badge">
                    <span class="exp-n">@s.StatYears+</span>
                    <span class="exp-l">Years of<br>Excellence</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(s.LinkedInUrl))
                {
                    <a href="@s.LinkedInUrl" target="_blank" rel="noopener" class="li-badge">
                        <i class="fab fa-linkedin"></i> LinkedIn Profile
                    </a>
                }
            </div>

            <div class="about-content reveal">
                <p class="about-lead">@s.AboutLead</p>
                <p>@s.AboutBody</p>

                <div class="about-cards">
                    <div class="about-card">
                        <i class="fas fa-brain"></i>
                        <div><strong>AI &amp; LLM Expert</strong><p>RAG, LLMs, agentic systems, predictive AI &amp; AI Foundry</p></div>
                    </div>
                    <div class="about-card">
                        <i class="fas fa-cloud"></i>
                        <div><strong>Azure Architect</strong><p>Service Bus, Data Factory, Cosmos DB, Copilot Studio</p></div>
                    </div>
                    <div class="about-card">
                        <i class="fas fa-diagram-project"></i>
                        <div><strong>Engineering Leader</strong><p>40+ engineers, delivery governance &amp; technical strategy</p></div>
                    </div>
                    <div class="about-card">
                        <i class="fas fa-rocket"></i>
                        <div><strong>DevOps &amp; Automation</strong><p>CI/CD, IaC (ARM, Terraform, Bicep), Kubernetes</p></div>
                    </div>
                </div>

                <div class="about-tags">
                    @foreach (var tag in TextHelpers.Csv(s.AboutTags))
                    {
                        <span>@tag</span>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===================================================== SKILLS -->
@if (Model.SkillCategories.Any())
{
    <section class="section section-alt" id="skills">
        <div class="container">
            <div class="sec-header reveal">
                <span class="sec-tag">Technical Expertise</span>
                <h2>Technologies I <span class="grad-text">Master</span></h2>
                <p class="sec-desc">A toolkit built over @s.StatYears+ years of enterprise delivery</p>
            </div>
            <div class="skills-wrap">
                @foreach (var cat in Model.SkillCategories)
                {
                    <div class="skill-group reveal">
                        <div class="sg-head"><i class="@cat.IconClass"></i><h3>@cat.Name</h3></div>
                        <div class="sg-grid">
                            @foreach (var sk in cat.Skills)
                            {
                                <div class="sk-card" data-pct="@sk.Percentage">
                                    <span>@sk.Name</span>
                                    <div class="sk-bar"><div class="sk-fill"></div></div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- ===================================================== EXPERIENCE -->
@if (Model.Experiences.Any())
{
    <section class="section" id="experience">
        <div class="container">
            <div class="sec-header reveal">
                <span class="sec-tag">Career Journey</span>
                <h2>Professional <span class="grad-text">Experience</span></h2>
            </div>
            <div class="timeline">
                @foreach (var exp in Model.Experiences)
                {
                    <div class="tl-item reveal">
                        <div class="tl-dot @(exp.IsCurrent ? "current" : "")"></div>
                        <div class="tl-card">
                            <div class="tl-top">
                                <div>
                                    <h3 class="tl-role">@exp.Role</h3>
                                    <h4 class="tl-co">@exp.Company</h4>
                                </div>
                                <div class="tl-meta">
                                    <span>@exp.DateRange</span>
                                    @if (!string.IsNullOrWhiteSpace(exp.Location))
                                    {
                                        <span><i class="fas fa-map-marker-alt"></i> @exp.Location</span>
                                    }
                                    @if (exp.IsCurrent) { <span class="badge-cur">Current</span> }
                                </div>
                            </div>
                            @if (exp.BulletList.Any())
                            {
                                <ul>
                                    @foreach (var bullet in exp.BulletList) { <li>@bullet</li> }
                                </ul>
                            }
                            @if (exp.TagList.Any())
                            {
                                <div class="tl-tags">
                                    @foreach (var t in exp.TagList) { <span>@t</span> }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- ===================================================== FEATURED PROJECTS -->
@if (s.EnableProjects && Model.FeaturedProjects.Any())
{
    <section class="section section-alt" id="projects">
        <div class="container">
            <div class="sec-header reveal">
                <span class="sec-tag">Featured Work</span>
                <h2>Projects That <span class="grad-text">Deliver Results</span></h2>
                <p class="sec-desc">Every project below started as a business problem, not a technology choice</p>
            </div>

            <div class="proj-grid">
                @foreach (var p in Model.FeaturedProjects)
                {
                    <partial name="_ProjectCard" model="p" />
                }
            </div>

            <div style="text-align:center;margin-top:2.5rem;">
                <a href="/projects" class="btn-primary">
                    View all @Model.TotalProjects projects <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </section>
}

<!-- ===================================================== LATEST BLOG -->
@if (s.EnableBlog && Model.LatestPosts.Any())
{
    <section class="section" id="insights">
        <div class="container">
            <div class="sec-header reveal">
                <span class="sec-tag">Insights</span>
                <h2>From The <span class="grad-text">Blog</span></h2>
                <p class="sec-desc">Practical notes on AI architecture, Azure and engineering leadership</p>
            </div>
            <div class="blog-grid">
                @foreach (var post in Model.LatestPosts)
                {
                    <partial name="_PostCard" model="post" />
                }
            </div>
            <div style="text-align:center;margin-top:2.5rem;">
                <a href="/blog" class="btn-ghost">Read all articles <i class="fas fa-arrow-right"></i></a>
            </div>
        </div>
    </section>
}

<!-- ===================================================== FAQ (rich results) -->
<section class="section section-alt" id="faq">
    <div class="container">
        <div class="sec-header reveal">
            <span class="sec-tag">Common Questions</span>
            <h2>What People <span class="grad-text">Usually Ask</span></h2>
        </div>
        <div class="faq-list">
            @foreach (var f in faqs)
            {
                <div class="faq-item reveal">
                    <button class="faq-q" type="button">@f.Q <i class="fas fa-plus"></i></button>
                    <div class="faq-a"><p>@f.A</p></div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ===================================================== NEWSLETTER -->
@if (s.EnableNewsletter)
{
    <section class="section" id="newsletter">
        <div class="container">
            <div class="newsletter reveal">
                <h3>Get new writing in your inbox</h3>
                <p>Practical AI architecture, Azure and engineering leadership. No noise, unsubscribe anytime.</p>
                <form class="sub-form" data-subscribe data-source="home">
                    @Html.AntiForgeryToken()
                    <input type="email" name="email" placeholder="you@@company.com" required aria-label="Email address">
                    <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
                    <button type="submit">Subscribe</button>
                </form>
                <div class="sub-msg" role="status"></div>
            </div>
        </div>
    </section>
}

<!-- ===================================================== CONTACT -->
<section class="section section-alt" id="contact">
    <div class="container">
        <div class="sec-header reveal">
            <span class="sec-tag">Get In Touch</span>
            <h2>Let's Build Something <span class="grad-text">Amazing</span></h2>
            <p class="sec-desc">Have a project in mind or want to explore working together?</p>
        </div>

        <div class="contact-grid">
            <div class="contact-info reveal">
                <h3>Contact Information</h3>

                <div class="ci-item">
                    <div class="ci-icon"><i class="fas fa-envelope"></i></div>
                    <div><strong>Email</strong><a href="mailto:@s.Email">@s.Email</a></div>
                </div>
                <div class="ci-item">
                    <div class="ci-icon"><i class="fas fa-map-marker-alt"></i></div>
                    <div><strong>Location</strong><span>@s.Location</span></div>
                </div>
                @if (!string.IsNullOrWhiteSpace(s.WhatsAppNumber))
                {
                    <div class="ci-item">
                        <div class="ci-icon" style="color:#25d366;background:rgba(37,211,102,.12)"><i class="fab fa-whatsapp"></i></div>
                        <div><strong>WhatsApp</strong><a href="https://wa.me/@s.WhatsAppNumber" target="_blank" rel="noopener">@s.Phone</a></div>
                    </div>
                }
                <div class="ci-item">
                    <div class="ci-icon"><i class="fas fa-calendar-check"></i></div>
                    <div><strong>Availability</strong><span>@s.Availability</span></div>
                </div>

                <div class="ci-socials">
                    @if (!string.IsNullOrWhiteSpace(s.LinkedInUrl)) { <a href="@s.LinkedInUrl" target="_blank" rel="noopener" class="ci-soc"><i class="fab fa-linkedin-in"></i></a> }
                    @if (!string.IsNullOrWhiteSpace(s.GitHubUrl)) { <a href="@s.GitHubUrl" target="_blank" rel="noopener" class="ci-soc"><i class="fab fa-github"></i></a> }
                    @if (!string.IsNullOrWhiteSpace(s.YouTubeUrl)) { <a href="@s.YouTubeUrl" target="_blank" rel="noopener" class="ci-soc"><i class="fab fa-youtube"></i></a> }
                    @if (!string.IsNullOrWhiteSpace(s.UpworkUrl)) { <a href="@s.UpworkUrl" target="_blank" rel="noopener" class="ci-soc"><i class="fas fa-briefcase"></i></a> }
                </div>

                @if (!string.IsNullOrWhiteSpace(s.CalendlyUrl))
                {
                    <a href="@s.CalendlyUrl" target="_blank" rel="noopener" class="btn-primary" style="display:inline-flex;margin-top:1.5rem;">
                        <i class="fas fa-video"></i> Schedule a Meeting
                    </a>
                }
            </div>

            @if (s.EnableContactForm)
            {
                <form class="contact-form reveal" method="post" asp-controller="Home" asp-action="Contact">
                    @Html.AntiForgeryToken()
                    <div class="cf-row">
                        <div class="cf-group">
                            <label for="cf-name">Full Name</label>
                            <input type="text" id="cf-name" name="Name" placeholder="John Doe" required maxlength="160">
                        </div>
                        <div class="cf-group">
                            <label for="cf-email">Email Address</label>
                            <input type="email" id="cf-email" name="Email" placeholder="john@@example.com" required maxlength="200">
                        </div>
                    </div>
                    <div class="cf-group">
                        <label for="cf-subject">Subject</label>
                        <input type="text" id="cf-subject" name="Subject" placeholder="Project Inquiry" maxlength="250">
                    </div>
                    <div class="cf-group">
                        <label for="cf-msg">Message</label>
                        <textarea id="cf-msg" name="Message" rows="5" placeholder="Tell me about your project..." required maxlength="4000"></textarea>
                    </div>
                    <button type="submit" class="btn-primary" style="width:100%;justify-content:center;">
                        Send Message <i class="fas fa-paper-plane"></i>
                    </button>
                    @if (TempData["ContactSuccess"] is string ok)
                    {
                        <div class="cf-status ok">@ok</div>
                    }
                    @if (TempData["ContactError"] is string err)
                    {
                        <div class="cf-status err">@err</div>
                    }
                </form>
            }
        </div>
    </div>
</section>
