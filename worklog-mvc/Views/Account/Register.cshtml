@model WorkLogApp.Models.ViewModels.RegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Create account";
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create account — WorkLog</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>

<div class="login-page">
  <div class="login-card">

    <a asp-controller="Home" asp-action="Index" class="back-link">← back</a>

    <div class="login-logo">worklog<span>.</span></div>
    <p class="login-tag">Create your free account</p>

    @if (!ViewData.ModelState.IsValid)
    {
      <div class="login-err">
        @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
          <div>@e.ErrorMessage</div>
        }
      </div>
    }

    <form asp-controller="Account" asp-action="Register" method="post" class="login-form">
      @Html.AntiForgeryToken()
      <input type="hidden" asp-for="Name" id="hName">

      <div class="lfield">
        <label>Username</label>
        <input asp-for="Username" placeholder="pick a username" autocomplete="username"
               autocapitalize="none" autofocus oninput="syncName()">
        <span class="lfield-hint">Letters, numbers, _ - . only</span>
      </div>

      <div class="lfield">
        <label>Password</label>
        <input asp-for="Password" type="password" placeholder="min 6 characters"
               autocomplete="new-password">
      </div>

      <button type="submit" class="login-btn">Create account →</button>
    </form>

    <div class="login-register-link" style="margin-top:20px">
      Already have an account? <a asp-controller="Account" asp-action="Login">Sign in</a>
    </div>

  </div>
</div>

<script>
  function syncName() {
    document.getElementById('hName').value =
      document.getElementById('Username').value.trim() || 'User';
  }
</script>
</body>
</html>
