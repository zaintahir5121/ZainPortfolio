@model WorkLogApp.Models.ViewModels.RegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Join WorkLog";
    bool hasErrors = !ViewData.ModelState.IsValid;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create a Free Account — WorkLog | worklog.today</title>
  <meta name="description" content="Create your free WorkLog account at worklog.today. Log daily work in seconds, AI structures it, export timesheets instantly. No credit card, no subscription.">
  <meta name="robots" content="index, follow, max-snippet:-1">
  <link rel="canonical" href="https://worklog.today/Account/Register">
  <meta property="og:type"        content="website">
  <meta property="og:site_name"   content="WorkLog">
  <meta property="og:url"         content="https://worklog.today/Account/Register">
  <meta property="og:title"       content="Join WorkLog — Free Work Journal &amp; Time Tracker">
  <meta property="og:description" content="Sign up free at worklog.today. Log work in seconds, AI parses it, timesheets export in one click. Private by default, no credit card required.">
  <meta property="og:image"       content="https://worklog.today/og-image.png">
  <meta name="twitter:card"       content="summary_large_image">
  <meta name="twitter:title"      content="Join WorkLog — Free Work Journal">
  <meta name="twitter:description" content="Sign up free. Log work in seconds, AI structures it. worklog.today">
  <meta name="twitter:image"      content="https://worklog.today/og-image.png">
  <meta name="theme-color" content="#6366f1">
  <link rel="manifest" href="/manifest.json">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Inter', sans-serif;
      background: #05050f;
      min-height: 100dvh;
      display: flex; align-items: center; justify-content: center;
      padding: 20px;
      overflow: hidden;
    }

    .orb { position: fixed; border-radius: 50%; pointer-events: none; z-index: 0; filter: blur(80px); }
    .orb-1 { width: 55vw; height: 55vw; top: -20vw; right: -10vw; background: radial-gradient(circle, rgba(168,85,247,.32) 0%, transparent 65%); animation: orbDrift 16s ease-in-out infinite; }
    .orb-2 { width: 40vw; height: 40vw; bottom: -12vw; left: -8vw; background: radial-gradient(circle, rgba(99,102,241,.28) 0%, transparent 65%); animation: orbDrift 20s ease-in-out infinite reverse; }
    .orb-3 { width: 28vw; height: 28vw; top: 30%; right: 55%; background: radial-gradient(circle, rgba(236,72,153,.12) 0%, transparent 65%); animation: orbDrift 24s ease-in-out infinite 6s; }
    @@keyframes orbDrift {
      0%, 100% { transform: translate(0,0) scale(1); }
      33% { transform: translate(-2vw, 2vh) scale(1.04); }
      66% { transform: translate(1vw, -2vh) scale(.97); }
    }

    .page-wrap { position: relative; z-index: 1; width: 100%; max-width: 480px; }

    .chat-window {
      background: rgba(8, 6, 22, 0.84);
      border: 1px solid rgba(255,255,255,.07);
      border-radius: 22px;
      backdrop-filter: blur(28px);
      -webkit-backdrop-filter: blur(28px);
      box-shadow: 0 32px 80px rgba(0,0,0,.65), 0 0 0 1px rgba(255,255,255,.04), inset 0 1px 0 rgba(255,255,255,.06);
      overflow: hidden;
    }

    .cw-bar {
      display: flex; align-items: center; justify-content: space-between;
      padding: 18px 24px 16px;
      border-bottom: 1px solid rgba(255,255,255,.05);
    }
    .cw-bar-back { font-size: 12px; color: rgba(255,255,255,.22); text-decoration: none; transition: color .15s; }
    .cw-bar-back:hover { color: rgba(255,255,255,.5); }
    .cw-logo { font-size: 16px; font-weight: 800; color: rgba(255,255,255,.88); letter-spacing: -.4px; }
    .cw-logo em { opacity: .25; font-style: normal; }
    .cw-bar-spacer { width: 40px; }

    .cw-status { display: flex; align-items: center; justify-content: center; gap: 6px; padding: 8px 24px 0; }
    .cw-status-dot { width: 7px; height: 7px; background: #a78bfa; border-radius: 50%; box-shadow: 0 0 6px rgba(167,139,250,.6); animation: pulse 2s ease-in-out infinite; }
    .cw-status-txt { font-size: 11.5px; color: rgba(255,255,255,.3); }
    @@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.5} }

    .cw-body { padding: 20px 24px 0; display: flex; flex-direction: column; gap: 8px; }

    .cw-err {
      margin: 8px 24px 0 68px;
      background: rgba(239,68,68,.1); border: 1px solid rgba(239,68,68,.22);
      border-radius: 8px 18px 18px 18px;
      padding: 10px 16px; color: #fca5a5; font-size: 13px;
      animation: springIn .4s cubic-bezier(.16,1,.3,1) both;
    }

    .cw-bot { display: flex; align-items: flex-start; gap: 10px; }
    .cw-av {
      width: 34px; height: 34px; flex-shrink: 0;
      background: linear-gradient(135deg, #8b5cf6 0%, #d946ef 100%);
      border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      color: #fff; font-size: 15px; font-weight: 700;
      box-shadow: 0 4px 14px rgba(139,92,246,.45);
    }
    .cw-bub {
      background: rgba(139,92,246,.1);
      border: 1px solid rgba(139,92,246,.22);
      border-radius: 6px 18px 18px 18px;
      padding: 12px 16px;
      color: rgba(218,218,255,.9);
      font-size: 14.5px; line-height: 1.65;
      max-width: 320px;
    }
    .cw-bub strong { color: #fff; }
    .cw-bub small { display: block; font-size: 11.5px; color: rgba(160,160,220,.45); margin-top: 5px; }

    .cw-user { display: flex; justify-content: flex-end; position: relative; }
    .cw-inp-wrap { position: relative; width: 285px; }
    .cw-inp {
      width: 100%;
      background: rgba(255,255,255,.05);
      border: 1.5px solid rgba(255,255,255,.1);
      border-radius: 18px 6px 18px 18px;
      padding: 11px 44px 11px 18px;
      color: rgba(255,255,255,.9);
      font-size: 14.5px; font-family: 'Inter', sans-serif;
      outline: none;
      transition: border-color .2s, background .2s, box-shadow .2s;
    }
    .cw-inp:focus {
      border-color: rgba(139,92,246,.6);
      background: rgba(139,92,246,.08);
      box-shadow: 0 0 0 4px rgba(139,92,246,.12);
    }
    .cw-inp::placeholder { color: rgba(255,255,255,.18); }
    .cw-inp-arrow {
      position: absolute; right: 8px; top: 50%; transform: translateY(-50%);
      width: 28px; height: 28px;
      background: rgba(139,92,246,.5);
      border: none; border-radius: 50%;
      color: #fff; cursor: pointer; font-size: 13px;
      display: flex; align-items: center; justify-content: center;
      transition: background .15s, transform .15s;
    }
    .cw-inp-arrow:hover { background: #8b5cf6; transform: translateY(-50%) scale(1.1); }
    .cw-inp-arrow.submit { background: #8b5cf6; }
    .cw-inp-arrow.submit:hover { background: #7c3aed; }

    .cw-foot {
      padding: 16px 24px 22px;
      margin-top: 16px;
      border-top: 1px solid rgba(255,255,255,.05);
    }
    .cw-signin { text-align: center; font-size: 13px; color: rgba(255,255,255,.28); }
    .cw-signin a { color: rgba(139,92,246,.9); font-weight: 600; text-decoration: none; transition: color .15s; }
    .cw-signin a:hover { color: #c084fc; }

    .hidden { display: none !important; }

    @@keyframes springIn {
      from { opacity: 0; transform: translateY(12px) scale(.97); }
      to   { opacity: 1; transform: translateY(0) scale(1); }
    }
    .a1 { animation: springIn .5s cubic-bezier(.16,1,.3,1) .1s both; }
    .a2 { animation: springIn .5s cubic-bezier(.16,1,.3,1) .26s both; }
    .a3 { animation: springIn .5s cubic-bezier(.16,1,.3,1) .44s both; }
    .a4 { animation: springIn .5s cubic-bezier(.16,1,.3,1) .60s both; }

    @@media (prefers-reduced-motion: reduce) {
      *, .orb { animation: none !important; }
    }
  </style>
</head>
<body>

<div class="orb orb-1"></div>
<div class="orb orb-2"></div>
<div class="orb orb-3"></div>

<div class="page-wrap">
  <div class="chat-window">

    <div class="cw-bar">
      <a href="/" class="cw-bar-back">← home</a>
      <div class="cw-logo">worklog<em>.</em></div>
      <div class="cw-bar-spacer"></div>
    </div>

    <div class="cw-status">
      <span class="cw-status-dot"></span>
      <span class="cw-status-txt">Free forever · no credit card</span>
    </div>

    @if (hasErrors)
    {
      <div class="cw-err">
        @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        { <div>@e.ErrorMessage</div> }
      </div>
    }

    <form asp-controller="Account" asp-action="Register" method="post" autocomplete="on" id="regForm">
      @Html.AntiForgeryToken()
      <input type="hidden" asp-for="Name" id="hName">

      <div class="cw-body">
        <div class="cw-bot a1">
          <div class="cw-av">✦</div>
          <div class="cw-bub">Hey! 👋 Let's set you up in 10 seconds.<br>
            Pick a <strong>username</strong> you'll use to sign in.
            <small>Letters, numbers, _ - . only · no spaces</small>
          </div>
        </div>

        <div class="cw-user a2">
          <div class="cw-inp-wrap">
            <input class="cw-inp" asp-for="Username" id="Username"
                   placeholder="choose a username…" autocomplete="username"
                   autocapitalize="none" autofocus
                   oninput="syncName()" onkeydown="usernameKey(event)">
            <button type="button" class="cw-inp-arrow" onclick="revealPwd()" tabindex="-1">→</button>
          </div>
        </div>

        <div class="cw-bot a3 @(hasErrors ? "" : "hidden")" id="pwdQ">
          <div class="cw-av">✦</div>
          <div class="cw-bub">Nice choice! Now set a <strong>password</strong>.
            <small>At least 6 characters · only you will know it</small>
          </div>
        </div>

        <div class="cw-user a4 @(hasErrors ? "" : "hidden")" id="pwdW">
          <div class="cw-inp-wrap">
            <input class="cw-inp" asp-for="Password" id="Password" type="password"
                   placeholder="min 6 characters" autocomplete="new-password"
                   onkeydown="pwdKey(event)">
            <button type="submit" class="cw-inp-arrow submit" tabindex="-1">→</button>
          </div>
        </div>
      </div>
    </form>

    <div class="cw-foot">
      <div class="cw-signin">
        Already have an account? <a asp-controller="Account" asp-action="Login">Sign in →</a>
      </div>
    </div>

  </div>
</div>

<script>
  function syncName() {
    document.getElementById('hName').value =
      document.getElementById('Username').value.trim() || 'User';
  }
  function revealPwd() {
    if (!document.getElementById('Username').value.trim()) return;
    syncName();
    ['pwdQ','pwdW'].forEach(id => {
      const el = document.getElementById(id);
      el.classList.remove('hidden');
      el.style.animation = 'springIn .45s cubic-bezier(.16,1,.3,1) 0s both';
    });
    setTimeout(() => document.getElementById('Password')?.focus(), 180);
  }
  function usernameKey(e) {
    if ((e.key === 'Enter' || e.key === 'Tab') && document.getElementById('Username').value.trim()) {
      e.preventDefault(); revealPwd();
    }
  }
  function pwdKey(e) {
    if (e.key === 'Enter') { e.preventDefault(); document.getElementById('regForm').submit(); }
  }
</script>
</body>
</html>
