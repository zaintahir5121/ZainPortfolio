@model List<WorkLogApp.Models.Experience>
@{
    ViewData["Title"] = "Experience";
}

<div class="pg-head">
  <div>
    <h1>Experience</h1>
    <p class="pg-date">Your career timeline — every role that shaped you.</p>
  </div>
  <a asp-controller="Growth" asp-action="Index" class="pg-back">← Growth Hub</a>
</div>

<!-- Add form -->
<div class="add-card" id="addCard">
  <button class="add-toggle" id="addToggle" onclick="toggleAddForm()">+ Add role</button>
  <form class="add-form hidden" id="addForm" method="post" asp-controller="Experience" asp-action="Add">
    @Html.AntiForgeryToken()
    <div class="af-grid">
      <div class="rfield">
        <label>Company *</label>
        <input name="company" placeholder="Acme Corp, Freelance, Startup XYZ..." required>
      </div>
      <div class="rfield">
        <label>Role / Title *</label>
        <input name="role" placeholder="Senior Developer, Lead Engineer..." required>
      </div>
      <div class="rfield">
        <label>Location</label>
        <input name="location" placeholder="Remote, New York, London..." >
      </div>
      <div class="rfield">
        <label>Start date</label>
        <input type="date" name="startDate" required>
      </div>
      <div class="rfield" id="endDateField">
        <label>End date</label>
        <input type="date" name="endDate" id="endDateInput">
      </div>
      <div class="rfield xp-current-check">
        <label style="flex-direction:row;align-items:center;gap:8px;cursor:pointer">
          <input type="checkbox" name="isCurrent" value="true" id="isCurrentCheck" onchange="toggleCurrent(this)">
          <span>Currently working here</span>
        </label>
      </div>
      <div class="rfield af-full">
        <label>Description</label>
        <textarea name="description" placeholder="Key responsibilities, impact, what you built..."></textarea>
      </div>
      <div class="rfield af-full">
        <label>Skills / Tags</label>
        <input name="tags" placeholder="React, Node.js, team lead, product management...">
      </div>
    </div>
    <div class="af-actions">
      <button type="submit" class="btn-primary">Save role</button>
      <button type="button" class="btn-ghost" onclick="toggleAddForm()">Cancel</button>
    </div>
  </form>
</div>

@if (Model.Count == 0)
{
  <div class="empty">
    <div class="empty-ico">💼</div>
    <h3>No experience yet</h3>
    <p>Add your career history — jobs, freelance gigs, internships, anything that counts.</p>
  </div>
}
else
{
  <div class="xp-timeline">
    @foreach (var e in Model)
    {
      <div class="xp-item">
        <div class="xp-spine">
          <div class="xp-dot @(e.IsCurrent ? "xp-dot-current" : "")"></div>
          <div class="xp-line"></div>
        </div>
        <div class="xp-body">
          <div class="xp-header">
            <div>
              <div class="xp-role">@e.Role</div>
              <div class="xp-company">
                @e.Company
                @if (!string.IsNullOrWhiteSpace(e.Location)) { <span class="xp-loc">· @e.Location</span> }
              </div>
            </div>
            <div class="xp-right">
              <div class="xp-dates">
                @e.StartDate.ToString("MMM yyyy") — @(e.IsCurrent ? "Present" : (e.EndDate?.ToString("MMM yyyy") ?? "—"))
              </div>
              <div class="xp-duration">
                @e.Duration
                @if (e.IsCurrent) { <span class="xp-current-badge">Current</span> }
              </div>
            </div>
          </div>
          @if (!string.IsNullOrWhiteSpace(e.Description))
          {
            <div class="xp-desc">@e.Description</div>
          }
          @if (!string.IsNullOrWhiteSpace(e.Tags))
          {
            <div class="xp-tags">
              @foreach (var tag in e.Tags.Split(",", StringSplitOptions.RemoveEmptyEntries))
              {
                <span class="xp-tag">@tag.Trim()</span>
              }
            </div>
          }
          <form method="post" asp-controller="Experience" asp-action="Delete" style="margin-top:12px">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@e.Id">
            <button class="btn-del" onclick="return confirm('Remove this role?')">Remove</button>
          </form>
        </div>
      </div>
    }
  </div>
}

@section Scripts {
<script>
function toggleAddForm() {
  const form = document.getElementById("addForm");
  const btn  = document.getElementById("addToggle");
  const isHidden = form.classList.contains("hidden");
  form.classList.toggle("hidden", !isHidden);
  btn.textContent = isHidden ? "✕ Cancel" : "+ Add role";
}
function toggleCurrent(cb) {
  const field = document.getElementById("endDateField");
  const input = document.getElementById("endDateInput");
  field.style.opacity = cb.checked ? "0.3" : "1";
  input.disabled = cb.checked;
}
</script>
}
