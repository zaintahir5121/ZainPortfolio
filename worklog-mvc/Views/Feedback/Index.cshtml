@model List<WorkLogApp.Models.FeedbackEntry>
@{
    ViewData["Title"] = "Feedback — Admin";
    var avg = Model.Any() ? Model.Average(f => f.Rating) : 0;
}
<div class="main-inner" style="max-width:860px;margin:0 auto;padding:32px 20px">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;flex-wrap:wrap;gap:12px">
    <div>
      <h1 style="font-size:22px;font-weight:800;color:var(--text);margin:0">💬 User Feedback</h1>
      <p style="font-size:13px;color:var(--muted);margin:4px 0 0">@Model.Count submission@(Model.Count != 1 ? "s" : "") · avg rating @avg.ToString("F1") / 5</p>
    </div>
  </div>

  @if (!Model.Any())
  {
    <div style="text-align:center;padding:60px 20px;color:var(--muted)">
      <div style="font-size:42px;margin-bottom:12px">💬</div>
      <div style="font-size:16px;font-weight:600;color:var(--text-2)">No feedback yet</div>
      <p style="font-size:13px;margin-top:6px">Users can submit feedback from the app footer.</p>
    </div>
  }
  else
  {
    <div style="display:flex;flex-direction:column;gap:12px">
      @foreach (var f in Model)
      {
        var stars = string.Concat(Enumerable.Range(1, 5).Select(i => i <= f.Rating ? "★" : "☆"));
        <div style="background:var(--white);border:1px solid var(--line);border-radius:12px;padding:16px 18px">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;flex-wrap:wrap;gap:8px">
            <div style="display:flex;align-items:center;gap:12px">
              <span style="font-size:18px;color:#f59e0b;letter-spacing:-1px">@stars</span>
              <span style="font-size:13px;font-weight:600;background:var(--accent-bg);color:var(--accent);padding:2px 10px;border-radius:99px">@f.Category</span>
              @if (!string.IsNullOrWhiteSpace(f.UserName))
              {
                <span style="font-size:12px;color:var(--muted)">by @f.UserName</span>
              }
            </div>
            <span style="font-size:11.5px;color:var(--muted)">@f.CreatedAt.ToString("MMM d, yyyy · h:mm tt")</span>
          </div>
          @if (!string.IsNullOrWhiteSpace(f.Message))
          {
            <p style="font-size:13.5px;color:var(--text-2);margin:0;line-height:1.6">@f.Message</p>
          }
          else
          {
            <p style="font-size:12px;color:var(--muted);margin:0;font-style:italic">No message provided.</p>
          }
        </div>
      }
    </div>
  }
</div>
