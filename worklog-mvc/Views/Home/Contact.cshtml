@{
    Layout = "_PublicLayout";
    ViewData["Title"]       = "Contact WorkLog";
    ViewData["Description"] = "Get in touch with the WorkLog team — feedback, bug reports, or feature requests. We'd love to hear from you.";
    ViewData["Robots"]      = "index, follow";
}

<div class="policy-head">
  <div class="ph-label">Get in touch</div>
  <h1>Contact Us</h1>
  <p class="ph-meta">We'd love to hear from you — feedback, bugs, or feature ideas.</p>
</div>

<div class="policy-body">

  @if (TempData["ContactSent"] is string)
  {
    <div class="pb-callout" style="background:#dcfce7;border-color:#bbf7d0;color:#166534">
      <strong>Message sent!</strong> Thanks for reaching out. We'll get back to you as soon as possible.
    </div>
  }

  <form class="contact-form" method="post" asp-controller="Home" asp-action="ContactSubmit">
    @Html.AntiForgeryToken()
    <div class="cf-grid">
      <div class="cfield">
        <label for="cfName">Your name</label>
        <input type="text" id="cfName" name="name" placeholder="Jane Smith" required>
      </div>
      <div class="cfield">
        <label for="cfEmail">Email address</label>
        <input type="email" id="cfEmail" name="email" placeholder="jane@example.com" required>
      </div>
      <div class="cfield cf-full">
        <label for="cfSubject">Subject</label>
        <input type="text" id="cfSubject" name="subject" placeholder="Feature request, bug report, or general enquiry">
      </div>
      <div class="cfield cf-full">
        <label for="cfMsg">Message</label>
        <textarea id="cfMsg" name="message" placeholder="Tell us what's on your mind..." required></textarea>
      </div>
    </div>
    <button type="submit" class="cf-submit">Send message →</button>
  </form>

  <div class="contact-info">
    <div class="ci-item">
      <div class="ci-ico">📧</div>
      <div>
        <div class="ci-label">Email</div>
        <div class="ci-val"><a href="mailto:zain.tahir512@gmail.com">zain.tahir512@gmail.com</a></div>
      </div>
    </div>
    <div class="ci-item">
      <div class="ci-ico">🕐</div>
      <div>
        <div class="ci-label">Response time</div>
        <div class="ci-val">Typically within 2–3 business days</div>
      </div>
    </div>
    <div class="ci-item">
      <div class="ci-ico">💡</div>
      <div>
        <div class="ci-label">Feature ideas</div>
        <div class="ci-val">Always welcome — WorkLog is actively developed</div>
      </div>
    </div>
  </div>

</div>
