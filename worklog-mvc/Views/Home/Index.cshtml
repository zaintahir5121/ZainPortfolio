  <script type="application/ld+json">
  [
    {
      "@@context": "https://schema.org",
      "@@type": "WebSite",
      "url": "https://worklog.today",
      "name": "WorkLog",
      "description": "Free daily work journal and AI-powered time tracker for employees and freelancers.",
      "potentialAction": {
        "@@type": "SearchAction",
        "target": "https://worklog.today/Logs?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@@context": "https://schema.org",
      "@@type": "SoftwareApplication",
      "name": "WorkLog",
      "alternateName": "worklog.today",
      "description": "Free daily work journal and time tracker for employees and freelancers. Log work in seconds, AI structures it, timesheets export in one click.",
      "url": "https://worklog.today",
      "applicationCategory": "ProductivityApplication",
      "applicationSubCategory": "Time Tracking",
      "operatingSystem": "Web, iOS, Android, Windows, macOS",
      "browserRequirements": "Requires a modern web browser",
      "offers": { "@@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "featureList": ["AI daily log parsing", "Timesheet export", "Voice input", "Weekly progress charts", "Recurring entries", "Desktop PWA widget", "CSV export", "Privacy-first"],
      "screenshot": "https://worklog.today/og-image.png",
      "author": { "@@type": "Organization", "name": "WorkLog", "url": "https://worklog.today" }
    },
    {
      "@@context": "https://schema.org",
      "@@type": "FAQPage",
      "mainEntity": [
        {
          "@@type": "Question",
          "name": "Is WorkLog free?",
          "acceptedAnswer": { "@@type": "Answer", "text": "Yes — completely free. No credit card, no subscription, no usage limits. WorkLog is a free work log app built for people who believe their data should stay private." }
        },
        {
          "@@type": "Question",
          "name": "How is WorkLog different from other time trackers?",
          "acceptedAnswer": { "@@type": "Answer", "text": "Most time trackers require you to start and stop timers. WorkLog works the other way — you write what you did at the end of the day, and AI structures it for you automatically. It takes 60 seconds, not 60 interruptions." }
        },
        {
          "@@type": "Question",
          "name": "Is my work data private?",
          "acceptedAnswer": { "@@type": "Answer", "text": "Yes. Your journal lives in your own database. Nothing is sent to third-party analytics or advertising servers. The AI runs locally — your work entries are never shared." }
        },
        {
          "@@type": "Question",
          "name": "Can I export timesheets from WorkLog?",
          "acceptedAnswer": { "@@type": "Answer", "text": "Yes. WorkLog exports CSV timesheets for any date range — compatible with payroll software, invoicing tools, and HR systems. One click, instant download." }
        },
        {
          "@@type": "Question",
          "name": "Does WorkLog work on mobile and desktop?",
          "acceptedAnswer": { "@@type": "Answer", "text": "WorkLog works in any browser on any device. You can install it as a PWA on your phone's home screen or as a desktop widget on Windows — it behaves like a native app." }
        }
      ]
    }
  ]
  </script>

