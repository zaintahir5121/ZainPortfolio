@{
    Layout = null;
    ViewData["Title"] = "WorkLog";
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WorkLog — Your personal work journal</title>
  <meta name="description" content="WorkLog — simple, AI-powered work journal for developers and freelancers. Voice logging, daily summaries, timesheets, and personal growth tracking.">
  <meta name="robots" content="index, follow">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>

<div class="landing">

  <nav class="l-nav">
    <div class="l-logo">worklog<span>.</span></div>
    <a asp-controller="Account" asp-action="Login" class="l-signin">Sign in →</a>
  </nav>

  <div class="l-hero">
    <div class="l-eyebrow">For developers &amp; freelancers</div>

    <h1>Your personal<br><em>work journal.</em></h1>

    <p class="l-sub">
      The simplest way to track what you work on every day —
      voice input, AI summaries, timesheets, and a full growth tracker.
    </p>

    <a asp-controller="Account" asp-action="Login" class="l-cta">Start logging free</a>

    <div class="l-pills">
      <span class="pill">✦ AI-powered logging</span>
      <span class="pill">🎤 Voice input</span>
      <span class="pill">📊 Timesheets</span>
      <span class="pill">🏆 Growth tracking</span>
      <span class="pill">↺ Recurring entries</span>
    </div>
  </div>

  <!-- mini preview of card colours -->
  <div class="l-preview" aria-hidden="true">
    <div class="p-card p-c0">
      <div class="p-proj">Client Portal v2</div>
      <div class="p-desc">Implemented JWT auth refresh flow and token rotation</div>
      <div class="p-foot"><span class="p-hrs">3h</span><span class="p-tag">backend</span></div>
    </div>
    <div class="p-card p-c1">
      <div class="p-proj">Internal Dashboard</div>
      <div class="p-desc">Fixed responsive layout on reports page, dark mode toggle</div>
      <div class="p-foot"><span class="p-hrs">2h</span><span class="p-tag">frontend</span></div>
    </div>
    <div class="p-card p-c2">
      <div class="p-proj">API Gateway</div>
      <div class="p-desc">Added rate limiting middleware and logging pipeline</div>
      <div class="p-foot"><span class="p-hrs">4h</span><span class="p-tag">devops</span></div>
    </div>
  </div>

  <footer class="l-footer">
    <div class="lf-inner">
      <span>&copy; 2025 WorkLog &mdash; simple by design</span>
      <nav class="lf-links">
        <a asp-controller="Home" asp-action="About">About</a>
        <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        <a asp-controller="Home" asp-action="Terms">Terms</a>
        <a asp-controller="Home" asp-action="Contact">Contact</a>
      </nav>
    </div>
  </footer>
</div>

</body>
</html>
