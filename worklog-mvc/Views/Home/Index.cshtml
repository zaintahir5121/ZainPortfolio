@{
    Layout = null;
    ViewData["Title"] = "Keep. — Your personal notes, everywhere";
}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Keep. — Your personal notes, everywhere</title>
  <meta name="description" content="Keep. is a beautiful personal notes app. Create, pin, color-code and search your notes from anywhere.">
  <meta name="theme-color" content="#fbbc04">
  <link rel="manifest" href="/manifest.json">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;700&family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #fff; --surface: #f8f9fa; --text: #202124; --text2: #5f6368;
      --border: #e0e0e0; --accent: #fbbc04; --accent2: #6366f1;
    }
    [data-theme="dark"] {
      --bg: #202124; --surface: #2d2e30; --text: #e8eaed; --text2: #9aa0a6;
      --border: #3c4043;
    }
    body { font-family: 'Google Sans', 'Roboto', sans-serif; background: var(--bg); color: var(--text); line-height: 1.6; }

    /* Nav */
    .lp-nav {
      position: sticky; top: 0; z-index: 10;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 32px; height: 64px;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
    }
    .lp-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
    .lp-logo-text { font-size: 22px; font-weight: 700; color: var(--text); letter-spacing: -.5px; }
    .lp-logo-text em { color: var(--accent); font-style: normal; }
    .lp-nav-links { display: flex; align-items: center; gap: 8px; }
    .lp-nav-link { padding: 8px 16px; border-radius: 24px; font-size: 14px; font-weight: 500; text-decoration: none; color: var(--text2); transition: background .15s; }
    .lp-nav-link:hover { background: var(--surface); }
    .lp-nav-cta { background: var(--accent2); color: #fff !important; }
    .lp-nav-cta:hover { background: #4f46e5 !important; }

    /* Hero */
    .lp-hero {
      max-width: 1100px; margin: 0 auto; padding: 80px 32px 60px;
      display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center;
    }
    .lp-hero-badge {
      display: inline-flex; align-items: center; gap: 6px;
      background: rgba(99,102,241,.08); border: 1px solid rgba(99,102,241,.2);
      color: #6366f1; border-radius: 20px; padding: 5px 14px;
      font-size: 12.5px; font-weight: 600; margin-bottom: 20px; letter-spacing: .2px;
    }
    .lp-hero h1 {
      font-size: clamp(36px, 4.5vw, 58px); font-weight: 700; line-height: 1.15;
      letter-spacing: -.5px; margin-bottom: 20px;
    }
    .lp-hero h1 .hl { color: var(--accent2); }
    .lp-hero p { font-size: 17px; color: var(--text2); line-height: 1.7; margin-bottom: 32px; max-width: 480px; }
    .lp-cta-row { display: flex; gap: 12px; flex-wrap: wrap; }
    .lp-btn {
      padding: 13px 28px; border-radius: 28px; font-size: 15px; font-weight: 600;
      text-decoration: none; border: none; cursor: pointer; transition: all .2s;
    }
    .lp-btn-primary { background: var(--accent2); color: #fff; box-shadow: 0 4px 16px rgba(99,102,241,.35); }
    .lp-btn-primary:hover { background: #4f46e5; transform: translateY(-1px); }
    .lp-btn-secondary { background: var(--surface); color: var(--text); border: 1px solid var(--border); }
    .lp-btn-secondary:hover { background: var(--border); }

    /* Hero cards demo */
    .lp-hero-demo { position: relative; }
    .demo-board {
      background: var(--surface); border-radius: 16px; padding: 20px;
      box-shadow: 0 8px 40px rgba(0,0,0,.12); display: grid;
      grid-template-columns: 1fr 1fr; gap: 12px;
    }
    .demo-card {
      border-radius: 10px; padding: 14px; font-size: 13px;
      border: 1px solid rgba(0,0,0,.08); position: relative; overflow: hidden;
    }
    .demo-card-title { font-weight: 600; font-size: 14px; margin-bottom: 6px; }
    .demo-card-body { color: #5f6368; line-height: 1.6; }
    .dc-yellow { background: #fff8e1; }
    .dc-teal   { background: #e0f2f1; }
    .dc-blue   { background: #e3f2fd; }
    .dc-purple { background: #f3e5f5; }
    .dc-pin { position: absolute; top: 10px; right: 10px; font-size: 14px; }

    /* Features */
    .lp-features { background: var(--surface); padding: 80px 32px; }
    .lp-features-inner { max-width: 1100px; margin: 0 auto; }
    .lp-section-label { text-align: center; color: var(--accent2); font-size: 13px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 12px; }
    .lp-section-title { text-align: center; font-size: clamp(26px, 3.5vw, 38px); font-weight: 700; letter-spacing: -.3px; margin-bottom: 8px; }
    .lp-section-sub { text-align: center; color: var(--text2); font-size: 16px; margin-bottom: 48px; }
    .lp-feat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
    .lp-feat-card {
      background: var(--bg); border-radius: 16px; padding: 28px;
      border: 1px solid var(--border); transition: box-shadow .2s, transform .2s;
    }
    .lp-feat-card:hover { box-shadow: 0 8px 32px rgba(0,0,0,.08); transform: translateY(-2px); }
    .lp-feat-ico { width: 48px; height: 48px; border-radius: 12px; margin-bottom: 16px; display: flex; align-items: center; justify-content: center; font-size: 22px; }
    .lp-feat-ico-ai    { background: linear-gradient(135deg, rgba(99,102,241,.12), rgba(168,85,247,.12)); }
    .lp-feat-ico-color { background: rgba(251,188,4,.1); }
    .lp-feat-ico-pin   { background: rgba(66,133,244,.1); }
    .lp-feat-ico-search { background: rgba(52,168,83,.1); }
    .lp-feat-ico-dark  { background: rgba(32,33,36,.08); }
    .lp-feat-ico-pwa   { background: rgba(234,67,53,.1); }
    .lp-feat-title { font-size: 16px; font-weight: 700; margin-bottom: 8px; }
    .lp-feat-desc  { font-size: 14px; color: var(--text2); line-height: 1.65; }

    /* CTA strip */
    .lp-cta-strip {
      text-align: center; padding: 80px 32px;
      background: linear-gradient(135deg, rgba(99,102,241,.05), rgba(168,85,247,.05));
    }
    .lp-cta-strip h2 { font-size: clamp(24px, 3vw, 36px); font-weight: 700; margin-bottom: 12px; }
    .lp-cta-strip p { color: var(--text2); font-size: 16px; margin-bottom: 28px; }

    /* Footer */
    .lp-footer {
      border-top: 1px solid var(--border); padding: 24px 32px;
      display: flex; align-items: center; justify-content: space-between;
      font-size: 13px; color: var(--text2);
    }
    .lp-footer a { color: var(--text2); text-decoration: none; }
    .lp-footer a:hover { color: var(--text); }

    @@media (max-width: 900px) {
      .lp-hero { grid-template-columns: 1fr; text-align: center; padding: 50px 24px 40px; }
      .lp-hero p { margin: 0 auto 28px; }
      .lp-cta-row { justify-content: center; }
      .lp-hero-demo { display: none; }
      .lp-feat-grid { grid-template-columns: 1fr 1fr; }
    }
    @@media (max-width: 600px) {
      .lp-feat-grid { grid-template-columns: 1fr; }
      .lp-nav { padding: 0 16px; }
      .lp-footer { flex-direction: column; gap: 8px; text-align: center; }
    }
  </style>
</head>
<body>

<nav class="lp-nav">
  <a href="/" class="lp-logo">
    <svg width="28" height="28" viewBox="0 0 500 500">
      <rect width="500" height="500" rx="100" fill="#fbbc04"/>
      <path d="M310 90H190c-25 0-45 20-45 45v235l105-76 105 76V135c0-25-20-45-45-45z" fill="#fff"/>
    </svg>
    <span class="lp-logo-text">Keep<em>.</em></span>
  </a>
  <div class="lp-nav-links">
    <a asp-controller="Account" asp-action="Login" class="lp-nav-link">Sign in</a>
    <a asp-controller="Account" asp-action="Register" class="lp-nav-link lp-nav-cta">Get started free →</a>
  </div>
</nav>

<section>
  <div class="lp-hero">
    <div>
      <div class="lp-hero-badge">✨ Now with AI Assistant</div>
      <h1>Notes that think<br>as fast as <span class="hl">you do.</span></h1>
      <p>Keep. is a Google Keep-style personal notes app with an AI assistant. Create, pin, color-code, and search your notes — with smart AI help to write, summarise, and organise.</p>
      <div class="lp-cta-row">
        <a asp-controller="Account" asp-action="Register" class="lp-btn lp-btn-primary">Start for free →</a>
        <a asp-controller="Account" asp-action="Login" class="lp-btn lp-btn-secondary">Sign in</a>
      </div>
    </div>
    <div class="lp-hero-demo">
      <div class="demo-board">
        <div class="demo-card dc-yellow">
          <span class="dc-pin">📌</span>
          <div class="demo-card-title">AI Integration ✨</div>
          <div class="demo-card-body">Ollama chat, daily digest, note polish feature...</div>
        </div>
        <div class="demo-card dc-teal">
          <div class="demo-card-title">Shopping</div>
          <div class="demo-card-body">Milk · Eggs · Coffee<br>Bread · Yogurt</div>
        </div>
        <div class="demo-card dc-blue">
          <div class="demo-card-title">Meeting Notes</div>
          <div class="demo-card-body">Q3 roadmap: performance, UX improvements, AI features.</div>
        </div>
        <div class="demo-card dc-purple">
          <div class="demo-card-title">Books 📚</div>
          <div class="demo-card-body">Pragmatic Programmer · Clean Code · DDIA</div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="lp-features">
  <div class="lp-features-inner">
    <div class="lp-section-label">Features</div>
    <h2 class="lp-section-title">Everything you need to stay organised</h2>
    <p class="lp-section-sub">Beautiful, fast, and smart — built for the way you think.</p>
    <div class="lp-feat-grid">
      <div class="lp-feat-card">
        <div class="lp-feat-ico lp-feat-ico-ai">✨</div>
        <div class="lp-feat-title">AI Assistant</div>
        <div class="lp-feat-desc">Chat with an AI that knows your notes. Ask questions, get a daily digest, or polish any note with one click.</div>
      </div>
      <div class="lp-feat-card">
        <div class="lp-feat-ico lp-feat-ico-color">🎨</div>
        <div class="lp-feat-title">12 Colour Labels</div>
        <div class="lp-feat-desc">Colour-code your notes with 12 beautiful palette options. Visually organise without a complicated tagging system.</div>
      </div>
      <div class="lp-feat-card">
        <div class="lp-feat-ico lp-feat-ico-pin">📌</div>
        <div class="lp-feat-title">Pin &amp; Archive</div>
        <div class="lp-feat-desc">Pin important notes to the top. Archive the rest. Move to Trash with undo for anything accidentally deleted.</div>
      </div>
      <div class="lp-feat-card">
        <div class="lp-feat-ico lp-feat-ico-search">🔍</div>
        <div class="lp-feat-title">Instant Search</div>
        <div class="lp-feat-desc">Client-side search filters your notes in real time as you type — no loading, no waiting.</div>
      </div>
      <div class="lp-feat-card">
        <div class="lp-feat-ico lp-feat-ico-dark">🌙</div>
        <div class="lp-feat-title">Dark Mode</div>
        <div class="lp-feat-desc">Beautiful light and dark themes with full keyboard shortcut support and your preference remembered across sessions.</div>
      </div>
      <div class="lp-feat-card">
        <div class="lp-feat-ico lp-feat-ico-pwa">📱</div>
        <div class="lp-feat-title">Works Everywhere</div>
        <div class="lp-feat-desc">Install as a PWA on mobile or desktop. Full masonry grid layout adapts beautifully from phone to ultrawide.</div>
      </div>
    </div>
  </div>
</section>

<div class="lp-cta-strip">
  <h2>Ready to start capturing your ideas?</h2>
  <p>Free forever. No credit card. Your notes stay private.</p>
  <a asp-controller="Account" asp-action="Register" class="lp-btn lp-btn-primary">Create a free account →</a>
</div>

<footer class="lp-footer">
  <span>© 2026 Keep. · Made with ❤️ by <a href="https://buymeacoffee.com/zaintahir512" target="_blank">Zain Tahir</a></span>
  <div style="display:flex;gap:16px">
    <a asp-controller="Account" asp-action="Login">Sign in</a>
    <a asp-controller="Account" asp-action="Register">Register</a>
    <a href="https://buymeacoffee.com/zaintahir512" target="_blank">☕ Buy me a coffee</a>
  </div>
</footer>

<script>
(function(){
  const t = localStorage.getItem('gk_theme') || 'light';
  document.documentElement.dataset.theme = t;
})();
</script>
</body>
</html>
