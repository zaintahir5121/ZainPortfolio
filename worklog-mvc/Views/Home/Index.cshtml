@{
    Layout = null;
    ViewData["Title"] = "WorkLog — Know exactly where your day went";
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Primary SEO — targeting low-competition keywords -->
  <title>WorkLog — Free Daily Work Journal &amp; Employee Time Tracker</title>
  <meta name="description" content="The simplest free work log app for employees and freelancers. Type what you did, AI structures it. Export timesheets in one click. No credit card, no subscription — your data stays private.">
  <meta name="keywords" content="free work log app, daily work journal, employee time tracker free, simple timesheet app, work hours tracker, daily standup tracker, work activity log, time tracking software free, work log software, free employee time log">
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large">
  <meta name="author" content="WorkLog">
  <link rel="canonical" href="https://worklog.app/">

  <!-- Open Graph (LinkedIn, Facebook preview) -->
  <meta property="og:type"         content="website">
  <meta property="og:url"          content="https://worklog.app/">
  <meta property="og:title"        content="WorkLog — Free Daily Work Journal &amp; Time Tracker">
  <meta property="og:description"  content="Log your day in seconds. AI parses it automatically. Export timesheets, track your streak, see your week at a glance. Free, private, no subscription.">
  <meta property="og:image"        content="https://worklog.app/og-image.png">
  <meta property="og:image:width"  content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:site_name"    content="WorkLog">
  <meta property="og:locale"       content="en_US">

  <!-- Twitter / X Card -->
  <meta name="twitter:card"        content="summary_large_image">
  <meta name="twitter:title"       content="WorkLog — Free Daily Work Journal">
  <meta name="twitter:description" content="Log your work in seconds. AI parses it. Timesheets in one click. Free, private, no subscription.">
  <meta name="twitter:image"       content="https://worklog.app/og-image.png">

  <!-- PWA / Mobile install -->
  <meta name="theme-color" content="#6366f1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="WorkLog">
  <link rel="manifest" href="/manifest.json">

  <!-- Structured data: SoftwareApplication -->
  <script type="application/ld+json">
  {
    "@@context": "https://schema.org",
    "@@type": "SoftwareApplication",
    "name": "WorkLog",
    "description": "Free daily work journal and time tracker for employees and freelancers.",
    "url": "https://worklog.app",
    "applicationCategory": "ProductivityApplication",
    "operatingSystem": "Web",
    "offers": { "@@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "featureList": ["AI daily log parsing", "Timesheet export", "Voice input", "Weekly progress", "Recurring entries", "Privacy-first"]
  }
  </script>

  <!-- FAQ schema — boosts Google rich results -->
  <script type="application/ld+json">
  {
    "@@context": "https://schema.org",
    "@@type": "FAQPage",
    "mainEntity": [
      { "@@type":"Question","name":"Is WorkLog free?","acceptedAnswer":{"@@type":"Answer","text":"Yes — completely free. No credit card, no subscription, no limits."}},
      { "@@type":"Question","name":"Is my work data private?","acceptedAnswer":{"@@type":"Answer","text":"Yes. Your journal lives in your own database. Nothing is sent to third-party servers."}},
      { "@@type":"Question","name":"How do I export a timesheet?","acceptedAnswer":{"@@type":"Answer","text":"One click. WorkLog generates CSV timesheets for payroll, invoicing, or sharing with your manager."}},
      { "@@type":"Question","name":"Does it work on mobile?","acceptedAnswer":{"@@type":"Answer","text":"Yes. WorkLog works in any browser and can be installed on your home screen like a native app."}}
    ]
  }
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body class="landing-body">

<div class="landing">

  <!-- ── Nav ──────────────────────────────────────────────────────────── -->
  <nav class="l-nav">
    <div class="l-logo">worklog<span>.</span></div>
    <div class="l-nav-links">
      <a href="#features" class="l-nav-link">Features</a>
      <a asp-controller="Home" asp-action="About" class="l-nav-link">About</a>
    </div>
    <a asp-controller="Account" asp-action="Login" class="l-signin">Sign in →</a>
  </nav>

  <!-- ── Hero ──────────────────────────────────────────────────────────── -->
  <div class="l-hero">
    <div class="l-badge">✦ Free &amp; private</div>

    <h1 class="l-h1">
      Know exactly where<br>
      <em>your day went.</em>
    </h1>

    <p class="l-sub">
      WorkLog is the simplest work journal you'll ever use.
      Tell it what you did — it handles the rest.
    </p>

    <div class="l-cta-row">
      <a asp-controller="Account" asp-action="Login" class="l-cta-btn">
        Start your journal free →
      </a>
      <a href="#features" class="l-cta-ghost">See how it works ↓</a>
    </div>

    <div class="l-social">
      <span class="l-social-item">✓ No credit card</span>
      <span class="l-social-sep">·</span>
      <span class="l-social-item">✓ No subscriptions</span>
      <span class="l-social-sep">·</span>
      <span class="l-social-item">✓ Your data stays yours</span>
    </div>
  </div>

  <!-- ── App preview ───────────────────────────────────────────────────── -->
  <div class="l-preview-wrap" aria-hidden="true">
    <div class="l-preview-frame">
      <div class="lpf-bar">
        <span class="lpf-dot lpf-r"></span>
        <span class="lpf-dot lpf-y"></span>
        <span class="lpf-dot lpf-g"></span>
        <span class="lpf-url">worklog · today</span>
      </div>
      <div class="lpf-body">
        <div class="lpf-input">
          <span class="lpf-text">Fixed payment API bugs for 2h, attended sprint planning for 1h…</span>
          <span class="lpf-cursor"></span>
        </div>
        <div class="lpf-entries">
          <div class="lpf-entry">
            <span class="lpf-dot-e" style="background:#3b82f6"></span>
            <span class="lpf-edesc">Fixed payment API bugs</span>
            <span class="lpf-ebadge" style="background:#dbeafe;color:#1d4ed8">Development</span>
            <span class="lpf-etime">2h</span>
          </div>
          <div class="lpf-entry">
            <span class="lpf-dot-e" style="background:#f59e0b"></span>
            <span class="lpf-edesc">Sprint planning meeting</span>
            <span class="lpf-ebadge" style="background:#fef3c7;color:#b45309">Meeting</span>
            <span class="lpf-etime">1h</span>
          </div>
          <div class="lpf-entry">
            <span class="lpf-dot-e" style="background:#10b981"></span>
            <span class="lpf-edesc">Reviewed pull requests</span>
            <span class="lpf-ebadge" style="background:#d1fae5;color:#065f46">Code Review</span>
            <span class="lpf-etime">30m</span>
          </div>
        </div>
        <div class="lpf-footer">
          Total: <strong>3h 30m</strong>
          <button class="lpf-btn">Send Work Log →</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Features ──────────────────────────────────────────────────────── -->
  <div class="l-features" id="features">
    <div class="l-features-label">Everything you need</div>
    <h2 class="l-features-h2">Simple to use. Powerful to have.</h2>

    <div class="l-feat-grid">
      <div class="l-feat-card">
        <div class="l-feat-ico">⚡</div>
        <div class="l-feat-title">Log in seconds</div>
        <p class="l-feat-desc">
          Just type what you did in plain language.
          AI reads it and organises everything — projects, hours, categories — automatically.
        </p>
      </div>
      <div class="l-feat-card">
        <div class="l-feat-ico">🎤</div>
        <div class="l-feat-title">Speak your day</div>
        <p class="l-feat-desc">
          Prefer talking? Hit the mic and narrate your day out loud.
          WorkLog transcribes and parses your words instantly.
        </p>
      </div>
      <div class="l-feat-card">
        <div class="l-feat-ico">📊</div>
        <div class="l-feat-title">Instant timesheets</div>
        <p class="l-feat-desc">
          See this week's hours at a glance. Export timesheets in one click
          — for invoicing, payroll, or just your own records.
        </p>
      </div>
      <div class="l-feat-card">
        <div class="l-feat-ico">🌱</div>
        <div class="l-feat-title">Track your growth</div>
        <p class="l-feat-desc">
          Log achievements, career milestones, and what you're learning.
          Build a complete record of your professional journey.
        </p>
      </div>
      <div class="l-feat-card">
        <div class="l-feat-ico">↺</div>
        <div class="l-feat-title">Recurring entries</div>
        <p class="l-feat-desc">
          Set up daily standup, code review, or any routine task once.
          WorkLog auto-logs it every morning so you never miss it.
        </p>
      </div>
      <div class="l-feat-card">
        <div class="l-feat-ico">🔒</div>
        <div class="l-feat-title">Completely private</div>
        <p class="l-feat-desc">
          Your journal lives in your own database. Nothing is sent
          to third-party servers. Your data is yours — always.
        </p>
      </div>
    </div>
  </div>

  <!-- ── CTA banner ────────────────────────────────────────────────────── -->
  <div class="l-cta-banner">
    <h2 class="l-cta-banner-h">Ready to know where your time goes?</h2>
    <p class="l-cta-banner-sub">Takes 30 seconds to set up. No credit card, no subscription.</p>
    <a asp-controller="Account" asp-action="Login" class="l-cta-btn l-cta-light">
      Start your work journal →
    </a>
  </div>

  <!-- ── Footer ────────────────────────────────────────────────────────── -->
  <footer class="l-footer">
    <div class="lf-inner">
      <div class="lf-brand">worklog<span>.</span> <span class="lf-tagline">simple by design</span></div>
      <nav class="lf-links">
        <a asp-controller="Home" asp-action="About">About</a>
        <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        <a asp-controller="Home" asp-action="Terms">Terms</a>
        <a asp-controller="Home" asp-action="Contact">Contact</a>
      </nav>
      <div class="lf-right">
        <a href="https://buymeacoffee.com/worklog" target="_blank" rel="noopener" class="lf-bmc">☕ Buy me a coffee</a>
        <span class="lf-copy">&copy; 2025 WorkLog</span>
      </div>
    </div>
  </footer>

</div>

<!-- Floating Buy Me a Coffee -->
<a href="https://buymeacoffee.com/worklog" target="_blank" rel="noopener" class="bmc-float" title="Support WorkLog">☕</a>

<script>
  // Smooth scroll for anchor links
  document.querySelectorAll('a[href^="#"]').forEach(a => {
    a.addEventListener('click', e => {
      const t = document.querySelector(a.getAttribute('href'));
      if (t) { e.preventDefault(); t.scrollIntoView({ behavior: 'smooth' }); }
    });
  });
</script>
</body>
</html>
