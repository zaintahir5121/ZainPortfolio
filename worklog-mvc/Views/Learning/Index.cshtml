@model List<WorkLogApp.Models.LearningItem>
@{
    ViewData["Title"] = "Learning";
    string curStatus  = ViewBag.Status    ?? "all";
    int inProgress    = ViewBag.InProgress ?? 0;
    int completed     = ViewBag.Completed  ?? 0;
    int wantCount     = ViewBag.WantCount  ?? 0;
}

<div class="pg-head">
  <div>
    <h1>Learning</h1>
    <p class="pg-date">Courses, books, articles — every thing you're levelling up on.</p>
  </div>
  <a asp-controller="Growth" asp-action="Index" class="pg-back">← Growth Hub</a>
</div>

<!-- Add form -->
<div class="add-card" id="addCard">
  <button class="add-toggle" id="addToggle" onclick="toggleAddForm()">+ Add item</button>
  <form class="add-form hidden" id="addForm" method="post" asp-controller="Learning" asp-action="Add">
    @Html.AntiForgeryToken()
    <div class="af-grid">
      <div class="rfield af-full">
        <label>Title *</label>
        <input name="title" placeholder="Clean Code, AWS Solutions Architect, React Tutorial..." required>
      </div>
      <div class="rfield">
        <label>Type</label>
        <select name="type">
          <option value="course">🎓 Course</option>
          <option value="book">📖 Book</option>
          <option value="article">📄 Article</option>
          <option value="video">🎬 Video</option>
          <option value="podcast">🎙️ Podcast</option>
          <option value="tutorial">💻 Tutorial</option>
          <option value="other">💡 Other</option>
        </select>
      </div>
      <div class="rfield">
        <label>Source / Platform</label>
        <input name="source" placeholder="Udemy, YouTube, O'Reilly, Coursera...">
      </div>
      <div class="rfield">
        <label>Status</label>
        <select name="status">
          <option value="in-progress">▶ In progress</option>
          <option value="want">📌 Want to learn</option>
          <option value="completed">✅ Completed</option>
        </select>
      </div>
      <div class="rfield">
        <label>Started</label>
        <input type="date" name="startedDate">
      </div>
      <div class="rfield">
        <label>Rating (0–5)</label>
        <input type="number" name="rating" min="0" max="5" value="0" style="width:70px">
      </div>
      <div class="rfield af-full">
        <label>Notes</label>
        <textarea name="notes" placeholder="Key takeaways, what you learned, would you recommend it?"></textarea>
      </div>
    </div>
    <div class="af-actions">
      <button type="submit" class="btn-primary">Save</button>
      <button type="button" class="btn-ghost" onclick="toggleAddForm()">Cancel</button>
    </div>
  </form>
</div>

<!-- Status filter + stats -->
<div class="learn-bar">
  <div class="cat-filter">
    <a asp-controller="Learning" asp-action="Index" class="cat-tab @(curStatus=="all"?"cat-on":"")">All</a>
    <a asp-controller="Learning" asp-action="Index" asp-route-status="in-progress" class="cat-tab @(curStatus=="in-progress"?"cat-on":"")">▶ In progress <span class="cat-count">@inProgress</span></a>
    <a asp-controller="Learning" asp-action="Index" asp-route-status="want" class="cat-tab @(curStatus=="want"?"cat-on":"")">📌 Want to learn <span class="cat-count">@wantCount</span></a>
    <a asp-controller="Learning" asp-action="Index" asp-route-status="completed" class="cat-tab @(curStatus=="completed"?"cat-on":"")">✅ Completed <span class="cat-count">@completed</span></a>
  </div>
</div>

@if (Model.Count == 0)
{
  <div class="empty">
    <div class="empty-ico">📚</div>
    <h3>Nothing tracked yet</h3>
    <p>Add courses, books, articles — anything you're learning or planning to learn.</p>
  </div>
}
else
{
  <div class="learn-grid">
    @foreach (var l in Model)
    {
      <div class="learn-card lc-@l.Status">
        <div class="lc-top">
          <span class="lc-type-ico">@l.TypeEmoji</span>
          <span class="lc-status-badge ls-@l.Status">@l.StatusLabel</span>
          <form method="post" asp-controller="Learning" asp-action="Delete" style="margin-left:auto">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@l.Id">
            <button class="ac-del" onclick="return confirm('Remove this item?')">✕</button>
          </form>
        </div>
        <div class="lc-title">@l.Title</div>
        @if (!string.IsNullOrWhiteSpace(l.Source))
        {
          <div class="lc-source">@l.Source</div>
        }
        @if (!string.IsNullOrWhiteSpace(l.Notes))
        {
          <div class="lc-notes">@l.Notes</div>
        }
        @if (l.Rating > 0)
        {
          <div class="lc-stars">@string.Concat(Enumerable.Repeat("★", l.Rating))@string.Concat(Enumerable.Repeat("☆", 5 - l.Rating))</div>
        }
        <div class="lc-footer">
          @if (l.CompletedDate.HasValue)
          {
            <span class="lc-date">Completed @l.CompletedDate.Value.ToString("MMM yyyy")</span>
          }
          else if (l.StartedDate.HasValue)
          {
            <span class="lc-date">Started @l.StartedDate.Value.ToString("MMM yyyy")</span>
          }
          @if (l.Status != "completed")
          {
            <form method="post" asp-controller="Learning" asp-action="UpdateStatus" style="margin-left:auto">
              @Html.AntiForgeryToken()
              <input type="hidden" name="id" value="@l.Id">
              <input type="hidden" name="status" value="completed">
              <button class="lc-done-btn" title="Mark complete">✓ Done</button>
            </form>
          }
        </div>
      </div>
    }
  </div>
}

@section Scripts {
<script>
function toggleAddForm() {
  const form = document.getElementById("addForm");
  const btn  = document.getElementById("addToggle");
  const isHidden = form.classList.contains("hidden");
  form.classList.toggle("hidden", !isHidden);
  btn.textContent = isHidden ? "✕ Cancel" : "+ Add item";
}
</script>
}
