// ── Voice input ───────────────────────────────────────────────────────────
const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
let recognition = null, recogActive = false;

function wbToggleVoice() {
  if (!SR) {
    showToast('Voice input needs Chrome, Edge, or Safari.');
    return;
  }
  if (location.protocol !== 'https:' && location.hostname !== 'localhost' && location.hostname !== '127.0.0.1') {
    showToast('Voice input requires a secure (HTTPS) connection.');
    return;
  }
  recogActive ? stopVoice() : startVoice();
}
function startVoice() {
  try {
    recognition = new SR();
    recognition.continuous      = false;
    recognition.interimResults  = true;
    recognition.lang            = 'en-US';
    recognition.maxAlternatives = 1;
    recognition.onstart  = () => { recogActive = true; micBtn.classList.add('wbmic-on'); setStatus('🎤 Listening… speak now'); };
    recognition.onend    = () => stopVoice();
    recognition.onerror  = (e) => {
      stopVoice();
      if (e.error === 'not-allowed' || e.error === 'permission-denied') {
        showToast('🎤 Microphone permission denied — allow it in your browser settings.');
      } else if (e.error === 'no-speech') {
        showToast('No speech detected — try again.');
      } else if (e.error !== 'aborted') {
        showToast('Voice input error: ' + e.error);
      }
    };
    recognition.onresult = (e) => {
      const t = Array.from(e.results).map(r => r[0].transcript).join('');
      inp.value = t; wbAutosize(inp);
      if (e.results[e.results.length - 1].isFinal) { stopVoice(); inp.focus(); }
    };
    recognition.start();
  } catch(err) {
    stopVoice();
    showToast('Could not start voice input: ' + err.message);
  }
}
function stopVoice() {
  if (recogActive) setStatus('');
  recogActive = false; micBtn.classList.remove('wbmic-on');
  try { recognition?.stop(); } catch {}
}

