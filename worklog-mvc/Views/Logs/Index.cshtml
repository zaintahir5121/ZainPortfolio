// ── Conversation history ──────────────────────────────────────────────────
function handleHistory() {
  const h = histLoad();
  if (!h.length) {
    appendBot("No conversation history yet. Everything you say here is saved automatically. Type 'clear history' to reset it.");
    return;
  }
  const t = inp.value.toLowerCase();
  if (/clear/.test(t)) {
    histClear();
    appendBot("✓ Conversation history cleared.");
    return;
  }
  // Show recent messages grouped by day
  const byDay = {};
  h.slice(-60).forEach(m => {
    const day = new Date(m.ts).toLocaleDateString('en-US', { weekday:'short', month:'short', day:'numeric' });
    if (!byDay[day]) byDay[day] = [];
    byDay[day].push(m);
  });
  const days = Object.entries(byDay).slice(-7); // last 7 days
  let html = `<strong>📖 Your conversation history (last ${h.length} messages)</strong>`;
  days.forEach(([day, msgs]) => {
    html += `<div style="margin-top:10px;font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.5px">${day}</div>`;
    msgs.forEach(m => {
      const isUser = m.role === 'user';
      html += `<div style="margin-top:4px;font-size:12.5px;padding:4px 8px;border-radius:6px;background:${isUser?'var(--accent-bg)':'var(--bg)'};color:${isUser?'var(--accent)':'var(--text-2)'}">
        <span style="font-weight:600;margin-right:6px">${isUser?'You':'Bot'}:</span>${escHtml(m.text.slice(0,140))}${m.text.length>140?'…':''}
      </div>`;
    });
  });
  html += `<div style="margin-top:10px;display:flex;gap:8px">
    <button onclick="wbExportHistory()" style="font-size:12px;color:var(--accent);background:none;border:1px solid var(--accent);border-radius:6px;padding:3px 10px;cursor:pointer;font-family:var(--font)">📥 Export</button>
    <button onclick="histClear();appendBot('✓ History cleared.')" style="font-size:12px;color:var(--muted);background:none;border:1px solid var(--line);border-radius:6px;padding:3px 10px;cursor:pointer;font-family:var(--font)">🗑 Clear</button>
  </div>`;
  appendBot(html);
}

function wbExportHistory() {
  const h = histLoad();
  const lines = h.map(m => {
    const d = new Date(m.ts).toLocaleString();
    return `[${d}] ${m.role === 'user' ? 'You' : 'WorkLog Bot'}: ${m.text}`;
  });
  const blob = new Blob([lines.join('\n')], { type: 'text/plain' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `worklog-chat-history-${toIso(new Date())}.txt`;
  a.click(); URL.revokeObjectURL(a.href);
  showToast('✓ History exported');
}

