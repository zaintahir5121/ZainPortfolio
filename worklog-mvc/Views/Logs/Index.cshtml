@model WorkLogApp.Models.ViewModels.DashboardViewModel
@section Styles {
<style>
  body{overflow:hidden!important}
  .main-wrap{max-width:none!important;margin:0!important;padding:0!important;height:calc(100dvh - 54px);height:calc(100vh - 54px);overflow:hidden!important}
  .app-footer{display:none!important}
</style>
}
@{
    var todayLogs = Model.Logs.Where(l => l.Date == DateOnly.FromDateTime(DateTime.Today)).ToList();
    var maxDayH   = Model.WeekDays.Count > 0 ? Model.WeekDays.Max(d => d.Hours) : 1m;
    if (maxDayH == 0) maxDayH = 1m;
    var dowShare  = (int)DateTime.Today.DayOfWeek;
    var monShare  = DateTime.Today.AddDays(dowShare == 0 ? -6 : -(dowShare - 1));
    var sunShare  = monShare.AddDays(6);
    var weekLabel = $"{monShare:MMM d} – {sunShare:MMM d, yyyy}";
    var weekShort = $"{monShare:MMM d} – {sunShare:MMM d}";
    // SVG ring offset for sidebar (r=27 → circumference=169.65)
    var ringOffset = (169.65m * (1 - Math.Min(1m, Model.WeekPctInt / 100m))).ToString("F1");
}

<div class="wb-app">

  <!-- ════ SIDEBAR ════════════════════════════════════════════════════════ -->
  <aside class="wb-sidebar" id="wbSidebar">

    <!-- Bot identity -->
    <div class="wb-sb-bot">
      <div class="wb-sb-av">✦</div>
      <div>
        <div class="wb-sb-name">WorkLog Bot</div>
        <div class="wb-sb-status"><span class="wb-online"></span>online · auto-logs everything</div>
      </div>
    </div>

    <!-- Quick stats -->
    <div class="wb-sc">
      <div class="wb-sc-title">Today</div>
      <div class="wb-qs-grid">
        <div class="wb-qs-item">
          <span class="wb-qs-num">@Model.TodayHours h</span>
          <span class="wb-qs-lbl">logged</span>
        </div>
        <div class="wb-qs-item">
          <span class="wb-qs-num">@Model.Streak @(Model.Streak >= 3 ? "🔥" : "📅")</span>
          <span class="wb-qs-lbl">day streak</span>
        </div>
        <div class="wb-qs-item">
          <span class="wb-qs-num">@Model.ProjectsCount</span>
          <span class="wb-qs-lbl">projects</span>
        </div>
        <div class="wb-qs-item">
          <span class="wb-qs-num">@Model.WeekPctInt%</span>
          <span class="wb-qs-lbl">of goal</span>
        </div>
      </div>
    </div>

    <!-- Week progress -->
    <div class="wb-sc">
      <div class="wb-sc-title">This Week</div>
      <div style="display:flex;align-items:center;gap:14px">
        <div class="wb-week-ring">
          <svg width="68" height="68" viewBox="0 0 68 68">
            <circle cx="34" cy="34" r="27" fill="none" stroke="var(--line)" stroke-width="5"/>
            <circle cx="34" cy="34" r="27" fill="none"
                    stroke="@(Model.WeekPctInt >= 100 ? "#10b981" : "#6366f1")"
                    stroke-width="5" stroke-linecap="round"
                    stroke-dasharray="169.65"
                    stroke-dashoffset="@ringOffset"
                    transform="rotate(-90 34 34)"/>
          </svg>
          <div class="wb-ring-inner">
            <span class="wb-ring-pct">@Model.WeekPctInt%</span>
          </div>
        </div>
        <div>
          <div style="font-size:17px;font-weight:800;color:var(--text)">@Model.WeekTotalFormatted</div>
          <div style="font-size:11.5px;color:var(--muted);margin-top:2px">/ @((int)Model.WeekGoal)h goal</div>
          <div style="font-size:11px;color:var(--muted);margin-top:4px;line-height:1.4">@Model.ProgressMessage</div>
        </div>
      </div>
    </div>

    <!-- Today's log (editable) -->
    @if (todayLogs.Any())
    {
      <div class="wb-sc">
        <div class="wb-sc-title">
          <span>Today's Log</span>
          <span style="font-size:11px;font-weight:700;color:var(--accent);background:var(--accent-bg);padding:1px 8px;border-radius:99px">@todayLogs.Sum(l => l.Hours) h</span>
        </div>
        <div class="wb-today-list">
          @foreach (var log in todayLogs)
          {
            <div class="wb-tl-item" id="wbtl-@log.Id">
              <div class="wb-tl-view">
                <span class="wb-tl-dot" style="background:@CategoryColor(log.Tags)"></span>
                <span class="wb-tl-desc" title="@log.Description">@log.Description</span>
                <span class="wb-tl-hrs">@log.Hours h</span>
                <button class="wb-tl-edit" onclick="wbStartEdit(@log.Id)" title="Edit">✏</button>
                <form asp-action="Delete" method="post" class="wb-tl-del-form">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="id" value="@log.Id">
                  <button type="submit" class="wb-tl-del" title="Delete">×</button>
                </form>
              </div>
              <div class="wb-tl-editf hidden" id="wbedit-@log.Id">
                <input type="text" class="wb-tl-inp wb-tl-idesc" value="@log.Description" placeholder="Description">
                <div class="wb-tl-editrow">
                  <input type="number" class="wb-tl-inp wb-tl-ihrs" value="@log.Hours" step="0.25" min="0.25" max="24">
                  <select class="wb-tl-inp wb-tl-icat">
                    @foreach (var cat in new[]{"Development","Meeting","Code Review","Testing","Documentation","DevOps","Research","Design","Other"})
                    {
                      <option value="@cat" selected="@(log.Tags == cat ? "selected" : null)">@cat</option>
                    }
                  </select>
                </div>
                <div class="wb-tl-editbtns">
                  <button type="button" class="wb-tl-save" onclick="wbSaveEdit(@log.Id)">Save</button>
                  <button type="button" class="wb-tl-cancel" onclick="wbCancelEdit(@log.Id)">Cancel</button>
                </div>
              </div>
            </div>
          }
        </div>
      </div>
    }

    <!-- Quick actions -->
    <div class="wb-sc">
      <div class="wb-sc-title">Quick Actions</div>
      <div class="wb-qa-list">
        <button class="wb-qa-btn" onclick="openShareModal()">
          <span>✨</span> Share this week
        </button>
        <a href="/Recurring" class="wb-qa-btn">
          <span>↺</span> Recurring tasks
        </a>
        <a href="/Timesheet" class="wb-qa-btn">
          <span>📅</span> View timesheet
        </a>
        <button class="wb-qa-btn" onclick="wbToggleTeams()">
          <span>⚡</span> Teams integration
        </button>
      </div>
    </div>

    <!-- AI insight -->
    <div class="wb-sc">
      <div class="wb-sc-title">✦ Weekly Insight</div>
      <p class="wb-insight-text" id="wbInsightText">Loading…</p>
    </div>

    <!-- Teams card (toggle) -->
    <div class="wb-sc" id="wbTeamsCard" style="display:none">
      <div class="wb-sc-title">
        <span>🔗 Teams Integration</span>
        <button onclick="wbToggleTeams()" style="background:none;border:none;cursor:pointer;font-size:13px;color:var(--muted);line-height:1">✕</button>
      </div>
      <p style="font-size:11.5px;color:var(--muted);line-height:1.5;margin-bottom:8px">Log from Microsoft Teams via Power Automate. Your API key:</p>
      <div id="wbApiKeyWrap" style="font-size:11px;color:var(--muted)">Loading…</div>
      <button onclick="wbRegenerateKey()" style="margin-top:8px;font-size:11px;color:var(--muted);background:none;border:1px solid var(--line);border-radius:6px;padding:4px 10px;cursor:pointer;font-family:var(--font)">↻ Regenerate key</button>
      <details style="margin-top:10px">
        <summary style="font-size:11.5px;color:var(--accent);cursor:pointer;font-weight:500">How to connect Teams →</summary>
        <p style="font-size:10.5px;color:var(--muted);margin-top:6px;line-height:1.65">
          Teams → Workflows → New → "When a message is posted" → HTTP POST to:<br>
          <code style="background:var(--bg);padding:2px 5px;border-radius:4px;display:block;margin:4px 0;word-break:break-all;font-size:10px">/api/webhook/log</code>
          Body: <code style="background:var(--bg);padding:1px 5px;border-radius:4px;font-size:10px">&#123;"apiKey":"KEY","text":"@@{triggerBody()}"&#125;</code>
        </p>
      </details>
    </div>

  </aside>

  <!-- ════ MAIN CHAT ═══════════════════════════════════════════════════════ -->
  <div class="wb-main">

    <!-- Mobile top bar -->
    <div class="wb-mobile-bar">
      <button class="wb-sidebar-toggle" onclick="wbToggleSidebar()" aria-label="Menu">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <div style="display:flex;align-items:center;gap:8px">
        <div style="width:26px;height:26px;border-radius:7px;background:linear-gradient(135deg,var(--accent),var(--accent-2));display:flex;align-items:center;justify-content:center;color:white;font-size:12px;flex-shrink:0">✦</div>
        <span class="wb-mobile-title">WorkLog Bot</span>
      </div>
      <button class="wb-share-mini" onclick="openShareModal()" title="Share week">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
      </button>
    </div>

    <!-- Chat feed -->
    <div class="wb-feed" id="wbFeed">

      <!-- Bot greeting -->
      <div class="wb-msg wb-msg-bot">
        <div class="wb-av">✦</div>
        <div class="wb-bub wb-bub-bot">
          <strong>Hey @Model.FirstName! 👋</strong><br>
          I'm <strong>WorkLog Bot</strong>. Just tell me what you worked on and I'll parse, categorize, and log everything — no forms needed.<br>
          <span style="color:var(--muted);font-size:13px;margin-top:5px;display:block">
            Try: <em>"Fixed auth bug 2h, standup 15min, reviewed 3 PRs 1h"</em><br>
            Or ask: <em>"standup"</em> · <em>"today"</em> · <em>"show last Friday"</em> · <em>"this week"</em> · <em>"help"</em>
          </span>
        </div>
      </div>

      @if (todayLogs.Any())
      {
        <div class="wb-msg wb-msg-bot">
          <div class="wb-av">✦</div>
          <div class="wb-bub wb-bub-bot">
            <strong>You've already logged <span style="color:var(--accent)">@todayLogs.Sum(l => l.Hours)h</span> today across @todayLogs.Count item@(todayLogs.Count != 1 ? "s" : ""):</strong>
            <div class="wb-entries">
              @foreach (var log in todayLogs)
              {
                <div class="wb-entry-row">
                  <span class="wb-entry-dot" style="background:@CategoryColor(log.Tags)"></span>
                  <span class="wb-entry-desc">@log.Description</span>
                  <span class="wb-entry-proj">@log.Project</span>
                  <span class="wb-entry-hrs">@log.Hours h</span>
                </div>
              }
            </div>
            <div style="margin-top:8px;font-size:12.5px;color:var(--muted)">Keep going — tell me anything else you worked on and I'll add it.</div>
          </div>
        </div>
      }

    </div>

    <!-- Quick chips -->
    <div class="wb-chips">
      <button class="wb-chip" onclick="wbSendChip('generate my standup')">📋 Standup</button>
      <button class="wb-chip" onclick="wbSendChip('what did I log today?')">📅 Today</button>
      <button class="wb-chip" onclick="wbSendChip('show this week')">📊 This week</button>
      <button class="wb-chip" onclick="wbOpenDatePicker()">🗓 Pick date</button>
      <button class="wb-chip" onclick="wbSendChip('Team meeting 1 hour')">💬 Meeting</button>
      <button class="wb-chip" onclick="wbSendChip('Code review 1 hour')">🔍 Review</button>
      <button class="wb-chip" onclick="wbSendChip('Bug fixing 2 hours')">🐛 Bug fix</button>
      <button class="wb-chip" onclick="openShareModal()">✨ Share</button>
      <input type="date" id="wbDatePick" class="wb-date-inp" onchange="wbDatePicked(this.value)">
    </div>

    <!-- Input bar -->
    <div class="wb-bar">
      <button class="wb-mic" id="wbMicBtn" onclick="wbToggleVoice()" title="Voice input">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1a4 4 0 0 1 4 4v6a4 4 0 0 1-8 0V5a4 4 0 0 1 4-4zm0 2a2 2 0 0 0-2 2v6a2 2 0 0 0 4 0V5a2 2 0 0 0-2-2zm7 7a1 1 0 0 1 1 1 8 8 0 0 1-16 0 1 1 0 0 1 2 0 6 6 0 0 0 12 0 1 1 0 0 1 1-1zm-7 11v2a1 1 0 0 1-2 0v-2a1 1 0 0 1 2 0z"/></svg>
      </button>
      <button class="wb-aifix" id="wbAiFixBtn" onclick="wbToggleAiFix()" title="AI Fix — Ollama will correct your English before logging">✨ AI Fix</button>
      <div class="wb-ta-wrap">
        <textarea id="wbInput" class="wb-ta"
                  placeholder="What did you work on? e.g. 'Fixed login bug 2h, reviewed 3 PRs 1h, sprint planning 45min…'"
                  rows="1"
                  onkeydown="wbKeydown(event)"
                  oninput="wbAutosize(this)"></textarea>
        <button class="wb-ta-send" id="wbSendBtn" onclick="wbSend()" title="Send (Enter)">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
        </button>
      </div>
    </div>

  </div>
</div>

<!-- Mobile sidebar overlay -->
<div class="wb-overlay" id="wbOverlay" onclick="wbCloseSidebar()"></div>

<!-- ══ SHARE MODAL ═══════════════════════════════════════════════════════════ -->
<div id="shareModal" class="sm-overlay hidden" onclick="if(event.target===this)closeShareModal()">
  <div class="sm-panel">
    <div class="sm-header">
      <span class="sm-title">Share your week</span>
      <button class="sm-close" onclick="closeShareModal()">✕</button>
    </div>

    <div class="sm-card-wrap">
      <div id="shareCard" class="sc-card">
        <div class="sc-top">
          <span class="sc-logo">worklog<span>.</span></span>
          <span class="sc-week">Week of @weekLabel</span>
        </div>
        <div class="sc-name">@Model.FirstName's work week</div>
        <div class="sc-stats">
          <div class="sc-stat">
            <span class="sc-num">@Model.WeekTotalFormatted</span>
            <span class="sc-lbl">logged</span>
          </div>
          <div class="sc-div"></div>
          <div class="sc-stat">
            <span class="sc-num">@Model.Streak</span>
            <span class="sc-lbl">day streak 🔥</span>
          </div>
          <div class="sc-div"></div>
          <div class="sc-stat">
            <span class="sc-num">@Model.ProjectsCount</span>
            <span class="sc-lbl">projects</span>
          </div>
        </div>
        <div class="sc-prog-wrap">
          <div class="sc-prog-bar">
            <div class="sc-prog-fill" style="width:@Math.Min(100,Model.WeekPctInt)%"></div>
          </div>
          <span class="sc-prog-lbl">@Model.WeekPctInt% of weekly goal</span>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.TopProject))
        {
          <div class="sc-top-proj">
            <span class="sc-proj-dot"></span>
            Top project: <strong>@Model.TopProject</strong>
            <span class="sc-proj-hrs">@Model.TopProjectHours h</span>
          </div>
        }
        <div class="sc-msg">@Model.ProgressMessage</div>
        <div class="sc-footer">Tracked with worklog · worklog.app</div>
      </div>
    </div>

    <div class="sm-actions">
      <button class="sm-btn sm-li" onclick="shareLinkedIn()">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        LinkedIn
      </button>
      <button class="sm-btn sm-tw" onclick="shareTwitter()">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.737-8.835L1.254 2.25H8.08l4.259 5.63 5.905-5.63zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        X / Twitter
      </button>
      <button class="sm-btn sm-fb" onclick="shareFacebook()">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        Facebook
      </button>
      <button class="sm-btn sm-ig" onclick="downloadCard()">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
        Download
      </button>
    </div>

    <div id="liCopyBox" class="sm-copy-box hidden">
      <p class="sm-copy-label">Copy this text, then paste into your LinkedIn post:</p>
      <textarea id="liCopyText" class="sm-copy-ta" readonly></textarea>
      <button class="sm-copy-btn" onclick="copyLinkedInText()">📋 Copy to clipboard</button>
      <span id="copiedConfirm" class="sm-copied hidden">✓ Copied!</span>
    </div>
  </div>
</div>

@functions {
    static string CategoryColor(string cat) => cat switch {
        "Development"   => "#3b82f6",
        "Meeting"       => "#f59e0b",
        "Code Review"   => "#10b981",
        "Testing"       => "#8b5cf6",
        "Documentation" => "#06b6d4",
        "DevOps"        => "#ef4444",
        "Research"      => "#6366f1",
        "Design"        => "#ec4899",
        _               => "#94a3b8",
    };
}

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" defer></script>
<script>
// ── Full-screen mode ──────────────────────────────────────────────────────
document.body.classList.add('wb-page');

// ── Server data ───────────────────────────────────────────────────────────
const WB = {
  firstName:  @Json.Serialize(Model.FirstName),
  todayLogs:  @Html.Raw(System.Text.Json.JsonSerializer.Serialize(todayLogs.Select(l => new {
                  id = l.Id, description = l.Description, project = l.Project,
                  hours = l.Hours, category = l.Tags
              }))),
  weekDays:   @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeekDays.Select(d => new {
                  name = d.Name, hours = d.Hours, isToday = d.IsToday,
                  isFuture = d.IsFuture, formatted = d.Formatted
              }))),
  weekTotal:  @Json.Serialize(Model.WeekTotalFormatted),
  weekPct:    @Model.WeekPctInt,
  weekGoal:   @((int)Model.WeekGoal),
  streak:     @Model.Streak,
  todayHours: @Model.TodayHours,
  topProject: @Json.Serialize(Model.TopProject),
};

const CAT_COLORS = {
  'Development':'#3b82f6','Meeting':'#f59e0b','Code Review':'#10b981',
  'Testing':'#8b5cf6','Documentation':'#06b6d4','DevOps':'#ef4444',
  'Research':'#6366f1','Design':'#ec4899','Other':'#94a3b8',
};
const CAT_LIST = ['Development','Meeting','Code Review','Testing','Documentation','DevOps','Research','Design','Other'];

// ── DOM refs ──────────────────────────────────────────────────────────────
const feed    = document.getElementById('wbFeed');
const inp     = document.getElementById('wbInput');
const sendBtn = document.getElementById('wbSendBtn');
const micBtn  = document.getElementById('wbMicBtn');

// ── AI Fix toggle ─────────────────────────────────────────────────────────
let wbAiFix = false;
function wbToggleAiFix() {
  wbAiFix = !wbAiFix;
  const btn = document.getElementById('wbAiFixBtn');
  btn.classList.toggle('on', wbAiFix);
  showToast(wbAiFix ? '✨ AI Fix ON — Ollama will correct your text before logging' : 'AI Fix off');
}

// ── Reload control (cancel if user clicks edit) ───────────────────────────
let reloadTimer = null;
function scheduleReload(ms = 4000) {
  cancelReload();
  reloadTimer = setTimeout(() => location.reload(), ms);
}
function cancelReload() {
  if (reloadTimer) { clearTimeout(reloadTimer); reloadTimer = null; }
}

// ── Input helpers ─────────────────────────────────────────────────────────
function wbKeydown(e) {
  if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); wbSend(); }
}
function wbAutosize(el) {
  el.style.height = 'auto';
  el.style.height = Math.min(el.scrollHeight, 120) + 'px';
}
function wbSendChip(text) {
  inp.value = text; wbAutosize(inp); inp.focus(); wbSend();
}

// ── Main send ─────────────────────────────────────────────────────────────
async function wbSend() {
  const text = inp.value.trim();
  if (!text) return;

  appendUser(text);
  histSave('user', text);
  inp.value = ''; wbAutosize(inp);
  inp.disabled = true; sendBtn.disabled = true;

  const intent = detectIntent(text);
  switch (intent) {
    case 'standup':   await handleStandup();          break;
    case 'today':     await handleToday();            break;
    case 'week':      await handleWeek();             break;
    case 'date':      await handleDateQuery(text);    break;
    case 'share':     handleShare();                  break;
    case 'recurring': handleRecurring();              break;
    case 'history':   handleHistory();                break;
    case 'help':      handleHelp();                   break;
    default:          await handleLog(text);          break;
  }

  inp.disabled = false; sendBtn.disabled = false; inp.focus();
}

// ── Intent detection ──────────────────────────────────────────────────────
function detectIntent(text) {
  const t = text.toLowerCase().trim();
  if (/\b(standup|stand[- ]up|daily update|scrum|morning update|generate.*standup|my standup)\b/.test(t)) return 'standup';
  // Date checks BEFORE 'today' so "what did I work on last Thursday?" routes correctly
  if (/\byesterday\b/.test(t)) return 'date';
  if (/\blast\s+(monday|tuesday|wednesday|thursday|friday|saturday|sunday)\b/.test(t)) return 'date';
  if (/\b(show|what did i|entries|logs? for|work on|worked on)\b.*\b(monday|tuesday|wednesday|thursday|friday|saturday|sunday|jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)\b/.test(t)) return 'date';
  if (/\bon\s+(monday|tuesday|wednesday|thursday|friday|saturday|sunday)\b/.test(t)) return 'date';
  if (/^(today\??|what (did|have) i|show.*today|my.*log|log.*today|done today)/.test(t) || t === 'today') return 'today';
  if (/\b(this week|weekly|show.*week|week.*stat|how.*week|week.*hour)\b/.test(t)) return 'week';
  if (/\b(share|post to|linkedin|twitter|social media)\b/.test(t)) return 'share';
  if (/\b(recurring|repeat|daily|scheduled|template)\b/.test(t)) return 'recurring';
  if (/^(\?|help|what can|commands|how to use|\/help)/.test(t)) return 'help';
  if (/\b(history|conversation|chat log|clear history|past messages|session summary|summarize.*session)\b/.test(t)) return 'history';
  return 'log';
}

// ── Message builders ──────────────────────────────────────────────────────
function appendUser(text) {
  const div = document.createElement('div');
  div.className = 'wb-msg wb-msg-user';
  div.innerHTML = `<div class="wb-bub wb-bub-user">${escHtml(text).replace(/\n/g,'<br>')}</div>`;
  feed.appendChild(div); scrollFeed();
}

function showTyping() {
  const id = 'wbty' + Date.now();
  const div = document.createElement('div');
  div.id = id; div.className = 'wb-msg wb-msg-bot';
  div.innerHTML = `<div class="wb-av">✦</div><div class="wb-bub wb-bub-bot wb-typing"><span></span><span></span><span></span></div>`;
  feed.appendChild(div); scrollFeed();
  return id;
}

function removeTyping(id) { document.getElementById(id)?.remove(); }

function appendBot(html, saveToHistory = true) {
  const div = document.createElement('div');
  div.className = 'wb-msg wb-msg-bot';
  div.innerHTML = `<div class="wb-av">✦</div><div class="wb-bub wb-bub-bot">${html}</div>`;
  feed.appendChild(div); scrollFeed();
  if (saveToHistory) {
    const bub = div.querySelector('.wb-bub-bot');
    histSave('bot', (bub?.textContent ?? '').replace(/\s+/g, ' ').trim().slice(0, 300));
  }
  return div.querySelector('.wb-bub-bot');
}

async function appendBotTyped(text) {
  const tid = showTyping();
  await delay(420 + Math.random() * 280);
  removeTyping(tid);
  const bub = appendBot('');
  const chars = [...text]; let i = 0;
  await new Promise(resolve => {
    const t = setInterval(() => {
      bub.innerHTML = escHtml(chars.slice(0, ++i).join('')).replace(/\n/g,'<br>');
      scrollFeed();
      if (i >= chars.length) { clearInterval(t); resolve(); }
    }, 14);
  });
  return bub;
}

function scrollFeed() { feed.scrollTop = feed.scrollHeight; }

// ── Log handler ───────────────────────────────────────────────────────────
async function handleLog(text) {
  let logText = text;

  // AI Fix: correct English via Ollama before logging
  if (wbAiFix) {
    const ftid = showTyping();
    try {
      const fr = await fetch('/Logs/FixText', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ text }),
      });
      removeTyping(ftid);
      if (fr.ok) {
        const { result } = await fr.json();
        if (result && result.trim() && result.trim().toLowerCase() !== text.toLowerCase()) {
          logText = result.trim();
          appendBot(`<em style="font-size:12px;color:var(--muted)">✨ AI understood:</em> <span style="color:var(--text)">${escHtml(logText)}</span>`);
          await delay(350);
        }
      }
    } catch { removeTyping(ftid); }
  }

  const tid = showTyping();
  try {
    const res = await fetch('/Logs/ChatLog', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ text: logText }),
    });
    removeTyping(tid);

    if (!res.ok) {
      const err = await res.json().catch(() => ({}));
      appendBot(`<span style="color:var(--red)">⚠ ${escHtml(err.error ?? 'Something went wrong.')}</span>`);
      return;
    }

    const data = await res.json();

    const rows = data.entries.map(e =>
      `<div class="wb-entry-row" id="wbce-${e.id}">
        <span class="wb-entry-dot" style="background:${CAT_COLORS[e.category]??'#94a3b8'}"></span>
        <span class="wb-entry-desc">${escHtml(e.description)}</span>
        <span class="wb-entry-proj">${escHtml(e.project)}</span>
        <span class="wb-entry-hrs">${e.hours}h</span>
        <button class="wb-entry-edit" onclick="wbChatEdit(${e.id})" title="Edit this entry">✏</button>
      </div>
      <div class="wb-chat-editf hidden" id="wbcef-${e.id}">
        <input type="text" class="wb-tl-inp wb-ce-desc" value="${escHtml(e.description)}" placeholder="Description">
        <div class="wb-tl-editrow">
          <input type="number" class="wb-tl-inp wb-ce-hrs" value="${e.hours}" step="0.25" min="0.25" max="24">
          <select class="wb-tl-inp wb-ce-cat">${wbCatOptions(e.category)}</select>
        </div>
        <div class="wb-tl-editbtns">
          <button type="button" class="wb-tl-save" onclick="wbChatSaveEdit(${e.id})">Save</button>
          <button type="button" class="wb-tl-cancel" onclick="wbChatCancelEdit(${e.id})">Cancel</button>
        </div>
      </div>`
    ).join('');

    appendBot(
      `<strong>✅ Logged ${data.entries.length} item${data.entries.length!==1?'s':''}!</strong>` +
      `<div class="wb-entries">${rows}</div>` +
      `<div class="wb-log-total">Total: <strong>${data.total}h</strong> · <button class="wb-log-refresh" onclick="location.reload()">↻ Refresh sidebar</button></div>`
    );
    showToast(`✓ ${data.entries.length} item${data.entries.length!==1?'s':''} logged!`);
    scheduleReload();

  } catch {
    removeTyping(tid);
    appendBot(`<span style="color:var(--red)">⚠ Network error. Please try again.</span>`);
  }
}

// ── Inline chat entry edit ────────────────────────────────────────────────
function wbCatOptions(selected) {
  return CAT_LIST.map(c => `<option value="${c}" ${c===selected?'selected':''}>${c}</option>`).join('');
}
function wbChatEdit(id) {
  cancelReload();
  document.getElementById(`wbce-${id}`)?.classList.add('hidden');
  document.getElementById(`wbcef-${id}`)?.classList.remove('hidden');
  document.querySelector(`#wbcef-${id} .wb-ce-desc`)?.focus();
}
function wbChatCancelEdit(id) {
  document.getElementById(`wbcef-${id}`)?.classList.add('hidden');
  document.getElementById(`wbce-${id}`)?.classList.remove('hidden');
}
async function wbChatSaveEdit(id) {
  const wrap = document.getElementById(`wbcef-${id}`);
  const desc = wrap.querySelector('.wb-ce-desc').value.trim();
  const hrs  = parseFloat(wrap.querySelector('.wb-ce-hrs').value);
  const cat  = wrap.querySelector('.wb-ce-cat').value;
  if (!desc || isNaN(hrs) || hrs <= 0) { showErr('Fill in description and hours.'); return; }
  try {
    const res = await fetch('/Logs/EditLog', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ id, description: desc, hours: hrs, category: cat }),
    });
    if (res.ok) {
      const row = document.getElementById(`wbce-${id}`);
      row.querySelector('.wb-entry-desc').textContent = desc;
      row.querySelector('.wb-entry-hrs').textContent = hrs + 'h';
      wbChatCancelEdit(id);
      showToast('✓ Entry updated');
    } else showErr('Could not save — try again.');
  } catch { showErr('Network error.'); }
}

