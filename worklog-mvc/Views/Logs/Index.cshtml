@model WorkLogApp.Models.ViewModels.DashboardViewModel
@section Styles {
<style>
  body{overflow:hidden!important}
  .main-wrap{max-width:none!important;margin:0!important;padding:0!important;height:calc(100dvh - 54px);height:calc(100vh - 54px);overflow:hidden!important}
  .app-footer{display:none!important}
</style>
}
@{
    var todayLogs = Model.Logs.Where(l => l.Date == DateOnly.FromDateTime(DateTime.Today)).ToList();
    var maxDayH   = Model.WeekDays.Count > 0 ? Model.WeekDays.Max(d => d.Hours) : 1m;
    if (maxDayH == 0) maxDayH = 1m;
    var dowShare  = (int)DateTime.Today.DayOfWeek;
    var monShare  = DateTime.Today.AddDays(dowShare == 0 ? -6 : -(dowShare - 1));
    var sunShare  = monShare.AddDays(6);
    var weekLabel = $"{monShare:MMM d} – {sunShare:MMM d, yyyy}";
    var weekShort = $"{monShare:MMM d} – {sunShare:MMM d}";
    // SVG ring offset for sidebar (r=27 → circumference=169.65)
    var ringOffset = (169.65m * (1 - Math.Min(1m, Model.WeekPctInt / 100m))).ToString("F1");
    // Board: last 14 days of logs grouped by date
    var grouped = Model.Logs
        .GroupBy(l => l.Date)
        .OrderByDescending(g => g.Key)
        .Take(14)
        .ToList();
}

<div class="wb-app">

  <!-- ════ SIDEBAR ════════════════════════════════════════════════════════ -->
  <aside class="wb-sidebar" id="wbSidebar">

    <!-- Bot identity -->
    <div class="wb-sb-bot">
      <div class="wb-sb-av">✦</div>
      <div>
        <div class="wb-sb-name">WorkLog Bot</div>
        <div class="wb-sb-status"><span class="wb-online"></span>online · auto-logs everything</div>
      </div>
    </div>

    <!-- Quick stats -->
    <div class="wb-sc">
      <div class="wb-sc-title">Today</div>
      <div class="wb-qs-grid">
        <div class="wb-qs-item">
          <span class="wb-qs-num">@Model.TodayHours h</span>
          <span class="wb-qs-lbl">logged</span>
        </div>
        <div class="wb-qs-item">
          <span class="wb-qs-num">@Model.Streak @(Model.Streak >= 3 ? "🔥" : "📅")</span>
          <span class="wb-qs-lbl">day streak</span>
        </div>
        <div class="wb-qs-item">
          <span class="wb-qs-num">@Model.ProjectsCount</span>
          <span class="wb-qs-lbl">projects</span>
        </div>
        <div class="wb-qs-item">
          <span class="wb-qs-num">@Model.WeekPctInt%</span>
          <span class="wb-qs-lbl">of goal</span>
        </div>
      </div>
    </div>

    <!-- Week progress -->
    <div class="wb-sc">
      <div class="wb-sc-title">This Week</div>
      <div style="display:flex;align-items:center;gap:14px">
        <div class="wb-week-ring">
          <svg width="68" height="68" viewBox="0 0 68 68">
            <circle cx="34" cy="34" r="27" fill="none" stroke="var(--line)" stroke-width="5"/>
            <circle cx="34" cy="34" r="27" fill="none"
                    stroke="@(Model.WeekPctInt >= 100 ? "#10b981" : "#6366f1")"
                    stroke-width="5" stroke-linecap="round"
                    stroke-dasharray="169.65"
                    stroke-dashoffset="@ringOffset"
                    transform="rotate(-90 34 34)"/>
          </svg>
          <div class="wb-ring-inner">
            <span class="wb-ring-pct">@Model.WeekPctInt%</span>
          </div>
        </div>
        <div>
          <div style="font-size:17px;font-weight:800;color:var(--text)">@Model.WeekTotalFormatted</div>
          <div style="font-size:11.5px;color:var(--muted);margin-top:2px">/ @((int)Model.WeekGoal)h goal</div>
          <div style="font-size:11px;color:var(--muted);margin-top:4px;line-height:1.4">@Model.ProgressMessage</div>
        </div>
      </div>
    </div>

    <!-- Today's log (editable) -->
    @if (todayLogs.Any())
    {
      <div class="wb-sc">
        <div class="wb-sc-title">
          <span>Today's Log</span>
          <span style="font-size:11px;font-weight:700;color:var(--accent);background:var(--accent-bg);padding:1px 8px;border-radius:99px">@todayLogs.Sum(l => l.Hours) h</span>
        </div>
        <div class="wb-today-list">
          @foreach (var log in todayLogs)
          {
            <div class="wb-tl-item" id="wbtl-@log.Id">
              <div class="wb-tl-view">
                <span class="wb-tl-dot" style="background:@CategoryColor(log.Tags)"></span>
                <span class="wb-tl-desc" title="@log.Description">@log.Description</span>
                <span class="wb-tl-hrs">@log.Hours h</span>
                <button class="wb-tl-edit" onclick="wbStartEdit(@log.Id)" title="Edit">✏</button>
                <form asp-action="Delete" method="post" class="wb-tl-del-form">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="id" value="@log.Id">
                  <button type="submit" class="wb-tl-del" title="Delete">×</button>
                </form>
              </div>
              <div class="wb-tl-editf hidden" id="wbedit-@log.Id">
                <input type="text" class="wb-tl-inp wb-tl-idesc" value="@log.Description" placeholder="Description">
                <div class="wb-tl-editrow">
                  <input type="number" class="wb-tl-inp wb-tl-ihrs" value="@log.Hours" step="0.25" min="0.25" max="24">
                  <select class="wb-tl-inp wb-tl-icat">
                    @foreach (var cat in new[]{"Development","Meeting","Code Review","Testing","Documentation","DevOps","Research","Design","Other"})
                    {
                      <option value="@cat" selected="@(log.Tags == cat ? "selected" : null)">@cat</option>
                    }
                  </select>
                </div>
                <div class="wb-tl-editbtns">
                  <button type="button" class="wb-tl-save" onclick="wbSaveEdit(@log.Id)">Save</button>
                  <button type="button" class="wb-tl-cancel" onclick="wbCancelEdit(@log.Id)">Cancel</button>
                </div>
              </div>
            </div>
          }
        </div>
      </div>
    }

    <!-- Quick actions -->
    <div class="wb-sc">
      <div class="wb-sc-title">Quick Actions</div>
      <div class="wb-qa-list">
        <button class="wb-qa-btn" onclick="openShareModal()">
          <span>✨</span> Share this week
        </button>
        <a href="/Recurring" class="wb-qa-btn">
          <span>↺</span> Recurring tasks
        </a>
        <a href="/Timesheet" class="wb-qa-btn">
          <span>📅</span> View timesheet
        </a>
        <button class="wb-qa-btn" onclick="openFeedback()">
          <span>💬</span> Give feedback
        </button>
      </div>
    </div>

    <!-- AI insight -->
    <div class="wb-sc">
      <div class="wb-sc-title">✦ Weekly Insight</div>
      <p class="wb-insight-text" id="wbInsightText">Loading…</p>
    </div>

  </aside>

  <!-- ════ MAIN BOARD ══════════════════════════════════════════════════════ -->
  <div class="wb-main">

    <!-- Mobile top bar -->
    <div class="wb-mobile-bar">
      <button class="wb-sidebar-toggle" onclick="wbToggleSidebar()" aria-label="Menu">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <div style="display:flex;align-items:center;gap:8px">
        <div style="width:26px;height:26px;border-radius:7px;background:linear-gradient(135deg,var(--accent),var(--accent-2));display:flex;align-items:center;justify-content:center;color:white;font-size:12px;flex-shrink:0">✦</div>
        <span class="wb-mobile-title">WorkLog Bot</span>
      </div>
      <button class="wb-share-mini" onclick="openShareModal()" title="Share week">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
      </button>
    </div>

    <!-- Bot status bar -->
    <div class="wb-status-bar" id="wbStatus">
      <span class="wb-status-icon">✦</span>
      <span class="wb-status-text" id="wbStatusText">
        Hey @Model.FirstName! Tell me what you worked on — I'll create cards below.
      </span>
    </div>

    <!-- ── Card board ── -->
    <div class="wb-board" id="wbBoard">
      @if (!grouped.Any())
      {
        <div class="wb-board-empty" id="wbEmptyState">
          <div class="wb-board-empty-ico">📋</div>
          <div class="wb-board-empty-title">No logs yet</div>
          <div class="wb-board-empty-sub">Tell me what you worked on and I'll create coloured cards here, grouped by day. You can edit, delete, and drag cards between days.</div>
        </div>
      }
      else
      {
        var today  = DateOnly.FromDateTime(DateTime.Today);
        var yester = today.AddDays(-1);
        @foreach (var day in grouped)
        {
          var isToday  = day.Key == today;
          var isYester = day.Key == yester;
          var dayLabel = isToday ? "Today" : isYester ? "Yesterday" : day.Key.ToString("dddd");
          var dayDate  = day.Key.ToString("MMM d");
          <div class="wb-day-group @(isToday ? "wb-day-today" : "")"
               data-date="@day.Key.ToString("yyyy-MM-dd")"
               ondragover="wbDragOver(event)"
               ondragleave="wbDragLeave(event)"
               ondrop="wbDrop(event,'@day.Key.ToString("yyyy-MM-dd")')">
            <div class="wb-day-hdr">
              <span class="wb-day-label">@dayLabel · @dayDate</span>
              <span class="wb-day-total" id="wbdt-@day.Key.ToString("yyyyMMdd")">@day.Sum(e => e.Hours) h</span>
              <span class="wb-day-line"></span>
            </div>
            <div class="wb-day-cards" id="wbdc-@day.Key.ToString("yyyyMMdd")">
              @foreach (var log in day.OrderBy(e => e.CreatedAt))
              {
                var cc = CategoryColor(log.Tags);
                <div class="wbcard" id="wbc-@log.Id" draggable="true"
                     data-id="@log.Id" data-date="@log.Date.ToString("yyyy-MM-dd")"
                     ondragstart="wbDragStart(event,@log.Id)">
                  <div class="wbcard-stripe" style="background:@cc"></div>
                  <div class="wbcard-body">
                    <div class="wbcard-desc" id="wbcd-@log.Id">@log.Description</div>
                    <div class="wbcard-meta">
                      <span class="wbcard-proj" title="@log.Project">@log.Project</span>
                      <span class="wbcard-hrs" id="wbch-@log.Id">@log.Hours h</span>
                    </div>
                    <span class="wbcard-badge" style="background:@cc" id="wbcb-@log.Id">@(string.IsNullOrWhiteSpace(log.Tags) ? "Other" : log.Tags)</span>
                  </div>
                  <div class="wbcard-foot">
                    <span class="wbcard-drag" title="Drag to move">⋮⋮</span>
                    <div class="wbcard-actions">
                      <button class="wbcard-btn" onclick="wbStartCardEdit(@log.Id)" title="Edit">✏</button>
                      <button class="wbcard-btn del" onclick="wbDeleteCard(@log.Id)" title="Delete">×</button>
                    </div>
                  </div>
                  <!-- Inline edit -->
                  <div class="wbcard-editf hidden" id="wbcef-@log.Id">
                    <textarea class="wbcard-einp wb-ce-desc" rows="2">@log.Description</textarea>
                    <div class="wbcard-erow">
                      <input type="number" class="wbcard-einp wb-ce-hrs" value="@log.Hours" step="0.25" min="0.25" max="24" style="width:62px">
                      <select class="wbcard-einp wb-ce-cat" style="flex:1">
                        @foreach (var cat in new[]{"Development","Meeting","Code Review","Testing","Documentation","DevOps","Research","Design","Other"})
                        {
                          <option value="@cat" selected="@(log.Tags == cat ? "selected" : null)">@cat</option>
                        }
                      </select>
                    </div>
                    <input type="text" class="wbcard-einp wb-ce-proj" value="@log.Project" placeholder="Project">
                    <div class="wbcard-ebtns">
                      <button class="wbcard-esave" onclick="wbSaveCardEdit(@log.Id)">Save</button>
                      <button class="wbcard-ecancel" onclick="wbCancelCardEdit(@log.Id)">Cancel</button>
                    </div>
                  </div>
                </div>
              }
            </div>
          </div>
        }
      }
    </div>

    <!-- Quick chips -->
    <div class="wb-chips">
      <button class="wb-chip" onclick="wbSendChip('generate my standup')">📋 Standup</button>
      <button class="wb-chip" onclick="wbSendChip('what did I log today?')">📅 Today</button>
      <button class="wb-chip" onclick="wbSendChip('show this week')">📊 This week</button>
      <button class="wb-chip" onclick="wbOpenDatePicker()">🗓 Pick date</button>
      <button class="wb-chip" onclick="wbSendChip('Team meeting 1 hour')">💬 Meeting</button>
      <button class="wb-chip" onclick="wbSendChip('Code review 1 hour')">🔍 Review</button>
      <button class="wb-chip" onclick="wbSendChip('Bug fixing 2 hours')">🐛 Bug fix</button>
      <button class="wb-chip" onclick="openShareModal()">✨ Share</button>
      <input type="date" id="wbDatePick" class="wb-date-inp" onchange="wbDatePicked(this.value)">
    </div>

    <!-- Input bar -->
    <div class="wb-bar">
      <button class="wb-mic" id="wbMicBtn" onclick="wbToggleVoice()" title="Voice input">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1a4 4 0 0 1 4 4v6a4 4 0 0 1-8 0V5a4 4 0 0 1 4-4zm0 2a2 2 0 0 0-2 2v6a2 2 0 0 0 4 0V5a2 2 0 0 0-2-2zm7 7a1 1 0 0 1 1 1 8 8 0 0 1-16 0 1 1 0 0 1 2 0 6 6 0 0 0 12 0 1 1 0 0 1 1-1zm-7 11v2a1 1 0 0 1-2 0v-2a1 1 0 0 1 2 0z"/></svg>
      </button>
      <button class="wb-aifix" id="wbAiFixBtn" onclick="wbToggleAiFix()" title="AI Fix — Ollama will correct your English before logging">✨ AI Fix</button>
      <div class="wb-ta-wrap">
        <textarea id="wbInput" class="wb-ta"
                  placeholder="What did you work on? e.g. 'Fixed login bug 2h, reviewed 3 PRs 1h, sprint planning 45min…'"
                  rows="1"
                  onkeydown="wbKeydown(event)"
                  oninput="wbAutosize(this)"></textarea>
        <button class="wb-ta-send" id="wbSendBtn" onclick="wbSend()" title="Send (Enter)">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
        </button>
      </div>
    </div>

  </div>
</div>

<!-- Mobile sidebar overlay -->
<div class="wb-overlay" id="wbOverlay" onclick="wbCloseSidebar()"></div>

<!-- ══ SHARE MODAL ═══════════════════════════════════════════════════════════ -->
<div id="shareModal" class="sm-overlay hidden" onclick="if(event.target===this)closeShareModal()">
  <div class="sm-panel">
    <div class="sm-header">
      <span class="sm-title">Share your week</span>
      <button class="sm-close" onclick="closeShareModal()">✕</button>
    </div>

    <div class="sm-card-wrap">
      <div id="shareCard" class="sc-card">
        <div class="sc-top">
          <span class="sc-logo">worklog<span>.</span></span>
          <span class="sc-week">Week of @weekLabel</span>
        </div>
        <div class="sc-name">@Model.FirstName's work week</div>
        <div class="sc-stats">
          <div class="sc-stat">
            <span class="sc-num">@Model.WeekTotalFormatted</span>
            <span class="sc-lbl">logged</span>
          </div>
          <div class="sc-div"></div>
          <div class="sc-stat">
            <span class="sc-num">@Model.Streak</span>
            <span class="sc-lbl">day streak 🔥</span>
          </div>
          <div class="sc-div"></div>
          <div class="sc-stat">
            <span class="sc-num">@Model.ProjectsCount</span>
            <span class="sc-lbl">projects</span>
          </div>
        </div>
        <div class="sc-prog-wrap">
          <div class="sc-prog-bar">
            <div class="sc-prog-fill" style="width:@Math.Min(100,Model.WeekPctInt)%"></div>
          </div>
          <span class="sc-prog-lbl">@Model.WeekPctInt% of weekly goal</span>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.TopProject))
        {
          <div class="sc-top-proj">
            <span class="sc-proj-dot"></span>
            Top project: <strong>@Model.TopProject</strong>
            <span class="sc-proj-hrs">@Model.TopProjectHours h</span>
          </div>
        }
        <div class="sc-msg">@Model.ProgressMessage</div>
        <div class="sc-footer">Tracked with worklog · worklog.app</div>
      </div>
    </div>

    <div class="sm-actions">
      <button class="sm-btn sm-li" onclick="shareLinkedIn()">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        LinkedIn
      </button>
      <button class="sm-btn sm-tw" onclick="shareTwitter()">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.737-8.835L1.254 2.25H8.08l4.259 5.63 5.905-5.63zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        X / Twitter
      </button>
      <button class="sm-btn sm-fb" onclick="shareFacebook()">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        Facebook
      </button>
      <button class="sm-btn sm-ig" onclick="downloadCard()">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
        Download
      </button>
    </div>

    <div id="liCopyBox" class="sm-copy-box hidden">
      <p class="sm-copy-label">Copy this text, then paste into your LinkedIn post:</p>
      <textarea id="liCopyText" class="sm-copy-ta" readonly></textarea>
      <button class="sm-copy-btn" onclick="copyLinkedInText()">📋 Copy to clipboard</button>
      <span id="copiedConfirm" class="sm-copied hidden">✓ Copied!</span>
    </div>
  </div>
</div>

@functions {
    static string CategoryColor(string cat) => cat switch {
        "Development"   => "#3b82f6",
        "Meeting"       => "#f59e0b",
        "Code Review"   => "#10b981",
        "Testing"       => "#8b5cf6",
        "Documentation" => "#06b6d4",
        "DevOps"        => "#ef4444",
        "Research"      => "#6366f1",
        "Design"        => "#ec4899",
        _               => "#94a3b8",
    };
}

<!-- Response modal -->
<div class="wbmodal-overlay" id="wbModal" onclick="if(event.target===this)wbCloseModal()">
  <div class="wbmodal-panel">
    <div class="wbmodal-hdr">
      <span class="wbmodal-title" id="wbModalTitle"></span>
      <button class="wbmodal-close" onclick="wbCloseModal()">✕</button>
    </div>
    <div class="wbmodal-body" id="wbModalBody"></div>
  </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" defer></script>
<script>
// ── Full-screen mode ──────────────────────────────────────────────────────
document.body.classList.add('wb-page');

// ── Server data ───────────────────────────────────────────────────────────
const WB = {
  firstName:  @Json.Serialize(Model.FirstName),
  todayLogs:  @Html.Raw(System.Text.Json.JsonSerializer.Serialize(todayLogs.Select(l => new {
                  id = l.Id, description = l.Description, project = l.Project,
                  hours = l.Hours, category = l.Tags
              }))),
  weekDays:   @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeekDays.Select(d => new {
                  name = d.Name, hours = d.Hours, isToday = d.IsToday,
                  isFuture = d.IsFuture, formatted = d.Formatted
              }))),
  weekTotal:  @Json.Serialize(Model.WeekTotalFormatted),
  weekPct:    @Model.WeekPctInt,
  weekGoal:   @((int)Model.WeekGoal),
  streak:     @Model.Streak,
  todayHours: @Model.TodayHours,
  topProject: @Json.Serialize(Model.TopProject),
};

const CAT_COLORS = {
  'Development':'#3b82f6','Meeting':'#f59e0b','Code Review':'#10b981',
  'Testing':'#8b5cf6','Documentation':'#06b6d4','DevOps':'#ef4444',
  'Research':'#6366f1','Design':'#ec4899','Other':'#94a3b8',
};
const CAT_LIST = ['Development','Meeting','Code Review','Testing','Documentation','DevOps','Research','Design','Other'];

// ── DOM refs ──────────────────────────────────────────────────────────────
const inp     = document.getElementById('wbInput');
const sendBtn = document.getElementById('wbSendBtn');
const micBtn  = document.getElementById('wbMicBtn');

// ── AI Fix toggle ─────────────────────────────────────────────────────────
let wbAiFix = false;
function wbToggleAiFix() {
  wbAiFix = !wbAiFix;
  const btn = document.getElementById('wbAiFixBtn');
  btn.classList.toggle('on', wbAiFix);
  showToast(wbAiFix ? '✨ AI Fix ON — Ollama will correct your text before logging' : 'AI Fix off');
}

// ── Status bar ────────────────────────────────────────────────────────────
let _statusTimer = null;
function setStatus(msg, isErr = false) {
  const bar  = document.getElementById('wbStatus');
  const text = document.getElementById('wbStatusText');
  if (msg === 'typing') {
    text.innerHTML = '<span class="wb-status-dots"><span></span><span></span><span></span></span>';
    bar.classList.remove('wb-status-err');
    return;
  }
  text.textContent = msg;
  bar.classList.toggle('wb-status-err', isErr);
  if (_statusTimer) clearTimeout(_statusTimer);
  _statusTimer = setTimeout(() => {
    text.textContent = `✦ WorkLog Bot${WB.streak > 0 ? ' · ' + WB.streak + '-day streak 🔥' : ''}`;
    bar.classList.remove('wb-status-err');
  }, 5000);
}

// ── Response modal ────────────────────────────────────────────────────────
function wbShowModal(title, html) {
  document.getElementById('wbModalTitle').textContent = title;
  document.getElementById('wbModalBody').innerHTML = html;
  document.getElementById('wbModal').classList.add('open');
}
function wbCloseModal() { document.getElementById('wbModal').classList.remove('open'); }

// ── Card board functions ──────────────────────────────────────────────────
function wbBuildCard(e) {
  const color   = CAT_COLORS[e.category] ?? '#94a3b8';
  const cat     = e.category || 'Other';
  const date    = e.date ?? toIso(new Date());
  const catOpts = CAT_LIST.map(c => `<option value="${c}" ${c===cat?'selected':''}>${c}</option>`).join('');
  return `<div class="wbcard wbcard-new" id="wbc-${e.id}" draggable="true"
               data-id="${e.id}" data-date="${date}"
               ondragstart="wbDragStart(event,${e.id})">
    <div class="wbcard-stripe" style="background:${color}"></div>
    <div class="wbcard-body">
      <div class="wbcard-desc" id="wbcd-${e.id}">${escHtml(e.description)}</div>
      <div class="wbcard-meta">
        <span class="wbcard-proj">${escHtml(e.project)}</span>
        <span class="wbcard-hrs" id="wbch-${e.id}">${e.hours}h</span>
      </div>
      <span class="wbcard-badge" style="background:${color}" id="wbcb-${e.id}">${escHtml(cat)}</span>
    </div>
    <div class="wbcard-foot">
      <span class="wbcard-drag" title="Drag to move day">⋮⋮</span>
      <div class="wbcard-actions">
        <button class="wbcard-btn" onclick="wbStartCardEdit(${e.id})" title="Edit">✏</button>
        <button class="wbcard-btn del" onclick="wbDeleteCard(${e.id})" title="Delete">×</button>
      </div>
    </div>
    <div class="wbcard-editf hidden" id="wbcef-${e.id}">
      <textarea class="wbcard-einp wb-ce-desc" rows="2">${escHtml(e.description)}</textarea>
      <div class="wbcard-erow">
        <input type="number" class="wbcard-einp wb-ce-hrs" value="${e.hours}" step="0.25" min="0.25" max="24" style="width:62px">
        <select class="wbcard-einp wb-ce-cat" style="flex:1">${catOpts}</select>
      </div>
      <input type="text" class="wbcard-einp wb-ce-proj" value="${escHtml(e.project)}" placeholder="Project">
      <div class="wbcard-ebtns">
        <button class="wbcard-esave" onclick="wbSaveCardEdit(${e.id})">Save</button>
        <button class="wbcard-ecancel" onclick="wbCancelCardEdit(${e.id})">Cancel</button>
      </div>
    </div>
  </div>`;
}

function wbAddCards(entries, dateIso) {
  document.getElementById('wbEmptyState')?.remove();
  let group = document.querySelector(`.wb-day-group[data-date="${dateIso}"]`);
  if (!group) {
    const today  = new Date(dateIso + 'T12:00:00');
    const now    = new Date();
    const isToday = dateIso === toIso(now);
    const label  = isToday ? 'Today' : today.toLocaleDateString('en-US', { weekday:'long' });
    const dLabel = today.toLocaleDateString('en-US', { month:'short', day:'numeric' });
    const dKey   = dateIso.replace(/-/g,'');
    group = document.createElement('div');
    group.className = `wb-day-group${isToday ? ' wb-day-today' : ''}`;
    group.dataset.date = dateIso;
    group.setAttribute('ondragover',  'wbDragOver(event)');
    group.setAttribute('ondragleave', 'wbDragLeave(event)');
    group.setAttribute('ondrop',      `wbDrop(event,'${dateIso}')`);
    group.innerHTML = `
      <div class="wb-day-hdr">
        <span class="wb-day-label">${label} · ${dLabel}</span>
        <span class="wb-day-total" id="wbdt-${dKey}">0h</span>
        <span class="wb-day-line"></span>
      </div>
      <div class="wb-day-cards" id="wbdc-${dKey}"></div>`;
    document.getElementById('wbBoard').insertBefore(group, document.getElementById('wbBoard').firstChild);
  }
  const dKey    = dateIso.replace(/-/g,'');
  const container = document.getElementById(`wbdc-${dKey}`) ?? group.querySelector('.wb-day-cards');
  entries.forEach(e => {
    container.insertAdjacentHTML('beforeend', wbBuildCard({ ...e, date: dateIso }));
  });
  wbUpdateDayTotal(dateIso);
}

function wbUpdateDayTotal(dateIso) {
  const dKey = dateIso.replace(/-/g,'');
  const container = document.getElementById(`wbdc-${dKey}`);
  if (!container) return;
  const cards = container.querySelectorAll('.wbcard');
  let total = 0;
  cards.forEach(c => { const h = c.querySelector('.wbcard-hrs'); if (h) total += parseFloat(h.textContent) || 0; });
  const el = document.getElementById(`wbdt-${dKey}`);
  if (el) el.textContent = total.toFixed(total % 1 === 0 ? 0 : 1) + 'h';
}

// Card edit
function wbStartCardEdit(id) {
  const card = document.getElementById(`wbc-${id}`);
  card.querySelector('.wbcard-body')?.classList.add('hidden');
  card.querySelector('.wbcard-foot')?.classList.add('hidden');
  card.querySelector('.wbcard-editf')?.classList.remove('hidden');
  card.setAttribute('draggable','false');
  card.querySelector('.wb-ce-desc')?.focus();
}
function wbCancelCardEdit(id) {
  const card = document.getElementById(`wbc-${id}`);
  card.querySelector('.wbcard-editf')?.classList.add('hidden');
  card.querySelector('.wbcard-body')?.classList.remove('hidden');
  card.querySelector('.wbcard-foot')?.classList.remove('hidden');
  card.setAttribute('draggable','true');
}
async function wbSaveCardEdit(id) {
  const card = document.getElementById(`wbc-${id}`);
  const wrap = card.querySelector('.wbcard-editf');
  const desc = wrap.querySelector('.wb-ce-desc').value.trim();
  const hrs  = parseFloat(wrap.querySelector('.wb-ce-hrs').value);
  const cat  = wrap.querySelector('.wb-ce-cat').value;
  const proj = wrap.querySelector('.wb-ce-proj').value.trim();
  if (!desc || isNaN(hrs) || hrs <= 0) { showErr('Fill in description and hours.'); return; }
  try {
    const res = await fetch('/Logs/EditLog', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ id, description: desc, hours: hrs, category: cat, project: proj }),
    });
    if (!res.ok) { showErr('Could not save.'); return; }
    const color = CAT_COLORS[cat] ?? '#94a3b8';
    document.getElementById(`wbcd-${id}`).textContent = desc;
    document.getElementById(`wbch-${id}`).textContent = hrs + 'h';
    card.querySelector('.wbcard-stripe').style.background = color;
    const badge = document.getElementById(`wbcb-${id}`);
    if (badge) { badge.style.background = color; badge.textContent = cat; }
    wbCancelCardEdit(id);
    wbUpdateDayTotal(card.dataset.date);
    showToast('✓ Entry updated');
  } catch { showErr('Network error.'); }
}
async function wbDeleteCard(id) {
  const card = document.getElementById(`wbc-${id}`);
  if (!card) return;
  const dateIso = card.dataset.date;
  try {
    const res = await fetch('/Logs/DeleteEntry', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ id }),
    });
    if (res.ok) {
      card.style.cssText += ';transform:scale(0);opacity:0;transition:transform .18s,opacity .18s';
      setTimeout(() => { card.remove(); wbUpdateDayTotal(dateIso); }, 200);
      showToast('✓ Entry deleted');
    } else showErr('Could not delete.');
  } catch { showErr('Network error.'); }
}

// Drag and drop between days
let _dragId = null;
function wbDragStart(e, id) {
  _dragId = id;
  e.dataTransfer.effectAllowed = 'move';
  e.dataTransfer.setData('text/plain', String(id));
  setTimeout(() => document.getElementById(`wbc-${id}`)?.classList.add('wbcard-dragging'), 0);
}
function wbDragOver(e) {
  e.preventDefault(); e.dataTransfer.dropEffect = 'move';
  e.currentTarget.querySelector('.wb-day-cards')?.classList.add('wb-drag-over');
}
function wbDragLeave(e) {
  if (!e.currentTarget.contains(e.relatedTarget))
    e.currentTarget.querySelector('.wb-day-cards')?.classList.remove('wb-drag-over');
}
async function wbDrop(e, newDate) {
  e.preventDefault();
  e.currentTarget.querySelector('.wb-day-cards')?.classList.remove('wb-drag-over');
  const id   = parseInt(e.dataTransfer.getData('text/plain'));
  const card = document.getElementById(`wbc-${id}`);
  if (!card) return;
  card.classList.remove('wbcard-dragging');
  const oldDate = card.dataset.date;
  if (oldDate === newDate) return;
  const dKey   = newDate.replace(/-/g,'');
  const target = document.getElementById(`wbdc-${dKey}`) ?? e.currentTarget.querySelector('.wb-day-cards');
  if (target) { target.appendChild(card); card.dataset.date = newDate; }
  wbUpdateDayTotal(oldDate);
  wbUpdateDayTotal(newDate);
  try {
    const newDateOnly = newDate; // ISO yyyy-MM-dd
    await fetch('/Logs/EditLog', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ id, date: newDateOnly }),
    });
    showToast(`✓ Moved to ${new Date(newDate+'T12:00').toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric'})}`);
  } catch { showErr('Could not save move.'); }
}

// ── Input helpers ─────────────────────────────────────────────────────────
function wbKeydown(e) {
  if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); wbSend(); }
}
function wbAutosize(el) {
  el.style.height = 'auto';
  el.style.height = Math.min(el.scrollHeight, 120) + 'px';
}
function wbSendChip(text) {
  inp.value = text; wbAutosize(inp); inp.focus(); wbSend();
}

// ── Main send ─────────────────────────────────────────────────────────────
async function wbSend() {
  const text = inp.value.trim();
  if (!text) return;

  inp.value = ''; wbAutosize(inp);
  inp.disabled = true; sendBtn.disabled = true;
  histSave('user', text);
  setStatus('typing');
  const intent = detectIntent(text);
  switch (intent) {
    case 'standup':   await handleStandup();          break;
    case 'today':     await handleToday();            break;
    case 'week':      await handleWeek();             break;
    case 'date':      await handleDateQuery(text);    break;
    case 'share':     handleShare();                  break;
    case 'recurring': handleRecurring();              break;
    case 'history':   handleHistory();                break;
    case 'help':      handleHelp();                   break;
    default:          await handleLog(text);          break;
  }

  inp.disabled = false; sendBtn.disabled = false; inp.focus();
}

// ── Intent detection ──────────────────────────────────────────────────────
function detectIntent(text) {
  const t = text.toLowerCase().trim();
  if (/\b(standup|stand[- ]up|daily update|scrum|morning update|generate.*standup|my standup)\b/.test(t)) return 'standup';
  // Date checks BEFORE 'today' so "what did I work on last Thursday?" routes correctly
  if (/\byesterday\b/.test(t)) return 'date';
  if (/\blast\s+(monday|tuesday|wednesday|thursday|friday|saturday|sunday)\b/.test(t)) return 'date';
  if (/\b(show|what did i|entries|logs? for|work on|worked on)\b.*\b(monday|tuesday|wednesday|thursday|friday|saturday|sunday|jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)\b/.test(t)) return 'date';
  if (/\bon\s+(monday|tuesday|wednesday|thursday|friday|saturday|sunday)\b/.test(t)) return 'date';
  if (/^(today\??|what (did|have) i|show.*today|my.*log|log.*today|done today)/.test(t) || t === 'today') return 'today';
  if (/\b(this week|weekly|show.*week|week.*stat|how.*week|week.*hour)\b/.test(t)) return 'week';
  if (/\b(share|post to|linkedin|twitter|social media)\b/.test(t)) return 'share';
  if (/\b(recurring|repeat|daily|scheduled|template)\b/.test(t)) return 'recurring';
  if (/^(\?|help|what can|commands|how to use|\/help)/.test(t)) return 'help';
  if (/\b(history|conversation|chat log|clear history|past messages|session summary|summarize.*session)\b/.test(t)) return 'history';
  return 'log';
}

// ── Log handler — adds cards to board ────────────────────────────────────
async function handleLog(text) {
  let logText = text;

  if (wbAiFix) {
    setStatus('typing');
    try {
      const fr = await fetch('/Logs/FixText', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ text }),
      });
      if (fr.ok) {
        const { result } = await fr.json();
        if (result && result.trim().toLowerCase() !== text.toLowerCase()) {
          logText = result.trim();
          setStatus(`✨ AI understood: "${logText}"`);
          await delay(700);
        }
      }
    } catch {}
  }

  setStatus('typing');
  try {
    const res = await fetch('/Logs/ChatLog', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ text: logText }),
    });

    if (!res.ok) {
      const err = await res.json().catch(() => ({}));
      setStatus(`⚠ ${err.error ?? 'Something went wrong.'}`, true);
      return;
    }

    const data = await res.json();
    const dateIso = toIso(new Date());
    wbAddCards(data.entries.map(e => ({ ...e, date: dateIso })), dateIso);

    // Update sidebar today hours live
    WB.todayHours += Number(data.total);
    const todayEl = document.querySelector('.wb-qs-num');
    if (todayEl) todayEl.textContent = WB.todayHours + 'h';

    const n = data.entries.length;
    setStatus(`✅ Added ${n} card${n!==1?'s':''} — ${WB.todayHours.toFixed(1)}h today`);
    showToast(`✓ ${n} card${n!==1?'s':''} added!`);
    histSave('user', text);
    histSave('bot', `Logged: ${data.entries.map(e=>e.description).join(', ')}`);

  } catch {
    setStatus('⚠ Network error. Please try again.', true);
  }
}

// ── Today / Week handlers → modal ────────────────────────────────────────
async function handleToday() {
  if (!WB.todayLogs.length) {
    setStatus("Nothing logged yet today — tell me what you worked on!");
    return;
  }
  const total = WB.todayLogs.reduce((s, e) => s + Number(e.hours), 0);
  const rows = WB.todayLogs.map(e =>
    `<div class="wb-entry-row">
      <span class="wb-entry-dot" style="background:${CAT_COLORS[e.category]??'#94a3b8'}"></span>
      <span class="wb-entry-desc">${escHtml(e.description)}</span>
      <span class="wb-entry-proj">${escHtml(e.project)}</span>
      <span class="wb-entry-hrs">${e.hours}h</span>
    </div>`
  ).join('');
  wbShowModal(`📋 Today — ${total.toFixed(1)}h total`, `<div class="wb-entries">${rows}</div>`);
}

async function handleWeek() {
  const maxH = Math.max(...WB.weekDays.map(d => d.hours), 1);
  const bars = WB.weekDays.map(d => {
    const w = Math.round(d.hours / maxH * 100);
    const color = d.isToday ? 'var(--accent)' : d.hours > 0 ? 'var(--accent-2)' : 'var(--line)';
    return `<div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
      <span style="width:30px;font-size:11px;color:${d.isToday?'var(--accent)':'var(--muted)'};font-weight:${d.isToday?700:400};flex-shrink:0">${escHtml(d.name)}</span>
      <div style="flex:1;height:8px;border-radius:99px;background:var(--line);overflow:hidden">
        <div style="width:${w}%;height:100%;border-radius:99px;background:${color}"></div>
      </div>
      <span style="font-size:12px;font-weight:${d.isToday?700:500};color:${d.isToday?'var(--accent)':'var(--text)'};width:36px;flex-shrink:0;text-align:right">${escHtml(d.formatted)}</span>
    </div>`;
  }).join('');
  const streak = WB.streak > 1 ? `<div style="margin-top:12px;font-size:13px;color:var(--muted)">🔥 ${WB.streak}-day logging streak — keep it up!</div>` : '';
  wbShowModal(
    `📊 This week — ${escHtml(WB.weekTotal)} / ${WB.weekGoal}h (${WB.weekPct}%)`,
    `<div>${bars}</div>${streak}`
  );
}

// ── Standup generator ─────────────────────────────────────────────────────
async function handleStandup() {
  setStatus('typing');
  try {
    const res = await fetch('/Logs/AiSummary', { method:'POST' });
    let body = '';
    if (res.ok) {
      const { result } = await res.json();
      body = result;
    } else {
      if (!WB.todayLogs.length) {
        setStatus("Nothing logged today yet — log some work first and I'll write your standup!");
        return;
      }
      body = buildFallbackStandup();
    }
    const sid = 'wbsu' + Date.now();
    wbShowModal('📋 Daily Standup',
      `<div style="padding:10px 12px;background:var(--bg);border-radius:8px;border-left:3px solid var(--accent);font-size:13px;line-height:1.65;white-space:pre-wrap;margin-bottom:10px" id="${sid}">${escHtml(body)}</div>` +
      `<button class="wb-standup-copy" onclick="wbCopyStandup('${sid}')">📋 Copy to clipboard</button>`
    );
    setStatus('✅ Standup ready — copy and paste to Slack/Teams!');
    histSave('bot', body.slice(0, 200));
  } catch {
    setStatus('⚠ Could not generate standup — log some work first or check Ollama.', true);
  }
}

function buildFallbackStandup() {
  const items = WB.todayLogs.map(e => `• ${e.description} (${e.hours}h)`).join('\n');
  const total = WB.todayLogs.reduce((s, e) => s + Number(e.hours), 0);
  return `What I worked on today:\n${items}\n\nTotal: ${total.toFixed(1)}h\nBlockers: None`;
}

function wbCopyStandup(id) {
  const el = document.getElementById(id);
  if (!el) return;
  const text = el.textContent ?? el.innerText;
  navigator.clipboard?.writeText(text).catch(() => {
    const ta = document.createElement('textarea');
    ta.value = text; ta.style.cssText = 'position:fixed;opacity:0';
    document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove();
  });
  showToast('✓ Standup copied!');
}

// ── Date query handler ────────────────────────────────────────────────────
async function handleDateQuery(text, isoDate = null) {
  const dateStr = isoDate ?? parseNaturalDate(text);
  if (!dateStr) {
    setStatus("I couldn't figure out which date. Try 'show me June 10', 'yesterday', 'last Friday', or use the 🗓 chip.", true);
    return;
  }
  setStatus('typing');
  try {
    const res = await fetch(`/Logs/DateLogs?date=${encodeURIComponent(dateStr)}`);
    if (!res.ok) { setStatus('Could not load logs for that date.', true); return; }
    const data = await res.json();
    if (!data.entries.length) {
      wbShowModal(`📅 ${data.date}`, `<span style="color:var(--muted);font-size:13px">Nothing logged on this day.</span>`);
      setStatus(`No logs found for ${data.date}`);
      return;
    }
    const rows = data.entries.map(e =>
      `<div class="wb-entry-row">
        <span class="wb-entry-dot" style="background:${CAT_COLORS[e.category]??'#94a3b8'}"></span>
        <span class="wb-entry-desc">${escHtml(e.description)}</span>
        <span class="wb-entry-proj">${escHtml(e.project)}</span>
        <span class="wb-entry-hrs">${e.hours}h</span>
      </div>`
    ).join('');
    wbShowModal(`📅 ${data.date} — ${data.total}h total`, `<div class="wb-entries">${rows}</div>`);
    setStatus(`Showing logs for ${data.date}`);
  } catch { setStatus('⚠ Network error.', true); }
}

function parseNaturalDate(text) {
  const t = text.toLowerCase().trim();
  const today = new Date();

  if (/\byesterday\b/.test(t)) {
    const d = new Date(today); d.setDate(d.getDate() - 1); return toIso(d);
  }

  const days = ['sunday','monday','tuesday','wednesday','thursday','friday','saturday'];
  for (let i = 0; i < days.length; i++) {
    if (t.includes(days[i])) {
      const d = new Date(today);
      let diff = (today.getDay() - i + 7) % 7;
      if (diff === 0) diff = 7;
      d.setDate(d.getDate() - diff); return toIso(d);
    }
  }

  // "June 10", "Jun 10th", etc.
  const months = ['jan','feb','mar','apr','may','jun','jul','aug','sep','oct','nov','dec'];
  for (let i = 0; i < months.length; i++) {
    const m = t.match(new RegExp(months[i] + '[a-z]*\\s+(\\d{1,2})'));
    if (m) return `${today.getFullYear()}-${String(i+1).padStart(2,'0')}-${String(parseInt(m[1])).padStart(2,'0')}`;
  }

  // ISO or numeric
  const iso = t.match(/(\d{4})-(\d{2})-(\d{2})/);
  if (iso) return `${iso[1]}-${iso[2]}-${iso[3]}`;

  const num = t.match(/(\d{1,2})[\/\-](\d{1,2})(?:[\/\-](\d{2,4}))?/);
  if (num) {
    const y = num[3] ? (parseInt(num[3]) < 100 ? 2000 + parseInt(num[3]) : parseInt(num[3])) : today.getFullYear();
    return `${y}-${String(parseInt(num[1])).padStart(2,'0')}-${String(parseInt(num[2])).padStart(2,'0')}`;
  }

  return null;
}

function toIso(d) {
  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
}

// ── Date picker chip ──────────────────────────────────────────────────────
function wbOpenDatePicker() {
  const dp = document.getElementById('wbDatePick');
  dp.style.pointerEvents = 'auto';
  dp.value = toIso(new Date());
  dp.focus(); dp.click();
  setTimeout(() => { dp.style.pointerEvents = 'none'; }, 2000);
}

function wbDatePicked(val) {
  if (!val) return;
  document.getElementById('wbDatePick').value = '';
  const label = new Date(val + 'T12:00:00').toLocaleDateString('en-US', { weekday:'long', month:'long', day:'numeric' });
  setStatus(`Showing logs for ${label}…`);
  inp.disabled = true; sendBtn.disabled = true;
  handleDateQuery(null, val).then(() => { inp.disabled = false; sendBtn.disabled = false; inp.focus(); });
}

// ── Conversation history ──────────────────────────────────────────────────
function handleHistory() {
  const h = histLoad();
  const t = inp.value.toLowerCase();
  if (/clear/.test(t)) {
    histClear();
    setStatus('✓ Conversation history cleared.');
    return;
  }
  if (!h.length) {
    setStatus("No conversation history yet. Everything you type here is saved automatically.");
    return;
  }
  const byDay = {};
  h.slice(-60).forEach(m => {
    const day = new Date(m.ts).toLocaleDateString('en-US', { weekday:'short', month:'short', day:'numeric' });
    if (!byDay[day]) byDay[day] = [];
    byDay[day].push(m);
  });
  const days = Object.entries(byDay).slice(-7);
  let html = '';
  days.forEach(([day, msgs]) => {
    html += `<div style="margin-bottom:6px;font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.5px">${day}</div>`;
    msgs.forEach(m => {
      const isUser = m.role === 'user';
      html += `<div style="margin-bottom:4px;font-size:12.5px;padding:4px 8px;border-radius:6px;background:${isUser?'var(--accent-bg)':'var(--bg)'};color:${isUser?'var(--accent)':'var(--text-2)'}">
        <span style="font-weight:600;margin-right:6px">${isUser?'You':'Bot'}:</span>${escHtml(m.text.slice(0,140))}${m.text.length>140?'…':''}
      </div>`;
    });
    html += '<div style="height:6px"></div>';
  });
  html += `<div style="margin-top:6px;display:flex;gap:8px">
    <button onclick="wbExportHistory()" style="font-size:12px;color:var(--accent);background:none;border:1px solid var(--accent);border-radius:6px;padding:3px 10px;cursor:pointer;font-family:var(--font)">📥 Export</button>
    <button onclick="histClear();wbCloseModal();setStatus('✓ History cleared.')" style="font-size:12px;color:var(--muted);background:none;border:1px solid var(--line);border-radius:6px;padding:3px 10px;cursor:pointer;font-family:var(--font)">🗑 Clear</button>
  </div>`;
  wbShowModal(`📖 History (${h.length} messages)`, html);
}

function wbExportHistory() {
  const h = histLoad();
  const lines = h.map(m => {
    const d = new Date(m.ts).toLocaleString();
    return `[${d}] ${m.role === 'user' ? 'You' : 'WorkLog Bot'}: ${m.text}`;
  });
  const blob = new Blob([lines.join('\n')], { type: 'text/plain' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `worklog-chat-history-${toIso(new Date())}.txt`;
  a.click(); URL.revokeObjectURL(a.href);
  showToast('✓ History exported');
}

