// ── Sidebar entry edit ────────────────────────────────────────────────────
function wbStartEdit(id) {
  document.getElementById(`wbtl-${id}`).querySelector('.wb-tl-view').classList.add('hidden');
  document.getElementById(`wbedit-${id}`).classList.remove('hidden');
  document.querySelector(`#wbedit-${id} .wb-tl-idesc`)?.focus();
}
function wbCancelEdit(id) {
  document.getElementById(`wbedit-${id}`).classList.add('hidden');
  document.getElementById(`wbtl-${id}`).querySelector('.wb-tl-view').classList.remove('hidden');
}
async function wbSaveEdit(id) {
  const wrap = document.getElementById(`wbedit-${id}`);
  const desc = wrap.querySelector('.wb-tl-idesc').value.trim();
  const hrs  = parseFloat(wrap.querySelector('.wb-tl-ihrs').value);
  const cat  = wrap.querySelector('.wb-tl-icat').value;
  if (!desc || isNaN(hrs) || hrs <= 0) { showErr('Description and hours are required.'); return; }
  try {
    const res = await fetch('/Logs/EditLog', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ id, description: desc, hours: hrs, category: cat }),
    });
    if (res.ok) location.reload();
    else showErr('Could not save — try again.');
  } catch { showErr('Network error.'); }
}

