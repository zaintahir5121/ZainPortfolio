@model WorkLogApp.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "WorkLog Today";
    var todayLogs = Model.Logs.Where(l => l.Date == DateOnly.FromDateTime(DateTime.Today)).ToList();
    var maxDayH   = Model.WeekDays.Count > 0 ? Model.WeekDays.Max(d => d.Hours) : 1m;
    if (maxDayH == 0) maxDayH = 1m;
    // Share card week range
    var dowShare  = (int)DateTime.Today.DayOfWeek;
    var monShare  = DateTime.Today.AddDays(dowShare == 0 ? -6 : -(dowShare - 1));
    var sunShare  = monShare.AddDays(6);
    var weekLabel = $"{monShare:MMM d} – {sunShare:MMM d, yyyy}";
    var weekShort = $"{monShare:MMM d} – {sunShare:MMM d}";
}

<!-- ── Two-column today layout ──────────────────────────────────────────── -->
<div class="tl-layout">

  <!-- ════ LEFT: Daily input ════════════════════════════════════════════ -->
  <div class="tl-main">

    <!-- Greeting -->
    <div class="tl-greet">
      <h1 class="tl-hi">Hi @Model.FirstName! What did you work on today?</h1>
      <p class="tl-sub">Type a summary, speak, or tap a quick-log below.</p>
    </div>

    <!-- Quick-log chips -->
    <div class="ql-chips">
      <button class="ql-chip" onclick="quickLog('Morning standup','Meeting',0.25)">☕ Standup <span>15m</span></button>
      <button class="ql-chip" onclick="quickLog('Team meeting','Meeting',1)">💬 Meeting <span>1h</span></button>
      <button class="ql-chip" onclick="quickLog('Code review','Code Review',1)">🔍 Review <span>1h</span></button>
      <button class="ql-chip" onclick="quickLog('Bug fixing','Development',2)">🐛 Bug fix <span>2h</span></button>
      <button class="ql-chip" onclick="quickLog('Writing documentation','Documentation',1)">📝 Docs <span>1h</span></button>
      <button class="ql-chip" onclick="quickLog('Deployment','DevOps',0.5)">🚀 Deploy <span>30m</span></button>
    </div>

    <!-- Input card -->
    <div class="tl-input-card">
      <textarea id="dayInput" class="tl-textarea"
                placeholder="e.g. Fixed payment API bugs for 2h, attended sprint planning for 1h, reviewed pull requests for 30m…"
                rows="4" autocomplete="off" spellcheck="true"></textarea>

      <div class="tl-input-foot">
        <button id="voiceBtn" class="tl-voice-btn" title="Start voice input">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 1a4 4 0 0 1 4 4v6a4 4 0 0 1-8 0V5a4 4 0 0 1 4-4zm-6 10a6 6 0 0 0 12 0h2a8 8 0 0 1-7 7.93V21h-2v-2.07A8 8 0 0 1 4 11z"/>
          </svg>
          Voice
        </button>
        <div class="tl-input-right">
          <span id="autoHint" class="tl-char-count"></span>
          <button id="parseBtn" class="tl-parse-btn" disabled>
            <span id="parseBtnIcon">✦</span> <span id="parseBtnText">Parse with AI</span>
          </button>
        </div>
      </div>

      <!-- Voice waveform -->
      <div id="voiceWave" class="tl-wave hidden">
        <div class="wave-bars">
          <span></span><span></span><span></span><span></span><span></span>
          <span></span><span></span><span></span><span></span><span></span>
        </div>
        <small>Listening…</small>
      </div>

      <!-- Processing indicator -->
      <div id="processing" class="tl-processing hidden">
        <div class="proc-dots"><span></span><span></span><span></span></div>
        <span>AI is processing your work…</span>
      </div>
    </div>

    <!-- AI Summary (shown after parse) -->
    <div id="aiSummary" class="tl-summary hidden">
      <div class="ts-head">
        <div class="ts-head-left">
          <span class="ts-star">✦</span>
          <span class="ts-title">AI Summary</span>
          <span class="ts-subtitle">Review and edit before saving</span>
        </div>
        <button class="ts-clear-btn" onclick="clearSummary()">✕ Clear</button>
      </div>

      <div id="parsedList" class="ts-list"></div>

      <div class="ts-footer">
        <div class="ts-total">Total Time: <strong id="totalTime">0h</strong></div>
        <button id="sendBtn" class="tl-send-btn">Send Work Log →</button>
      </div>
      <p class="ts-privacy">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" style="margin-right:4px">
          <path d="M12 1L3 5v6c0 5.25 3.75 10.15 9 11.35C17.25 21.15 21 16.25 21 11V5z"/>
        </svg>
        Your data is private and secure. Powered by Ollama (Local AI)
      </p>
    </div>

    <!-- Today's saved entries -->
    @if (todayLogs.Any())
    {
      <div class="tl-today-saved">
        <div class="tts-head">
          <span class="tts-title">Today's log</span>
          <span class="tts-badge">@todayLogs.Sum(l => l.Hours)h logged</span>
        </div>
        <div class="tts-cards" id="logCards">
          @foreach (var log in todayLogs)
          {
            <div class="tts-card" id="lc-@log.Id" data-id="@log.Id">
              <!-- View mode -->
              <div class="tts-card-view">
                <div class="tts-card-left">
                  <span class="tts-dot" style="background:@CategoryColor(log.Tags)"></span>
                  <div class="tts-card-body">
                    <span class="tts-desc">@log.Description</span>
                    <div class="tts-card-meta">
                      @if (!string.IsNullOrWhiteSpace(log.Project))
                      {
                        <span class="tts-proj">@log.Project</span>
                      }
                      @if (!string.IsNullOrWhiteSpace(log.Tags))
                      {
                        <span class="tts-cat-pill" style="background:@CategoryColorBg(log.Tags);color:@CategoryColor(log.Tags)">@log.Tags</span>
                      }
                    </div>
                  </div>
                </div>
                <div class="tts-card-right">
                  <span class="tts-hrs">@log.Hours h</span>
                  <button class="tts-edit-btn" onclick="startEdit(@log.Id)" title="Edit">✏️</button>
                  <form asp-action="Delete" method="post" class="tts-del-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@log.Id">
                    <button type="submit" class="tts-del-btn" title="Delete">×</button>
                  </form>
                </div>
              </div>
              <!-- Edit mode (hidden by default) -->
              <div class="tts-card-edit hidden" id="edit-@log.Id">
                <div class="tce-row">
                  <input type="text" class="tce-inp tce-desc" value="@log.Description" placeholder="Description">
                  <input type="number" class="tce-inp tce-hrs" value="@log.Hours" step="0.25" min="0.25" max="24" placeholder="hrs">
                </div>
                <div class="tce-row">
                  <input type="text" class="tce-inp tce-proj" value="@log.Project" placeholder="Project">
                  <select class="tce-inp tce-cat">
                    @foreach (var cat in new[]{"Development","Meeting","Code Review","Testing","Documentation","DevOps","Research","Design","Other"})
                    {
                      <option value="@cat" @(log.Tags == cat ? "selected" : "")>@cat</option>
                    }
                  </select>
                </div>
                <div class="tce-actions">
                  <button type="button" class="tce-save-btn" onclick="saveEdit(@log.Id)">Save</button>
                  <button type="button" class="tce-cancel-btn" onclick="cancelEdit(@log.Id)">Cancel</button>
                </div>
              </div>
            </div>
          }
        </div>
      </div>
    }

  </div>

  <!-- ════ RIGHT: Sidebar ═══════════════════════════════════════════════ -->
  <div class="tl-sidebar">

    <!-- This Week -->
    <div class="tl-card">
      <div class="tlc-head">
        <span class="tlc-title">This Week</span>
        <a asp-controller="Timesheet" asp-action="Index" class="tlc-action" title="View full timesheet">📅</a>
      </div>
      <div class="week-days">
        @foreach (var day in Model.WeekDays)
        {
          <div class="wd-row @(day.IsToday ? "wd-today" : "") @(day.IsFuture ? "wd-future" : "")">
            <span class="wd-name">@day.Name</span>
            <div class="wd-bar-track">
              @if (!day.IsFuture && day.Hours > 0)
              {
                <div class="wd-bar" style="width:@((day.Hours / maxDayH * 100).ToString("F0"))%"></div>
              }
            </div>
            <span class="wd-hours">@day.Formatted</span>
          </div>
        }
      </div>
      <div class="week-total-row">
        <span class="wtr-lbl">Total</span>
        <span class="wtr-hrs">@Model.WeekTotalFormatted</span>
      </div>
    </div>

    <!-- Weekly Progress -->
    <div class="tl-card">
      <div class="tlc-head">
        <span class="tlc-title">Weekly Progress</span>
        <span class="tlc-goal">@((int)Model.WeekGoal)h goal</span>
      </div>
      <div class="prog-ring-wrap">
        <svg width="140" height="140" viewBox="0 0 120 120" class="prog-svg">
          <circle cx="60" cy="60" r="50" fill="none" stroke="var(--line)" stroke-width="9"/>
          <circle cx="60" cy="60" r="50" fill="none"
                  stroke="@(Model.WeekPctInt >= 100 ? "#10b981" : Model.WeekPctInt >= 50 ? "#6366f1" : "#f59e0b")"
                  stroke-width="9" stroke-linecap="round"
                  stroke-dasharray="314.159"
                  stroke-dashoffset="@Model.SvgOffset.ToString("F1")"
                  transform="rotate(-90 60 60)"/>
        </svg>
        <div class="prog-inner">
          <div class="prog-pct">@Model.WeekPctInt<span class="prog-sym">%</span></div>
          <div class="prog-hrs">@Model.WeekTotalFormatted</div>
          <div class="prog-goal-lbl">/ @((int)Model.WeekGoal)h</div>
        </div>
      </div>
      <p class="prog-msg">@Model.ProgressMessage</p>
    </div>

    <!-- AI Insight -->
    <div class="tl-card ai-insight-card" id="insightCard">
      <div class="tlc-head">
        <span class="tlc-title">✦ Your week, in plain English</span>
      </div>
      <p class="ai-insight-text" id="insightText">Loading…</p>
    </div>

    <!-- Export Timesheet -->
    <div class="tl-card">
      <div class="tlc-head">
        <span class="tlc-title">Export Timesheet</span>
      </div>
      <div class="exp-row">
        <a asp-controller="Timesheet" asp-action="ExportCsv" class="exp-btn exp-csv">
          📊 CSV
        </a>
        <a asp-controller="Timesheet" asp-action="Index" class="exp-btn exp-view">
          📄 View
        </a>
        <a asp-controller="Timesheet" asp-action="ExportCsv" class="exp-btn exp-xl">
          ⬇️ Excel
        </a>
      </div>
    </div>

    <!-- Quick stats -->
    <div class="tl-card">
      <div class="qs-row">
        <div class="qs-stat">
          <span class="qs-num">@Model.Streak</span>
          <span class="qs-lbl">day streak 🔥</span>
        </div>
        <div class="qs-div"></div>
        <div class="qs-stat">
          <span class="qs-num">@Model.TodayHours h</span>
          <span class="qs-lbl">today</span>
        </div>
        <div class="qs-div"></div>
        <div class="qs-stat">
          <span class="qs-num">@Model.ProjectsCount</span>
          <span class="qs-lbl">projects</span>
        </div>
      </div>
    </div>

    <!-- Share your week -->
    <div class="tl-card share-cta-card">
      <div class="share-cta-inner">
        <div class="share-cta-icon">✦</div>
        <div>
          <div class="share-cta-title">Share your week</div>
          <div class="share-cta-sub">Post your progress to LinkedIn, Instagram &amp; more</div>
        </div>
      </div>
      <button class="share-cta-btn" onclick="openShareModal()">Create share card →</button>
    </div>

  </div>
</div>

<!-- ══ SHARE MODAL ═══════════════════════════════════════════════════════════ -->
<div id="shareModal" class="sm-overlay hidden" onclick="if(event.target===this)closeShareModal()">
  <div class="sm-panel">
    <div class="sm-header">
      <span class="sm-title">Share your week</span>
      <button class="sm-close" onclick="closeShareModal()">✕</button>
    </div>

    <!-- The card that gets captured -->
    <div class="sm-card-wrap">
      <div id="shareCard" class="sc-card">
        <div class="sc-top">
          <span class="sc-logo">worklog<span>.</span></span>
          <span class="sc-week">Week of @weekLabel</span>
        </div>

        <div class="sc-name">@Model.FirstName's work week</div>

        <div class="sc-stats">
          <div class="sc-stat">
            <span class="sc-num">@Model.WeekTotalFormatted</span>
            <span class="sc-lbl">logged</span>
          </div>
          <div class="sc-div"></div>
          <div class="sc-stat">
            <span class="sc-num">@Model.Streak</span>
            <span class="sc-lbl">day streak 🔥</span>
          </div>
          <div class="sc-div"></div>
          <div class="sc-stat">
            <span class="sc-num">@Model.ProjectsCount</span>
            <span class="sc-lbl">projects</span>
          </div>
        </div>

        <!-- Progress bar -->
        <div class="sc-prog-wrap">
          <div class="sc-prog-bar">
            <div class="sc-prog-fill" style="width:@Math.Min(100,Model.WeekPctInt)%"></div>
          </div>
          <span class="sc-prog-lbl">@Model.WeekPctInt% of weekly goal</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.TopProject))
        {
          <div class="sc-top-proj">
            <span class="sc-proj-dot"></span>
            Top project: <strong>@Model.TopProject</strong>
            <span class="sc-proj-hrs">@Model.TopProjectHours h</span>
          </div>
        }

        <div class="sc-msg">@Model.ProgressMessage</div>

        <div class="sc-footer">Tracked with worklog · worklog.app</div>
      </div>
    </div>

    <!-- Share actions -->
    <div class="sm-actions">
      <button class="sm-btn sm-li" onclick="shareLinkedIn()">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        LinkedIn
      </button>
      <button class="sm-btn sm-fb" onclick="shareFacebook()">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        Facebook
      </button>
      <button class="sm-btn sm-tw" onclick="shareTwitter()">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.737-8.835L1.254 2.25H8.08l4.259 5.63 5.905-5.63zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        X / Twitter
      </button>
      <button class="sm-btn sm-ig" onclick="downloadCard()">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
        Download for Instagram
      </button>
    </div>

    <!-- LinkedIn copy box -->
    <div id="liCopyBox" class="sm-copy-box hidden">
      <p class="sm-copy-label">Copy this text, then paste into your LinkedIn post:</p>
      <textarea id="liCopyText" class="sm-copy-ta" readonly></textarea>
      <button class="sm-copy-btn" onclick="copyLinkedInText()">📋 Copy to clipboard</button>
      <span id="copiedConfirm" class="sm-copied hidden">✓ Copied!</span>
    </div>

  </div>
</div>

@functions {
    static string CategoryColor(string cat) => cat switch {
        "Development"   => "#3b82f6",
        "Meeting"       => "#f59e0b",
        "Code Review"   => "#10b981",
        "Testing"       => "#8b5cf6",
        "Documentation" => "#06b6d4",
        "DevOps"        => "#ef4444",
        "Research"      => "#6366f1",
        "Design"        => "#ec4899",
        _               => "#94a3b8",
    };
    static string CategoryColorBg(string cat) => cat switch {
        "Development"   => "#dbeafe",
        "Meeting"       => "#fef3c7",
        "Code Review"   => "#d1fae5",
        "Testing"       => "#ede9fe",
        "Documentation" => "#cffafe",
        "DevOps"        => "#fee2e2",
        "Research"      => "#e0e7ff",
        "Design"        => "#fce7f3",
        _               => "#f1f5f9",
    };
}

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" defer></script>
<script>
const CAT_COLORS = {
  'Development':'#3b82f6','Meeting':'#f59e0b','Code Review':'#10b981',
  'Testing':'#8b5cf6','Documentation':'#06b6d4','DevOps':'#ef4444',
  'Research':'#6366f1','Design':'#ec4899','Other':'#94a3b8',
};
const CAT_BG = {
  'Development':'#dbeafe','Meeting':'#fef3c7','Code Review':'#d1fae5',
  'Testing':'#ede9fe','Documentation':'#cffafe','DevOps':'#fee2e2',
  'Research':'#e0e7ff','Design':'#fce7f3','Other':'#f1f5f9',
};

let parsedEntries = [];
let autoParseTimer = null;

const dayInput   = document.getElementById('dayInput');
const parseBtn   = document.getElementById('parseBtn');
const processing = document.getElementById('processing');
const aiSummary  = document.getElementById('aiSummary');
const parsedList = document.getElementById('parsedList');
const totalTime  = document.getElementById('totalTime');
const sendBtn    = document.getElementById('sendBtn');
const voiceBtn   = document.getElementById('voiceBtn');
const voiceWave  = document.getElementById('voiceWave');
const autoHint   = document.getElementById('autoHint');

// Auto-parse: trigger 2.5 seconds after typing stops
dayInput.addEventListener('input', () => {
  const len = dayInput.value.trim().length;
  parseBtn.disabled = len < 8;
  clearTimeout(autoParseTimer);
  if (len >= 15) {
    autoHint.textContent = 'parsing in 2s…';
    autoParseTimer = setTimeout(() => { autoHint.textContent = ''; parseDay(); }, 2500);
  } else {
    autoHint.textContent = '';
  }
});

parseBtn.addEventListener('click', () => { clearTimeout(autoParseTimer); autoHint.textContent = ''; parseDay(); });

async function parseDay() {
  const text = dayInput.value.trim();
  if (text.length < 5) return;

  parseBtn.disabled = true;
  document.getElementById('parseBtnText').textContent = 'Parsing…';
  document.getElementById('parseBtnIcon').textContent = '⏳';
  processing.classList.remove('hidden');
  aiSummary.classList.add('hidden');

  try {
    const res = await fetch('/Logs/ParseDay', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ text }),
    });
    if (!res.ok) { const e = await res.json().catch(()=>({})); showErr(e.error ?? 'Parse failed — is Ollama running?'); return; }
    parsedEntries = await res.json();
    renderSummary();
  } catch { showErr('Network error — check Ollama is running on port 11434.'); }
  finally {
    parseBtn.disabled = false;
    document.getElementById('parseBtnText').textContent = 'Parse with AI';
    document.getElementById('parseBtnIcon').textContent = '✦';
    processing.classList.add('hidden');
  }
}

// Quick-log: one-click instant save
async function quickLog(description, category, hours) {
  try {
    const res = await fetch('/Logs/BulkAdd', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ entries: [{ description, category, hours, project: category }] }),
    });
    if (res.ok) {
      showToast(`✓ ${description} logged`);
      setTimeout(() => window.location.reload(), 800);
    } else { showErr('Could not log — please try again.'); }
  } catch { showErr('Network error.'); }
}

function renderSummary() {
  parsedList.innerHTML = '';
  parsedEntries.forEach((e, i) => {
    const bg  = CAT_BG[e.category]    ?? CAT_BG.Other;
    const col = CAT_COLORS[e.category] ?? CAT_COLORS.Other;
    const h = Math.floor(e.hours), m = Math.round((e.hours-h)*60);
    const timeStr = h>0&&m>0?`${h}h ${m}m`:h>0?`${h}h`:`${m}m`;

    const row = document.createElement('div');
    row.className = 'ts-entry';
    row.innerHTML = `
      <span class="ts-dot" style="background:${col}"></span>
      <div class="ts-body">
        <span class="ts-desc" contenteditable="true" data-i="${i}" data-f="desc">${escHtml(e.description)}</span>
        <span class="ts-badge" style="background:${bg};color:${col}">${e.category}</span>
      </div>
      <span class="ts-time" contenteditable="true" data-i="${i}" data-f="hours">${timeStr}</span>
      <button class="ts-del" data-i="${i}">×</button>
    `;
    parsedList.appendChild(row);
  });

  parsedList.querySelectorAll('[contenteditable]').forEach(el => el.addEventListener('blur', onEdit));
  parsedList.querySelectorAll('.ts-del').forEach(btn => btn.addEventListener('click', () => {
    parsedEntries.splice(+btn.dataset.i, 1); renderSummary();
  }));
  updateTotal();
  aiSummary.classList.remove('hidden');
}

function onEdit(ev) {
  const i = +ev.target.dataset.i, f = ev.target.dataset.f, v = ev.target.textContent.trim();
  if (f === 'desc') { parsedEntries[i].description = v; }
  else {
    const h = v.match(/(\d+(?:\.\d+)?)\s*h/i)?.[1];
    const m = v.match(/(\d+)\s*m/i)?.[1];
    if (h||m) parsedEntries[i].hours = parseFloat(h??0) + parseInt(m??0)/60;
    else { const n=parseFloat(v); if(!isNaN(n)) parsedEntries[i].hours=n; }
    updateTotal();
  }
}

function updateTotal() {
  const tot = parsedEntries.reduce((s,e)=>s+(e.hours||0),0);
  const h=Math.floor(tot), m=Math.round((tot-h)*60);
  totalTime.textContent = h>0&&m>0?`${h}h ${m}m`:h>0?`${h}h`:`${m}m`;
}

window.clearSummary = () => {
  parsedEntries=[]; aiSummary.classList.add('hidden');
  dayInput.value=''; charCount.textContent='0 words'; parseBtn.disabled=true;
};

sendBtn.addEventListener('click', async () => {
  if (!parsedEntries.length) return;
  sendBtn.disabled=true; sendBtn.textContent='Saving…';
  try {
    const res = await fetch('/Logs/BulkAdd', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ entries: parsedEntries }),
    });
    if (res.ok) { window.location.reload(); }
    else { const e=await res.json().catch(()=>({})); showErr(e.error??'Save failed'); sendBtn.disabled=false; sendBtn.textContent='Send Work Log →'; }
  } catch { showErr('Network error'); sendBtn.disabled=false; sendBtn.textContent='Send Work Log →'; }
});

// Voice
let rec;
voiceBtn.addEventListener('click', () => {
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (!SR) { showErr('Voice not supported in this browser.'); return; }
  if (!rec) {
    rec = new SR(); rec.continuous=true; rec.interimResults=true; rec.lang='en-US';
    let base='';
    rec.onresult = ev => {
      let interim='';
      for (let i=ev.resultIndex;i<ev.results.length;i++) {
        if (ev.results[i].isFinal) base+=ev.results[i][0].transcript+' ';
        else interim+=ev.results[i][0].transcript;
      }
      dayInput.value=base+interim; dayInput.dispatchEvent(new Event('input'));
    };
    rec.onend=()=>{ voiceBtn.classList.remove('voice-on'); voiceWave.classList.add('hidden'); };
  }
  if (voiceBtn.classList.contains('voice-on')) { rec.stop(); }
  else { rec.start(); voiceBtn.classList.add('voice-on'); voiceWave.classList.remove('hidden'); }
});

