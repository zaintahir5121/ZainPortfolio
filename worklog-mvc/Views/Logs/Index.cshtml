function handleHelp() {
  appendBot(
    `<strong>Here's what I can do:</strong>` +
    `<div style="margin-top:12px;display:flex;flex-direction:column;gap:8px;font-size:13px">` +
    `<div><span style="background:var(--accent-bg);color:var(--accent);padding:2px 9px;border-radius:6px;font-size:11.5px;font-weight:600">log work</span> <span style="color:var(--text-2);margin-left:6px">Just describe it: "Fixed auth bug 2h, standup 15min"</span></div>` +
    `<div><span style="background:var(--accent-bg);color:var(--accent);padding:2px 9px;border-radius:6px;font-size:11.5px;font-weight:600">today</span> <span style="color:var(--text-2);margin-left:6px">Show what you've logged today</span></div>` +
    `<div><span style="background:var(--accent-bg);color:var(--accent);padding:2px 9px;border-radius:6px;font-size:11.5px;font-weight:600">this week</span> <span style="color:var(--text-2);margin-left:6px">Week summary with day-by-day breakdown</span></div>` +
    `<div><span style="background:var(--accent-bg);color:var(--accent);padding:2px 9px;border-radius:6px;font-size:11.5px;font-weight:600">share</span> <span style="color:var(--text-2);margin-left:6px">Create a shareable card for LinkedIn, Twitter, Instagram</span></div>` +
    `<div><span style="background:var(--accent-bg);color:var(--accent);padding:2px 9px;border-radius:6px;font-size:11.5px;font-weight:600">recurring</span> <span style="color:var(--text-2);margin-left:6px">Manage auto-logging templates</span></div>` +
    `</div>` +
    `<div style="margin-top:10px;font-size:12px;color:var(--muted)">💡 Tip: Use the 🎤 mic button for voice input on mobile!</div>`
  );
}

// ── Voice input ───────────────────────────────────────────────────────────
const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
let recognition = null, recogActive = false;

function wbToggleVoice() {
  if (!SR) { showToast('Voice input requires Chrome or Safari.'); return; }
  recogActive ? stopVoice() : startVoice();
}

function startVoice() {
  recognition = new SR();
  recognition.continuous = false;
  recognition.interimResults = true;
  recognition.lang = 'en-US';
  recognition.onstart  = () => { recogActive = true;  micBtn.classList.add('wbmic-on'); };
  recognition.onend    = () => stopVoice();
  recognition.onerror  = () => stopVoice();
  recognition.onresult = (e) => {
    const transcript = Array.from(e.results).map(r => r[0].transcript).join('');
    inp.value = transcript; wbAutosize(inp);
    if (e.results[e.results.length - 1].isFinal) stopVoice();
  };
  recognition.start();
}

function stopVoice() {
  recogActive = false;
  micBtn.classList.remove('wbmic-on');
  try { recognition?.stop(); } catch {}
}

