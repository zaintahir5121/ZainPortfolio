// ── Social share ─────────────────────────────────────────────────────────────
function openShareModal()  { document.getElementById('shareModal').classList.remove('hidden'); }
function closeShareModal() { document.getElementById('shareModal').classList.add('hidden'); document.getElementById('liCopyBox').classList.add('hidden'); }

function buildLinkedInText() {
  const name    = @Json.Serialize(Model.FirstName);
  const hrs     = @Json.Serialize(Model.WeekTotalFormatted);
  const streak  = @Model.Streak;
  const proj    = @Model.ProjectsCount;
  const pct     = @Model.WeekPctInt;
  const topProj = @Json.Serialize(Model.TopProject);
  const weekOf  = @Json.Serialize(weekShort);

  let lines = [
    `📊 My work wrap for the week of ${weekOf}:`,
    ``,
    `⏱ ${hrs} logged across ${proj} project${proj===1?'':'s'}`,
    streak > 1 ? `🔥 ${streak}-day logging streak` : null,
    pct >= 100 ? `✅ Hit my weekly goal!` : `📈 ${pct}% of weekly goal reached`,
    topProj ? `🚀 Top project: ${topProj}` : null,
    ``,
    `Tracking my work consistently has changed how I plan, reflect, and grow.`,
    ``,
    `#WorkLog #Productivity #CareerGrowth #WorkLife`,
  ].filter(l => l !== null);

  return lines.join('\n');
}

function shareLinkedIn() {
  document.getElementById('liCopyText').value = buildLinkedInText();
  document.getElementById('liCopyBox').classList.remove('hidden');
  document.getElementById('liCopyBox').scrollIntoView({ behavior:'smooth' });
  // also open LinkedIn in background
  setTimeout(() => window.open('https://www.linkedin.com/feed/', '_blank'), 600);
}

function shareFacebook() {
  const text = encodeURIComponent(buildLinkedInText());
  window.open(`https://www.facebook.com/sharer/sharer.php?quote=${text}&u=https://worklog.app`, '_blank');
}

function shareTwitter() {
  const hrs    = @Json.Serialize(Model.WeekTotalFormatted);
  const streak = @Model.Streak;
  const pct    = @Model.WeekPctInt;
  const t = encodeURIComponent(`📊 This week: ${hrs} logged, ${streak}-day streak, ${pct}% of goal reached. Consistency is everything. #WorkLog #Productivity`);
  window.open(`https://x.com/intent/tweet?text=${t}`, '_blank');
}

function copyLinkedInText() {
  const ta = document.getElementById('liCopyText');
  ta.select();
  navigator.clipboard?.writeText(ta.value).catch(() => document.execCommand('copy'));
  const c = document.getElementById('copiedConfirm');
  c.classList.remove('hidden'); setTimeout(() => c.classList.add('hidden'), 2500);
}

async function downloadCard() {
  if (!window.html2canvas) { showErr('Downloading…'); return; }
  const card = document.getElementById('shareCard');
  try {
    const canvas = await html2canvas(card, { scale:3, useCORS:true, backgroundColor:null });
    const a = document.createElement('a'); a.download='worklog-week.png';
    a.href = canvas.toDataURL('image/png'); a.click();
  } catch { showErr('Could not generate image — try a different browser.'); }
}

function escHtml(s){ return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function showErr(msg) {
  const d=document.createElement('div');
  d.className='toast-wrap toast-err'; d.innerHTML=`<div class="toast">${msg}</div>`;
  document.body.appendChild(d); setTimeout(()=>d.remove(),4500);
}
function showToast(msg) {
  const d=document.createElement('div');
  d.className='toast-wrap toast-ok'; d.innerHTML=`<div class="toast">${msg}</div>`;
  document.body.appendChild(d); setTimeout(()=>d.remove(),3000);
}

// ── Inline log card editing ──────────────────────────────────────────────────
function startEdit(id) {
  document.querySelector(`#lc-${id} .tts-card-view`).classList.add('hidden');
  document.getElementById(`edit-${id}`).classList.remove('hidden');
  document.querySelector(`#edit-${id} .tce-desc`).focus();
}

function cancelEdit(id) {
  document.getElementById(`edit-${id}`).classList.add('hidden');
  document.querySelector(`#lc-${id} .tts-card-view`).classList.remove('hidden');
}

async function saveEdit(id) {
  const wrap = document.getElementById(`edit-${id}`);
  const desc = wrap.querySelector('.tce-desc').value.trim();
  const hrs  = parseFloat(wrap.querySelector('.tce-hrs').value);
  const proj = wrap.querySelector('.tce-proj').value.trim();
  const cat  = wrap.querySelector('.tce-cat').value;

  if (!desc || isNaN(hrs) || hrs <= 0) { showErr('Description and hours are required.'); return; }

  try {
    const res = await fetch('/Logs/EditLog', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ id, description: desc, hours: hrs, project: proj, category: cat }),
    });
    if (res.ok) { window.location.reload(); }
    else { showErr('Could not save — please try again.'); }
  } catch { showErr('Network error.'); }
}
