    `<div><span style="background:var(--accent-bg);color:var(--accent);padding:2px 9px;border-radius:6px;font-size:11.5px;font-weight:600">history</span> <span style="color:var(--text-2);margin-left:6px">View your full conversation history with export · say "clear history" to reset</span></div>` +
    `</div>` +
    `<div style="margin-top:10px;font-size:12px;color:var(--muted)">💡 Use 🎤 for voice · ✏ to edit any entry · 🗓 to browse any date · 📖 "history" to review sessions</div>`
  );
}

// ── Voice input ───────────────────────────────────────────────────────────
const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
let recognition = null, recogActive = false;

function wbToggleVoice() {
  if (!SR) { showToast('Voice input requires Chrome or Safari.'); return; }
  recogActive ? stopVoice() : startVoice();
}
function startVoice() {
  recognition = new SR();
  recognition.continuous = false; recognition.interimResults = true; recognition.lang = 'en-US';
  recognition.onstart  = () => { recogActive = true; micBtn.classList.add('wbmic-on'); };
  recognition.onend    = () => stopVoice();
  recognition.onerror  = () => stopVoice();
  recognition.onresult = (e) => {
    const t = Array.from(e.results).map(r => r[0].transcript).join('');
    inp.value = t; wbAutosize(inp);
    if (e.results[e.results.length-1].isFinal) stopVoice();
  };
  recognition.start();
}
function stopVoice() {
  recogActive = false; micBtn.classList.remove('wbmic-on');
  try { recognition?.stop(); } catch {}
}

// ── Mobile sidebar ────────────────────────────────────────────────────────
function wbToggleSidebar() {
  const sb = document.getElementById('wbSidebar');
  const ov = document.getElementById('wbOverlay');
  sb.classList.toggle('open'); ov.classList.toggle('open');
}
function wbCloseSidebar() {
  document.getElementById('wbSidebar').classList.remove('open');
  document.getElementById('wbOverlay').classList.remove('open');
}

// ── Sidebar entry edit ────────────────────────────────────────────────────
function wbStartEdit(id) {
  document.getElementById(`wbtl-${id}`).querySelector('.wb-tl-view').classList.add('hidden');
  document.getElementById(`wbedit-${id}`).classList.remove('hidden');
  document.querySelector(`#wbedit-${id} .wb-tl-idesc`)?.focus();
}
function wbCancelEdit(id) {
  document.getElementById(`wbedit-${id}`).classList.add('hidden');
  document.getElementById(`wbtl-${id}`).querySelector('.wb-tl-view').classList.remove('hidden');
}
async function wbSaveEdit(id) {
  const wrap = document.getElementById(`wbedit-${id}`);
  const desc = wrap.querySelector('.wb-tl-idesc').value.trim();
  const hrs  = parseFloat(wrap.querySelector('.wb-tl-ihrs').value);
  const cat  = wrap.querySelector('.wb-tl-icat').value;
  if (!desc || isNaN(hrs) || hrs <= 0) { showErr('Description and hours are required.'); return; }
  try {
    const res = await fetch('/Logs/EditLog', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ id, description: desc, hours: hrs, category: cat }),
    });
    if (res.ok) location.reload();
    else showErr('Could not save — try again.');
  } catch { showErr('Network error.'); }
}

// ── Teams sidebar ─────────────────────────────────────────────────────────
async function wbToggleTeams() {
  const card = document.getElementById('wbTeamsCard');
  const visible = card.style.display !== 'none';
  card.style.display = visible ? 'none' : '';
  if (!visible) {
    const wrap = document.getElementById('wbApiKeyWrap');
    try {
      const res = await fetch('/Account/ApiKey');
      if (!res.ok) { wrap.textContent = 'Could not load key.'; return; }
      const { apiKey } = await res.json();
      wrap.innerHTML = `<code style="font-size:10.5px;background:var(--bg);padding:4px 8px;border-radius:6px;display:block;word-break:break-all;font-family:monospace">${escHtml(apiKey)}</code>`;
    } catch { wrap.textContent = 'Error loading key.'; }
  }
}
async function wbRegenerateKey() {
  if (!confirm('Regenerate API key? Your Teams integration will stop working until updated.')) return;
  const tok = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
  try {
    const res = await fetch('/Account/RegenerateKey', { method:'POST', headers:{ 'RequestVerificationToken': tok } });
    if (res.ok) { wbToggleTeams(); wbToggleTeams(); showToast('✓ Key regenerated'); }
    else showErr('Could not regenerate.');
  } catch { showErr('Network error.'); }
}

// ── Weekly Insight ────────────────────────────────────────────────────────
(async () => {
  try {
    const res = await fetch('/Logs/WeeklyInsight');
    if (res.ok) { const { insight } = await res.json(); document.getElementById('wbInsightText').textContent = insight; }
  } catch { document.getElementById('wbInsightText').textContent = 'Log more to see weekly patterns here.'; }
})();

// ── Share modal ───────────────────────────────────────────────────────────
function openShareModal()  { document.getElementById('shareModal').classList.remove('hidden'); }
function closeShareModal() {
  document.getElementById('shareModal').classList.add('hidden');
  document.getElementById('liCopyBox').classList.add('hidden');
}

function buildLinkedInText() {
  const hrs    = @Json.Serialize(Model.WeekTotalFormatted);
  const streak = @Model.Streak;
  const proj   = @Model.ProjectsCount;
  const pct    = @Model.WeekPctInt;
  const topPr  = @Json.Serialize(Model.TopProject);
  const weekOf = @Json.Serialize(weekShort);
  return [
    `📊 My work wrap for the week of ${weekOf}:`, ``,
    `⏱ ${hrs} logged across ${proj} project${proj===1?'':'s'}`,
    streak > 1 ? `🔥 ${streak}-day logging streak` : null,
    pct >= 100 ? `✅ Hit my weekly goal!` : `📈 ${pct}% of weekly goal reached`,
    topPr ? `🚀 Top project: ${topPr}` : null, ``,
    `Tracking my work consistently has changed how I plan, reflect, and grow.`, ``,
    `#WorkLog #Productivity #CareerGrowth #WorkLife`,
  ].filter(l => l !== null).join('\n');
}

function shareLinkedIn() {
  document.getElementById('liCopyText').value = buildLinkedInText();
  document.getElementById('liCopyBox').classList.remove('hidden');
  document.getElementById('liCopyBox').scrollIntoView({ behavior:'smooth' });
  setTimeout(() => window.open('https://www.linkedin.com/feed/', '_blank'), 600);
}
function shareFacebook() {
  window.open(`https://www.facebook.com/sharer/sharer.php?quote=${encodeURIComponent(buildLinkedInText())}&u=https://worklog.app`, '_blank');
}
function shareTwitter() {
  const hrs = @Json.Serialize(Model.WeekTotalFormatted);
  const t   = encodeURIComponent(`📊 This week: ${hrs} logged, @Model.Streak-day streak, @Model.WeekPctInt% of goal. Consistency is everything. #WorkLog #Productivity`);
  window.open(`https://x.com/intent/tweet?text=${t}`, '_blank');
}
function copyLinkedInText() {
  const ta = document.getElementById('liCopyText'); ta.select();
  navigator.clipboard?.writeText(ta.value).catch(() => document.execCommand('copy'));
  const c = document.getElementById('copiedConfirm');
  c.classList.remove('hidden'); setTimeout(() => c.classList.add('hidden'), 2500);
}
async function downloadCard() {
  if (!window.html2canvas) { showErr('Image library still loading…'); return; }
  try {
    const canvas = await html2canvas(document.getElementById('shareCard'), { scale:3, useCORS:true, backgroundColor:null });
    const a = document.createElement('a'); a.download = 'worklog-week.png';
    a.href = canvas.toDataURL('image/png'); a.click();
  } catch { showErr('Could not generate image — try a different browser.'); }
}

// ── Session conversation history (localStorage) ───────────────────────────
const HIST_KEY = 'wbHistory_@Model.FirstName';
const MAX_HIST = 120;

function histLoad() {
  try { return JSON.parse(localStorage.getItem(HIST_KEY) ?? '[]'); } catch { return []; }
}
function histSave(role, text) {
  try {
    const h = histLoad();
    h.push({ role, text, ts: Date.now() });
    if (h.length > MAX_HIST) h.splice(0, h.length - MAX_HIST);
    localStorage.setItem(HIST_KEY, JSON.stringify(h));
  } catch {}
}
function histSummary() {
  const h = histLoad();
  if (!h.length) return "No conversation history yet. Start chatting and I'll remember everything!";
  const lines = h.slice(-50).map(m => {
    const d = new Date(m.ts).toLocaleDateString('en-US', { month:'short', day:'numeric' });
    return `[${d}] ${m.role === 'user' ? 'You' : 'Bot'}: ${m.text.slice(0, 120)}`;
  });
  return `Last ${lines.length} messages:\n\n${lines.join('\n')}`;
}
function histClear() {
  localStorage.removeItem(HIST_KEY);
  showToast('✓ Conversation history cleared');
}

// Auto-save bot replies happens inside appendBot (defined below) via histSave

// ── Utils ─────────────────────────────────────────────────────────────────
function delay(ms) { return new Promise(r => setTimeout(r, ms)); }
function escHtml(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function showErr(msg) {
  const d = document.createElement('div');
  d.className = 'toast-wrap toast-err'; d.innerHTML = `<div class="toast">${msg}</div>`;
  document.body.appendChild(d); setTimeout(() => d.remove(), 4500);
}
function showToast(msg) {
  const d = document.createElement('div');
  d.className = 'toast-wrap toast-ok'; d.innerHTML = `<div class="toast">${msg}</div>`;
  document.body.appendChild(d); setTimeout(() => d.remove(), 3000);
}
</script>
}
