      <div style="flex:1;height:7px;border-radius:99px;background:var(--line);overflow:hidden">
        <div style="width:${w}%;height:100%;border-radius:99px;background:${color}"></div>
      </div>
      <span style="font-size:12px;font-weight:${d.isToday?700:500};color:${d.isToday?'var(--accent)':'var(--text)'};width:32px;flex-shrink:0">${escHtml(d.formatted)}</span>
    </div>`;
  }).join('');
  const streak = WB.streak > 1 ? `<div style="margin-top:8px;font-size:13px;color:var(--muted)">🔥 ${WB.streak}-day streak — keep it up!</div>` : '';
  appendBot(
    `<strong>📊 This week — ${escHtml(WB.weekTotal)} of ${WB.weekGoal}h goal (${WB.weekPct}%)</strong>` +
    `<div style="margin-top:10px">${bars}</div>${streak}`
