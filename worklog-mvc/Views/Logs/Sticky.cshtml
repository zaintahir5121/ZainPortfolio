@model List<WorkLogApp.Models.LogEntry>
@using WorkLogApp.Models
@{
    ViewData["Title"] = "Notes";
    decimal todayHours    = ViewBag.TodayHours     is decimal h  ? h  : 0m;
    var yesterdayLogs     = ViewBag.YesterdayLogs  as List<LogEntry> ?? new();
    decimal yesterdayHours = ViewBag.YesterdayHours is decimal yh ? yh : 0m;
    var recentProjects    = ViewBag.RecentProjects as List<string> ?? new();
    string dateLabel      = ViewBag.Date           as string ?? DateTime.Today.ToString("ddd, MMM d");
}

@section Styles {
<style>
  /* ── Standalone / WCO: hide shell chrome ── */
  @@media (display-mode: standalone), (display-mode: window-controls-overlay) {
    .topnav, .app-footer { display: none !important; }
    .main-wrap { padding: 0 !important; margin: 0 !important; max-width: none !important;
                 height: 100dvh !important; overflow: hidden !important; }
    .sk-root { height: 100dvh !important; }
  }

  .sk-root {
    display: flex; flex-direction: column;
    height: calc(100vh - 54px);
    overflow: hidden; background: #f0eff9;
    -webkit-font-smoothing: antialiased;
  }

  /* ── Top bar ── */
  .sk-topbar {
    background: #fff; border-bottom: 1px solid #e8e5f5;
    padding: 0 14px; display: flex; align-items: center; gap: 10px;
    flex-shrink: 0; min-height: 46px; box-sizing: border-box;
    box-shadow: 0 1px 6px rgba(99,102,241,.07);
  }
  @@media (display-mode: standalone) {
    .sk-topbar { -webkit-app-region: drag; app-region: drag; }
    .sk-topbar > * { -webkit-app-region: no-drag; app-region: no-drag; }
  }
  @@media (display-mode: window-controls-overlay) {
    .sk-topbar {
      position: fixed; z-index: 50;
      top: env(titlebar-area-y, 0px); left: env(titlebar-area-x, 0px);
      width: env(titlebar-area-width, 100%); height: env(titlebar-area-height, 46px);
      padding: 0 12px; -webkit-app-region: drag; app-region: drag;
    }
    .sk-topbar > * { -webkit-app-region: no-drag; app-region: no-drag; }
    .sk-wco-spacer { display: block !important; height: env(titlebar-area-height, 46px); }
  }
  .sk-wco-spacer { display: none; flex-shrink: 0; }
  .sk-topbar-logo { font-size: 15px; font-weight: 800; color: #6366f1; letter-spacing: -.3px; text-decoration: none; }
  .sk-topbar-date { font-size: 11.5px; color: #94a3b8; flex: 1; text-align: right; white-space: nowrap; }
  .sk-bmc-btn {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 5px 11px; border-radius: 20px; text-decoration: none;
    background: #ffdd00; color: #1a1a1a; font-size: 11.5px; font-weight: 700;
    border: none; cursor: pointer; white-space: nowrap;
    transition: background .14s, transform .1s;
    box-shadow: 0 1px 4px rgba(0,0,0,.12);
  }
  .sk-bmc-btn:hover { background: #f5d000; transform: scale(1.03); }

  /* ── Scrollable canvas ── */
  .sk-canvas { flex: 1; overflow-y: auto; padding: 14px 14px 20px; }
  .sk-canvas::-webkit-scrollbar { width: 5px; }
  .sk-canvas::-webkit-scrollbar-thumb { background: #d4d0f0; border-radius: 99px; }

  /* ── Creator ── */
  .sk-creator {
    max-width: 520px; margin: 0 auto 18px;
    background: #fff; border-radius: 12px;
    box-shadow: 0 2px 12px rgba(99,102,241,.1);
    border: 1.5px solid #e8e5f5;
    transition: box-shadow .15s, border-color .15s;
    overflow: hidden;
  }
  .sk-creator:focus-within {
    box-shadow: 0 6px 24px rgba(99,102,241,.18);
    border-color: #c7d2fe;
  }
  /* idle placeholder row */
  .sk-creator-idle {
    display: flex; align-items: center; gap: 10px;
    padding: 13px 16px; cursor: text;
    font-size: 14px; color: #94a3b8;
  }
  .sk-creator-idle-ico { font-size: 17px; }
  /* expanded form */
  .sk-creator-form { display: none; flex-direction: column; }
  .sk-creator.active .sk-creator-idle { display: none; }
  .sk-creator.active .sk-creator-form { display: flex; }
  .sk-creator-ta {
    border: none; outline: none; resize: none;
    padding: 14px 16px 8px; font-size: 14px; font-family: inherit;
    color: #1e293b; line-height: 1.55; min-height: 68px; max-height: 130px;
    background: transparent; overflow-y: auto;
  }
  /* Category toggle */
  .sk-cat-row {
    display: flex; gap: 7px; padding: 8px 14px 12px;
    border-top: 1px solid #f1f0f9;
  }
  .sk-cat-btn {
    flex: 1; padding: 7px 10px; border-radius: 20px;
    border: 1.5px solid #e8e5f5; background: #f8f7ff;
    font-size: 12.5px; font-weight: 600; color: #94a3b8;
    cursor: pointer; font-family: inherit; transition: all .14s;
    text-align: center;
  }
  .sk-cat-btn.active { border-color: #6366f1; background: #eef2ff; color: #6366f1; }
  .sk-cat-btn[data-cat="Work Log"].active { border-color: #10b981; background: #d1fae5; color: #065f46; }
  /* hint */
  .sk-creator-hint {
    font-size: 10.5px; color: #c4bfe8; text-align: center;
    padding: 0 14px 10px; display: none;
  }
  .sk-creator.active .sk-creator-hint { display: block; }

  /* ── Grid ── */
  .sk-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(175px, 1fr));
    gap: 11px; align-items: start;
  }

  /* ── Section divider ── */
  .sk-sec-hdr {
    display: flex; align-items: center; gap: 8px; cursor: pointer;
    font-size: 10px; font-weight: 700; text-transform: uppercase;
    letter-spacing: .6px; color: #a89fc4;
    padding: 10px 2px 8px; user-select: none;
    grid-column: 1 / -1;
  }
  .sk-sec-hdr .sk-chev { font-size: 9px; margin-left: auto; }
  .sk-yday-items { display: contents; }

  /* ── Note card ── */
  .sk-note {
    border-radius: 10px; padding: 12px 13px 13px; min-height: 120px;
    box-shadow: 0 2px 8px rgba(0,0,0,.07), 0 0 0 1px rgba(0,0,0,.04);
    cursor: pointer; position: relative; overflow: hidden;
    display: flex; flex-direction: column; gap: 6px;
    transition: box-shadow .15s, transform .12s;
    word-break: break-word;
    background: #fefce8;
  }
  .sk-note:hover { box-shadow: 0 6px 20px rgba(0,0,0,.12), 0 0 0 1px rgba(0,0,0,.05); transform: translateY(-2px); }
  /* fold corner */
  .sk-note::after {
    content: ''; position: absolute; bottom: 0; right: 0;
    width: 16px; height: 16px;
    background: linear-gradient(225deg, rgba(0,0,0,.1) 50%, transparent 50%);
  }
  .sk-note-cat  { font-size: 9.5px; font-weight: 800; text-transform: uppercase; letter-spacing: .5px; opacity: .7; }
  .sk-note-desc { font-size: 13px; line-height: 1.5; color: #1e293b; flex: 1;
                  overflow: hidden; display: -webkit-box; -webkit-line-clamp: 8; -webkit-box-orient: vertical; }
  .sk-note-proj { font-size: 10.5px; color: #94a3b8; margin-top: auto;
                  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  /* category colours */
  .sk-note[data-cat="Notes"]    { background: #fefce8; }
  .sk-note[data-cat="Work Log"] { background: #d1fae5; }
  .sk-note[data-cat="Notes"]    .sk-note-cat { color: #92400e; }
  .sk-note[data-cat="Work Log"] .sk-note-cat { color: #065f46; }

  /* ── Empty state ── */
  .sk-empty {
    grid-column: 1 / -1; display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 10px; text-align: center; padding: 48px 24px; color: #a89fc4;
  }
  .sk-empty-ico { font-size: 42px; opacity: .45; }
  .sk-empty-txt { font-size: 13.5px; line-height: 1.7; }

  /* ── Standalone footer ── */
  .sk-sfoot {
    display: none; padding: 7px 14px; font-size: 11px; color: #94a3b8;
    border-top: 1px solid #e8e5f5; flex-shrink: 0;
    align-items: center; justify-content: center; gap: 8px;
    background: #fff;
  }
  .sk-sfoot a { color: #6366f1; text-decoration: none; font-weight: 600; }
  .sk-sfoot a:hover { text-decoration: underline; }
  @@media (display-mode: standalone), (display-mode: window-controls-overlay) {
    .sk-sfoot { display: flex; }
  }

  /* ── Edit modal ── */
  .sk-modal-ov {
    position: fixed; inset: 0; background: rgba(0,0,0,.45); backdrop-filter: blur(3px);
    display: flex; align-items: center; justify-content: center;
    z-index: 300; padding: 20px;
  }
  .sk-modal-panel {
    background: #fff; border-radius: 14px; width: 100%; max-width: 400px;
    box-shadow: 0 20px 60px rgba(0,0,0,.22); overflow: hidden;
    animation: skUp .2s cubic-bezier(.22,1,.36,1);
  }
  @@keyframes skUp { from { transform: translateY(14px); opacity: 0; } to { transform: none; opacity: 1; } }
  .sk-modal-panel[data-cat="Notes"]    { background: #fefce8; border: 1px solid #fde68a; }
  .sk-modal-panel[data-cat="Work Log"] { background: #d1fae5; border: 1px solid #6ee7b7; }
  .sk-modal-hdr { display: flex; align-items: center; gap: 10px; padding: 14px 16px 8px; }
  .sk-modal-catl { font-size: 11.5px; font-weight: 800; flex: 1; color: #475569; }
  .sk-modal-x {
    width: 28px; height: 28px; border-radius: 8px; border: 1px solid rgba(0,0,0,.08);
    background: rgba(255,255,255,.7); cursor: pointer; font-size: 13px; color: #64748b;
    display: flex; align-items: center; justify-content: center;
  }
  .sk-modal-body { padding: 4px 16px 14px; }
  .sk-modal-text {
    font-size: 15px; line-height: 1.6; color: #1e293b; min-height: 60px;
    word-break: break-word; outline: none; border-radius: 8px;
    padding: 9px 11px; background: rgba(255,255,255,.6); cursor: text;
    border: 1px solid transparent; transition: border-color .15s;
    margin-bottom: 8px;
  }
  .sk-modal-text:focus { border-color: #6366f1; background: #fff; }
  .sk-modal-panel[data-cat="Work Log"] .sk-modal-text:focus { border-color: #10b981; }
  .sk-modal-foot { display: flex; gap: 8px; padding: 10px 16px 14px; border-top: 1px solid rgba(0,0,0,.06); }
  .sk-modal-del  { padding: 7px 14px; border-radius: 8px; border: 1px solid #fecaca; background: #fff1f2; color: #ef4444; font-size: 12px; font-weight: 700; cursor: pointer; font-family: inherit; }
  .sk-modal-save { flex: 1; padding: 7px; border-radius: 8px; border: none; background: #6366f1; color: #fff; font-size: 12px; font-weight: 700; cursor: pointer; font-family: inherit; transition: background .12s; }
  .sk-modal-save:hover { background: #4f46e5; }
  .sk-modal-save:disabled { opacity: .4; cursor: default; }
  .sk-modal-panel[data-cat="Work Log"] .sk-modal-save { background: #10b981; }

  /* ── Toast ── */
  .sk-toast {
    position: fixed; bottom: 44px; left: 50%; transform: translateX(-50%);
    background: #1e293b; color: #fff; font-size: 12px; font-weight: 600;
    padding: 7px 16px; border-radius: 99px; opacity: 0; transition: opacity .2s;
    white-space: nowrap; pointer-events: none; z-index: 400;
  }
  .sk-toast.show { opacity: 1; }

  /* ── Card pop-in animation ── */
  @@keyframes skPop {
    from { opacity: 0; transform: scale(.88) translateY(-8px); }
    to   { opacity: 1; transform: none; }
  }
  .sk-note-new { animation: skPop .25s cubic-bezier(.22,1,.36,1); }
</style>
}

<div class="sk-root">

  <div class="sk-topbar">
    <span class="sk-topbar-logo">📝 Notes.</span>
    <span class="sk-topbar-date">@dateLabel</span>
    <a class="sk-bmc-btn" href="https://buymeacoffee.com/zaintahir512" target="_blank" rel="noopener">☕ Buy me a coffee</a>
  </div>
  <div class="sk-wco-spacer"></div>

  <div class="sk-canvas" id="skCanvas">

    <!-- Creator -->
    <div class="sk-creator" id="skCreator">
      <div class="sk-creator-idle" onclick="skActivate()">
        <span class="sk-creator-idle-ico">✏️</span>
        <span>Take a note… (or press N)</span>
      </div>
      <div class="sk-creator-form" id="skForm">
        <textarea id="skTa" class="sk-creator-ta" placeholder="What's on your mind?"
                  oninput="skAutosize(this)" onkeydown="skKeydown(event)"></textarea>
        <div class="sk-cat-row">
          <button class="sk-cat-btn active" data-cat="Notes"    id="skCatNotes"   onclick="skSetCat('Notes')">📝 Notes</button>
          <button class="sk-cat-btn"        data-cat="Work Log" id="skCatWork"    onclick="skSetCat('Work Log')">⚙️ Work Log</button>
        </div>
      </div>
      <div class="sk-creator-hint">Press Enter to save · Esc to cancel</div>
    </div>

    <!-- Grid -->
    <div class="sk-grid" id="skGrid">
      @if (Model.Any())
      {
        foreach (var log in Model)
        {
          var cat = (log.Tags == "Work Log") ? "Work Log" : "Notes";
          <div class="sk-note" id="skn-@log.Id" data-cat="@cat"
               onclick="skOpenModal(@log.Id,'@System.Web.HttpUtility.JavaScriptStringEncode(log.Description)','@cat')">
            <div class="sk-note-cat">@cat</div>
            <div class="sk-note-desc" id="skt-@log.Id">@log.Description</div>
            @if (!string.IsNullOrWhiteSpace(log.Project))
            {
              <div class="sk-note-proj">📁 @log.Project</div>
            }
          </div>
        }
      }
      else
      {
        <div class="sk-empty" id="skEmpty">
          <div class="sk-empty-ico">📝</div>
          <div class="sk-empty-txt">Nothing here yet.<br>Click above or press <strong>N</strong> to add your first note.</div>
        </div>
      }

      @if (yesterdayLogs.Any())
      {
        <div class="sk-sec-hdr" onclick="skToggleYday()">
          <span>Yesterday</span>
          <span class="sk-chev" id="skYdayChev">▾</span>
        </div>
        <div class="sk-yday-items" id="skYdayList">
          @foreach (var log in yesterdayLogs)
          {
            var cat = (log.Tags == "Work Log") ? "Work Log" : "Notes";
            <div class="sk-note" data-cat="@cat">
              <div class="sk-note-cat">@cat</div>
              <div class="sk-note-desc">@log.Description</div>
              @if (!string.IsNullOrWhiteSpace(log.Project))
              {
                <div class="sk-note-proj">📁 @log.Project</div>
              }
            </div>
          }
        </div>
      }
    </div>
  </div>

  <div class="sk-sfoot">
    <a href="/Logs">Full dashboard →</a>
    <span>·</span>
    <a class="sk-bmc-btn" href="https://buymeacoffee.com/zaintahir512" target="_blank" rel="noopener">☕ Buy me a coffee</a>
  </div>
</div>

<!-- Edit modal -->
<div class="sk-modal-ov" id="skModal" style="display:none" onclick="if(event.target===this)skCloseModal()">
  <div class="sk-modal-panel" id="skModalPanel">
    <div class="sk-modal-hdr">
      <span class="sk-modal-catl" id="skModalCat"></span>
      <button class="sk-modal-x" onclick="skCloseModal()">✕</button>
    </div>
    <div class="sk-modal-body">
      <div class="sk-modal-text" id="skModalText" contenteditable="true"></div>
    </div>
    <div class="sk-modal-foot">
      <button class="sk-modal-del" onclick="skModalDelete()">🗑 Delete</button>
      <button class="sk-modal-save" id="skModalSaveBtn" onclick="skModalSave()">Save</button>
    </div>
  </div>
</div>

<div class="sk-toast" id="skToast"></div>

@section Scripts {
<script>
let _skActive = false;
let _skCat    = 'Notes';
let _skModalId = null;

// ── Creator ────────────────────────────────────────────────────────────────
function skActivate() {
  if (_skActive) return;
  _skActive = true;
  document.getElementById('skCreator').classList.add('active');
  setTimeout(() => document.getElementById('skTa').focus(), 30);
}
function skDeactivate() {
  _skActive = false;
  const creator = document.getElementById('skCreator');
  creator.classList.remove('active');
  const ta = document.getElementById('skTa');
  ta.value = ''; ta.style.height = '';
}
function skSetCat(cat) {
  _skCat = cat;
  document.getElementById('skCatNotes').classList.toggle('active', cat === 'Notes');
  document.getElementById('skCatWork').classList.toggle('active', cat === 'Work Log');
}
function skAutosize(el) {
  el.style.height = 'auto';
  el.style.height = Math.min(el.scrollHeight, 130) + 'px';
}
function skKeydown(e) {
  if (e.key === 'Escape') { e.preventDefault(); skDeactivate(); return; }
  if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); skSave(); }
}

// ── Save ───────────────────────────────────────────────────────────────────
async function skSave() {
  const ta   = document.getElementById('skTa');
  const text = ta.value.trim();
  if (!text) return;
  // Optimistic: add card immediately, then persist
  const tempId = 'tmp-' + Date.now();
  skAddCard({ id: tempId, description: text, category: _skCat, project: '' }, true);
  skDeactivate();
  try {
    const res = await fetch('/Logs/QuickAdd', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ description: text, hours: 0, category: _skCat, project: '' }),
    });
    if (!res.ok) { document.getElementById(`skn-${tempId}`)?.remove(); skToast('Could not save'); return; }
    const entry = await res.json();
    // Replace temp card with real id
    const tempEl = document.getElementById(`skn-${tempId}`);
    if (tempEl) {
      tempEl.id = `skn-${entry.id}`;
      tempEl.setAttribute('onclick', `skOpenModal(${entry.id},'${_skJs(entry.description)}','${_skJs(_skCat)}')`);
      const descEl = tempEl.querySelector('.sk-note-desc');
      if (descEl) descEl.id = `skt-${entry.id}`;
    }
  } catch {
    document.getElementById(`skn-${tempId}`)?.remove();
    skToast('Network error');
  }
}
function skAddCard(entry, animate) {
  const card = document.createElement('div');
  card.className = 'sk-note' + (animate ? ' sk-note-new' : '');
  card.id = `skn-${entry.id}`;
  card.dataset.cat = entry.category;
  card.setAttribute('onclick', `skOpenModal('${entry.id}','${_skJs(entry.description)}','${_skJs(entry.category)}')`);
  card.innerHTML = `<div class="sk-note-cat">${_skEsc(entry.category)}</div>
    <div class="sk-note-desc" id="skt-${entry.id}">${_skEsc(entry.description)}</div>`;
  const grid  = document.getElementById('skGrid');
  const empty = document.getElementById('skEmpty');
  if (empty) empty.remove();
  grid.insertAdjacentElement('afterbegin', card);
}

// ── Yesterday toggle ─────────────────────────────────────────────────────────
function skToggleYday() {
  const list = document.getElementById('skYdayList');
  const chev = document.getElementById('skYdayChev');
  if (!list) return;
  const hidden = list.style.display === 'none';
  list.style.display = hidden ? '' : 'none';
  if (chev) chev.textContent = hidden ? '▾' : '▸';
}

// ── Modal ─────────────────────────────────────────────────────────────────────
function skOpenModal(id, text, cat) {
  _skModalId = id;
  const panel = document.getElementById('skModalPanel');
  panel.dataset.cat = cat;
  document.getElementById('skModalCat').textContent = cat;
  const textEl = document.getElementById('skModalText');
  textEl.textContent = text;
  document.getElementById('skModal').style.display = 'flex';
  setTimeout(() => {
    textEl.focus();
    const r = document.createRange(); r.selectNodeContents(textEl); r.collapse(false);
    const s = window.getSelection(); s.removeAllRanges(); s.addRange(r);
  }, 80);
}
function skCloseModal() {
  document.getElementById('skModal').style.display = 'none';
  _skModalId = null;
}
async function skModalDelete() {
  if (_skModalId == null) return;
  const id = _skModalId;
  skCloseModal();
  const el = document.getElementById(`skn-${id}`);
  if (el) { el.style.cssText += ';transition:all .18s;transform:scale(.88);opacity:0'; setTimeout(() => el.remove(), 200); }
  try { await fetch('/Logs/DeleteEntry', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ id }) }); } catch {}
  skToast('✓ Deleted');
}
async function skModalSave() {
  if (_skModalId == null) return;
  const id      = _skModalId;
  const textEl  = document.getElementById('skModalText');
  const newText = textEl.textContent.trim();
  if (!newText) return;
  const btn = document.getElementById('skModalSaveBtn');
  btn.disabled = true; btn.textContent = 'Saving…';
  try {
    const res = await fetch('/Logs/UpdateEntry', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id, description: newText }),
    });
    if (!res.ok) { btn.disabled = false; btn.textContent = 'Save'; skToast('Could not save'); return; }
    const descEl = document.getElementById(`skt-${id}`);
    if (descEl) descEl.textContent = newText;
    const card = document.getElementById(`skn-${id}`);
    if (card) card.setAttribute('onclick', `skOpenModal(${id},'${_skJs(newText)}','${_skJs(card.dataset.cat)}')`);
    skCloseModal(); skToast('✓ Saved');
  } catch { btn.disabled = false; btn.textContent = 'Save'; skToast('Network error'); }
}

// ── Toast ─────────────────────────────────────────────────────────────────
let _toastT;
function skToast(msg) {
  const t = document.getElementById('skToast');
  t.textContent = msg; t.classList.add('show');
  clearTimeout(_toastT);
  _toastT = setTimeout(() => t.classList.remove('show'), 2500);
}

// ── Keyboard shortcuts ─────────────────────────────────────────────────────
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') { skCloseModal(); skDeactivate(); return; }
  if (e.key === 'n' && !e.ctrlKey && !e.metaKey && !e.altKey &&
      !['INPUT','TEXTAREA','SELECT'].includes(document.activeElement?.tagName)) {
    e.preventDefault(); skActivate();
  }
});

// ── Window size persistence ─────────────────────────────────────────────────
if (window.matchMedia('(display-mode: standalone)').matches ||
    window.matchMedia('(display-mode: window-controls-overlay)').matches) {
  try {
    const savedW = parseInt(localStorage.getItem('sk_w') || '0');
    const savedH = parseInt(localStorage.getItem('sk_h') || '0');
    window.resizeTo(savedW > 260 ? savedW : 400, savedH > 200 ? savedH : 600);
  } catch {}
  let _rsT;
  window.addEventListener('resize', () => {
    clearTimeout(_rsT);
    _rsT = setTimeout(() => {
      try { localStorage.setItem('sk_w', window.outerWidth); localStorage.setItem('sk_h', window.outerHeight); } catch {}
    }, 400);
  });
}

// ── Helpers ────────────────────────────────────────────────────────────────
function _skEsc(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function _skJs(s)  { return String(s).replace(/\\/g,'\\\\').replace(/'/g,"\\'").replace(/\n/g,'\\n').replace(/\r/g,''); }
</script>
}
