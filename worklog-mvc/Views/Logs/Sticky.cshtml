@model List<WorkLogApp.Models.LogEntry>
@{
    Layout = null;
    decimal todayHours = ViewBag.TodayHours is decimal h ? h : 0m;
    string firstName = ViewBag.FirstName as string ?? "there";
    var recentProjects = ViewBag.RecentProjects as List<string> ?? new List<string>();
    string dateLabel = ViewBag.Date as string ?? DateTime.Today.ToString("ddd, MMM d");
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>WorkLog Notes</title>
  <meta name="theme-color" content="#6366f1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    html,body{height:100%;overflow:hidden;-webkit-font-smoothing:antialiased}
    body{
      font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
      background:#fefce8;
      display:flex;flex-direction:column;
      height:100dvh;
    }

    /* ── Header ── */
    .sk-hdr{
      background:#6366f1;
      color:#fff;
      padding:10px 14px;
      display:flex;align-items:center;gap:8px;
      flex-shrink:0;
      -webkit-app-region:drag;
    }
    .sk-logo{font-size:16px;font-weight:800;letter-spacing:-.3px;-webkit-app-region:no-drag}
    .sk-pill{
      font-size:11px;font-weight:700;
      background:rgba(255,255,255,.22);
      padding:2px 9px;border-radius:99px;
      white-space:nowrap;
    }
    .sk-date{font-size:11px;opacity:.7;flex:1;text-align:right;white-space:nowrap}
    .sk-hdr-btn{
      -webkit-app-region:no-drag;
      width:26px;height:26px;border-radius:6px;border:none;
      background:rgba(255,255,255,.18);color:#fff;
      font-size:14px;line-height:1;cursor:pointer;
      display:flex;align-items:center;justify-content:center;
      transition:background .12s;text-decoration:none;
    }
    .sk-hdr-btn:hover{background:rgba(255,255,255,.34)}

    /* ── Add form ── */
    .sk-form{
      display:none;flex-direction:column;gap:8px;
      padding:10px 12px;
      background:#fff;
      border-bottom:2px solid #6366f1;
      flex-shrink:0;
    }
    .sk-form.open{display:flex}
    .sk-form-ta{
      border:1.5px solid #e2e8f0;border-radius:10px;
      padding:9px 12px;font-size:14px;font-family:inherit;
      resize:none;outline:none;min-height:62px;
      color:#0f172a;line-height:1.55;
    }
    .sk-form-ta:focus{border-color:#6366f1}
    .sk-form-row{display:flex;gap:7px;align-items:center;flex-wrap:wrap}
    .sk-form-cat{
      flex:1;min-width:100px;
      border:1.5px solid #e2e8f0;border-radius:8px;
      padding:6px 8px;font-size:12.5px;font-family:inherit;
      background:#fff;outline:none;color:#334155;
    }
    .sk-form-hrs{
      width:48px;border:1.5px solid #e2e8f0;border-radius:8px;
      padding:6px 8px;font-size:13px;font-family:inherit;
      text-align:center;outline:none;
      -moz-appearance:textfield;
    }
    .sk-form-hrs::-webkit-outer-spin-button,
    .sk-form-hrs::-webkit-inner-spin-button{-webkit-appearance:none}
    .sk-form-hlbl{font-size:12px;color:#64748b;margin-left:-3px}
    .sk-form-proj{
      flex:1;min-width:90px;
      border:1.5px solid #e2e8f0;border-radius:8px;
      padding:6px 8px;font-size:12.5px;font-family:inherit;
      background:#fff;outline:none;color:#334155;
    }
    .sk-form-submit{
      padding:7px 16px;background:#6366f1;color:#fff;
      border:none;border-radius:9px;font-size:13px;font-weight:700;
      cursor:pointer;font-family:inherit;white-space:nowrap;
      transition:background .12s;
    }
    .sk-form-submit:hover{background:#4f46e5}
    .sk-form-submit:disabled{opacity:.4;cursor:default}

    /* ── Notes list ── */
    .sk-notes{
      flex:1;overflow-y:auto;
      padding:10px 10px 16px;
      display:flex;flex-direction:column;gap:8px;
    }
    .sk-notes::-webkit-scrollbar{width:4px}
    .sk-notes::-webkit-scrollbar-thumb{background:#e2e8f0;border-radius:99px}

    /* ── Single note card ── */
    .sk-note{
      background:#fff;
      border-radius:10px;
      border-left:4px solid #94a3b8;
      padding:10px 12px;
      box-shadow:0 1px 4px rgba(0,0,0,.06);
      position:relative;
      transition:box-shadow .15s;
    }
    .sk-note:hover{box-shadow:0 3px 12px rgba(0,0,0,.1)}
    .sk-note-cat{
      font-size:10px;font-weight:800;text-transform:uppercase;
      letter-spacing:.5px;margin-bottom:5px;
    }
    .sk-note-desc{
      font-size:13.5px;line-height:1.5;color:#1e293b;
      margin-bottom:6px;word-break:break-word;
    }
    .sk-note-foot{
      display:flex;align-items:center;gap:6px;
      font-size:11px;color:#94a3b8;
    }
    .sk-note-proj{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .sk-note-hrs{font-weight:800;flex-shrink:0}
    .sk-note-del{
      position:absolute;top:8px;right:8px;
      width:22px;height:22px;border-radius:50%;
      background:none;border:none;cursor:pointer;
      color:#cbd5e1;font-size:14px;line-height:1;
      display:flex;align-items:center;justify-content:center;
      opacity:0;transition:opacity .15s,color .1s,background .1s;
    }
    .sk-note:hover .sk-note-del{opacity:1}
    .sk-note-del:hover{color:#ef4444;background:#fee2e2}

    /* Category colours */
    .sk-note[data-cat="Development"]   {border-color:#3b82f6;background:#eff6ff}
    .sk-note[data-cat="Meeting"]       {border-color:#f59e0b;background:#fffbeb}
    .sk-note[data-cat="Code Review"]   {border-color:#10b981;background:#f0fdf4}
    .sk-note[data-cat="Testing"]       {border-color:#8b5cf6;background:#faf5ff}
    .sk-note[data-cat="Documentation"] {border-color:#06b6d4;background:#ecfeff}
    .sk-note[data-cat="DevOps"]        {border-color:#ef4444;background:#fff1f2}
    .sk-note[data-cat="Research"]      {border-color:#6366f1;background:#eef2ff}
    .sk-note[data-cat="Design"]        {border-color:#ec4899;background:#fdf2f8}
    .sk-note[data-cat="Notes"]         {border-color:#d97706;background:#fefce8}
    .sk-note[data-cat="Other"]         {border-color:#94a3b8;background:#f8fafc}

    .sk-note[data-cat="Development"]   .sk-note-cat{color:#3b82f6}
    .sk-note[data-cat="Meeting"]       .sk-note-cat{color:#d97706}
    .sk-note[data-cat="Code Review"]   .sk-note-cat{color:#10b981}
    .sk-note[data-cat="Testing"]       .sk-note-cat{color:#8b5cf6}
    .sk-note[data-cat="Documentation"] .sk-note-cat{color:#06b6d4}
    .sk-note[data-cat="DevOps"]        .sk-note-cat{color:#ef4444}
    .sk-note[data-cat="Research"]      .sk-note-cat{color:#6366f1}
    .sk-note[data-cat="Design"]        .sk-note-cat{color:#ec4899}
    .sk-note[data-cat="Notes"]         .sk-note-cat{color:#d97706}
    .sk-note[data-cat="Other"]         .sk-note-cat{color:#94a3b8}
    .sk-note-hrs{color:var(--accent,#6366f1)}

    /* ── Empty state ── */
    .sk-empty{
      flex:1;display:flex;flex-direction:column;
      align-items:center;justify-content:center;
      gap:10px;text-align:center;padding:32px;color:#94a3b8;
    }
    .sk-empty-ico{font-size:38px;opacity:.5}
    .sk-empty-txt{font-size:13.5px;line-height:1.6}

    /* ── Footer ── */
    .sk-footer{
      padding:6px 12px;
      font-size:11px;color:#94a3b8;text-align:center;
      border-top:1px solid rgba(0,0,0,.06);
      flex-shrink:0;display:flex;align-items:center;justify-content:center;gap:8px;
    }
    .sk-footer a{color:#6366f1;text-decoration:none;font-weight:600}
    .sk-footer a:hover{text-decoration:underline}
    .sk-tip{
      font-size:10px;color:#cbd5e1;
      display:flex;align-items:center;gap:4px;cursor:help;
    }

    /* ── Toast ── */
    .sk-toast{
      position:fixed;bottom:44px;left:50%;transform:translateX(-50%);
      background:#1e293b;color:#fff;font-size:12px;font-weight:600;
      padding:7px 16px;border-radius:99px;
      opacity:0;transition:opacity .2s;white-space:nowrap;pointer-events:none;
      z-index:100;
    }
    .sk-toast.show{opacity:1}

    /* ── New note animation ── */
    @@keyframes skPop{from{opacity:0;transform:translateY(-6px) scale(.96)}to{opacity:1;transform:translateY(0) scale(1)}}
    .sk-note-new{animation:skPop .2s cubic-bezier(.22,1,.36,1)}
  </style>
</head>
<body>

  <!-- Header -->
  <div class="sk-hdr">
    <span class="sk-logo">✦ WorkLog</span>
    <span class="sk-pill" id="skPill">@todayHours h today</span>
    <span class="sk-date">@dateLabel</span>
    <a href="/Logs" class="sk-hdr-btn" title="Open full app" style="-webkit-app-region:no-drag">⤢</a>
    <button class="sk-hdr-btn" id="skAddToggle" onclick="skToggleForm()" title="Add note (N)">+</button>
  </div>

  <!-- Quick-add form -->
  <div class="sk-form" id="skForm">
    <textarea id="skTa" class="sk-form-ta" placeholder="What did you work on?" rows="2"
              onkeydown="skKeydown(event)" oninput="skAutosize(this)"></textarea>
    <div class="sk-form-row">
      <select id="skCat" class="sk-form-cat">
        <option value="Notes" selected>📝 Notes</option>
        <option value="Development">💻 Development</option>
        <option value="Meeting">👥 Meeting</option>
        <option value="Code Review">🔍 Code Review</option>
        <option value="Testing">🧪 Testing</option>
        <option value="Documentation">📄 Docs</option>
        <option value="DevOps">⚙️ DevOps</option>
        <option value="Research">🔬 Research</option>
        <option value="Design">🎨 Design</option>
        <option value="Other">Other</option>
      </select>
      <input type="number" id="skHrsInp" class="sk-form-hrs" value="0.5" min="0.25" max="24" step="0.25">
      <span class="sk-form-hlbl">h</span>
      @if (recentProjects.Any())
      {
        <input type="text" id="skProj" class="sk-form-proj" placeholder="Project" list="skProjList">
        <datalist id="skProjList">
          @foreach (var p in recentProjects) { <option value="@p"></option> }
        </datalist>
      }
      else
      {
        <input type="text" id="skProj" class="sk-form-proj" placeholder="Project">
      }
      <button class="sk-form-submit" id="skSaveBtn" onclick="skSave()">Add →</button>
    </div>
  </div>

  <!-- Notes board -->
  @if (Model.Any())
  {
    <div class="sk-notes" id="skBoard">
      @foreach (var log in Model)
      {
        var cat = string.IsNullOrWhiteSpace(log.Tags) ? "Other" : log.Tags;
        <div class="sk-note" id="skn-@log.Id" data-cat="@cat">
          <div class="sk-note-cat">@cat</div>
          <div class="sk-note-desc">@log.Description</div>
          <div class="sk-note-foot">
            <span class="sk-note-proj">@(string.IsNullOrWhiteSpace(log.Project) ? "" : "📁 " + log.Project)</span>
            <span class="sk-note-hrs">@log.Hours h</span>
          </div>
          <button class="sk-note-del" onclick="skDelete(@log.Id)" title="Delete">×</button>
        </div>
      }
    </div>
  }
  else
  {
    <div class="sk-empty" id="skBoard">
      <div class="sk-empty-ico">📝</div>
      <div class="sk-empty-txt">No notes today yet.<br>Press <strong>N</strong> or tap <strong>+</strong> to add one.</div>
    </div>
  }

  <!-- Footer -->
  <div class="sk-footer">
    <a href="/Logs">Full dashboard →</a>
    <span>·</span>
    <span class="sk-tip" title="Install as app: click the install icon in your browser address bar. Then pin it to Windows Startup via Task Manager → Startup Apps.">💡 How to auto-start</span>
  </div>

  <div class="sk-toast" id="skToast"></div>

  <script>
  const CAT_COLORS = {
    'Development':'#3b82f6','Meeting':'#f59e0b','Code Review':'#10b981',
    'Testing':'#8b5cf6','Documentation':'#06b6d4','DevOps':'#ef4444',
    'Research':'#6366f1','Design':'#ec4899','Notes':'#d97706','Other':'#94a3b8',
  };

  let skFormOpen = false;
  let skTotal = @todayHours;

  function skToggleForm() {
    skFormOpen = !skFormOpen;
    document.getElementById('skForm').classList.toggle('open', skFormOpen);
    document.getElementById('skAddToggle').textContent = skFormOpen ? '×' : '+';
    if (skFormOpen) setTimeout(() => document.getElementById('skTa').focus(), 30);
  }

  function skKeydown(e) {
    if (e.key === 'Escape') { e.preventDefault(); skToggleForm(); return; }
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); skSave(); }
  }

  function skAutosize(el) {
    el.style.height = 'auto';
    el.style.height = Math.min(el.scrollHeight, 120) + 'px';
  }

  function escHtml(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

  async function skSave() {
    const ta   = document.getElementById('skTa');
    const text = ta.value.trim();
    if (!text) { ta.focus(); return; }
    const cat  = document.getElementById('skCat').value;
    const hrs  = parseFloat(document.getElementById('skHrsInp').value) || 0.5;
    const proj = document.getElementById('skProj')?.value?.trim() || '';
    const btn  = document.getElementById('skSaveBtn');
    btn.disabled = true; btn.textContent = '…';
    try {
      const res = await fetch('/Logs/QuickAdd', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ description: text, hours: hrs, category: cat, project: proj }),
      });
      if (!res.ok) { skToast('Could not save'); return; }
      const entry = await res.json();
      ta.value = ''; skAutosize(ta);
      skTotal = Math.round((skTotal + hrs) * 100) / 100;
      document.getElementById('skPill').textContent = skTotal + ' h today';
      skAddCard(entry);
      skToggleForm();
      skToast('✓ Note added!');
    } catch { skToast('Network error'); }
    finally { btn.disabled = false; btn.textContent = 'Add →'; }
  }

  function skAddCard(entry) {
    const cat = entry.category || 'Other';
    const proj = entry.project ? '📁 ' + escHtml(entry.project) : '';
    const html = `<div class="sk-note sk-note-new" id="skn-${entry.id}" data-cat="${escHtml(cat)}">
      <div class="sk-note-cat">${escHtml(cat)}</div>
      <div class="sk-note-desc">${escHtml(entry.description)}</div>
      <div class="sk-note-foot">
        <span class="sk-note-proj">${proj}</span>
        <span class="sk-note-hrs">${entry.hours} h</span>
      </div>
      <button class="sk-note-del" onclick="skDelete(${entry.id})" title="Delete">×</button>
    </div>`;
    const board = document.getElementById('skBoard');
    if (board.classList.contains('sk-empty')) {
      board.className = 'sk-notes';
      board.innerHTML = '';
    }
    board.insertAdjacentHTML('afterbegin', html);
  }

  async function skDelete(id) {
    const el = document.getElementById(`skn-${id}`);
    if (!el) return;
    const hrs = parseFloat(el.querySelector('.sk-note-hrs')?.textContent) || 0;
    el.style.cssText += ';transition:all .18s;transform:scale(.92);opacity:0';
    setTimeout(() => { el.remove(); }, 200);
    skTotal = Math.max(0, Math.round((skTotal - hrs) * 100) / 100);
    document.getElementById('skPill').textContent = skTotal + ' h today';
    try {
      await fetch('/Logs/DeleteEntry', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ id }),
      });
    } catch {}
  }

  let _toastTimer;
  function skToast(msg) {
    const t = document.getElementById('skToast');
    t.textContent = msg; t.classList.add('show');
    clearTimeout(_toastTimer);
    _toastTimer = setTimeout(() => t.classList.remove('show'), 2500);
  }

  // Keyboard shortcut: N opens the add form
  document.addEventListener('keydown', e => {
    if (e.key === 'n' && !e.ctrlKey && !e.metaKey && !e.altKey &&
        !['INPUT','TEXTAREA','SELECT'].includes(document.activeElement?.tagName)) {
      e.preventDefault(); if (!skFormOpen) skToggleForm();
    }
  });
  </script>
</body>
</html>
