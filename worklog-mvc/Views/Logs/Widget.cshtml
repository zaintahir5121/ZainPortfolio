@using WorkLogApp.Models
@{
    Layout = null;
    var  todayWork     = ViewBag.TodayLogs     as List<LogEntry> ?? new();
    var  todayNotes    = ViewBag.TodayNotes    as List<LogEntry> ?? new();
    var  ydayWork      = ViewBag.YesterdayLogs as List<LogEntry> ?? new();
    var  ydayNotes     = ViewBag.YesterdayNotes as List<LogEntry> ?? new();
    decimal todayH     = ViewBag.TodayHours    is decimal th ? th : 0m;
    decimal ydayH      = ViewBag.YesterdayHours is decimal yh ? yh : 0m;
    decimal goal       = ViewBag.DailyGoal     is decimal dg ? dg : 8m;
    decimal pct        = goal > 0 ? Math.Min(todayH / goal * 100, 100) : 0;
    string  date       = ViewBag.Date          as string ?? "";
    string  firstName  = ViewBag.FirstName     as string ?? "";
    var     projects   = ViewBag.RecentProjects as List<string> ?? new();
    string  weekJson   = ViewBag.WeekJson      as string ?? "[]";
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WorkLog</title>
  <link rel="manifest" href="/manifest-widget.json">
  <meta name="theme-color" content="#6366f1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0 }
    :root {
      --accent:   #6366f1;
      --accent2:  #8b5cf6;
      --note-bg:  #fefce8;
      --note-bd:  #fde68a;
      --note-acc: #d97706;
      --bg:       #f5f5fa;
      --card:     #ffffff;
      --text:     #1e1e2e;
      --text2:    #4a4a6a;
      --muted:    #8b8ea6;
      --line:     #e8e8f0;
      --font:     'Inter', system-ui, sans-serif;
      --r:        10px;
    }
    html, body { height: 100%; overflow: hidden; }
    body {
      font-family: var(--font); background: var(--bg); color: var(--text);
      font-size: 13px; -webkit-font-smoothing: antialiased;
      min-width: 260px; display: flex; flex-direction: column; height: 100%;
    }

    /* ── Accent strip (hidden under WCO) ── */
    .wg-strip { height: 3px; background: linear-gradient(90deg,var(--accent),var(--accent2)); flex-shrink: 0; transition: background .3s; }
    .wg-strip.notes { background: linear-gradient(90deg,#f59e0b,#d97706); }

    /* ── Top bar ── */
    .wg-bar {
      display: flex; align-items: center; gap: 7px;
      padding: 7px 11px 0;
      background: var(--card);
      flex-shrink: 0;
      /* Draggable region so user can move window by dragging the bar */
      -webkit-app-region: drag; app-region: drag;
    }
    .wg-bar > * { -webkit-app-region: no-drag; app-region: no-drag; }
    .wg-logo { font-size: 13px; font-weight: 800; color: var(--text); text-decoration: none; letter-spacing: -.3px; }
    .wg-logo span { color: var(--accent); }
    .wg-date { flex: 1; font-size: 10.5px; color: var(--muted); font-weight: 500; text-align: center; user-select: none; }
    .wg-icon-btn {
      width: 24px; height: 24px; border-radius: 6px; border: 1px solid var(--line);
      background: var(--bg); cursor: pointer; font-size: 11px;
      display: flex; align-items: center; justify-content: center;
      color: var(--muted); transition: color .15s, background .15s;
    }
    .wg-icon-btn:hover { background: var(--card); color: var(--accent); }
    .wg-pin-btn.pinned { color: var(--accent); border-color: var(--accent); background: #eef2ff; }

    /* ── Standalone: hide our header bar — OS provides thin title bar for dragging ── */
    @@media (display-mode: standalone) {
      .wg-bar   { display: none; }
      .wg-strip { -webkit-app-region: drag; app-region: drag; height: 6px; }
      .wg-tabs  { -webkit-app-region: drag; app-region: drag; }
      .wg-tabs > * { -webkit-app-region: no-drag; app-region: no-drag; }
    }
    /* ── WCO: tabs fill the OS title-bar area — truly header-less ── */
    @@media (display-mode: window-controls-overlay) {
      .wg-strip { display: none; }
      .wg-bar   { display: none; }
      .wg-tabs {
        position: fixed; z-index: 50;
        top: env(titlebar-area-y, 0px);
        left: env(titlebar-area-x, 0px);
        width: env(titlebar-area-width, 100%);
        height: env(titlebar-area-height, 36px);
        border-bottom: 1px solid var(--line);
        -webkit-app-region: drag; app-region: drag;
        box-sizing: border-box;
      }
      .wg-tabs > * { -webkit-app-region: no-drag; app-region: no-drag; }
      .wg-wco-spacer { display: block; }
    }
    /* WCO spacer: pushes flex content below the fixed tab bar */
    .wg-wco-spacer { display: none; flex-shrink: 0; height: env(titlebar-area-height, 36px); }

    /* ── Tabs ── */
    .wg-tabs {
      display: flex; background: var(--card); border-bottom: 1px solid var(--line);
      padding: 0 11px; flex-shrink: 0;
    }
    .wg-tab {
      flex: 1; padding: 6px 4px 5px; text-align: center;
      font-size: 11.5px; font-weight: 700; cursor: pointer;
      border: none; background: none; font-family: var(--font); color: var(--muted);
      border-bottom: 2.5px solid transparent; transition: color .15s, border-color .15s;
      display: flex; align-items: center; justify-content: center; gap: 4px;
    }
    .wg-tab.active { color: var(--accent); border-bottom-color: var(--accent); }
    .wg-tab.notes-tab.active { color: var(--note-acc); border-bottom-color: var(--note-acc); }
    .wg-tab-badge {
      font-size: 9.5px; font-weight: 700; padding: 1px 5px; border-radius: 99px;
      background: var(--bg); color: var(--muted);
    }
    .wg-tab.active .wg-tab-badge { background: #eef2ff; color: var(--accent); }
    .wg-tab.notes-tab.active .wg-tab-badge { background: #fef3c7; color: var(--note-acc); }

    /* ── Setup drawer ── */
    .wg-setup-drawer {
      background: var(--card); border-bottom: 1px solid var(--line);
      padding: 11px 12px 10px; flex-shrink: 0;
    }
    .wg-setup-title { font-size: 11.5px; font-weight: 800; color: var(--text); margin-bottom: 7px; }
    .wg-dl-btn {
      display: flex; align-items: center; gap: 7px; width: 100%;
      padding: 8px 11px; border-radius: 8px;
      background: linear-gradient(135deg,var(--accent),var(--accent2));
      color: #fff; text-decoration: none; font-size: 12px; font-weight: 700; margin-bottom: 7px;
    }
    .wg-dl-btn:hover { opacity: .9; }
    .wg-dl-sub { font-size: 10.5px; color: var(--muted); margin-bottom: 7px; line-height: 1.5; }
    .wg-dl-sub strong { color: var(--text); }
    .wg-setup-alt { font-size: 9.5px; font-weight: 700; letter-spacing: .5px; text-transform: uppercase; color: var(--muted); margin: 5px 0; }
    .wg-setup-step { display: flex; gap: 7px; align-items: flex-start; margin-bottom: 4px; }
    .wg-step-n { width: 15px; height: 15px; border-radius: 50%; background: var(--line); color: var(--muted); font-size: 9px; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 1px; }
    .wg-step-t { font-size: 10.5px; color: var(--text2); line-height: 1.45; }
    .wg-step-t strong { color: var(--text); font-weight: 700; }
    .wg-setup-close { margin-top: 7px; width: 100%; padding: 5px; border-radius: 6px; border: 1px solid var(--line); background: var(--bg); cursor: pointer; font-size: 10.5px; font-weight: 600; font-family: var(--font); color: var(--muted); }

    /* ── Scrollable body ── */
    .wg-body { flex: 1; overflow-y: auto; min-height: 0; }
    .wg-body::-webkit-scrollbar { width: 3px }
    .wg-body::-webkit-scrollbar-thumb { background: var(--line); border-radius: 99px }

    .wg-pane { display: none; }
    .wg-pane.active { display: block; }
    .wg-section { border-bottom: 1px solid var(--line); }

    /* ── Section header with + icon ── */
    .wg-sec-hdr { display: flex; align-items: center; gap: 7px; padding: 9px 12px 6px; }
    .wg-sec-label { font-size: 9px; font-weight: 700; letter-spacing: .7px; color: var(--muted); text-transform: uppercase; }
    .wg-sec-pill {
      font-size: 11.5px; font-weight: 700; color: var(--accent);
      background: #eef2ff; padding: 1px 7px; border-radius: 99px; margin-left: auto;
    }
    .wg-sec-pill.note { background: #fef3c7; color: var(--note-acc); }
    .wg-plus {
      width: 22px; height: 22px; border-radius: 50%; border: none; cursor: pointer;
      font-size: 17px; font-weight: 300; line-height: 1;
      display: flex; align-items: center; justify-content: center;
      background: var(--accent); color: #fff; flex-shrink: 0;
      transition: transform .15s, box-shadow .15s;
      box-shadow: 0 2px 8px rgba(99,102,241,.35);
    }
    .wg-plus:hover { transform: scale(1.12); box-shadow: 0 4px 14px rgba(99,102,241,.5); }
    .wg-plus.note { background: var(--note-acc); box-shadow: 0 2px 8px rgba(217,119,6,.35); }
    .wg-plus.note:hover { box-shadow: 0 4px 14px rgba(217,119,6,.5); }
    .wg-chevron { font-size: 10px; color: var(--muted); user-select: none; }

    /* ── Progress bar ── */
    .wg-prog-wrap { padding: 0 12px 2px; }
    .wg-prog-track { height: 4px; background: var(--line); border-radius: 99px; overflow: hidden; }
    .wg-prog-fill { height: 100%; border-radius: 99px; background: linear-gradient(90deg,var(--accent),var(--accent2)); transition: width .6s cubic-bezier(.22,1,.36,1); min-width: 2px; }
    .wg-prog-sub { font-size: 9.5px; color: var(--muted); padding: 2px 12px 5px; }

    /* ── Work entry rows ── */
    .wg-entry {
      display: flex; align-items: flex-start; gap: 7px;
      padding: 5px 12px; cursor: pointer; transition: background .1s;
    }
    .wg-entry:hover { background: #f0f0f8; }
    .wg-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; margin-top: 4px; background: #94a3b8; }
    .wg-dot[data-cat="Development"]   { background: #6366f1 }
    .wg-dot[data-cat="Meeting"]        { background: #f59e0b }
    .wg-dot[data-cat="Code Review"]    { background: #10b981 }
    .wg-dot[data-cat="Testing"]        { background: #8b5cf6 }
    .wg-dot[data-cat="Documentation"]  { background: #06b6d4 }
    .wg-dot[data-cat="DevOps"]         { background: #ef4444 }
    .wg-dot[data-cat="Research"]       { background: #818cf8 }
    .wg-dot[data-cat="Design"]         { background: #ec4899 }
    .wg-desc { flex: 1; font-size: 11.5px; line-height: 1.4; color: var(--text2); word-break: break-word; }
    .wg-desc .wg-proj { opacity: .5; font-size: 10px; }
    .wg-emeta { display: flex; align-items: center; gap: 3px; flex-shrink: 0; }
    .wg-hrs { font-size: 10.5px; font-weight: 600; color: var(--muted); white-space: nowrap; }
    .wg-del {
      width: 16px; height: 16px; border-radius: 4px; border: none; background: transparent;
      cursor: pointer; color: var(--muted); font-size: 10px; opacity: 0;
      transition: opacity .15s, background .1s;
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .wg-entry:hover .wg-del, .wg-note-card:hover .wg-del { opacity: 1; }
    .wg-del:hover { background: #fee2e2; color: #ef4444; opacity: 1 !important; }

    /* ── Note cards ── */
    .wg-notes-list { padding: 7px 10px 4px; display: flex; flex-direction: column; gap: 6px; }
    .wg-note-card {
      background: var(--note-bg); border: 1px solid var(--note-bd); border-radius: 8px;
      border-left: 3px solid var(--note-acc); padding: 8px 10px;
      position: relative; cursor: pointer; transition: box-shadow .15s, transform .12s;
    }
    .wg-note-card:hover { box-shadow: 0 3px 14px rgba(0,0,0,.12); }
    .wg-note-card.pinned { border-left-color: #6366f1; }
    .wg-note-text { font-size: 12px; line-height: 1.5; color: var(--text); word-break: break-word; padding-right: 40px; }
    .wg-note-meta { font-size: 9.5px; color: var(--muted); margin-top: 4px; }
    .wg-note-actions { position: absolute; top: 5px; right: 5px; display: flex; gap: 3px; opacity: 0; transition: opacity .15s; }
    .wg-note-card:hover .wg-note-actions { opacity: 1; }
    .wg-pin {
      width: 18px; height: 18px; border-radius: 4px; border: none; background: transparent;
      cursor: pointer; font-size: 11px; color: var(--muted);
      display: flex; align-items: center; justify-content: center;
    }
    .wg-pin:hover, .wg-note-card.pinned .wg-pin { color: var(--accent); }

    .wg-empty { padding: 9px 12px 5px; font-size: 11px; color: var(--muted); font-style: italic; }

    /* ── Inline add form ── */
    .wg-form {
      margin: 0 12px 10px;
      border: 1.5px solid var(--accent); border-radius: var(--r);
      background: var(--card); overflow: hidden;
    }
    .wg-form.note-form { border-color: var(--note-acc); background: var(--note-bg); }
    .wg-ta {
      width: 100%; border: none; outline: none; resize: none;
      padding: 8px 10px 3px; font-size: 12px; font-family: var(--font);
      color: var(--text); background: transparent; line-height: 1.45;
      min-height: 36px; max-height: 85px;
    }
    .wg-ta::placeholder { color: var(--muted); }
    .wg-form-row { display: flex; align-items: center; gap: 4px; padding: 2px 6px 6px; }
    .wg-form-sel {
      flex: 1; min-width: 80px; border: 1px solid var(--line); border-radius: 6px;
      padding: 3px 6px; font-size: 11px; font-family: var(--font); color: var(--text); background: var(--bg); outline: none;
    }
    .wg-hrs-ctrl { display: flex; align-items: center; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; background: var(--bg); flex-shrink: 0; }
    .wg-hrs-ctrl button { width: 22px; height: 24px; border: none; background: transparent; cursor: pointer; font-size: 13px; color: var(--muted); font-family: var(--font); line-height: 1; }
    .wg-hrs-ctrl button:hover { background: var(--line); }
    .wg-hrs-val { font-size: 11px; font-weight: 700; color: var(--text); min-width: 20px; text-align: center; }
    .wg-save-btn {
      padding: 4px 9px; border-radius: 6px; border: none; cursor: pointer;
      background: linear-gradient(135deg,var(--accent),var(--accent2));
      color: #fff; font-size: 11px; font-weight: 700; font-family: var(--font); flex-shrink: 0;
    }
    .wg-save-btn:disabled { opacity: .4; cursor: default; }
    .wg-save-btn.note { background: linear-gradient(135deg,#f59e0b,#d97706); }
    .wg-proj-inp {
      width: 100%; border: none; border-top: 1px solid var(--line);
      outline: none; padding: 4px 10px; font-size: 11px; font-family: var(--font);
      color: var(--text); background: rgba(255,255,255,.6);
    }
    .wg-proj-inp::placeholder { color: var(--muted); }

    /* ── Week chart ── */
    .wg-week-wrap { padding: 8px 12px 10px; }
    .wg-week-title { font-size: 9px; font-weight: 700; letter-spacing: .7px; color: var(--muted); text-transform: uppercase; margin-bottom: 5px; }
    .wg-week-chart { display: flex; gap: 3px; align-items: flex-end; height: 36px; }
    .wg-week-col { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 3px; }
    .wg-week-bar-wrap { flex: 1; width: 100%; display: flex; align-items: flex-end; background: var(--bg); border-radius: 3px 3px 0 0; }
    .wg-week-bar { width: 100%; border-radius: 3px 3px 0 0; min-height: 2px; background: linear-gradient(180deg,var(--accent2),var(--accent)); }
    .wg-week-day { font-size: 8.5px; color: var(--muted); font-weight: 600; }

    /* ── Footer ── */
    .wg-footer {
      display: flex; align-items: center; justify-content: space-between;
      padding: 6px 12px 7px; background: var(--card); border-top: 1px solid var(--line); flex-shrink: 0;
    }
    .wg-setup-link { font-size: 10.5px; color: var(--muted); background: none; border: none; cursor: pointer; font-family: var(--font); font-weight: 600; padding: 0; }
    .wg-setup-link:hover { color: var(--accent); }
    .wg-full-link { font-size: 10.5px; font-weight: 700; color: var(--accent); text-decoration: none; }
    .wg-full-link:hover { text-decoration: underline; }

    /* ── Expand modal ── */
    .wg-overlay {
      position: fixed; inset: 0; background: rgba(0,0,0,.5); backdrop-filter: blur(3px);
      display: flex; align-items: center; justify-content: center; z-index: 200; padding: 20px;
      animation: wgFadeIn .15s ease;
    }
    @@keyframes wgFadeIn { from { opacity: 0 } to { opacity: 1 } }
    .wg-expand-card {
      background: var(--card); border-radius: 16px; padding: 0;
      width: 100%; max-width: 380px;
      box-shadow: 0 24px 80px rgba(0,0,0,.3);
      overflow: hidden;
      animation: wgSlideUp .2s cubic-bezier(.22,1,.36,1);
    }
    .wg-expand-card.note-card { background: var(--note-bg); border: 1px solid var(--note-bd); }
    @@keyframes wgSlideUp { from { transform: translateY(16px); opacity: 0 } to { transform: translateY(0); opacity: 1 } }
    .wg-exp-header {
      display: flex; align-items: center; gap: 10px;
      padding: 14px 16px 10px;
    }
    .wg-exp-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; background: #94a3b8; }
    .wg-exp-cat { font-size: 11px; font-weight: 700; color: var(--muted); flex: 1; }
    .wg-exp-close {
      width: 26px; height: 26px; border-radius: 8px; border: 1px solid var(--line);
      background: var(--bg); cursor: pointer; font-size: 13px; color: var(--muted);
      display: flex; align-items: center; justify-content: center;
    }
    .wg-exp-close:hover { color: var(--text); }
    .wg-exp-body { padding: 4px 16px 16px; }
    .wg-exp-desc {
      font-size: 16px; font-weight: 600; line-height: 1.55; color: var(--text);
      margin-bottom: 12px; word-break: break-word;
    }
    .wg-exp-note-text {
      font-size: 15px; line-height: 1.6; color: var(--text); margin-bottom: 12px;
      word-break: break-word; min-height: 60px;
    }
    .wg-exp-meta { display: flex; gap: 8px; flex-wrap: wrap; }
    .wg-exp-chip {
      font-size: 11px; font-weight: 600; color: var(--text2);
      background: var(--bg); border: 1px solid var(--line);
      padding: 3px 9px; border-radius: 99px;
    }
    .wg-exp-footer {
      display: flex; gap: 8px; padding: 10px 16px 14px; border-top: 1px solid var(--line);
    }
    .wg-exp-del-btn {
      padding: 7px 11px; border-radius: 8px; border: 1px solid #fecaca;
      background: #fff1f2; color: #ef4444; font-size: 11.5px; font-weight: 700;
      cursor: pointer; font-family: var(--font);
    }
    .wg-exp-del-btn:hover { background: #fee2e2; }
    .wg-exp-pin-btn {
      padding: 7px 11px; border-radius: 8px; border: 1px solid var(--line);
      background: var(--bg); color: var(--muted); font-size: 11.5px; font-weight: 600;
      cursor: pointer; font-family: var(--font);
    }
    .wg-exp-pin-btn.active { background: #eef2ff; color: var(--accent); border-color: var(--accent); }
    .wg-exp-save-btn {
      flex: 1; padding: 7px; border-radius: 8px; border: none;
      background: linear-gradient(135deg,var(--accent),var(--accent2));
      color: #fff; font-size: 11.5px; font-weight: 700; cursor: pointer; font-family: var(--font);
    }
    .wg-exp-save-btn.note { background: linear-gradient(135deg,#f59e0b,#d97706); }
    .wg-exp-save-btn:disabled { opacity: .45; cursor: default; }
    /* Editable text in the modal */
    .wg-exp-desc[contenteditable], .wg-exp-note-text[contenteditable] {
      outline: none; border-radius: 6px; padding: 4px 6px; margin: -4px -6px;
      background: rgba(99,102,241,.05); cursor: text;
    }
    .wg-expand-card.note-card .wg-exp-note-text[contenteditable] { background: rgba(217,119,6,.06); }
  </style>
</head>
<body>
  <div class="wg-strip" id="wgStrip"></div>

  <!-- Top bar — draggable region in WCO mode -->
  <div class="wg-bar">
    <a href="/Logs" class="wg-logo" target="_blank" rel="noopener">worklog<span>.</span></a>
    <span class="wg-date">@date · @firstName</span>
    <button class="wg-icon-btn wg-pin-btn" id="wgPinWin" onclick="wgToggleWindowPin()" title="Keep on top (re-open as pinned)">📌</button>
    <button class="wg-icon-btn" onclick="wgToggleSetup()" title="Auto-start setup">⚡</button>
  </div>

  <!-- Tabs -->
  <div class="wg-tabs">
    <button class="wg-tab active" id="tabLog" onclick="wgSwitchTab('log')">
      📋 Log <span class="wg-tab-badge" id="tabLogBadge">@todayWork.Count</span>
    </button>
    <button class="wg-tab notes-tab" id="tabNotes" onclick="wgSwitchTab('notes')">
      📝 Notes <span class="wg-tab-badge" id="tabNotesBadge">@todayNotes.Count</span>
    </button>
  </div>

  <!-- WCO spacer: invisible flex item that offsets content below fixed tab bar -->
  <div class="wg-wco-spacer"></div>

  <!-- Setup drawer -->
  <div class="wg-setup-drawer" id="wgSetup" style="display:none">
    <div class="wg-setup-title">⚡ Auto-start with Windows</div>
    <a href="/Logs/SetupScript" class="wg-dl-btn" download="setup-worklog-widget.ps1">
      ⬇ Download setup script (.ps1)
    </a>
    <div class="wg-dl-sub">Download → right-click → <strong>Run with PowerShell</strong>. Creates startup + desktop shortcuts. One time only.</div>
    <div class="wg-setup-alt">Or manual steps</div>
    <div class="wg-setup-step">
      <div class="wg-step-n">1</div>
      <div class="wg-step-t">Install as PWA — click <strong>⊕</strong> in Edge/Chrome address bar</div>
    </div>
    <div class="wg-setup-step">
      <div class="wg-step-n">2</div>
      <div class="wg-step-t">Three-dot menu inside the app → <strong>Open at login</strong></div>
    </div>
    <button class="wg-setup-close" onclick="wgToggleSetup()">✕ Close</button>
  </div>

  <!-- Body -->
  <div class="wg-body">

    <!-- ═══ LOG TAB ═══ -->
    <div class="wg-pane active" id="paneLog">
      <div class="wg-section">
        <div class="wg-sec-hdr">
          <span class="wg-sec-label">Today</span>
          <span class="wg-sec-pill" id="wgTodayPill">@todayH.ToString("F1") h</span>
          <button class="wg-plus" onclick="wgToggleLogForm(event)" title="Add log entry">+</button>
        </div>
        <div class="wg-prog-wrap">
          <div class="wg-prog-track">
            <div class="wg-prog-fill" id="wgProgFill" style="width:@pct.ToString("F0")%"></div>
          </div>
        </div>
        <div class="wg-prog-sub" id="wgProgSub">@pct.ToString("F0")% of @goal h daily goal</div>

        @foreach (var e in todayWork)
        {
          <div class="wg-entry" id="wge-@e.Id" onclick="wgOpenLogModal(@e.Id,'@System.Web.HttpUtility.JavaScriptStringEncode(e.Description)','@e.Tags','@e.Hours','@System.Web.HttpUtility.JavaScriptStringEncode(e.Project ?? "")')">
            <span class="wg-dot" data-cat="@e.Tags"></span>
            <span class="wg-desc">@e.Description@if (!string.IsNullOrWhiteSpace(e.Project) && e.Project != e.Tags){<span class="wg-proj"> · @e.Project</span>}</span>
            <div class="wg-emeta">
              <span class="wg-hrs">@e.Hours h</span>
              <button class="wg-del" onclick="event.stopPropagation();wgDelete(@e.Id,'log')">✕</button>
            </div>
          </div>
        }
        @if (!todayWork.Any()) { <div class="wg-empty" id="wgLogEmpty">No entries yet today.</div> }

        <div class="wg-form" id="wgLogForm" style="display:none">
          <textarea class="wg-ta" id="wgLogDesc" rows="2" placeholder="What did you work on?"
            oninput="wgAutosize(this)" onkeydown="wgLogKey(event)"></textarea>
          <div class="wg-form-row">
            <select class="wg-form-sel" id="wgCat">
              <option>Development</option><option>Meeting</option><option>Code Review</option>
              <option>Testing</option><option>Documentation</option><option>Research</option>
              <option>Design</option><option>DevOps</option><option>Other</option>
            </select>
            <div class="wg-hrs-ctrl">
              <button type="button" onclick="wgStep(-0.5)">−</button>
              <span class="wg-hrs-val" id="wgHrsVal">1</span>
              <button type="button" onclick="wgStep(0.5)">+</button>
            </div>
            <button class="wg-save-btn" id="wgLogSaveBtn" onclick="wgSaveLog()">Add →</button>
          </div>
          <input class="wg-proj-inp" id="wgProj" placeholder="Project (optional)" list="wgProjList">
          <datalist id="wgProjList">@foreach (var p in projects) { <option value="@p"></option> }</datalist>
        </div>
      </div>

      @if (ydayWork.Any())
      {
      <div class="wg-section">
        <div class="wg-sec-hdr" onclick="wgToggleSection('wgYday','wgYdayChev')" style="cursor:pointer">
          <span class="wg-sec-label">Yesterday</span>
          <span class="wg-sec-pill">@ydayH.ToString("F1") h</span>
          <span class="wg-chevron" id="wgYdayChev">▾</span>
        </div>
        <div id="wgYday">
          @foreach (var e in ydayWork)
          {
            <div class="wg-entry" onclick="wgOpenLogModal(@e.Id,'@System.Web.HttpUtility.JavaScriptStringEncode(e.Description)','@e.Tags','@e.Hours','@System.Web.HttpUtility.JavaScriptStringEncode(e.Project ?? "")')">
              <span class="wg-dot" data-cat="@e.Tags"></span>
              <span class="wg-desc">@e.Description@if (!string.IsNullOrWhiteSpace(e.Project) && e.Project != e.Tags){<span class="wg-proj"> · @e.Project</span>}</span>
              <span class="wg-hrs">@e.Hours h</span>
            </div>
          }
        </div>
      </div>
      }

      <div class="wg-week-wrap">
        <div class="wg-week-title">This Week</div>
        <div class="wg-week-chart" id="wgWeekChart"></div>
      </div>
    </div>

    <!-- ═══ NOTES TAB ═══ -->
    <div class="wg-pane" id="paneNotes">
      <div class="wg-section">
        <div class="wg-sec-hdr">
          <span class="wg-sec-label" style="color:#d97706">Today's Notes</span>
          <span class="wg-sec-pill note" id="wgNotesPill">@todayNotes.Count</span>
          <button class="wg-plus note" onclick="wgToggleNoteForm(event)" title="Add note">+</button>
        </div>

        <div class="wg-notes-list" id="wgNotesList">
          @foreach (var e in todayNotes)
          {
            <div class="wg-note-card" id="wge-@e.Id"
              onclick="wgOpenNoteModal(@e.Id,'@System.Web.HttpUtility.JavaScriptStringEncode(e.Description)','@System.Web.HttpUtility.JavaScriptStringEncode(e.Project ?? "")')">
              <div class="wg-note-text">@e.Description</div>
              @if (!string.IsNullOrWhiteSpace(e.Project) && e.Project != "Notes")
              {
                <div class="wg-note-meta">@e.Project</div>
              }
              <div class="wg-note-actions" onclick="event.stopPropagation()">
                <button class="wg-pin" onclick="wgPinNote(@e.Id)" title="Pin">📌</button>
                <button class="wg-del" onclick="wgDelete(@e.Id,'note')">✕</button>
              </div>
            </div>
          }
        </div>
        @if (!todayNotes.Any()) { <div class="wg-empty" id="wgNotesEmpty">No notes yet today.</div> }

        <div class="wg-form note-form" id="wgNoteForm" style="display:none">
          <textarea class="wg-ta" id="wgNoteDesc" rows="3" placeholder="Write a note…"
            oninput="wgAutosize(this)" onkeydown="wgNoteKey(event)"></textarea>
          <div class="wg-form-row">
            <input style="flex:1;border:1px solid var(--line);border-radius:6px;padding:3px 7px;font-size:11px;font-family:var(--font);color:var(--text);background:var(--bg);outline:none"
              id="wgNoteProj" placeholder="Tag / project (optional)" list="wgProjList">
            <button class="wg-save-btn note" id="wgNoteSaveBtn" onclick="wgSaveNote()">Add →</button>
          </div>
        </div>
      </div>

      @if (ydayNotes.Any())
      {
      <div class="wg-section">
        <div class="wg-sec-hdr" onclick="wgToggleSection('wgYdayNotes','wgYdayNotesChev')" style="cursor:pointer">
          <span class="wg-sec-label" style="color:#d97706">Yesterday</span>
          <span class="wg-sec-pill note">@ydayNotes.Count</span>
          <span class="wg-chevron" id="wgYdayNotesChev">▾</span>
        </div>
        <div id="wgYdayNotes">
          @foreach (var e in ydayNotes)
          {
            <div class="wg-note-card" style="margin:0 10px 6px"
              onclick="wgOpenNoteModal(@e.Id,'@System.Web.HttpUtility.JavaScriptStringEncode(e.Description)','@System.Web.HttpUtility.JavaScriptStringEncode(e.Project ?? "")')">
              <div class="wg-note-text">@e.Description</div>
              @if (!string.IsNullOrWhiteSpace(e.Project) && e.Project != "Notes")
              {
                <div class="wg-note-meta">@e.Project</div>
              }
            </div>
          }
        </div>
      </div>
      }
    </div>

  </div>

  <!-- Footer -->
  <div class="wg-footer">
    <button class="wg-setup-link" id="wgSetupFooterBtn" onclick="wgToggleSetup()">⚡ Auto-start</button>
    <a href="/Logs" class="wg-full-link" target="_blank" rel="noopener">Full app →</a>
  </div>

  <!-- ═══ EXPAND MODAL ═══ -->
  <div class="wg-overlay" id="wgOverlay" style="display:none" onclick="if(event.target===this)wgCloseModal()">
    <div class="wg-expand-card" id="wgExpandCard">
      <div class="wg-exp-header">
        <div class="wg-exp-dot" id="wgExpDot"></div>
        <span class="wg-exp-cat" id="wgExpCat"></span>
        <button class="wg-exp-close" onclick="wgCloseModal()">✕</button>
      </div>
      <div class="wg-exp-body">
        <div class="wg-exp-desc" id="wgExpDesc"></div>
        <div class="wg-exp-note-text" id="wgExpNoteText" style="display:none"></div>
        <div class="wg-exp-meta" id="wgExpMeta"></div>
      </div>
      <div class="wg-exp-footer" id="wgExpFooter">
        <button class="wg-exp-pin-btn" id="wgExpPinBtn" style="display:none" onclick="wgExpPinToggle()">📌 Pin</button>
        <button class="wg-exp-del-btn" id="wgExpDelBtn" onclick="wgExpDelete()">🗑</button>
        <button class="wg-exp-save-btn" id="wgExpSaveBtn" onclick="wgExpSave()">Save</button>
      </div>
    </div>
  </div>

  <script>
  let _wgHrs   = 1;
  let _wgToday = @todayH;
  const _wgGoal = @goal;
  let _logCount  = @todayWork.Count;
  let _noteCount = @todayNotes.Count;
  let _modalId   = null;
  let _modalType = null;
  const _pins    = new Set(JSON.parse(localStorage.getItem('wg_pins') || '[]'));

  // PWA resize — restore saved size or default 400×660 (sticky-note style)
  if (window.matchMedia('(display-mode: standalone)').matches ||
      window.matchMedia('(display-mode: window-controls-overlay)').matches) {
    try {
      const savedW = parseInt(localStorage.getItem('wg_w') || '0');
      const savedH = parseInt(localStorage.getItem('wg_h') || '0');
      window.resizeTo(savedW > 260 ? savedW : 360, savedH > 200 ? savedH : 560);
    } catch {}
    // Save size when user resizes
    let _rsTimer;
    window.addEventListener('resize', () => {
      clearTimeout(_rsTimer);
      _rsTimer = setTimeout(() => {
        try { localStorage.setItem('wg_w', window.outerWidth); localStorage.setItem('wg_h', window.outerHeight); } catch {}
      }, 400);
    });
  }

  // Apply pins on load
  _pins.forEach(id => {
    const card = document.getElementById(`wge-${id}`);
    if (card) { card.classList.add('pinned'); }
  });

  // Week chart
  const _weekData = @Html.Raw(weekJson);
  const _chartEl  = document.getElementById('wgWeekChart');
  if (_weekData.length) {
    _chartEl.innerHTML = _weekData.map(w => {
      const p = Math.min((w.h / _wgGoal) * 100, 100);
      return `<div class="wg-week-col">
        <div class="wg-week-bar-wrap"><div class="wg-week-bar" style="height:${p.toFixed(0)}%"></div></div>
        <div class="wg-week-day">${w.d}</div></div>`;
    }).join('');
  } else {
    _chartEl.innerHTML = '<div style="font-size:10px;color:var(--muted)">No data yet</div>';
  }

  /* ── Tabs ── */
  function wgSwitchTab(tab) {
    document.getElementById('tabLog').classList.toggle('active', tab==='log');
    document.getElementById('tabNotes').classList.toggle('active', tab==='notes');
    document.getElementById('paneLog').classList.toggle('active', tab==='log');
    document.getElementById('paneNotes').classList.toggle('active', tab==='notes');
    const strip = document.getElementById('wgStrip');
    if (strip) strip.className = tab==='notes' ? 'wg-strip notes' : 'wg-strip';
    document.getElementById('wgSetup').style.display = 'none';
    // Hide auto-start button on Notes tab (it's a Log/setup feature)
    const setupBtn = document.getElementById('wgSetupFooterBtn');
    if (setupBtn) setupBtn.style.display = tab==='log' ? '' : 'none';
    _closeLogForm(); _closeNoteForm();
  }

  /* ── Setup drawer ── */
  function wgToggleSetup() {
    const d = document.getElementById('wgSetup');
    d.style.display = d.style.display==='none' ? 'block' : 'none';
  }

  /* ── Window pin (saves flag in localStorage, user can set PWA to always-on-top via OS) ── */
  function wgToggleWindowPin() {
    const btn = document.getElementById('wgPinWin');
    btn.classList.toggle('pinned');
    // Edge/Chrome PWA: we can't force always-on-top from JS.
    // Instead open in a new standalone window with alwaysOnTop hint via URL param.
    alert('To keep this window on top:\n1. Right-click the taskbar icon → "Always on top"\n   (or use the OS window snapping feature)\n2. On Windows 11: right-click title bar → "Always on top"');
  }

  /* ── Log form ── */
  function wgToggleLogForm(e) {
    if (e) e.stopPropagation();
    const f = document.getElementById('wgLogForm');
    f.style.display === 'none' ? (_openLogForm()) : (_closeLogForm());
  }
  function _openLogForm() {
    document.getElementById('wgLogForm').style.display = 'block';
    setTimeout(() => document.getElementById('wgLogDesc').focus(), 50);
  }
  function _closeLogForm() {
    document.getElementById('wgLogForm').style.display = 'none';
    document.getElementById('wgLogDesc').value = '';
    document.getElementById('wgProj').value = '';
    _wgHrs = 1; document.getElementById('wgHrsVal').textContent = '1';
  }
  function wgLogKey(e) {
    if (e.key==='Enter' && !e.shiftKey) { e.preventDefault(); wgSaveLog(); }
    if (e.key==='Escape') _closeLogForm();
  }
  function wgStep(d) {
    _wgHrs = Math.max(0.25, Math.round((_wgHrs+d)*4)/4);
    document.getElementById('wgHrsVal').textContent = _wgHrs%1===0 ? String(_wgHrs) : _wgHrs.toFixed(2);
  }
  async function wgSaveLog() {
    const desc = document.getElementById('wgLogDesc').value.trim();
    if (!desc) { document.getElementById('wgLogDesc').focus(); return; }
    const btn = document.getElementById('wgLogSaveBtn');
    btn.disabled = true; btn.textContent = '…';
    try {
      const res = await fetch('/Logs/QuickAdd', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ description: desc, hours: _wgHrs,
          category: document.getElementById('wgCat').value,
          project: document.getElementById('wgProj').value.trim() || null })
      });
      if (res.ok) {
        const e = await res.json();
        _addLogRow(e); _updateProgress(e.hours); _closeLogForm();
      }
    } finally { btn.disabled=false; btn.textContent='Add →'; }
  }
  function _addLogRow(e) {
    document.getElementById('wgLogEmpty')?.remove();
    const proj = e.project && e.project!==e.category ? `<span class="wg-proj"> · ${_esc(e.project)}</span>`:'';
    const row = document.createElement('div');
    row.className='wg-entry'; row.id=`wge-${e.id}`;
    row.setAttribute('onclick', `wgOpenLogModal(${e.id},'${_jsStr(e.description)}','${_jsStr(e.category)}','${e.hours}','')`);
    row.innerHTML=`<span class="wg-dot" data-cat="${_esc(e.category)}"></span>
      <span class="wg-desc">${_esc(e.description)}${proj}</span>
      <div class="wg-emeta"><span class="wg-hrs">${e.hours} h</span>
      <button class="wg-del" onclick="event.stopPropagation();wgDelete(${e.id},'log')">✕</button></div>`;
    document.getElementById('wgLogForm').before(row);
    _logCount++; document.getElementById('tabLogBadge').textContent=_logCount;
  }
  function _updateProgress(delta) {
    _wgToday += Number(delta);
    const p = Math.min(_wgToday/_wgGoal*100,100);
    document.getElementById('wgProgFill').style.width=p.toFixed(0)+'%';
    document.getElementById('wgProgSub').textContent=`${p.toFixed(0)}% of ${_wgGoal} h daily goal`;
    document.getElementById('wgTodayPill').textContent=_wgToday.toFixed(1)+' h';
  }

  /* ── Note form ── */
  function wgToggleNoteForm(e) {
    if (e) e.stopPropagation();
    const f = document.getElementById('wgNoteForm');
    f.style.display==='none' ? _openNoteForm() : _closeNoteForm();
  }
  function _openNoteForm() {
    document.getElementById('wgNoteForm').style.display='block';
    setTimeout(()=>document.getElementById('wgNoteDesc').focus(),50);
  }
  function _closeNoteForm() {
    document.getElementById('wgNoteForm').style.display='none';
    document.getElementById('wgNoteDesc').value='';
    document.getElementById('wgNoteProj').value='';
  }
  function wgNoteKey(e) { if (e.key==='Escape') _closeNoteForm(); }
  async function wgSaveNote() {
    const desc = document.getElementById('wgNoteDesc').value.trim();
    if (!desc) { document.getElementById('wgNoteDesc').focus(); return; }
    const btn = document.getElementById('wgNoteSaveBtn');
    btn.disabled=true; btn.textContent='…';
    try {
      const res = await fetch('/Logs/QuickAdd', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ description:desc, hours:0.25, category:'Notes',
          project: document.getElementById('wgNoteProj').value.trim()||null })
      });
      if (res.ok) { const e=await res.json(); _addNoteCard(e); _closeNoteForm(); }
    } finally { btn.disabled=false; btn.textContent='Add →'; }
  }
  function _addNoteCard(e) {
    document.getElementById('wgNotesEmpty')?.remove();
    const proj = e.project && e.project!=='Notes' ? `<div class="wg-note-meta">${_esc(e.project)}</div>`:'';
    const card = document.createElement('div');
    card.className='wg-note-card'; card.id=`wge-${e.id}`;
    card.setAttribute('onclick',`wgOpenNoteModal(${e.id},'${_jsStr(e.description)}','')`);
    card.innerHTML=`<div class="wg-note-text">${_esc(e.description)}</div>${proj}
      <div class="wg-note-actions" onclick="event.stopPropagation()">
        <button class="wg-pin" onclick="wgPinNote(${e.id})" title="Pin">📌</button>
        <button class="wg-del" onclick="wgDelete(${e.id},'note')">✕</button></div>`;
    // Prepend pinned notes before unpinned
    const list = document.getElementById('wgNotesList');
    list.appendChild(card);
    _noteCount++; document.getElementById('tabNotesBadge').textContent=_noteCount;
    document.getElementById('wgNotesPill').textContent=_noteCount;
  }

  /* ── Pin note ── */
  function wgPinNote(id) {
    const card = document.getElementById(`wge-${id}`);
    if (!card) return;
    if (_pins.has(id)) {
      _pins.delete(id); card.classList.remove('pinned');
    } else {
      _pins.add(id); card.classList.add('pinned');
      // Move to top of list
      const list = document.getElementById('wgNotesList');
      list.prepend(card);
    }
    localStorage.setItem('wg_pins', JSON.stringify([..._pins]));
  }

  /* ── Delete ── */
  async function wgDelete(id, type) {
    if (!confirm('Remove this entry?')) return;
    const res = await fetch('/Logs/DeleteEntry', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({id})
    });
    if (res.ok) {
      document.getElementById(`wge-${id}`)?.remove();
      _pins.delete(id); localStorage.setItem('wg_pins',JSON.stringify([..._pins]));
      if (type==='log') { _logCount=Math.max(0,_logCount-1); document.getElementById('tabLogBadge').textContent=_logCount; }
      else { _noteCount=Math.max(0,_noteCount-1); document.getElementById('tabNotesBadge').textContent=_noteCount; document.getElementById('wgNotesPill').textContent=_noteCount; }
      if (_modalId===id) wgCloseModal();
    }
  }

  /* ── Section collapse ── */
  function wgToggleSection(listId, chevId) {
    const l=document.getElementById(listId), c=document.getElementById(chevId);
    if (!l) return;
    const h=l.style.display==='none';
    l.style.display=h?'':'none';
    if(c) c.textContent=h?'▾':'▸';
  }

  function wgAutosize(el) {
    el.style.height='auto';
    el.style.height=Math.min(el.scrollHeight,85)+'px';
  }

  /* ── Log expand modal ── */
  const _dotColors = {
    Development:'#6366f1',Meeting:'#f59e0b','Code Review':'#10b981',
    Testing:'#8b5cf6',Documentation:'#06b6d4',DevOps:'#ef4444',
    Research:'#818cf8',Design:'#ec4899',Notes:'#f59e0b'
  };
  function wgOpenLogModal(id, desc, cat, hrs, proj) {
    _modalId=id; _modalType='log';
    const card = document.getElementById('wgExpandCard');
    card.classList.remove('note-card');
    document.getElementById('wgExpSaveBtn').className='wg-exp-save-btn';
    document.getElementById('wgExpDot').style.background = _dotColors[cat]||'#94a3b8';
    document.getElementById('wgExpCat').textContent = cat;
    const descEl = document.getElementById('wgExpDesc');
    descEl.textContent = desc;
    descEl.contentEditable = 'true';
    descEl.style.display='block';
    document.getElementById('wgExpNoteText').style.display='none';
    document.getElementById('wgExpNoteText').contentEditable='false';
    const meta = document.getElementById('wgExpMeta');
    meta.innerHTML = `<span class="wg-exp-chip">${hrs} h</span>${proj?`<span class="wg-exp-chip">${_esc(proj)}</span>`:''}`;
    document.getElementById('wgExpPinBtn').style.display='none';
    document.getElementById('wgExpDelBtn').style.display='';
    document.getElementById('wgExpSaveBtn').style.display='';
    document.getElementById('wgOverlay').style.display='flex';
    // Focus and place cursor at end
    setTimeout(() => { descEl.focus(); const r=document.createRange(); r.selectNodeContents(descEl); r.collapse(false); const s=window.getSelection(); s.removeAllRanges(); s.addRange(r); }, 80);
  }

  /* ── Note expand modal ── */
  function wgOpenNoteModal(id, text, proj) {
    _modalId=id; _modalType='note';
    const card = document.getElementById('wgExpandCard');
    card.classList.add('note-card');
    document.getElementById('wgExpSaveBtn').className='wg-exp-save-btn note';
    document.getElementById('wgExpDot').style.background='#f59e0b';
    document.getElementById('wgExpCat').textContent='Note';
    document.getElementById('wgExpDesc').style.display='none';
    document.getElementById('wgExpDesc').contentEditable='false';
    const noteEl = document.getElementById('wgExpNoteText');
    noteEl.textContent=text;
    noteEl.contentEditable='true';
    noteEl.style.display='block';
    const meta=document.getElementById('wgExpMeta');
    meta.innerHTML=proj?`<span class="wg-exp-chip">${_esc(proj)}</span>`:'';
    const pinBtn=document.getElementById('wgExpPinBtn');
    pinBtn.style.display='';
    pinBtn.textContent=_pins.has(id)?'📌 Unpin':'📌 Pin';
    pinBtn.classList.toggle('active',_pins.has(id));
    document.getElementById('wgExpDelBtn').style.display='';
    document.getElementById('wgExpSaveBtn').style.display='';
    document.getElementById('wgOverlay').style.display='flex';
    setTimeout(() => { noteEl.focus(); const r=document.createRange(); r.selectNodeContents(noteEl); r.collapse(false); const s=window.getSelection(); s.removeAllRanges(); s.addRange(r); }, 80);
  }

  function wgCloseModal() {
    document.getElementById('wgOverlay').style.display='none';
    document.getElementById('wgExpDesc').contentEditable='false';
    document.getElementById('wgExpNoteText').contentEditable='false';
    _modalId=null; _modalType=null;
  }
  function wgExpPinToggle() {
    if (_modalId!=null) wgPinNote(_modalId);
    const btn=document.getElementById('wgExpPinBtn');
    btn.textContent=_pins.has(_modalId)?'📌 Unpin':'📌 Pin';
    btn.classList.toggle('active',_pins.has(_modalId));
  }
  function wgExpDelete() {
    if (_modalId!=null) wgDelete(_modalId, _modalType);
  }
  async function wgExpSave() {
    if (_modalId==null) return;
    const isNote = _modalType==='note';
    const el = isNote ? document.getElementById('wgExpNoteText') : document.getElementById('wgExpDesc');
    const newText = el.textContent.trim();
    if (!newText) return;
    const btn = document.getElementById('wgExpSaveBtn');
    btn.disabled=true; btn.textContent='Saving…';
    try {
      const res = await fetch('/Logs/UpdateEntry', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ id:_modalId, description:newText })
      });
      if (res.ok) {
        // Update the card in the list
        const card = document.getElementById(`wge-${_modalId}`);
        if (card) {
          const textEl = card.querySelector(isNote ? '.wg-note-text' : '.wg-desc');
          if (textEl) textEl.childNodes[0].textContent = newText;
          // Update onclick with new text
          const escaped = _jsStr(newText);
          if (isNote) card.setAttribute('onclick',`wgOpenNoteModal(${_modalId},'${escaped}','')`);
          else { const prev = card.getAttribute('onclick'); card.setAttribute('onclick', prev.replace(/^wgOpenLogModal\(\d+,'[^']*'/, `wgOpenLogModal(${_modalId},'${escaped}'`)); }
        }
        wgCloseModal();
      } else { btn.disabled=false; btn.textContent='Save'; }
    } catch { btn.disabled=false; btn.textContent='Save'; }
  }

  // N key → open active tab's form; Escape → close modal
  document.addEventListener('keydown', e => {
    if (e.key==='Escape') { wgCloseModal(); _closeLogForm(); _closeNoteForm(); return; }
    const tag=document.activeElement.tagName;
    if (e.key==='n'&&!e.ctrlKey&&!e.metaKey&&tag!=='INPUT'&&tag!=='TEXTAREA'&&tag!=='SELECT') {
      document.getElementById('paneLog').classList.contains('active')?wgToggleLogForm():wgToggleNoteForm();
    }
  });

  function _esc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  }
  // Safe for embedding in single-quoted JS string literals inside onclick attributes
  function _jsStr(s) {
    return String(s).replace(/\\/g,'\\\\').replace(/'/g,"\\'").replace(/\n/g,'\\n').replace(/\r/g,'');
  }
  </script>
</body>
</html>
