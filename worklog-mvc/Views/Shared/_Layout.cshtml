<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>@(ViewData["Title"] ?? "WorkLog")</title>
  <meta name="description" content="@(ViewData["Description"] ?? "WorkLog — simple, AI-powered work logging for teams and individuals.")">
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="#6366f1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="WorkLog">
  <link rel="manifest" href="/manifest.json">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
  @RenderSection("Styles", required: false)
</head>
<body>

<nav class="topnav">
  <a href="/" class="t-logo">worklog<span>.</span></a>
  <div class="t-links">
    <a asp-controller="Logs" asp-action="Index"
       class="t-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Logs" ? "t-link-on" : "")">Logs</a>
    <a asp-controller="Timesheet" asp-action="Index"
       class="t-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Timesheet" ? "t-link-on" : "")">Timesheet</a>
    <a asp-controller="Recurring" asp-action="Index"
       class="t-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Recurring" ? "t-link-on" : "")">↺ Recurring</a>
    @* Growth hidden — re-enable by uncommenting:
    @{
      var growthActive = new[]{"Growth","Achievements","Experience","Learning"}
        .Contains(ViewContext.RouteData.Values["controller"]?.ToString() ?? "");
    }
    <a asp-controller="Growth" asp-action="Index"
       class="t-link @(growthActive ? "t-link-on" : "")">🌱 Growth</a>
    *@
  </div>
  <div class="t-right">
    @if (ViewBag.TodayHours is decimal th && th > 0)
    {
      <span class="t-stat">@th h today</span>
    }
    <div class="t-avatar">@(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "?")</div>
    <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0" id="logoutForm">
      @Html.AntiForgeryToken()
      <button type="submit" class="t-signout">Sign out</button>
    </form>
  </div>
  <button class="t-menu-btn" id="tMenuBtn" aria-label="Open menu">&#9776;</button>
</nav>

<div class="t-mobile-drawer" id="tMobileDrawer">
  <a asp-controller="Logs" asp-action="Index"
     class="t-drawer-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Logs" ? "t-link-on" : "")">Logs</a>
  <a asp-controller="Timesheet" asp-action="Index"
     class="t-drawer-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Timesheet" ? "t-link-on" : "")">Timesheet</a>
  <a asp-controller="Recurring" asp-action="Index"
     class="t-drawer-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Recurring" ? "t-link-on" : "")">↺ Recurring</a>
  <div class="t-drawer-divider"></div>
  @* Growth hidden — uncomment to restore:
  <a asp-controller="Growth" asp-action="Index" class="t-drawer-link">🌱 Growth</a>
  <div class="t-drawer-divider"></div>
  *@
  <button class="t-drawer-signout" onclick="document.getElementById('logoutForm').submit()">Sign out</button>
</div>

<main class="main-wrap">
  @RenderBody()
</main>

<footer class="app-footer">
  <div class="af-inner">
    <span class="af-copy">&copy; 2026 WorkLog</span>
    <nav class="af-links">
      <a asp-controller="Home" asp-action="About">About</a>
      <a asp-controller="Home" asp-action="Privacy">Privacy</a>
      <a asp-controller="Home" asp-action="Terms">Terms</a>
      <a asp-controller="Home" asp-action="Contact">Contact</a>
      <button class="af-feedback" onclick="openFeedback()">💬 Feedback</button>
    </nav>
  </div>
</footer>

@if (TempData["Toast"] is string toast)
{
  <div class="toast-wrap" id="tw"><div class="toast">@toast</div></div>
  <script>setTimeout(()=>document.getElementById('tw')?.remove(), 3000)</script>
}
@if (TempData["Error"] is string err)
{
  <div class="toast-wrap toast-err" id="twe"><div class="toast">@err</div></div>
  <script>setTimeout(()=>document.getElementById('twe')?.remove(), 4000)</script>
}

<script>
  // Hamburger
  const btn = document.getElementById('tMenuBtn');
  const drawer = document.getElementById('tMobileDrawer');
  if (btn && drawer) {
    btn.addEventListener('click', () => {
      drawer.classList.toggle('open');
      btn.textContent = drawer.classList.contains('open') ? '✕' : '☰';
    });
    document.addEventListener('click', e => {
      if (!btn.contains(e.target) && !drawer.contains(e.target)) {
        drawer.classList.remove('open');
        btn.textContent = '☰';
      }
    });
  }
</script>

<!-- ── Feedback modal ─────────────────────────────────────────────────────── -->
<div class="fb-overlay" id="fbOverlay" onclick="if(event.target===this)closeFeedback()" style="display:none">
  <div class="fb-panel">
    <div class="fb-hdr">
      <div>
        <div class="fb-title">💬 Share your feedback</div>
        <div class="fb-sub">Help us make WorkLog better for you</div>
      </div>
      <button class="fb-close" onclick="closeFeedback()">✕</button>
    </div>
    <div class="fb-body">
      <div class="fb-q">How would you rate WorkLog?</div>
      <div class="fb-stars" id="fbStars">
        <button type="button" class="fb-star" onclick="fbRate(1)">★</button>
        <button type="button" class="fb-star" onclick="fbRate(2)">★</button>
        <button type="button" class="fb-star" onclick="fbRate(3)">★</button>
        <button type="button" class="fb-star" onclick="fbRate(4)">★</button>
        <button type="button" class="fb-star" onclick="fbRate(5)">★</button>
      </div>
      <div class="fb-field">
        <label class="fb-lbl">Category</label>
        <select class="fb-sel" id="fbCat">
          <option value="General Feedback">General Feedback</option>
          <option value="Feature Request">Feature Request</option>
          <option value="Bug Report">Bug Report</option>
          <option value="UI Improvement">UI Improvement</option>
          <option value="Performance">Performance</option>
        </select>
      </div>
      <div class="fb-field">
        <label class="fb-lbl">Tell us more <span style="font-weight:400;opacity:.45">(optional)</span></label>
        <textarea class="fb-ta" id="fbMsg" placeholder="What's on your mind?" rows="3" maxlength="1000"></textarea>
      </div>
      <button class="fb-submit" id="fbSubmitBtn" onclick="submitFeedback()">Send Feedback →</button>
      <div class="fb-success hidden" id="fbSuccess">✓ Thank you! Your feedback helps us improve WorkLog.</div>
    </div>
  </div>
</div>

<script>
let _fbRating = 0;
function openFeedback() {
  _fbRating = 0;
  document.querySelectorAll('.fb-star').forEach(s => s.classList.remove('on'));
  document.getElementById('fbMsg').value = '';
  document.getElementById('fbSuccess').classList.add('hidden');
  const btn = document.getElementById('fbSubmitBtn');
  btn.style.display = ''; btn.disabled = false; btn.textContent = 'Send Feedback →';
  document.getElementById('fbOverlay').style.display = 'flex';
}
function closeFeedback() { document.getElementById('fbOverlay').style.display = 'none'; }
function fbRate(n) {
  _fbRating = n;
  document.querySelectorAll('.fb-star').forEach((s, i) => s.classList.toggle('on', i < n));
}
async function submitFeedback() {
  if (!_fbRating) { alert('Please select a rating first.'); return; }
  const btn = document.getElementById('fbSubmitBtn');
  btn.disabled = true; btn.textContent = 'Sending…';
  try {
    const res = await fetch('/Feedback/Submit', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ rating: _fbRating, category: document.getElementById('fbCat').value, message: document.getElementById('fbMsg').value.trim() }),
    });
    if (res.ok) {
      btn.style.display = 'none';
      document.getElementById('fbSuccess').classList.remove('hidden');
      setTimeout(closeFeedback, 2800);
    } else { btn.disabled = false; btn.textContent = 'Send Feedback →'; }
  } catch { btn.disabled = false; btn.textContent = 'Send Feedback →'; }
}
</script>

@RenderSection("Scripts", required: false)
<a href="https://buymeacoffee.com/zaintahir512" target="_blank" rel="noopener" class="bmc-float" title="Support WorkLog — Buy me a coffee">☕</a>
<script>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
  }
</script>
</body>
</html>
