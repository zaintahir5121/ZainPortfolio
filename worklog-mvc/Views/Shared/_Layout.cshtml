<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>@(ViewData["Title"] is string t ? t + " — worklog." : "worklog.")</title>
  <meta name="description" content="@(ViewData["Description"] as string ?? "worklog. — AI-powered work log and timesheets.")">
  <meta name="theme-color" content="#111827">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="worklog.">
  <link rel="manifest" href="/manifest.json">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;700&family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
  @RenderSection("Styles", required: false)
</head>
<body>

@if (User.Identity?.IsAuthenticated == true)
{
  <!-- ── Top bar ── -->
  <header class="sp-bar">
    <a href="/WorkLog" class="gk-logo" title="worklog.">
      <svg width="28" height="28" viewBox="0 0 500 500">
        <rect width="500" height="500" rx="10" fill="#6366f1"/>
        <path d="M120 140h260v40H120zm0 90h260v40H120zm0 90h180v40H120zm220 10l80-20v80z" fill="#fff"/>
      </svg>
      <span class="gk-logo-text">worklog<em>.</em></span>
    </a>

    <div class="sp-bar-spacer"></div>

    <button class="gk-icon-btn" onclick="gkToggleTheme()" title="Toggle dark mode">
      <svg width="20" height="20" viewBox="0 0 24 24" id="gkThemeIcon"><path d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-2.98 0-5.4-2.42-5.4-5.4 0-1.81.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z" fill="currentColor"/></svg>
    </button>

    <div class="gk-avatar" onclick="this.classList.toggle('open')">
      @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "?")
      <div class="gk-avatar-menu" onclick="event.stopPropagation()">
        <div style="padding:12px 16px 8px; font-size:14px; font-weight:600;">@User.Identity?.Name</div>
        <div class="gk-avatar-menu-sep"></div>
        <a href="https://buymeacoffee.com/zaintahir512" target="_blank" rel="noopener" class="gk-avatar-menu-item">
          <svg width="16" height="16" viewBox="0 0 24 24"><path d="M20 3H4v10c0 2.21 1.79 4 4 4h6c2.21 0 4-1.79 4-4v-3h2c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 5h-2V5h2v3zM4 19h16v2H4z" fill="currentColor"/></svg>
          Buy me a coffee ☕
        </a>
        <div class="gk-avatar-menu-sep"></div>
        <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0">
          @Html.AntiForgeryToken()
          <button type="submit" class="gk-avatar-menu-item" style="border:none;cursor:pointer;width:100%">
            <svg width="16" height="16" viewBox="0 0 24 24"><path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z" fill="currentColor"/></svg>
            Sign out
          </button>
        </form>
      </div>
    </div>
  </header>

  <main class="sp-main" id="spMain">
    @RenderBody()
  </main>
}
else
{
  <main class="auth-wrap">
    @RenderBody()
  </main>
}

<!-- Toast -->
<div class="gk-toast" id="gkToast">
  <span id="gkToastMsg"></span>
  <button class="gk-toast-undo" id="gkToastUndo" style="display:none" onclick="gkUndoLast()">Undo</button>
</div>

@RenderSection("Scripts", required: false)

<script>
// ── Theme ──────────────────────────────────────────────────────────────────────
(function() {
  const t = localStorage.getItem('gk_theme') || 'light';
  document.documentElement.dataset.theme = t;
})();
function gkToggleTheme() {
  const html = document.documentElement;
  const next = html.dataset.theme === 'dark' ? 'light' : 'dark';
  html.dataset.theme = next;
  localStorage.setItem('gk_theme', next);
}

// ── Toast ──────────────────────────────────────────────────────────────────────
var _toastT, _undoFn = null;
function gkToast(msg, undoFn) {
  var el     = document.getElementById('gkToast');
  var msgEl  = document.getElementById('gkToastMsg');
  var undoEl = document.getElementById('gkToastUndo');
  if (!el) return;
  msgEl.textContent = msg;
  _undoFn = undoFn || null;
  if (undoEl) undoEl.style.display = undoFn ? '' : 'none';
  el.classList.add('show');
  clearTimeout(_toastT);
  _toastT = setTimeout(function() { el.classList.remove('show'); _undoFn = null; }, 3500);
}
function gkUndoLast() {
  if (_undoFn) { _undoFn(); _undoFn = null; document.getElementById('gkToast')?.classList.remove('show'); }
}

// ── Global API helper ──────────────────────────────────────────────────────────
async function gkPost(url, data) {
  const r = await fetch(url, {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data),
  });
  if (!r.ok) throw new Error(r.status);
  return r.text().then(t => t ? JSON.parse(t) : null).catch(() => null);
}

// ── Keyboard ───────────────────────────────────────────────────────────────────
document.addEventListener('keydown', function(e) {
  if (e.ctrlKey && e.key === 'd') { e.preventDefault(); gkToggleTheme(); }
});
</script>
</body>
</html>
