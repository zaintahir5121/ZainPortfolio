<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>@(ViewData["Title"] is string t ? t + " — Keep" : "Keep")</title>
  <meta name="description" content="@(ViewData["Description"] as string ?? "Keep — your personal notes, everywhere.")">
  <meta name="theme-color" content="#ffffff">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="Keep">
  <link rel="manifest" href="/manifest.json">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;700&family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
  @RenderSection("Styles", required: false)
</head>
<body>

@if (User.Identity?.IsAuthenticated == true)
{
  var section = ViewBag.Section as string ?? "notes";
  <!-- ── Top bar ── -->
  <header class="gk-topbar">
    <button class="gk-icon-btn" id="gkMenuBtn" onclick="gkToggleSidebar()" title="Main menu" aria-label="Main menu">
      <svg width="20" height="20" viewBox="0 0 24 24"><path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" fill="currentColor"/></svg>
    </button>
    <a href="/Notes" class="gk-logo" title="Keep">
      <svg width="28" height="28" viewBox="0 0 500 500">
        <rect width="500" height="500" rx="100" fill="#fbbc04"/>
        <path d="M310 90H190c-25 0-45 20-45 45v235l105-76 105 76V135c0-25-20-45-45-45z" fill="#fff"/>
      </svg>
      <span class="gk-logo-text">Keep.</span>
    </a>

    <div class="gk-search" id="gkSearchBox">
      <button class="gk-icon-btn" style="color:var(--text2)" aria-label="Search">
        <svg width="18" height="18" viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" fill="currentColor"/></svg>
      </button>
      <input type="text" id="gkSearchInput" class="gk-search-input" placeholder="Search your notes"
             autocomplete="off" oninput="gkFilter(this.value)"
             onkeydown="if(event.key==='Escape'){gkClearSearch();this.blur();}">
      <button class="gk-icon-btn gk-search-clear" id="gkSearchClear" style="display:none" onclick="gkClearSearch()" aria-label="Clear search">
        <svg width="18" height="18" viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" fill="currentColor"/></svg>
      </button>
    </div>

    <div class="gk-topbar-spacer"></div>

    <button class="gk-icon-btn" id="gkViewBtn" onclick="gkToggleView()" title="Toggle list view">
      <svg width="20" height="20" viewBox="0 0 24 24" id="gkViewIcon"><path d="M4 5h3v3H4zm0 5h3v3H4zm0 5h3v3H4zm5-10h11v3H9zm0 5h11v3H9zm0 5h11v3H9z" fill="currentColor"/></svg>
    </button>
    <button class="gk-icon-btn" id="gkThemeBtn" onclick="gkToggleTheme()" title="Toggle dark mode">
      <svg width="20" height="20" viewBox="0 0 24 24" id="gkThemeIcon"><path d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-2.98 0-5.4-2.42-5.4-5.4 0-1.81.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z" fill="currentColor"/></svg>
    </button>
    <button class="gk-icon-btn" onclick="gkShowKbd()" title="Keyboard shortcuts (Ctrl+/)">
      <svg width="18" height="18" viewBox="0 0 24 24"><path d="M20 5H4c-1.1 0-1.99.9-1.99 2L2 17c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm-9 3h2v2h-2V8zm0 3h2v2h-2v-2zM8 8h2v2H8V8zm0 3h2v2H8v-2zm-1 5H5v-2h2v2zm9 0H8v-2h8v2zm0-3h-2v-2h2v2zm0-3h-2V8h2v2zm3 6h-2v-2h2v2zm0-3h-2v-2h2v2zm0-3h-2V8h2v2z" fill="currentColor"/></svg>
    </button>
    <button class="gk-icon-btn gk-ai-topbtn" onclick="gkAiOpen()" title="AI Assistant (Ctrl+K)">
      <svg width="20" height="20" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26C17.81 13.47 19 11.38 19 9c0-3.87-3.13-7-7-7zm1 14h-2v-1h2v1zm0-3h-2c-.55 0-1-.45-1-1V9.41l-1.29-1.3 1.41-1.41 1.17 1.17c.18.08.38.13.59.13h.12c.21 0 .41-.05.59-.13l1.17-1.17 1.41 1.41L14 9.41V12c0 .55-.45 1-1 1z" fill="none"/><path d="M9 21h6v-1H9v1zm3-19C8.13 2 5 5.13 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26C17.81 13.47 19 11.38 19 9c0-3.87-3.13-7-7-7zm1 14h-2v-1h2v1zm0-3h-2c-.55 0-1-.45-1-1v-2.59l-1.29-1.3 1.41-1.41 1.17 1.17c.18.08.38.13.59.13h.12c.21 0 .41-.05.59-.13l1.17-1.17 1.41 1.41L14 11.41V13c0 .55-.45 1-1 1z" fill="currentColor"/></svg>
    </button>

    <div class="gk-avatar" onclick="this.classList.toggle('open')">
      @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "?")
      <div class="gk-avatar-menu" onclick="event.stopPropagation()">
        <div style="padding:12px 16px 8px; font-size:14px; font-weight:600;">@User.Identity?.Name</div>
        <div class="gk-avatar-menu-sep"></div>
        <a href="https://buymeacoffee.com/zaintahir512" target="_blank" rel="noopener" class="gk-avatar-menu-item">
          <svg width="16" height="16" viewBox="0 0 24 24"><path d="M20 3H4v10c0 2.21 1.79 4 4 4h6c2.21 0 4-1.79 4-4v-3h2c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 5h-2V5h2v3zM4 19h16v2H4z" fill="currentColor"/></svg>
          Buy me a coffee ☕
        </a>
        <div class="gk-avatar-menu-sep"></div>
        <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0">
          @Html.AntiForgeryToken()
          <button type="submit" class="gk-avatar-menu-item" style="border:none;cursor:pointer;width:100%">
            <svg width="16" height="16" viewBox="0 0 24 24"><path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z" fill="currentColor"/></svg>
            Sign out
          </button>
        </form>
      </div>
    </div>
  </header>

  <div class="gk-layout">
    <!-- Sidebar -->
    <aside class="gk-sidebar" id="gkSidebar">
      <nav>
        <a asp-controller="Notes" asp-action="Index" class="gk-nav-item @(section == "notes" ? "active" : "")">
          <svg class="gk-nav-ico" width="20" height="20" viewBox="0 0 24 24">
            <path d="M9 21c0 .55.45 1 1 1h4c.55 0 1-.45 1-1v-1H9v1zm3-19C8.14 2 5 5.14 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.86-3.14-7-7-7z" fill="currentColor"/>
          </svg>
          <span class="gk-nav-label">Notes</span>
        </a>
        <a asp-controller="Notes" asp-action="Archive" class="gk-nav-item @(section == "archive" ? "active" : "")">
          <svg class="gk-nav-ico" width="20" height="20" viewBox="0 0 24 24">
            <path d="M20.54 5.23l-1.39-1.68C18.88 3.21 18.47 3 18 3H6c-.47 0-.88.21-1.16.55L3.46 5.23C3.17 5.57 3 6.02 3 6.5V19c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6.5c0-.48-.17-.93-.46-1.27zM12 17.5L6.5 12H10v-2h4v2h3.5L12 17.5zM5.12 5l.81-1h12l.94 1H5.12z" fill="currentColor"/>
          </svg>
          <span class="gk-nav-label">Archive</span>
        </a>
        <a asp-controller="Notes" asp-action="Trash" class="gk-nav-item @(section == "trash" ? "active" : "")">
          <svg class="gk-nav-ico" width="20" height="20" viewBox="0 0 24 24">
            <path d="M15 4V3H9v1H4v2h1l1 13c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2l1-13h1V4h-5zm2 15H7l-1-13h10l-1 13z" fill="currentColor"/>
          </svg>
          <span class="gk-nav-label">Trash</span>
        </a>
        <div class="gk-nav-sep"></div>
        <button type="button" class="gk-nav-item gk-nav-ai-btn" onclick="gkAiOpen()">
          <svg class="gk-nav-ico" width="20" height="20" viewBox="0 0 24 24">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z" fill="none"/>
            <path d="M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2zm1 13.5l-4-2.5 4-2.5v5z" fill="currentColor"/>
          </svg>
          <span class="gk-nav-label">AI Assistant ✨</span>
        </button>
        <button type="button" class="gk-nav-item" onclick="gkAiDailySummary()">
          <svg class="gk-nav-ico" width="20" height="20" viewBox="0 0 24 24">
            <path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11zM8 15h8v2H8zm0-4h8v2H8z" fill="currentColor"/>
          </svg>
          <span class="gk-nav-label">Daily Digest</span>
        </button>
      </nav>
    </aside>

    <!-- Main -->
    <main class="gk-content" id="gkContent">
      @RenderBody()
    </main>
  </div>

  <!-- Color picker (shared, moved around by JS) -->
  <div class="gk-colors" id="gkColorPicker" style="display:none">
    @foreach (var c in new[]{"default","red","orange","yellow","green","teal","blue","dark-blue","purple","pink","brown","gray"}) {
      <div class="gk-color-swatch cs-@c" data-color="@c" onclick="gkApplyColor('@c')" title="@(c == "default" ? "Default" : char.ToUpper(c[0]) + c[1..])"></div>
    }
  </div>

  <!-- Edit modal -->
  <div class="gk-modal-ov" id="gkModalOv" style="display:none" onclick="if(event.target===this)gkCloseModal()">
    <div class="gk-modal" id="gkModal">
      <input type="text" class="gk-modal-title" id="gkModalTitle" placeholder="Title">
      <div class="gk-modal-body" id="gkModalBody" contenteditable="true" data-placeholder="Take a note…"></div>
      <div class="gk-modal-list" id="gkModalList" style="display:none"></div>
      <div class="gk-modal-foot">
        <div class="gk-modal-tools" id="gkModalTools">
          <button class="gk-icon-btn" id="gkModalPinBtn" onclick="gkModalTogglePin()" title="Pin note">
            <svg width="18" height="18" viewBox="0 0 24 24"><path d="M14 4v5l2 1v4h-5v6l-1 1-1-1v-6H4v-4l2-1V4h8z" fill="currentColor"/></svg>
          </button>
          <button class="gk-icon-btn" id="gkModalColorBtn" onclick="gkShowColorPicker('modal')" title="Change color">
            <svg width="18" height="18" viewBox="0 0 24 24"><path d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.26-.38-.61-.38-.99 0-.83.67-1.5 1.5-1.5H16c2.76 0 5-2.24 5-5 0-4.42-4.03-8-9-8zm-5.5 9c-.83 0-1.5-.67-1.5-1.5S5.67 9 6.5 9 8 9.67 8 10.5 7.33 12 6.5 12zm3-4C8.67 8 8 7.33 8 6.5S8.67 5 9.5 5s1.5.67 1.5 1.5S10.33 8 9.5 8zm5 0c-.83 0-1.5-.67-1.5-1.5S13.67 5 14.5 5s1.5.67 1.5 1.5S15.33 8 14.5 8zm3 4c-.83 0-1.5-.67-1.5-1.5S16.67 9 17.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z" fill="currentColor"/></svg>
          </button>
          <button class="gk-icon-btn gk-modal-polish-btn" id="gkModalPolishBtn" onclick="gkModalPolish()" title="Polish with AI ✨">
            <svg width="18" height="18" viewBox="0 0 24 24"><path d="M7 16l-4-4 4-4 1.41 1.41L5.83 12l2.58 2.59L7 16zm10 0l-1.41-1.41L18.17 12l-2.58-2.59L17 8l4 4-4 4zm-5 2l-1.5-9h2l1.5 9h-2z" fill="currentColor"/></svg>
          </button>
          <button class="gk-icon-btn" id="gkModalArchiveBtn" onclick="gkModalToggleArchive()" title="Archive">
            <svg width="18" height="18" viewBox="0 0 24 24"><path d="M20.54 5.23l-1.39-1.68C18.88 3.21 18.47 3 18 3H6c-.47 0-.88.21-1.16.55L3.46 5.23C3.17 5.57 3 6.02 3 6.5V19c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6.5c0-.48-.17-.93-.46-1.27zM12 17.5L6.5 12H10v-2h4v2h3.5L12 17.5zM5.12 5l.81-1h12l.94 1H5.12z" fill="currentColor"/></svg>
          </button>
          <button class="gk-icon-btn" id="gkModalDeleteBtn" onclick="gkModalDelete()" title="Delete note">
            <svg width="18" height="18" viewBox="0 0 24 24"><path d="M15 4V3H9v1H4v2h1l1 13c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2l1-13h1V4h-5zm2 15H7l-1-13h10l-1 13z" fill="currentColor"/></svg>
          </button>
        </div>
        <div class="gk-modal-meta" id="gkModalMeta"></div>
        <button class="gk-modal-close" onclick="gkCloseModal()">Close</button>
      </div>
    </div>
  </div>

  <!-- Keyboard shortcuts overlay -->
  <div class="gk-kbd-ov" id="gkKbdOv" style="display:none" onclick="if(event.target===this)gkHideKbd()">
    <div class="gk-kbd-panel">
      <div class="gk-kbd-title">Keyboard shortcuts</div>
      <div class="gk-kbd-grid">
        <div class="gk-kbd-row"><span class="gk-kbd-desc">New note</span><div class="gk-kbd-keys"><kbd>N</kbd></div></div>
        <div class="gk-kbd-row"><span class="gk-kbd-desc">New checklist</span><div class="gk-kbd-keys"><kbd>L</kbd></div></div>
        <div class="gk-kbd-row"><span class="gk-kbd-desc">Search</span><div class="gk-kbd-keys"><kbd>Ctrl</kbd><kbd>F</kbd></div></div>
        <div class="gk-kbd-row"><span class="gk-kbd-desc">Close / cancel</span><div class="gk-kbd-keys"><kbd>Esc</kbd></div></div>
        <div class="gk-kbd-row"><span class="gk-kbd-desc">Save note</span><div class="gk-kbd-keys"><kbd>Ctrl</kbd><kbd>Enter</kbd></div></div>
        <div class="gk-kbd-row"><span class="gk-kbd-desc">Toggle dark mode</span><div class="gk-kbd-keys"><kbd>Ctrl</kbd><kbd>D</kbd></div></div>
        <div class="gk-kbd-row"><span class="gk-kbd-desc">Toggle view</span><div class="gk-kbd-keys"><kbd>Ctrl</kbd><kbd>G</kbd></div></div>
        <div class="gk-kbd-row"><span class="gk-kbd-desc">AI Assistant</span><div class="gk-kbd-keys"><kbd>Ctrl</kbd><kbd>K</kbd></div></div>
        <div class="gk-kbd-row"><span class="gk-kbd-desc">Shortcuts</span><div class="gk-kbd-keys"><kbd>Ctrl</kbd><kbd>/</kbd></div></div>
      </div>
      <button class="gk-kbd-close" onclick="gkHideKbd()">Got it</button>
    </div>
  </div>
}
else
{
  <main class="auth-wrap">
    @RenderBody()
  </main>
}

<!-- Toast -->
<div class="gk-toast" id="gkToast">
  <span id="gkToastMsg"></span>
  <button class="gk-toast-undo" id="gkToastUndo" style="display:none" onclick="gkUndoLast()">Undo</button>
</div>

@if (User.Identity?.IsAuthenticated == true)
{
  <!-- AI Chat Panel -->
  <div class="gk-ai-pane" id="gkAiPane">
    <div class="gk-ai-header">
      <div class="gk-ai-title">
        <svg width="18" height="18" viewBox="0 0 24 24" style="vertical-align:-2px"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z" fill="currentColor"/></svg>
        Keep AI
      </div>
      <div style="display:flex;gap:2px;align-items:center">
        <button class="gk-icon-btn" onclick="gkAiDailySummary()" title="Daily Digest">
          <svg width="16" height="16" viewBox="0 0 24 24"><path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" fill="currentColor"/></svg>
        </button>
        <button class="gk-icon-btn" onclick="gkAiClearChat()" title="Clear conversation">
          <svg width="16" height="16" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" fill="currentColor"/></svg>
        </button>
        <button class="gk-icon-btn" onclick="gkAiClose()" title="Close">
          <svg width="16" height="16" viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" fill="currentColor"/></svg>
        </button>
      </div>
    </div>
    <div class="gk-ai-msgs" id="gkAiMsgs">
      <div class="gk-ai-msg gk-ai-msg-bot">
        <div class="gk-ai-bubble">Hey! I'm Keep AI ✨ I can see your notes and help you think, write, and summarise. Ask me anything!</div>
      </div>
    </div>
    <form class="gk-ai-foot" onsubmit="gkAiSend(event)">
      <input type="text" id="gkAiInput" class="gk-ai-inp" placeholder="Ask anything about your notes…" autocomplete="off">
      <button type="submit" class="gk-ai-send" title="Send">
        <svg width="18" height="18" viewBox="0 0 24 24"><path d="M2 21l21-9L2 3v7l15 2-15 2z" fill="currentColor"/></svg>
      </button>
    </form>
  </div>
  <!-- AI FAB -->
  <button class="gk-ai-fab" id="gkAiFab" onclick="gkAiOpen()" title="AI Assistant">
    <svg width="22" height="22" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z" fill="currentColor"/></svg>
  </button>
  <!-- Daily Digest overlay -->
  <div class="gk-ai-digest-ov" id="gkAiDigestOv" style="display:none" onclick="if(event.target===this)gkAiDigestClose()">
    <div class="gk-ai-digest-card">
      <div class="gk-ai-digest-head">
        <span>📋 Daily Digest</span>
        <button class="gk-icon-btn" onclick="gkAiDigestClose()">
          <svg width="18" height="18" viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" fill="currentColor"/></svg>
        </button>
      </div>
      <div class="gk-ai-digest-body" id="gkAiDigestBody">
        <div class="gk-ai-typing"><span></span><span></span><span></span></div>
      </div>
    </div>
  </div>
}

@RenderSection("Scripts", required: false)

<script>
// ── Theme ──────────────────────────────────────────────────────────────────────
(function() {
  const t = localStorage.getItem('gk_theme') || 'light';
  document.documentElement.dataset.theme = t;
})();
function gkToggleTheme() {
  const html = document.documentElement;
  const next = html.dataset.theme === 'dark' ? 'light' : 'dark';
  html.dataset.theme = next;
  localStorage.setItem('gk_theme', next);
}

// ── Sidebar ────────────────────────────────────────────────────────────────────
let _sbOpen = localStorage.getItem('gk_sb') !== 'closed';
function gkToggleSidebar() {
  _sbOpen = !_sbOpen;
  localStorage.setItem('gk_sb', _sbOpen ? 'open' : 'closed');
  document.getElementById('gkSidebar')?.classList.toggle('open', _sbOpen);
  if (window.innerWidth <= 600) {
    document.getElementById('gkSidebar')?.classList.toggle('mobile-open', _sbOpen);
  }
}
document.addEventListener('DOMContentLoaded', () => {
  if (_sbOpen && window.innerWidth > 600) {
    document.getElementById('gkSidebar')?.classList.add('open');
  }
});

// ── View toggle ────────────────────────────────────────────────────────────────
let _listView = localStorage.getItem('gk_view') === 'list';
function gkToggleView() {
  _listView = !_listView;
  localStorage.setItem('gk_view', _listView ? 'list' : 'grid');
  _applyView();
}
function _applyView() {
  document.querySelectorAll('.gk-grid').forEach(g => g.classList.toggle('list-view', _listView));
  const icon = document.getElementById('gkViewIcon');
  if (icon) icon.innerHTML = _listView
    ? '<path d="M3 5h8v2H3zm0 4h8v2H3zm0 4h8v2H3zm10-8h8v2h-8zm0 4h8v2h-8zm0 4h8v2h-8z" fill="currentColor"/>'
    : '<path d="M4 5h3v3H4zm0 5h3v3H4zm0 5h3v3H4zm5-10h11v3H9zm0 5h11v3H9zm0 5h11v3H9z" fill="currentColor"/>';
}
document.addEventListener('DOMContentLoaded', _applyView);

// ── Search ─────────────────────────────────────────────────────────────────────
function gkFilter(q) {
  q = q.trim().toLowerCase();
  const clear = document.getElementById('gkSearchClear');
  if (clear) clear.style.display = q ? '' : 'none';
  document.querySelectorAll('.gk-card').forEach(card => {
    const text = (card.dataset.title + ' ' + card.dataset.content + ' ' + (card.dataset.type || '')).toLowerCase();
    card.style.display = (!q || text.includes(q)) ? '' : 'none';
  });
  document.querySelectorAll('.gk-section-label').forEach(s => s.style.display = q ? 'none' : '');
}
function gkClearSearch() {
  const inp = document.getElementById('gkSearchInput');
  if (inp) { inp.value = ''; gkFilter(''); }
}

// ── Keyboard shortcuts overlay ─────────────────────────────────────────────────
function gkShowKbd() { document.getElementById('gkKbdOv').style.display = 'flex'; }
function gkHideKbd() { document.getElementById('gkKbdOv').style.display = 'none'; }

// ── Toast ──────────────────────────────────────────────────────────────────────
let _toastT;
let _undoFn = null;
function gkToast(msg, undoFn) {
  const el  = document.getElementById('gkToast');
  const msg_el = document.getElementById('gkToastMsg');
  const undo_el = document.getElementById('gkToastUndo');
  if (!el) return;
  msg_el.textContent = msg;
  _undoFn = undoFn || null;
  if (undo_el) undo_el.style.display = undoFn ? '' : 'none';
  el.classList.add('show');
  clearTimeout(_toastT);
  _toastT = setTimeout(() => { el.classList.remove('show'); _undoFn = null; }, 3500);
}
function gkUndoLast() {
  if (_undoFn) { _undoFn(); _undoFn = null; document.getElementById('gkToast')?.classList.remove('show'); }
}

// ── Global API helper ──────────────────────────────────────────────────────────
async function gkPost(url, data) {
  const r = await fetch(url, {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data),
  });
  if (!r.ok) throw new Error(r.status);
  return r.text().then(t => t ? JSON.parse(t) : null).catch(() => null);
}

// ── Color picker state ─────────────────────────────────────────────────────────
let _cpContext  = null; // 'modal' or note id
let _cpCallback = null;
function gkShowColorPicker(context, anchorEl) {
  _cpContext = context;
  const cp = document.getElementById('gkColorPicker');
  if (!cp) return;
  // highlight active color
  const note = context === 'modal' ? _gkModalNote() : _noteById(context);
  const color = note?.dataset?.color || 'default';
  cp.querySelectorAll('.gk-color-swatch').forEach(s =>
    s.classList.toggle('active', s.dataset.color === color));
  if (anchorEl) {
    const r = anchorEl.getBoundingClientRect();
    cp.style.top  = (r.bottom + 6 + window.scrollY) + 'px';
    cp.style.left = r.left + 'px';
    cp.style.position = 'fixed';
    cp.style.top  = (r.bottom + 6) + 'px';
  }
  cp.style.display = 'flex';
  setTimeout(() => document.addEventListener('click', _cpOutside, { once: true }), 10);
}
function _cpOutside(e) {
  const cp = document.getElementById('gkColorPicker');
  if (cp && !cp.contains(e.target)) cp.style.display = 'none';
}
function gkApplyColor(color) {
  document.getElementById('gkColorPicker').style.display = 'none';
  if (_cpContext === 'modal') {
    gkModalSetColor(color);
  } else if (_cpContext) {
    _updateCardColor(_cpContext, color);
  }
}
function _updateCardColor(noteId, color) {
  const card = document.getElementById('gnc-' + noteId);
  if (card) {
    const oldColor = card.dataset.color || 'default';
    card.className = card.className.replace(/\bnc-\S+/g, '').trim() + ' nc-' + color;
    card.dataset.color = color;
    const modal = document.getElementById('gkModal');
    if (modal && modal.dataset.noteId == noteId) {
      modal.className = modal.className.replace(/\bnc-\S+/g, '').trim() + ' nc-' + color;
    }
  }
  gkPost('/Notes/Update', { id: parseInt(noteId), color });
}

// ── Global keyboard shortcuts ──────────────────────────────────────────────────
document.addEventListener('keydown', e => {
  const tag = document.activeElement?.tagName;
  const inInput = ['INPUT','TEXTAREA'].includes(tag) || document.activeElement?.isContentEditable;
  if (e.key === 'Escape') {
    gkCloseModal(); gkHideKbd();
    if (typeof gkCreatorClose === 'function') gkCreatorClose();
    return;
  }
  if (e.ctrlKey && e.key === '/') { e.preventDefault(); gkShowKbd(); return; }
  if (e.ctrlKey && e.key === 'd') { e.preventDefault(); gkToggleTheme(); return; }
  if (e.ctrlKey && e.key === 'g') { e.preventDefault(); gkToggleView(); return; }
  if (e.ctrlKey && e.key === 'f') { e.preventDefault(); document.getElementById('gkSearchInput')?.focus(); return; }
  if (e.ctrlKey && e.key === 'k') { e.preventDefault(); gkAiOpen(); return; }
  if (!inInput) {
    if (e.key === 'n') { e.preventDefault(); if (typeof gkOpenCreator === 'function') gkOpenCreator('note'); return; }
    if (e.key === 'l') { e.preventDefault(); if (typeof gkOpenCreator === 'function') gkOpenCreator('list'); return; }
  }
});

// ── Stubs (overridden per-page) ────────────────────────────────────────────────
function gkCloseModal() {}
function _gkModalNote() { return null; }
function _noteById(id) { return document.getElementById('gnc-' + id); }

// ── AI Assistant ───────────────────────────────────────────────────────────────
var _aiHistory = [];
var _aiOpen = false;

function gkAiOpen() {
  _aiOpen = true;
  document.getElementById('gkAiPane')?.classList.add('open');
  document.getElementById('gkAiFab')?.classList.add('hidden');
  setTimeout(() => document.getElementById('gkAiInput')?.focus(), 250);
}
function gkAiClose() {
  _aiOpen = false;
  document.getElementById('gkAiPane')?.classList.remove('open');
  document.getElementById('gkAiFab')?.classList.remove('hidden');
}
function gkAiClearChat() {
  _aiHistory = [];
  var msgs = document.getElementById('gkAiMsgs');
  if (!msgs) return;
  msgs.innerHTML = '<div class="gk-ai-msg gk-ai-msg-bot"><div class="gk-ai-bubble">Chat cleared! Ask me anything ✨</div></div>';
}

function _aiAppend(role, text) {
  var msgs = document.getElementById('gkAiMsgs');
  if (!msgs) return;
  var div = document.createElement('div');
  div.className = 'gk-ai-msg ' + (role === 'user' ? 'gk-ai-msg-user' : 'gk-ai-msg-bot');
  var bub = document.createElement('div');
  bub.className = 'gk-ai-bubble';
  bub.innerHTML = _aiMd(text);
  div.appendChild(bub);
  msgs.appendChild(div);
  msgs.scrollTop = msgs.scrollHeight;
}

function _aiTyping() {
  var msgs = document.getElementById('gkAiMsgs');
  if (!msgs) return null;
  var div = document.createElement('div');
  div.className = 'gk-ai-msg gk-ai-msg-bot gk-ai-typing-row';
  div.innerHTML = '<div class="gk-ai-bubble"><div class="gk-ai-typing"><span></span><span></span><span></span></div></div>';
  msgs.appendChild(div);
  msgs.scrollTop = msgs.scrollHeight;
  return div;
}

async function gkAiSend(e) {
  e.preventDefault();
  var inp = document.getElementById('gkAiInput');
  var msg = inp ? inp.value.trim() : '';
  if (!msg) return;
  inp.value = '';
  _aiAppend('user', msg);
  var typing = _aiTyping();
  try {
    var data = await gkPost('/Assistant/Chat', { message: msg, history: _aiHistory });
    if (typing) typing.remove();
    var reply = data && data.reply ? data.reply : '…';
    _aiAppend('assistant', reply);
    _aiHistory.push({ role: 'user', content: msg });
    _aiHistory.push({ role: 'assistant', content: reply });
    if (_aiHistory.length > 20) _aiHistory = _aiHistory.slice(-20);
  } catch(err) {
    if (typing) typing.remove();
    _aiAppend('assistant', '⚠️ Could not reach AI. Make sure Ollama is running.');
  }
}

async function gkAiDailySummary() {
  var ov = document.getElementById('gkAiDigestOv');
  var body = document.getElementById('gkAiDigestBody');
  if (!ov || !body) return;
  body.innerHTML = '<div class="gk-ai-typing"><span></span><span></span><span></span></div>';
  ov.style.display = 'flex';
  try {
    var data = await gkPost('/Assistant/DailySummary', {});
    body.innerHTML = _aiMd(data && data.summary ? data.summary : 'No summary available.');
  } catch(err) {
    body.innerHTML = '<p style="color:var(--text2)">⚠️ AI unavailable. Make sure Ollama is running.</p>';
  }
}
function gkAiDigestClose() {
  var ov = document.getElementById('gkAiDigestOv');
  if (ov) ov.style.display = 'none';
}

async function gkModalPolish() {
  var btn = document.getElementById('gkModalPolishBtn');
  var title = document.getElementById('gkModalTitle')?.value || '';
  var body = document.getElementById('gkModalBody')?.innerText || '';
  if (!title && !body) { gkToast('Add some content first!'); return; }
  if (btn) { btn.disabled = true; btn.style.opacity = '.4'; }
  try {
    var data = await gkPost('/Assistant/Polish', { title, content: body });
    if (btn) { btn.disabled = false; btn.style.opacity = ''; }
    if (data && data.improved) {
      var bodyEl = document.getElementById('gkModalBody');
      if (bodyEl) bodyEl.innerText = data.improved;
      gkToast('Note polished ✨');
    } else {
      gkToast('⚠️ AI unavailable');
    }
  } catch(err) {
    if (btn) { btn.disabled = false; btn.style.opacity = ''; }
    gkToast('⚠️ AI unavailable');
  }
}

// Simple markdown → HTML (bold, italic, bullets, headers, line breaks)
function _aiMd(text) {
  if (!text) return '';
  return text
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*(.+?)\*/g, '<em>$1</em>')
    .replace(/^#{1,3} (.+)$/gm, '<strong>$1</strong>')
    .replace(/^- (.+)$/gm, '• $1')
    .replace(/\n/g, '<br>');
}
