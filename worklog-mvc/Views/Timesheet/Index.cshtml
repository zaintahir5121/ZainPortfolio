@model WorkLogApp.Models.ViewModels.TimesheetViewModel
@section Styles {
<style>
/* Clickable day rows */
.ts-day-row { cursor: pointer; transition: background .12s; }
.ts-day-row:hover td { background: var(--accent-bg) !important; }
.ts-day-row.ts-day-active td { background: var(--accent-bg) !important; }
.ts-day-row.ts-day-active .td-date { border-left: 3px solid var(--accent); }

/* Day detail panel */
.ts-day-panel {
  background: var(--white); border: 1px solid var(--line); border-radius: 12px;
  padding: 14px 16px; margin-bottom: 18px; animation: tsDpIn .18s ease;
}
@@keyframes tsDpIn { from{opacity:0;transform:translateY(-6px)} to{opacity:1;transform:none} }
.ts-dp-hdr {
  display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 10px;
}
.ts-dp-date { font-size: 13.5px; font-weight: 700; color: var(--text); }
.ts-dp-hrs  { font-size: 22px; font-weight: 800; color: var(--accent); line-height: 1; }
.ts-dp-close {
  background: none; border: none; cursor: pointer; font-size: 14px; color: var(--muted);
  padding: 2px 6px; border-radius: 6px; margin-left: 6px; flex-shrink: 0;
}
.ts-dp-close:hover { background: var(--bg); color: var(--text); }
.ts-dp-entries { display: flex; flex-direction: column; gap: 1px; margin-bottom: 10px; }
.ts-dp-row {
  display: flex; align-items: center; gap: 8px; padding: 6px 0;
  border-bottom: 1px solid var(--bg); font-size: 13px;
}
.ts-dp-row:last-child { border-bottom: none; }
.ts-dp-dot  { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
.ts-dp-desc { flex: 1; color: var(--text); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ts-dp-proj { font-size: 11px; color: var(--muted); flex-shrink: 0; max-width: 80px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; background: var(--bg); padding: 1px 6px; border-radius: 5px; }
.ts-dp-h    { font-size: 13px; font-weight: 700; color: var(--accent); flex-shrink: 0; }
.ts-dp-ai-btn {
  width: 100%; padding: 7px; border-radius: 8px; font-family: var(--font);
  background: var(--accent-bg); border: 1px solid var(--accent); color: var(--accent);
  font-size: 12.5px; font-weight: 600; cursor: pointer; transition: all .15s;
}
.ts-dp-ai-btn:hover { background: var(--accent); color: white; }
.ts-dp-ai-btn:disabled { opacity: .5; cursor: default; }
.ts-dp-ai-out {
  margin-top: 10px; padding: 10px 12px; background: var(--bg); border-radius: 8px;
  border-left: 3px solid var(--accent); font-size: 13px; line-height: 1.65; color: var(--text-2);
}
</style>
}
@{
    ViewData["Title"] = "Timesheet";
    var months = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.MonthNames
                    .Take(12).Select((n, i) => (Name: n, Value: i + 1));
}

<!-- ── Page header ── -->
<div class="pg-head">
  <div>
    <h1>Timesheet</h1>
    <p class="pg-date">Generate and export your time records</p>
  </div>
  <div style="display:flex;gap:10px;align-items:center">
    <a asp-action="Print"
       asp-route-period="@Model.PeriodType"
       asp-route-month="@Model.Month"
       asp-route-year="@Model.Year"
       target="_blank" class="ts-btn-outline">
      🖨 Print / PDF
    </a>
  </div>
</div>

<!-- ── Period selector ── -->
<div class="ts-period-bar">
  <form asp-action="Index" method="get" class="ts-period-form" id="period-form">

    <div class="ts-period-group">
      <span class="ts-period-label">Period</span>
      <div class="ts-seg" id="seg">
        @foreach (var (val, label) in new[]{ ("mid","Mid-month  1–15"), ("end","End-month  16–31"), ("full","Full month") })
        {
          <button type="button" class="seg-btn @(Model.PeriodType == val ? "seg-on" : "")"
                  data-val="@val" onclick="setPeriod('@val')">@label</button>
        }
      </div>
      <input type="hidden" name="period" id="period-input" value="@Model.PeriodType">
    </div>

    <div class="ts-period-group">
      <span class="ts-period-label">Month</span>
      <select name="month" class="ts-sel" onchange="this.form.submit()">
        @foreach (var m in months)
        {
          <option value="@m.Value" selected="@(m.Value == Model.Month ? "selected" : null)">@m.Name</option>
        }
      </select>
    </div>

    <div class="ts-period-group">
      <span class="ts-period-label">Year</span>
      <select name="year" class="ts-sel" onchange="this.form.submit()">
        @for (int y = DateTime.Today.Year + 1; y >= DateTime.Today.Year - 9; y--)
        {
          <option value="@y" selected="@(y == Model.Year ? "selected" : null)">@y</option>
        }
      </select>
    </div>

  </form>

  <div class="ts-export-group">
    <span class="ts-period-label">Export</span>
    <div style="display:flex;gap:7px;flex-wrap:wrap">
      <a asp-action="ExportCsv"
         asp-route-period="@Model.PeriodType"
         asp-route-month="@Model.Month"
         asp-route-year="@Model.Year"
         asp-route-fmt="standard"
         class="ts-btn-outline">⬇ CSV</a>

      <a asp-action="ExportCsv"
         asp-route-period="@Model.PeriodType"
         asp-route-month="@Model.Month"
         asp-route-year="@Model.Year"
         asp-route-fmt="bamboohr"
         class="ts-btn-outline" title="BambooHR-compatible import format">🌿 BambooHR CSV</a>
    </div>
  </div>
</div>

@if (!Model.Entries.Any())
{
  <!-- Empty state -->
  <div class="empty" style="padding:60px 20px">
    <div class="empty-ico">🗓️</div>
    <h3>No logs for @Model.PeriodLabel</h3>
    <p>
      Add work logs for this period and they'll appear here automatically.<br>
      <a asp-controller="Logs" asp-action="Index" style="color:var(--text);text-decoration:underline">Go to My Logs →</a>
    </p>
  </div>
}
else
{
  <!-- ── Stats row ── -->
  <div class="ts-stats">
    <div class="ts-stat">
      <div class="ts-stat-num">@Model.TotalHours<span class="ts-stat-unit">h</span></div>
      <div class="ts-stat-lbl">Total hours</div>
    </div>
    <div class="ts-stat">
      <div class="ts-stat-num">@Model.DaysWorked</div>
      <div class="ts-stat-lbl">Days worked</div>
    </div>
    <div class="ts-stat">
      <div class="ts-stat-num">@Model.ProjectCount</div>
      <div class="ts-stat-lbl">Projects</div>
    </div>
    <div class="ts-stat">
      <div class="ts-stat-num">@((Model.TotalHours / (Model.DaysWorked == 0 ? 1 : Model.DaysWorked)).ToString("F1"))<span class="ts-stat-unit">h</span></div>
      <div class="ts-stat-lbl">Avg / day</div>
    </div>

    <!-- AI summary trigger -->
    <button class="ts-ai-btn" id="ai-sum-btn" onclick="genAiSummary()">
      ✦ AI Write Summary
    </button>
  </div>

  <!-- AI summary box -->
  <div class="ts-ai-box hidden" id="ai-box">
    <div class="ts-ai-hdr">
      <span>✦ AI Period Summary</span>
      <button onclick="document.getElementById('ai-box').classList.add('hidden')" class="ai-box-close">✕</button>
    </div>
    <div class="ts-ai-body" id="ai-body"></div>
    <div class="ts-ai-foot">
      <span class="ts-ai-hint">Suitable for manager / HR review</span>
      <button onclick="copyAiText()" class="ts-btn-outline" style="font-size:12px;padding:5px 12px">📋 Copy</button>
    </div>
  </div>

  <!-- ── Two column layout: table + project summary ── -->
  <div class="ts-grid">

    <!-- Daily breakdown table -->
    <div class="ts-table-wrap">
      <div class="ts-section-title">Daily breakdown · @Model.PeriodLabel</div>
      <table class="ts-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Day</th>
            <th>Project</th>
            <th>Description</th>
            <th class="ts-num">Hours</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var day in Model.ByDay)
          {
            var dayEntries = day.ToList();
            var dayTotal   = dayEntries.Sum(e => e.Hours);

            @for (int i = 0; i < dayEntries.Count; i++)
            {
              var e = dayEntries[i];
              var dateKey = day.Key.ToString("yyyy-MM-dd");
              <tr class="@(i == 0 ? "tr-day-first ts-day-row" : "tr-day-cont")"
                  @(i == 0 ? Html.Raw($"id=\"tdr-{dateKey}\" onclick=\"tsSelectDay('{dateKey}')\" title=\"Click to see {day.Key:dddd, MMMM d} summary\"") : Html.Raw(""))>
                @if (i == 0)
                {
                  <td class="td-date" rowspan="@dayEntries.Count">
                    <div class="td-date-num">@day.Key.Day</div>
                    <div class="td-date-mo">@day.Key.ToString("MMM")</div>
                  </td>
                  <td class="td-day" rowspan="@dayEntries.Count">@day.Key.DayOfWeek.ToString()[..3]</td>
                }
                <td class="td-proj">@e.Project</td>
                <td class="td-desc">
                  @e.Description
                  @if (e.TagList.Any())
                  {
                    <div class="td-tags">
                      @foreach (var t in e.TagList) { <span class="ctag">@t</span> }
                    </div>
                  }
                </td>
                <td class="ts-num td-hrs">@e.Hours</td>
              </tr>
            }

            @if (dayEntries.Count > 1)
            {
              <tr class="tr-day-total">
                <td colspan="3" class="td-day-total-lbl">Day total</td>
                <td class="ts-num td-day-total-val">@dayTotal h</td>
              </tr>
            }
          }
        </tbody>
        <tfoot>
          <tr class="tr-grand-total">
            <td colspan="4">Total</td>
            <td class="ts-num">@Model.TotalHours h</td>
          </tr>
        </tfoot>
      </table>
    </div>

    <!-- Right column: day detail + project breakdown -->
    <div>

      <!-- Day detail panel — shown when a day row is clicked -->
      <div id="ts-day-panel" class="ts-day-panel" style="display:none">
        <div class="ts-dp-hdr">
          <div>
            <div class="ts-dp-date" id="ts-dp-date">—</div>
            <div class="ts-dp-hrs" id="ts-dp-hrs">0h</div>
          </div>
          <button class="ts-dp-close" onclick="tsClosePanel()" title="Close">✕</button>
        </div>
        <div class="ts-dp-entries" id="ts-dp-entries"></div>
        <button class="ts-dp-ai-btn" id="ts-dp-ai-btn" onclick="tsDayAi()">✦ AI Summary for this day</button>
        <div class="ts-dp-ai-out" id="ts-dp-ai-out" style="display:none"></div>
      </div>

      <div class="ts-section-title">By project</div>
      <div class="ts-proj-list">
        @{
          var totalHours = Model.TotalHours == 0 ? 1m : Model.TotalHours;
        }
        @foreach (var g in Model.ByProject)
        {
          var pct = (g.Sum(e => e.Hours) / totalHours) * 100m;
          <div class="ts-proj-row">
            <div class="ts-proj-top">
              <span class="ts-proj-name">@g.Key</span>
              <span class="ts-proj-hrs">@g.Sum(e => e.Hours) h</span>
            </div>
            <div class="ts-proj-bar-wrap">
              <div class="ts-proj-bar" style="width:@pct.ToString("F0")%"></div>
            </div>
            <div class="ts-proj-pct">@pct.ToString("F0")% of total</div>
          </div>
        }
      </div>

      <!-- Integration note -->
      <div class="ts-integrations">
        <div class="ts-int-title">HR Tool Exports</div>
        <div class="ts-int-row">
          <div class="ts-int-icon">🌿</div>
          <div>
            <div class="ts-int-name">BambooHR</div>
            <div class="ts-int-desc">Download BambooHR CSV → Time Tracking → Import</div>
            <a asp-action="ExportCsv"
               asp-route-period="@Model.PeriodType"
               asp-route-month="@Model.Month"
               asp-route-year="@Model.Year"
               asp-route-fmt="bamboohr"
               class="ts-int-link">Download BambooHR CSV →</a>
          </div>
        </div>
        <div class="ts-int-row">
          <div class="ts-int-icon">📄</div>
          <div>
            <div class="ts-int-name">Any HR / Payroll Tool</div>
            <div class="ts-int-desc">Standard CSV works with Workday, SAP, ADP, Rippling, Gusto</div>
            <a asp-action="ExportCsv"
               asp-route-period="@Model.PeriodType"
               asp-route-month="@Model.Month"
               asp-route-year="@Model.Year"
               asp-route-fmt="standard"
               class="ts-int-link">Download Standard CSV →</a>
          </div>
        </div>
        <div class="ts-int-row">
          <div class="ts-int-icon">🖨</div>
          <div>
            <div class="ts-int-name">Print / Manual Submit</div>
            <div class="ts-int-desc">Opens print view — save as PDF in browser print dialog</div>
            <a asp-action="Print"
               asp-route-period="@Model.PeriodType"
               asp-route-month="@Model.Month"
               asp-route-year="@Model.Year"
               target="_blank"
               class="ts-int-link">Open print view →</a>
          </div>
        </div>
      </div>
    </div>

  </div><!-- /ts-grid -->
}

@section Scripts {
<script>
// ── Embedded entries (for client-side day panel) ───────────────────────────
const TS_ENTRIES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
  Model.Entries.Select(e => new {
    date      = e.Date.ToString("yyyy-MM-dd"),
    dateLabel = e.Date.ToString("dddd, MMMM d"),
    project   = e.Project,
    description = e.Description,
    hours     = e.Hours,
    category  = e.Tags,
  }).ToList()
));

const TS_CAT_COLORS = {
  'Development':'#3b82f6','Meeting':'#f59e0b','Code Review':'#10b981',
  'Testing':'#8b5cf6','Documentation':'#06b6d4','DevOps':'#ef4444',
  'Research':'#6366f1','Design':'#ec4899','Other':'#94a3b8',
};

let tsActiveDate = null;

// ── Day row click ─────────────────────────────────────────────────────────
function tsSelectDay(date) {
  const entries = TS_ENTRIES.filter(e => e.date === date);
  const panel   = document.getElementById('ts-day-panel');
  const aiOut   = document.getElementById('ts-dp-ai-out');

  // Deactivate previous active row
  if (tsActiveDate) {
    document.getElementById(`tdr-${tsActiveDate}`)?.classList.remove('ts-day-active');
    if (tsActiveDate === date) { tsClosePanel(); return; } // toggle off
  }

  tsActiveDate = date;
  document.getElementById(`tdr-${date}`)?.classList.add('ts-day-active');

  const total = entries.reduce((s, e) => s + Number(e.hours), 0);
  document.getElementById('ts-dp-date').textContent = entries[0]?.dateLabel ?? date;
  document.getElementById('ts-dp-hrs').textContent  = total.toFixed(1) + 'h';

  const rows = entries.map(e => `
    <div class="ts-dp-row">
      <span class="ts-dp-dot" style="background:${TS_CAT_COLORS[e.category]??'#94a3b8'}"></span>
      <span class="ts-dp-desc" title="${esc(e.description)}">${esc(e.description)}</span>
      <span class="ts-dp-proj" title="${esc(e.project)}">${esc(e.project)}</span>
      <span class="ts-dp-h">${e.hours}h</span>
    </div>`
  ).join('');

  document.getElementById('ts-dp-entries').innerHTML = rows || '<div style="color:var(--muted);font-size:13px">Nothing logged this day.</div>';

  // Reset AI section
  aiOut.style.display  = 'none';
  aiOut.textContent    = '';
  const aiBtn          = document.getElementById('ts-dp-ai-btn');
  aiBtn.textContent    = '✦ AI Summary for this day';
  aiBtn.disabled       = false;
  aiBtn.dataset.date   = date;

  panel.style.display  = '';
  panel.scrollIntoView({ behavior:'smooth', block:'nearest' });
}

function tsClosePanel() {
  if (tsActiveDate) {
    document.getElementById(`tdr-${tsActiveDate}`)?.classList.remove('ts-day-active');
    tsActiveDate = null;
  }
  document.getElementById('ts-day-panel').style.display = 'none';
}

// ── AI day summary ────────────────────────────────────────────────────────
async function tsDayAi() {
  const btn  = document.getElementById('ts-dp-ai-btn');
  const out  = document.getElementById('ts-dp-ai-out');
  const date = btn.dataset.date;
  if (!date) return;

  btn.textContent = '… writing';
  btn.disabled    = true;

  try {
    const r = await fetch(`/Timesheet/AiDaySummary?date=${encodeURIComponent(date)}`);
    const d = await r.json();
    if (d.result) {
      out.textContent    = d.result;
      out.style.display  = '';
      btn.textContent    = '✦ Regenerate';
    } else {
      out.textContent    = d.error ?? 'AI error';
      out.style.display  = '';
      btn.textContent    = '✦ AI Summary for this day';
    }
  } catch {
    out.textContent    = 'Could not reach AI service.';
    out.style.display  = '';
    btn.textContent    = '✦ AI Summary for this day';
  }
  btn.disabled = false;
}

function esc(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

// ── Period selector ───────────────────────────────────────────────────────
function setPeriod(val) {
  document.getElementById('period-input').value = val;
  document.querySelectorAll('.seg-btn').forEach(b => b.classList.toggle('seg-on', b.dataset.val === val));
  document.getElementById('period-form').submit();
}

async function genAiSummary() {
  const btn = document.getElementById('ai-sum-btn');
  btn.textContent = '… writing';
  btn.disabled = true;

  try {
    const r = await fetch('/Timesheet/AiSummary', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        period: '@Model.PeriodType',
        month:  @Model.Month,
        year:   @Model.Year
      })
    });
    const d = await r.json();
    if (d.result) {
      document.getElementById('ai-body').textContent = d.result;
      document.getElementById('ai-box').classList.remove('hidden');
    } else {
      alert(d.error ?? 'AI error');
    }
  } catch { alert('Could not reach AI service'); }
  finally { btn.textContent = '✦ AI Write Summary'; btn.disabled = false; }
}

function copyAiText() {
  const text = document.getElementById('ai-body').textContent;
  navigator.clipboard.writeText(text).then(() => {
    showToast('Copied to clipboard!');
  });
}

function showToast(msg) {
  const el = document.createElement('div');
  el.className = 'toast-wrap';
  el.innerHTML = `<div class="toast">${msg}</div>`;
  document.body.appendChild(el);
  setTimeout(() => el.remove(), 3000);
}
</script>
}
