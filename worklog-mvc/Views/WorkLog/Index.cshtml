@model List<WorkLogApp.Models.WorkEntry>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Daily Work Log";
    var section = ViewBag.Section as string ?? "worklog";
    var todayHours = (double)(ViewBag.TodayHours ?? 0);
    var weekHours  = (double)(ViewBag.WeekHours  ?? 0);
    var streak     = (int)(ViewBag.Streak ?? 0);
    var projects   = ViewBag.Projects as List<string> ?? new List<string>();
    var today      = DateTime.UtcNow.Date;

    // Group entries by date for display
    var grouped = Model.GroupBy(e => e.LogDate.Date)
                       .OrderByDescending(g => g.Key)
                       .ToList();
}

@section Styles {
<style>
  .wl-wrap { max-width: 780px; margin: 0 auto; padding: 24px 24px 80px; }
  .wl-stats { display: flex; gap: 16px; margin-bottom: 20px; flex-wrap: wrap; }
  .wl-stat { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 14px 20px; text-align: center; flex: 1; min-width: 100px; }
  .wl-stat-val { display: block; font-size: 24px; font-weight: 700; color: var(--text); }
  .wl-stat-lbl { font-size: 12px; color: var(--text2); }
  .wl-streak .wl-stat-val { color: #f97316; }
  .wl-creator { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 20px; margin-bottom: 24px; box-shadow: var(--shadow); }
  .wl-creator-inp { width: 100%; border: none; outline: none; font-size: 16px; background: transparent; color: var(--text); resize: none; font-family: inherit; min-height: 60px; }
  .wl-creator-inp::placeholder { color: var(--text2); }
  .wl-creator-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 14px; flex-wrap: wrap; }
  .wl-creator-date { border: 1px solid var(--border); border-radius: 8px; padding: 7px 12px; font-size: 13.5px; background: var(--bg); color: var(--text); font-family: inherit; outline: none; }
  .wl-templates-row { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--border); }
  .wl-tpl-btn { padding: 5px 12px; border-radius: 20px; border: 1px solid var(--border); background: var(--bg); color: var(--text2); font-size: 12.5px; cursor: pointer; transition: all .15s; }
  .wl-tpl-btn:hover { border-color: var(--accent); color: var(--accent); }
  .wl-btn-primary { padding: 9px 22px; border-radius: 24px; background: var(--accent); color: #fff; border: none; cursor: pointer; font-size: 14px; font-weight: 600; transition: opacity .15s; }
  .wl-btn-primary:hover { opacity: .88; }
  .wl-btn-primary:disabled { opacity: .4; cursor: default; }
  .wl-entries { display: flex; flex-direction: column; gap: 8px; }
  .wl-day-group { margin-bottom: 12px; }
  .wl-day-header { display: flex; justify-content: space-between; align-items: center; padding: 4px 0 10px; font-size: 13px; font-weight: 600; color: var(--text2); border-bottom: 1px solid var(--border); margin-bottom: 10px; }
  .wl-day-hours { background: var(--bg); border: 1px solid var(--border); border-radius: 12px; padding: 2px 10px; font-size: 12px; }
  .wl-entry { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 14px 16px; transition: box-shadow .15s; }
  .wl-entry:hover { box-shadow: 0 1px 3px rgba(0,0,0,.08),0 1px 2px rgba(0,0,0,.04); }
  .wl-entry-raw { font-size: 14px; color: var(--text2); margin-bottom: 10px; line-height: 1.5; }
  .wl-entry-tasks { display: flex; flex-direction: column; gap: 6px; margin-bottom: 10px; }
  .wl-task { display: flex; align-items: center; gap: 8px; font-size: 13.5px; }
  .wl-task-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .wl-task-desc { flex: 1; color: var(--text); }
  .wl-task-hours { background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 1px 8px; font-size: 12px; font-weight: 600; color: var(--text2); flex-shrink: 0; }
  .wl-task-proj { background: rgba(99,102,241,.1); color: #6366f1; border-radius: 10px; padding: 1px 8px; font-size: 11.5px; flex-shrink: 0; }
  .wl-cat-development .wl-task-dot { background: #3b82f6; }
  .wl-cat-meeting     .wl-task-dot { background: #f59e0b; }
  .wl-cat-review      .wl-task-dot { background: #10b981; }
  .wl-cat-planning    .wl-task-dot { background: #8b5cf6; }
  .wl-cat-ops         .wl-task-dot { background: #ef4444; }
  .wl-cat-general     .wl-task-dot { background: #6b7280; }
  .wl-entry-foot { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--text2); }
  .wl-entry-time { flex: 1; }
  .wl-badge-raw { background: rgba(251,146,60,.15); color: #f97316; border-radius: 10px; padding: 1px 8px; font-size: 11.5px; }
  .wl-entry-del { background: none; border: none; cursor: pointer; color: var(--text2); font-size: 16px; padding: 2px 6px; border-radius: 6px; transition: color .15s, background .15s; }
  .wl-entry-del:hover { color: #ef4444; background: rgba(239,68,68,.08); }
  .wl-empty { text-align: center; padding: 60px 20px; color: var(--text2); }
  .wl-empty-ico { font-size: 48px; margin-bottom: 16px; }
  .wl-empty-title { font-size: 18px; font-weight: 600; color: var(--text); margin-bottom: 8px; }
  .wl-empty-sub { font-size: 14px; max-width: 360px; margin: 0 auto; line-height: 1.6; }
  .wl-parsing { display: flex; align-items: center; gap: 10px; padding: 12px 16px; background: rgba(99,102,241,.06); border: 1px solid rgba(99,102,241,.15); border-radius: 10px; margin-bottom: 12px; font-size: 13px; color: var(--text2); }
  @@keyframes wlFadeIn { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }
  .wl-entry-new { animation: wlFadeIn .25s cubic-bezier(.22,1,.36,1); }
  @@keyframes wlFadeOut { to { opacity: 0; transform: scale(.95); } }
  .wl-entry-removing { animation: wlFadeOut .18s forwards; }
</style>
}

<div class="wl-wrap">
  <!-- Stats -->
  <div class="wl-stats">
    <div class="wl-stat">
      <span class="wl-stat-val">@todayHours.ToString("F1")</span>
      <span class="wl-stat-lbl">Today</span>
    </div>
    <div class="wl-stat">
      <span class="wl-stat-val">@weekHours.ToString("F1")</span>
      <span class="wl-stat-lbl">This Week</span>
    </div>
    <div class="wl-stat wl-streak">
      <span class="wl-stat-val">🔥 @streak</span>
      <span class="wl-stat-lbl">Day Streak</span>
    </div>
  </div>

  <!-- Creator -->
  <div class="wl-creator">
    <div id="wlParsingBar" class="wl-parsing" style="display:none">
      <div class="gk-ai-typing"><span></span><span></span><span></span></div>
      AI is parsing your work log…
    </div>
    <textarea id="wlInput" class="wl-creator-inp"
              placeholder="What did you work on today? (e.g. Fixed auth bug 2h, reviewed PRs 1h, team standup 30m)"
              rows="3" onkeydown="wlInputKey(event)"></textarea>
    <div class="wl-creator-row">
      <input type="date" id="wlDate" class="wl-creator-date"
             value="@today.ToString("yyyy-MM-dd")"
             max="@today.ToString("yyyy-MM-dd")">
      <button class="wl-btn-primary" id="wlSubmitBtn" onclick="wlSubmit()">Log it →</button>
    </div>
    <div class="wl-templates-row">
      <button class="wl-tpl-btn" onclick="wlTemplate('Sprint review 2h, code review 1h, bug fixes 3h')">Sprint review</button>
      <button class="wl-tpl-btn" onclick="wlTemplate('Daily standup 15m, planning session 1h')">Stand-up</button>
      <button class="wl-tpl-btn" onclick="wlTemplate('Deep work on feature implementation 4h')">Deep work</button>
      <button class="wl-tpl-btn" onclick="wlTemplate('Team meetings 2h, 1:1 with manager 30m')">Meetings</button>
    </div>
    @if (projects.Count > 0) {
      <datalist id="wlProjectList">
        @foreach (var p in projects) { <option value="@p"></option> }
      </datalist>
    }
  </div>

  <!-- Entries -->
  <div class="wl-entries" id="wlEntriesList">
    @if (!Model.Any()) {
      <div class="wl-empty" id="wlEmpty">
        <div class="wl-empty-ico">⏱️</div>
        <div class="wl-empty-title">No work logged yet</div>
        <div class="wl-empty-sub">Start by describing what you worked on today. AI will automatically parse it into tasks and estimate hours.</div>
      </div>
    } else {
      @foreach (var group in grouped) {
        var groupHours = group.Sum(e => (double)e.TotalHours);
        var dayLabel = group.Key == today ? "Today"
                     : group.Key == today.AddDays(-1) ? "Yesterday"
                     : group.Key >= today.AddDays(-6) ? group.Key.ToString("dddd")
                     : group.Key.ToString("MMM d");
        <div class="wl-day-group" data-date="@group.Key.ToString("yyyy-MM-dd")">
          <div class="wl-day-header">
            <span>@dayLabel</span>
            <span class="wl-day-hours">@groupHours.ToString("F1")h</span>
          </div>
          @foreach (var entry in group.OrderByDescending(e => e.CreatedAt)) {
            <div class="wl-entry" id="wle-@entry.Id">
              <div class="wl-entry-raw">@entry.RawText</div>
              @if (entry.IsAiParsed && entry.Tasks.Any()) {
                <div class="wl-entry-tasks">
                  @foreach (var task in entry.Tasks.OrderBy(t => t.SortOrder)) {
                    <div class="wl-task wl-cat-@task.Category">
                      <span class="wl-task-dot"></span>
                      <span class="wl-task-desc">@task.Description</span>
                      @if (task.Hours > 0) {
                        <span class="wl-task-hours">@task.Hours.ToString("G3")h</span>
                      }
                      @if (!string.IsNullOrEmpty(task.Project)) {
                        <span class="wl-task-proj">@task.Project</span>
                      }
                    </div>
                  }
                </div>
              }
              <div class="wl-entry-foot">
                <span class="wl-entry-time">@entry.CreatedAt.ToString("h:mm tt")</span>
                @if (!entry.IsAiParsed) {
                  <span class="wl-badge-raw">not parsed</span>
                }
                @if (entry.TotalHours > 0) {
                  <span class="wl-task-hours">@entry.TotalHours.ToString("G3")h</span>
                }
                <button class="wl-entry-del" onclick="wlDeleteEntry(@entry.Id)" title="Delete entry">🗑</button>
              </div>
            </div>
          }
        </div>
      }
    }
  </div>
</div>

@section Scripts {
<script>
function wlInputKey(e) {
  if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) { e.preventDefault(); wlSubmit(); }
}

function wlTemplate(text) {
  var inp = document.getElementById('wlInput');
  inp.value = text;
  inp.focus();
  inp.setSelectionRange(text.length, text.length);
}

async function wlSubmit() {
  var inp  = document.getElementById('wlInput');
  var text = inp.value.trim();
  if (!text) { inp.focus(); return; }

  var dateVal = document.getElementById('wlDate').value;
  var btn  = document.getElementById('wlSubmitBtn');
  var bar  = document.getElementById('wlParsingBar');

  btn.disabled = true;
  if (bar) bar.style.display = 'flex';

  try {
    var data = await gkPost('/WorkLog/Log', { text: text, date: dateVal || null });
    inp.value = '';
    if (bar) bar.style.display = 'none';
    btn.disabled = false;
    if (data) {
      // Hide empty state
      var empty = document.getElementById('wlEmpty');
      if (empty) empty.remove();
      wlPrependEntry(data);
      gkToast('Work logged ✓');
    }
  } catch(err) {
    if (bar) bar.style.display = 'none';
    btn.disabled = false;
    gkToast('Failed to save — try again');
  }
}

function wlBuildEntryHtml(d) {
  var tasksHtml = '';
  if (d.isAiParsed && d.tasks && d.tasks.length > 0) {
    tasksHtml = '<div class="wl-entry-tasks">';
    d.tasks.forEach(function(t) {
      var dot = '<span class="wl-task-dot"></span>';
      var hrs = t.hours > 0 ? '<span class="wl-task-hours">' + t.hours + 'h</span>' : '';
      var prj = t.project ? '<span class="wl-task-proj">' + _esc(t.project) + '</span>' : '';
      tasksHtml += '<div class="wl-task wl-cat-' + (t.category || 'general') + '">' + dot + '<span class="wl-task-desc">' + _esc(t.description) + '</span>' + hrs + prj + '</div>';
    });
    tasksHtml += '</div>';
  }
  var notParsedBadge = d.isAiParsed ? '' : '<span class="wl-badge-raw">not parsed</span>';
  var totalHrs = d.totalHours > 0 ? '<span class="wl-task-hours">' + d.totalHours + 'h</span>' : '';
  return '<div class="wl-entry wl-entry-new" id="wle-' + d.id + '">'
    + '<div class="wl-entry-raw">' + _esc(d.rawText) + '</div>'
    + tasksHtml
    + '<div class="wl-entry-foot"><span class="wl-entry-time">' + d.createdAt + '</span>'
    + notParsedBadge + totalHrs
    + '<button class="wl-entry-del" onclick="wlDeleteEntry(' + d.id + ')" title="Delete">🗑</button></div>'
    + '</div>';
}

function wlPrependEntry(d) {
  var list = document.getElementById('wlEntriesList');
  // Find or create day group
  var dateKey = d.logDate;
  var group = list.querySelector('[data-date="' + dateKey + '"]');
  if (!group) {
    var dayDiv = document.createElement('div');
    dayDiv.className = 'wl-day-group';
    dayDiv.dataset.date = dateKey;
    dayDiv.innerHTML = '<div class="wl-day-header"><span>' + _esc(d.relDate) + '</span>'
      + '<span class="wl-day-hours" id="wl-dhours-' + dateKey + '">0.0h</span></div>';
    list.insertBefore(dayDiv, list.firstChild);
    group = dayDiv;
  }
  // Insert entry after header
  var header = group.querySelector('.wl-day-header');
  header.insertAdjacentHTML('afterend', wlBuildEntryHtml(d));
  // Update day total
  updateDayTotal(dateKey);
}

function updateDayTotal(dateKey) {
  var group = document.querySelector('[data-date="' + dateKey + '"]');
  if (!group) return;
  var hoursEl = group.querySelector('.wl-day-hours');
  if (!hoursEl) return;
  var total = 0;
  group.querySelectorAll('.wl-entry').forEach(function(el) {
    var hEl = el.querySelector('.wl-task-hours');
    if (hEl) {
      var v = parseFloat(hEl.textContent);
      if (!isNaN(v)) total += v;
    }
  });
  hoursEl.textContent = total.toFixed(1) + 'h';
}

async function wlDeleteEntry(id) {
  var el = document.getElementById('wle-' + id);
  if (!el) return;
  el.classList.add('wl-entry-removing');
  try {
    await gkPost('/WorkLog/DeleteEntry', { id: id });
    setTimeout(function() {
      var group = el.closest('.wl-day-group');
      el.remove();
      if (group) {
        var remaining = group.querySelectorAll('.wl-entry');
        if (remaining.length === 0) group.remove();
      }
      if (!document.querySelector('.wl-entry')) {
        document.getElementById('wlEntriesList').innerHTML =
          '<div class="wl-empty" id="wlEmpty"><div class="wl-empty-ico">⏱️</div>'
          + '<div class="wl-empty-title">No work logged yet</div>'
          + '<div class="wl-empty-sub">Start by describing what you worked on today.</div></div>';
      }
    }, 200);
    gkToast('Entry deleted');
  } catch(err) {
    el.classList.remove('wl-entry-removing');
    gkToast('Failed to delete');
  }
}

function _esc(s) {
  if (!s) return '';
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
</script>
}
