@model List<WorkLogApp.Models.WorkEntry>
@using WorkLogApp.Models
@using System.Text.Json
@{
    Layout = "_Layout";
    ViewData["Title"] = "worklog.";
    var todayHours = (double)(ViewBag.TodayHours ?? 0);
    var weekHours  = (double)(ViewBag.WeekHours  ?? 0);
    var streak     = (int)(ViewBag.Streak ?? 0);
    var projects   = ViewBag.Projects as List<string> ?? new List<string>();
    var notes      = ViewBag.Notes as List<WorkLogApp.Models.Note> ?? new List<WorkLogApp.Models.Note>();
    var today      = DateTime.UtcNow.Date;
    var pinned     = notes.Where(n => n.IsPinned).ToList();
    var otherNotes = notes.Where(n => !n.IsPinned).ToList();

    var grouped = Model.GroupBy(e => e.LogDate.Date)
                       .OrderByDescending(g => g.Key)
                       .ToList();
}

@section Styles {
<style>
  /* ── Tabs ── */
  .sp-tabs { display: flex; gap: 4px; margin-bottom: 24px; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 4px; }
  .sp-tab { flex: 1; padding: 9px 16px; border: none; border-radius: 9px; font-size: 14px; font-weight: 600; cursor: pointer; font-family: inherit; color: var(--text2); background: transparent; transition: all .15s; }
  .sp-tab.active { background: var(--accent); color: #fff; }
  .sp-panel { display: none; }
  .sp-panel.active { display: block; }

  /* ── Stats bar ── */
  .wl-stats { display: flex; gap: 16px; margin-bottom: 20px; flex-wrap: wrap; }
  .wl-stat { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 14px 20px; text-align: center; flex: 1; min-width: 100px; }
  .wl-stat-val { display: block; font-size: 24px; font-weight: 700; color: var(--text); }
  .wl-stat-lbl { font-size: 12px; color: var(--text2); }
  .wl-streak .wl-stat-val { color: #f97316; }

  /* ── Work log creator ── */
  .wl-creator { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 20px; margin-bottom: 24px; box-shadow: var(--shadow); }
  .wl-creator-inp { width: 100%; border: none; outline: none; font-size: 16px; background: transparent; color: var(--text); resize: none; font-family: inherit; min-height: 60px; }
  .wl-creator-inp::placeholder { color: var(--text2); }
  .wl-creator-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 14px; flex-wrap: wrap; }
  .wl-creator-date { border: 1px solid var(--border); border-radius: 8px; padding: 7px 12px; font-size: 13.5px; background: var(--bg); color: var(--text); font-family: inherit; outline: none; }
  .wl-templates-row { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--border); }
  .wl-tpl-btn { padding: 5px 12px; border-radius: 20px; border: 1px solid var(--border); background: var(--bg); color: var(--text2); font-size: 12.5px; cursor: pointer; transition: all .15s; }
  .wl-tpl-btn:hover { border-color: var(--accent); color: var(--accent); }
  .wl-btn-primary { padding: 9px 22px; border-radius: 24px; background: var(--accent); color: #fff; border: none; cursor: pointer; font-size: 14px; font-weight: 600; transition: opacity .15s; }
  .wl-btn-primary:hover { opacity: .88; }
  .wl-btn-primary:disabled { opacity: .4; cursor: default; }
  .wl-parsing { display: flex; align-items: center; gap: 10px; padding: 12px 16px; background: rgba(99,102,241,.06); border: 1px solid rgba(99,102,241,.15); border-radius: 10px; margin-bottom: 12px; font-size: 13px; color: var(--text2); }

  /* ── Work entries ── */
  .wl-entries { display: flex; flex-direction: column; gap: 8px; }
  .wl-day-group { margin-bottom: 12px; }
  .wl-day-header { display: flex; justify-content: space-between; align-items: center; padding: 4px 0 10px; font-size: 13px; font-weight: 600; color: var(--text2); border-bottom: 1px solid var(--border); margin-bottom: 10px; }
  .wl-day-hours { background: var(--bg); border: 1px solid var(--border); border-radius: 12px; padding: 2px 10px; font-size: 12px; }
  .wl-entry { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 14px 16px; transition: box-shadow .15s; }
  .wl-entry:hover { box-shadow: 0 1px 3px rgba(0,0,0,.08),0 1px 2px rgba(0,0,0,.04); }
  .wl-entry-raw { font-size: 14px; color: var(--text2); margin-bottom: 10px; line-height: 1.5; }
  .wl-entry-tasks { display: flex; flex-direction: column; gap: 6px; margin-bottom: 10px; }
  .wl-task { display: flex; align-items: center; gap: 8px; font-size: 13.5px; }
  .wl-task-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .wl-task-desc { flex: 1; color: var(--text); }
  .wl-task-hours { background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 1px 8px; font-size: 12px; font-weight: 600; color: var(--text2); flex-shrink: 0; }
  .wl-task-proj { background: rgba(99,102,241,.1); color: #6366f1; border-radius: 10px; padding: 1px 8px; font-size: 11.5px; flex-shrink: 0; }
  .wl-cat-development .wl-task-dot { background: #3b82f6; }
  .wl-cat-meeting     .wl-task-dot { background: #f59e0b; }
  .wl-cat-review      .wl-task-dot { background: #10b981; }
  .wl-cat-planning    .wl-task-dot { background: #8b5cf6; }
  .wl-cat-ops         .wl-task-dot { background: #ef4444; }
  .wl-cat-general     .wl-task-dot { background: #6b7280; }
  .wl-entry-foot { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--text2); }
  .wl-entry-time { flex: 1; }
  .wl-badge-raw { background: rgba(251,146,60,.15); color: #f97316; border-radius: 10px; padding: 1px 8px; font-size: 11.5px; }
  .wl-entry-del { background: none; border: none; cursor: pointer; color: var(--text2); font-size: 16px; padding: 2px 6px; border-radius: 6px; transition: color .15s, background .15s; }
  .wl-entry-del:hover { color: #ef4444; background: rgba(239,68,68,.08); }
  .wl-empty { text-align: center; padding: 60px 20px; color: var(--text2); }
  .wl-empty-ico { font-size: 48px; margin-bottom: 16px; }
  .wl-empty-title { font-size: 18px; font-weight: 600; color: var(--text); margin-bottom: 8px; }
  .wl-empty-sub { font-size: 14px; max-width: 360px; margin: 0 auto; line-height: 1.6; }

  @@keyframes wlFadeIn { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }
  .wl-entry-new { animation: wlFadeIn .25s cubic-bezier(.22,1,.36,1); }
  @@keyframes wlFadeOut { to { opacity: 0; transform: scale(.95); } }
  .wl-entry-removing { animation: wlFadeOut .18s forwards; }

  /* ── Notes panel ── */
  .sp-notes-search { display: flex; align-items: center; gap: 8px; background: var(--surface); border: 1px solid var(--border); border-radius: 24px; padding: 0 12px 0 16px; height: 42px; margin-bottom: 20px; }
  .sp-notes-search input { flex: 1; border: none; outline: none; background: transparent; font-size: 14px; color: var(--text); font-family: inherit; }
  .sp-notes-search input::placeholder { color: var(--text2); }
  .gk-cl-item { display: flex; align-items: center; gap: 8px; padding: 3px 16px; }
  .gk-cl-item input[type="checkbox"] { flex-shrink: 0; accent-color: var(--text2); }
  .gk-cl-item-txt { flex: 1; border: none; outline: none; background: transparent; font-size: 14px; font-family: inherit; color: var(--text); }
  .gk-cl-item-del { width: 24px; height: 24px; border-radius: 50%; border: none; background: none; color: var(--text2); cursor: pointer; opacity: 0; transition: opacity var(--trans); display: flex; align-items: center; justify-content: center; }
  .gk-cl-item:hover .gk-cl-item-del { opacity: 1; }
  #gkModalPinBtn.pinned { color: var(--text); }

  /* ── Timesheet panel ── */
  .ts-nav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; flex-wrap: wrap; gap: 12px; }
  .ts-nav-btn { padding: 8px 16px; border: 1px solid var(--border); background: var(--surface); color: var(--text); border-radius: 8px; cursor: pointer; font-size: 14px; transition: background .15s; font-family: inherit; }
  .ts-nav-btn:hover { background: var(--bg); }
  .ts-week-label { font-size: 15px; font-weight: 600; color: var(--text); }
  .ts-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .ts-export-btn { padding: 7px 16px; border-radius: 8px; border: 1px solid var(--border); background: var(--surface); color: var(--text); font-size: 13px; cursor: pointer; transition: all .15s; font-family: inherit; text-decoration: none; display: inline-flex; align-items: center; }
  .ts-export-btn:hover { border-color: var(--accent); color: var(--accent); }
  .ts-table-wrap { overflow-x: auto; }
  .ts-table { width: 100%; border-collapse: collapse; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; box-shadow: 0 1px 3px rgba(0,0,0,.08); min-width: 580px; }
  .ts-table th { background: var(--bg); padding: 10px 12px; font-size: 12.5px; font-weight: 600; color: var(--text2); text-align: center; border-bottom: 1px solid var(--border); }
  .ts-table th:first-child { text-align: left; }
  .ts-table td { padding: 10px 12px; font-size: 13.5px; border-bottom: 1px solid var(--border); text-align: center; color: var(--text2); }
  .ts-table td:first-child { text-align: left; color: var(--text); font-weight: 500; }
  .ts-table tr:last-child td { border-bottom: none; }
  .ts-table .ts-total-row td { font-weight: 700; background: var(--bg); color: var(--text); }
  .ts-hours-cell { color: var(--text); font-weight: 600; }
  .ts-zero { color: var(--border); }
  .ts-today-col { background: rgba(99,102,241,.04); }
  .ts-loading { text-align: center; padding: 40px 20px; color: var(--text2); }
  .ts-empty { text-align: center; padding: 60px 20px; color: var(--text2); }
  .ts-empty-ico { font-size: 48px; margin-bottom: 16px; }
  .ts-empty-title { font-size: 18px; font-weight: 600; color: var(--text); margin-bottom: 8px; }
</style>
}

<!-- Stats bar (always visible above tabs) -->
<div class="wl-stats">
  <div class="wl-stat">
    <span class="wl-stat-val">@todayHours.ToString("F1")</span>
    <span class="wl-stat-lbl">Today</span>
  </div>
  <div class="wl-stat">
    <span class="wl-stat-val">@weekHours.ToString("F1")</span>
    <span class="wl-stat-lbl">This Week</span>
  </div>
  <div class="wl-stat wl-streak">
    <span class="wl-stat-val">🔥 @streak</span>
    <span class="wl-stat-lbl">Day Streak</span>
  </div>
</div>

<!-- Tab pills -->
<div class="sp-tabs">
  <button class="sp-tab" data-tab="worklog" onclick="spTab('worklog')">⏱ Work Log</button>
  <button class="sp-tab" data-tab="notes"   onclick="spTab('notes')">💡 Notes</button>
  <button class="sp-tab" data-tab="timesheet" onclick="spTab('timesheet')">📅 Timesheet</button>
</div>

<!-- ═══════════════════════════════════════════════════════════════
     PANEL 1: WORK LOG
     ═══════════════════════════════════════════════════════════════ -->
<div class="sp-panel" id="spPanel-worklog">
  <div class="wl-creator">
    <div id="wlParsingBar" class="wl-parsing" style="display:none">
      <div class="gk-ai-typing"><span></span><span></span><span></span></div>
      AI is parsing your work log…
    </div>
    <textarea id="wlInput" class="wl-creator-inp"
              placeholder="What did you work on today? (e.g. Fixed auth bug 2h, reviewed PRs 1h, team standup 30m)"
              rows="3" onkeydown="wlInputKey(event)"></textarea>
    <div class="wl-creator-row">
      <input type="date" id="wlDate" class="wl-creator-date"
             value="@today.ToString("yyyy-MM-dd")"
             max="@today.ToString("yyyy-MM-dd")">
      <button class="wl-btn-primary" id="wlSubmitBtn" onclick="wlSubmit()">Log it →</button>
    </div>
    <div class="wl-templates-row">
      <button class="wl-tpl-btn" onclick="wlTemplate('Sprint review 2h, code review 1h, bug fixes 3h')">Sprint review</button>
      <button class="wl-tpl-btn" onclick="wlTemplate('Daily standup 15m, planning session 1h')">Stand-up</button>
      <button class="wl-tpl-btn" onclick="wlTemplate('Deep work on feature implementation 4h')">Deep work</button>
      <button class="wl-tpl-btn" onclick="wlTemplate('Team meetings 2h, 1:1 with manager 30m')">Meetings</button>
    </div>
    @if (projects.Count > 0) {
      <datalist id="wlProjectList">
        @foreach (var p in projects) { <option value="@p"></option> }
      </datalist>
    }
  </div>

  <div class="wl-entries" id="wlEntriesList">
    @if (!Model.Any()) {
      <div class="wl-empty" id="wlEmpty">
        <div class="wl-empty-ico">⏱️</div>
        <div class="wl-empty-title">No work logged yet</div>
        <div class="wl-empty-sub">Start by describing what you worked on today. AI will automatically parse it into tasks and estimate hours.</div>
      </div>
    } else {
      @foreach (var group in grouped) {
        var groupHours = group.Sum(e => (double)e.TotalHours);
        var dayLabel = group.Key == today ? "Today"
                     : group.Key == today.AddDays(-1) ? "Yesterday"
                     : group.Key >= today.AddDays(-6) ? group.Key.ToString("dddd")
                     : group.Key.ToString("MMM d");
        <div class="wl-day-group" data-date="@group.Key.ToString("yyyy-MM-dd")">
          <div class="wl-day-header">
            <span>@dayLabel</span>
            <span class="wl-day-hours">@groupHours.ToString("F1")h</span>
          </div>
          @foreach (var entry in group.OrderByDescending(e => e.CreatedAt)) {
            <div class="wl-entry" id="wle-@entry.Id">
              <div class="wl-entry-raw">@entry.RawText</div>
              @if (entry.IsAiParsed && entry.Tasks.Any()) {
                <div class="wl-entry-tasks">
                  @foreach (var task in entry.Tasks.OrderBy(t => t.SortOrder)) {
                    <div class="wl-task wl-cat-@task.Category">
                      <span class="wl-task-dot"></span>
                      <span class="wl-task-desc">@task.Description</span>
                      @if (task.Hours > 0) { <span class="wl-task-hours">@task.Hours.ToString("G3")h</span> }
                      @if (!string.IsNullOrEmpty(task.Project)) { <span class="wl-task-proj">@task.Project</span> }
                    </div>
                  }
                </div>
              }
              <div class="wl-entry-foot">
                <span class="wl-entry-time">@entry.CreatedAt.ToString("h:mm tt")</span>
                @if (!entry.IsAiParsed) { <span class="wl-badge-raw">not parsed</span> }
                @if (entry.TotalHours > 0) { <span class="wl-task-hours">@entry.TotalHours.ToString("G3")h</span> }
                <button class="wl-entry-del" onclick="wlDeleteEntry(@entry.Id)" title="Delete entry">🗑</button>
              </div>
            </div>
          }
        </div>
      }
    }
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════
     PANEL 2: NOTES
     ═══════════════════════════════════════════════════════════════ -->
<div class="sp-panel" id="spPanel-notes">
  <!-- Search -->
  <div class="sp-notes-search">
    <input type="text" id="gkSearchInput" placeholder="Search notes…" autocomplete="off"
           oninput="gkFilter(this.value)"
           onkeydown="if(event.key==='Escape'){gkClearSearch();this.blur();}">
    <button class="gk-icon-btn gk-search-clear" id="gkSearchClear" style="display:none;width:32px;height:32px" onclick="gkClearSearch()">
      <svg width="16" height="16" viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" fill="currentColor"/></svg>
    </button>
  </div>

  <!-- Note creator -->
  <div class="gk-creator" id="gkCreator">
    <div class="gk-creator-idle" id="gkCreatorIdle">
      <span class="gk-creator-idle-text">Take a note…</span>
      <div class="gk-creator-idle-btns">
        <button class="gk-creator-idle-btn" onclick="gkOpenCreator('list')" title="New list (L)">
          <svg width="20" height="20" viewBox="0 0 24 24"><path d="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z" fill="currentColor"/></svg>
        </button>
        <button class="gk-creator-idle-btn" onclick="gkOpenCreator('note')" title="New note (N)">
          <svg width="20" height="20" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" fill="currentColor"/></svg>
        </button>
      </div>
    </div>
    <div class="gk-creator-body" id="gkCreatorBody">
      <input type="text" class="gk-creator-title" id="gkCreatorTitle" placeholder="Title">
      <textarea class="gk-creator-ta" id="gkCreatorTa" placeholder="Take a note…"
                oninput="_autosizeTa(this)" onkeydown="_creatorTaKey(event)" style="display:none"></textarea>
      <div class="gk-creator-list" id="gkCreatorList" style="display:none"></div>
      <div class="gk-creator-foot">
        <div class="gk-creator-tools">
          <button class="gk-icon-btn" onclick="gkShowColorPicker('creator',this)" title="Change color">
            <svg width="18" height="18" viewBox="0 0 24 24"><path d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.26-.38-.61-.38-.99 0-.83.67-1.5 1.5-1.5H16c2.76 0 5-2.24 5-5 0-4.42-4.03-8-9-8zm-5.5 9c-.83 0-1.5-.67-1.5-1.5S5.67 9 6.5 9 8 9.67 8 10.5 7.33 12 6.5 12zm3-4C8.67 8 8 7.33 8 6.5S8.67 5 9.5 5s1.5.67 1.5 1.5S10.33 8 9.5 8zm5 0c-.83 0-1.5-.67-1.5-1.5S13.67 5 14.5 5s1.5.67 1.5 1.5S15.33 8 14.5 8zm3 4c-.83 0-1.5-.67-1.5-1.5S16.67 9 17.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z" fill="currentColor"/></svg>
          </button>
        </div>
        <button class="gk-creator-close" onclick="gkCreatorClose()">Close</button>
      </div>
    </div>
  </div>

  @if (pinned.Any()) {
    <div class="gk-section-label">Pinned</div>
    <div class="gk-grid" id="gkPinned">
      @foreach (var n in pinned) {
        var cat = n.Color ?? "default";
        <div class="gk-card nc-@cat pinned" id="gnc-@n.Id"
             data-id="@n.Id" data-color="@cat"
             data-title="@n.Title"
             data-content="@n.Content"
             data-type="@n.NoteType"
             data-time="@n.RelativeTime()"
             onclick="gkOpenNote(@n.Id)">
          <button class="gk-card-pin" title="Unpin" onclick="event.stopPropagation();gkTogglePin(@n.Id)">
            <svg width="16" height="16" viewBox="0 0 24 24"><path d="M14 4v5l2 1v4h-5v6l-1 1-1-1v-6H4v-4l2-1V4h8z" fill="currentColor"/></svg>
          </button>
          <div class="gk-card-body">
            @if (!string.IsNullOrEmpty(n.Title)) { <div class="gk-card-title">@n.Title</div> }
            @if (n.NoteType == "list" && n.ChecklistItems.Any()) {
              <div class="gk-card-list">
                @foreach (var item in n.ChecklistItems.Take(8)) {
                  <div class="gk-card-list-item @(item.IsChecked ? "checked" : "")">
                    <input type="checkbox" @(item.IsChecked ? "checked" : "") data-id="@item.Id" onclick="event.stopPropagation();gkToggleItem(@item.Id,this.checked)">
                    <span>@item.Text</span>
                  </div>
                }
                @if (n.ChecklistItems.Count > 8) { <div style="font-size:12px;color:var(--text2);padding-top:4px">+@(n.ChecklistItems.Count - 8) more</div> }
              </div>
            } else if (!string.IsNullOrEmpty(n.Content)) {
              <div class="gk-card-text">@n.Content</div>
            }
          </div>
          <div class="gk-card-actions" onclick="event.stopPropagation()">
            <button class="gk-card-act" onclick="gkToggleArchive(@n.Id)" title="Archive">
              <svg width="16" height="16" viewBox="0 0 24 24"><path d="M20.54 5.23l-1.39-1.68C18.88 3.21 18.47 3 18 3H6c-.47 0-.88.21-1.16.55L3.46 5.23C3.17 5.57 3 6.02 3 6.5V19c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6.5c0-.48-.17-.93-.46-1.27zM12 17.5L6.5 12H10v-2h4v2h3.5L12 17.5zM5.12 5l.81-1h12l.94 1H5.12z" fill="currentColor"/></svg>
            </button>
            <button class="gk-card-act" onclick="gkShowColorPicker(@n.Id,this)" title="Color">
              <svg width="16" height="16" viewBox="0 0 24 24"><path d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.26-.38-.61-.38-.99 0-.83.67-1.5 1.5-1.5H16c2.76 0 5-2.24 5-5 0-4.42-4.03-8-9-8zm-5.5 9c-.83 0-1.5-.67-1.5-1.5S5.67 9 6.5 9 8 9.67 8 10.5 7.33 12 6.5 12zm3-4C8.67 8 8 7.33 8 6.5S8.67 5 9.5 5s1.5.67 1.5 1.5S10.33 8 9.5 8zm5 0c-.83 0-1.5-.67-1.5-1.5S13.67 5 14.5 5s1.5.67 1.5 1.5S15.33 8 14.5 8zm3 4c-.83 0-1.5-.67-1.5-1.5S16.67 9 17.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z" fill="currentColor"/></svg>
            </button>
            <div class="gk-card-act-spacer"></div>
            <button class="gk-card-act del" onclick="gkDeleteNote(@n.Id)" title="Delete">
              <svg width="16" height="16" viewBox="0 0 24 24"><path d="M15 4V3H9v1H4v2h1l1 13c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2l1-13h1V4h-5zm2 15H7l-1-13h10l-1 13z" fill="currentColor"/></svg>
            </button>
          </div>
        </div>
      }
    </div>
    @if (otherNotes.Any()) { <div class="gk-section-gap"></div> }
  }

  @if (pinned.Any() && otherNotes.Any()) {
    <div class="gk-section-label">Others</div>
  }

  <div class="gk-grid" id="gkGrid">
    @foreach (var n in otherNotes) {
      var cat = n.Color ?? "default";
      <div class="gk-card nc-@cat" id="gnc-@n.Id"
           data-id="@n.Id" data-color="@cat"
           data-title="@n.Title"
           data-content="@n.Content"
           data-type="@n.NoteType"
           data-time="@n.RelativeTime()"
           onclick="gkOpenNote(@n.Id)">
        <button class="gk-card-pin" title="Pin" onclick="event.stopPropagation();gkTogglePin(@n.Id)">
          <svg width="16" height="16" viewBox="0 0 24 24"><path d="M16 9V4l1-1H7l1 1v5l-2 2v2h5.2v6l1 1 1-1v-6H18v-2l-2-2z" fill="currentColor"/></svg>
        </button>
        <div class="gk-card-body">
          @if (!string.IsNullOrEmpty(n.Title)) { <div class="gk-card-title">@n.Title</div> }
          @if (n.NoteType == "list" && n.ChecklistItems.Any()) {
            <div class="gk-card-list">
              @foreach (var item in n.ChecklistItems.Take(8)) {
                <div class="gk-card-list-item @(item.IsChecked ? "checked" : "")">
                  <input type="checkbox" @(item.IsChecked ? "checked" : "") data-id="@item.Id" onclick="event.stopPropagation();gkToggleItem(@item.Id,this.checked)">
                  <span>@item.Text</span>
                </div>
              }
              @if (n.ChecklistItems.Count > 8) { <div style="font-size:12px;color:var(--text2);padding-top:4px">+@(n.ChecklistItems.Count - 8) more</div> }
            </div>
          } else if (!string.IsNullOrEmpty(n.Content)) {
            <div class="gk-card-text">@n.Content</div>
          }
        </div>
        <div class="gk-card-actions" onclick="event.stopPropagation()">
          <button class="gk-card-act" onclick="gkToggleArchive(@n.Id)" title="Archive">
            <svg width="16" height="16" viewBox="0 0 24 24"><path d="M20.54 5.23l-1.39-1.68C18.88 3.21 18.47 3 18 3H6c-.47 0-.88.21-1.16.55L3.46 5.23C3.17 5.57 3 6.02 3 6.5V19c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6.5c0-.48-.17-.93-.46-1.27zM12 17.5L6.5 12H10v-2h4v2h3.5L12 17.5zM5.12 5l.81-1h12l.94 1H5.12z" fill="currentColor"/></svg>
          </button>
          <button class="gk-card-act" onclick="gkShowColorPicker(@n.Id,this)" title="Color">
            <svg width="16" height="16" viewBox="0 0 24 24"><path d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.26-.38-.61-.38-.99 0-.83.67-1.5 1.5-1.5H16c2.76 0 5-2.24 5-5 0-4.42-4.03-8-9-8zm-5.5 9c-.83 0-1.5-.67-1.5-1.5S5.67 9 6.5 9 8 9.67 8 10.5 7.33 12 6.5 12zm3-4C8.67 8 8 7.33 8 6.5S8.67 5 9.5 5s1.5.67 1.5 1.5S10.33 8 9.5 8zm5 0c-.83 0-1.5-.67-1.5-1.5S13.67 5 14.5 5s1.5.67 1.5 1.5S15.33 8 14.5 8zm3 4c-.83 0-1.5-.67-1.5-1.5S16.67 9 17.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z" fill="currentColor"/></svg>
          </button>
          <div class="gk-card-act-spacer"></div>
          <button class="gk-card-act del" onclick="gkDeleteNote(@n.Id)" title="Delete">
            <svg width="16" height="16" viewBox="0 0 24 24"><path d="M15 4V3H9v1H4v2h1l1 13c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2l1-13h1V4h-5zm2 15H7l-1-13h10l-1 13z" fill="currentColor"/></svg>
          </button>
        </div>
      </div>
    }
    @if (!notes.Any()) {
      <div class="gk-empty">
        <div class="gk-empty-icon">💡</div>
        <div class="gk-empty-title">Notes you add appear here</div>
        <div class="gk-empty-sub">Press N or click the pencil icon to create your first note</div>
      </div>
    }
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════
     PANEL 3: TIMESHEET (lazy loaded)
     ═══════════════════════════════════════════════════════════════ -->
<div class="sp-panel" id="spPanel-timesheet">
  <div id="tsContent">
    <div class="ts-loading">
      <div class="gk-ai-typing" style="justify-content:center"><span></span><span></span><span></span></div>
      <p style="margin-top:12px">Loading timesheet…</p>
    </div>
  </div>
</div>

@section Scripts {
<script>
// ── Tab switching ──────────────────────────────────────────────────────────────
var _tsLoaded = false;
var _tsOffset = 0;

function spTab(name) {
  document.querySelectorAll('.sp-tab').forEach(function(t) {
    t.classList.toggle('active', t.dataset.tab === name);
  });
  document.querySelectorAll('.sp-panel').forEach(function(p) {
    p.classList.toggle('active', p.id === 'spPanel-' + name);
  });
  localStorage.setItem('sp_tab', name);
  if (name === 'timesheet' && !_tsLoaded) { _tsLoaded = true; tsLoad(0); }
}

document.addEventListener('DOMContentLoaded', function() {
  spTab(localStorage.getItem('sp_tab') || 'worklog');
});

// ── Timesheet lazy load ────────────────────────────────────────────────────────
async function tsLoad(offset) {
  _tsOffset = offset;
  var container = document.getElementById('tsContent');
  if (!container) return;
  container.innerHTML = '<div class="ts-loading"><div class="gk-ai-typing" style="justify-content:center"><span></span><span></span><span></span></div><p style="margin-top:12px">Loading…</p></div>';
  try {
    var r = await fetch('/WorkLog/TimesheetJson?weekOffset=' + offset);
    if (!r.ok) throw new Error(r.status);
    var d = await r.json();
    container.innerHTML = _buildTimesheetHtml(d);
  } catch(err) {
    container.innerHTML = '<div class="ts-empty"><div class="ts-empty-ico">⚠️</div><div class="ts-empty-title">Could not load timesheet</div></div>';
  }
}

function _buildTimesheetHtml(d) {
  var today = new Date().toISOString().slice(0,10);
  var prevBtn = '<button class="ts-nav-btn" onclick="tsLoad(' + (d.weekOffset - 1) + ')">← Prev</button>';
  var nextBtn = d.weekOffset < 0
    ? '<button class="ts-nav-btn" onclick="tsLoad(' + (d.weekOffset + 1) + ')">Next →</button>'
    : '<button class="ts-nav-btn" style="opacity:.4;pointer-events:none">Next →</button>';
  var nav = '<div class="ts-nav"><div style="display:flex;align-items:center;gap:12px">'
    + prevBtn
    + '<span class="ts-week-label">Week of ' + d.weekStart + ' – ' + d.weekEnd + '</span>'
    + nextBtn
    + '</div><div class="ts-actions">'
    + '<a href="/WorkLog/ExportCsv" class="ts-export-btn">⬇ Export CSV</a>'
    + '<button class="ts-export-btn" onclick="tsCopyJira()">📋 Copy Jira</button>'
    + '<button class="ts-export-btn" onclick="tsCopySlack()">💬 Copy Slack</button>'
    + '</div></div>';

  if (!d.byProject || d.byProject.length === 0) {
    return nav + '<div class="ts-empty"><div class="ts-empty-ico">📅</div><div class="ts-empty-title">No work logged this week</div></div>';
  }

  var days = d.days || [];
  var head = '<thead><tr><th>Project</th>';
  days.forEach(function(day) {
    var cls = day.date === today ? ' class="ts-today-col"' : '';
    head += '<th' + cls + '>' + day.label + '<br><span style="font-weight:400;color:var(--text2)">' + day.short + '</span></th>';
  });
  head += '<th>Total</th></tr></thead>';

  var body = '<tbody>';
  d.byProject.forEach(function(proj) {
    body += '<tr><td>' + _esc(proj.name) + '</td>';
    days.forEach(function(day) {
      var h = proj.hours[day.date] || 0;
      var cls = day.date === today ? ' class="ts-today-col"' : '';
      body += '<td' + cls + '>' + (h > 0 ? '<span class="ts-hours-cell">' + h.toFixed(1) + 'h</span>' : '<span class="ts-zero">—</span>') + '</td>';
    });
    body += '<td class="ts-hours-cell">' + proj.total.toFixed(1) + 'h</td></tr>';
  });
  body += '</tbody>';

  var foot = '<tfoot><tr class="ts-total-row"><td>Total</td>';
  days.forEach(function(day) {
    var h = d.dayTotals[day.date] || 0;
    var cls = day.date === today ? ' class="ts-today-col"' : '';
    foot += '<td' + cls + '>' + (h > 0 ? h.toFixed(1) + 'h' : '<span class="ts-zero">—</span>') + '</td>';
  });
  foot += '<td>' + d.grandTotal.toFixed(1) + 'h</td></tr></tfoot>';

  _jiraText  = d.jiraText  || '';
  _slackText = d.slackText || '';

  return nav + '<div class="ts-table-wrap"><table class="ts-table">' + head + body + foot + '</table></div>';
}

var _jiraText  = '';
var _slackText = '';

function tsCopyJira() {
  navigator.clipboard.writeText(_jiraText).then(function() {
    gkToast('Jira format copied to clipboard');
  }).catch(function() { prompt('Copy Jira format:', _jiraText); });
}
function tsCopySlack() {
  navigator.clipboard.writeText(_slackText).then(function() {
    gkToast('Slack standup copied to clipboard');
  }).catch(function() { prompt('Copy Slack standup:', _slackText); });
}

// ── Work log JS ────────────────────────────────────────────────────────────────
function wlInputKey(e) {
  if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) { e.preventDefault(); wlSubmit(); }
}

function wlTemplate(text) {
  var inp = document.getElementById('wlInput');
  inp.value = text;
  inp.focus();
  inp.setSelectionRange(text.length, text.length);
}

async function wlSubmit() {
  var inp  = document.getElementById('wlInput');
  var text = inp.value.trim();
  if (!text) { inp.focus(); return; }
  var dateVal = document.getElementById('wlDate').value;
  var btn  = document.getElementById('wlSubmitBtn');
  var bar  = document.getElementById('wlParsingBar');
  btn.disabled = true;
  if (bar) bar.style.display = 'flex';
  try {
    var data = await gkPost('/WorkLog/Log', { text: text, date: dateVal || null });
    inp.value = '';
    if (bar) bar.style.display = 'none';
    btn.disabled = false;
    if (data) {
      var empty = document.getElementById('wlEmpty');
      if (empty) empty.remove();
      wlPrependEntry(data);
      gkToast('Work logged ✓');
    }
  } catch(err) {
    if (bar) bar.style.display = 'none';
    btn.disabled = false;
    gkToast('Failed to save — try again');
  }
}

function wlBuildEntryHtml(d) {
  var tasksHtml = '';
  if (d.isAiParsed && d.tasks && d.tasks.length > 0) {
    tasksHtml = '<div class="wl-entry-tasks">';
    d.tasks.forEach(function(t) {
      var dot = '<span class="wl-task-dot"></span>';
      var hrs = t.hours > 0 ? '<span class="wl-task-hours">' + t.hours + 'h</span>' : '';
      var prj = t.project ? '<span class="wl-task-proj">' + _esc(t.project) + '</span>' : '';
      tasksHtml += '<div class="wl-task wl-cat-' + (t.category || 'general') + '">' + dot + '<span class="wl-task-desc">' + _esc(t.description) + '</span>' + hrs + prj + '</div>';
    });
    tasksHtml += '</div>';
  }
  var notParsedBadge = d.isAiParsed ? '' : '<span class="wl-badge-raw">not parsed</span>';
  var totalHrs = d.totalHours > 0 ? '<span class="wl-task-hours">' + d.totalHours + 'h</span>' : '';
  return '<div class="wl-entry wl-entry-new" id="wle-' + d.id + '">'
    + '<div class="wl-entry-raw">' + _esc(d.rawText) + '</div>'
    + tasksHtml
    + '<div class="wl-entry-foot"><span class="wl-entry-time">' + d.createdAt + '</span>'
    + notParsedBadge + totalHrs
    + '<button class="wl-entry-del" onclick="wlDeleteEntry(' + d.id + ')" title="Delete">🗑</button></div>'
    + '</div>';
}

function wlPrependEntry(d) {
  var list = document.getElementById('wlEntriesList');
  var dateKey = d.logDate;
  var group = list.querySelector('[data-date="' + dateKey + '"]');
  if (!group) {
    var dayDiv = document.createElement('div');
    dayDiv.className = 'wl-day-group';
    dayDiv.dataset.date = dateKey;
    dayDiv.innerHTML = '<div class="wl-day-header"><span>' + _esc(d.relDate) + '</span>'
      + '<span class="wl-day-hours" id="wl-dhours-' + dateKey + '">0.0h</span></div>';
    list.insertBefore(dayDiv, list.firstChild);
    group = dayDiv;
  }
  var header = group.querySelector('.wl-day-header');
  header.insertAdjacentHTML('afterend', wlBuildEntryHtml(d));
  updateDayTotal(dateKey);
}

function updateDayTotal(dateKey) {
  var group = document.querySelector('[data-date="' + dateKey + '"]');
  if (!group) return;
  var hoursEl = group.querySelector('.wl-day-hours');
  if (!hoursEl) return;
  var total = 0;
  group.querySelectorAll('.wl-entry').forEach(function(el) {
    var hEl = el.querySelector('.wl-task-hours');
    if (hEl) { var v = parseFloat(hEl.textContent); if (!isNaN(v)) total += v; }
  });
  hoursEl.textContent = total.toFixed(1) + 'h';
}

async function wlDeleteEntry(id) {
  var el = document.getElementById('wle-' + id);
  if (!el) return;
  el.classList.add('wl-entry-removing');
  try {
    await gkPost('/WorkLog/DeleteEntry', { id: id });
    setTimeout(function() {
      var group = el.closest('.wl-day-group');
      el.remove();
      if (group) {
        var remaining = group.querySelectorAll('.wl-entry');
        if (remaining.length === 0) group.remove();
      }
      if (!document.querySelector('.wl-entry')) {
        document.getElementById('wlEntriesList').innerHTML =
          '<div class="wl-empty" id="wlEmpty"><div class="wl-empty-ico">⏱️</div>'
          + '<div class="wl-empty-title">No work logged yet</div>'
          + '<div class="wl-empty-sub">Start by describing what you worked on today.</div></div>';
      }
    }, 200);
    gkToast('Entry deleted');
  } catch(err) {
    el.classList.remove('wl-entry-removing');
    gkToast('Failed to delete');
  }
}

// ── Notes JS ───────────────────────────────────────────────────────────────────
var _SECTION = 'notes';

var _serverItems = {};
@foreach (var n in notes.Where(x => x.NoteType == "list")) {
  var itemsJson = JsonSerializer.Serialize(
    n.ChecklistItems.OrderBy(c => c.SortOrder)
                    .Select(c => new { id = c.Id, text = c.Text, isChecked = c.IsChecked })
  );
  @:_serverItems[@n.Id] = @Html.Raw(itemsJson);
}
function _getServerItems(id) { return _serverItems[id] || null; }

var _modal = { id: null, pinned: false, archived: false, color: 'default', dirty: false, type: 'note' };

function _gkModalNote() {
  return _modal.id ? document.getElementById('gnc-' + _modal.id) : null;
}

function gkOpenNote(id) {
  var card = document.getElementById('gnc-' + id);
  if (!card) return;
  _modal.id       = id;
  _modal.pinned   = card.classList.contains('pinned');
  _modal.archived = false;
  _modal.color    = card.dataset.color || 'default';
  _modal.type     = card.dataset.type || 'note';
  _modal.dirty    = false;
  var ov    = document.getElementById('gkModalOv');
  var modal = document.getElementById('gkModal');
  var title = document.getElementById('gkModalTitle');
  var body  = document.getElementById('gkModalBody');
  var list  = document.getElementById('gkModalList');
  modal.className = 'gk-modal nc-' + _modal.color;
  modal.dataset.noteId = id;
  title.value = card.dataset.title || '';
  if (_modal.type === 'list') {
    body.style.display = 'none'; list.style.display = 'block'; list.innerHTML = '';
    var allItems = _getServerItems(id);
    if (allItems) {
      allItems.forEach(function(it) { _addModalItem(it.id, it.text, it.isChecked, list); });
    } else {
      card.querySelectorAll('.gk-card-list-item').forEach(function(row) {
        var checked = row.classList.contains('checked');
        var text = row.querySelector('span') ? row.querySelector('span').textContent : '';
        var iid  = row.querySelector('input') ? (row.querySelector('input').dataset.id || '') : '';
        _addModalItem(iid, text, checked, list);
      });
    }
    var addBtn = document.createElement('button');
    addBtn.className = 'gk-modal-add-item';
    addBtn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" fill="currentColor"/></svg> List item';
    addBtn.onclick = function() { _modalAddNewItem(); };
    list.append(addBtn);
  } else {
    body.style.display = 'block'; list.style.display = 'none';
    body.textContent = card.dataset.content || '';
    setTimeout(function() {
      body.focus();
      try {
        var r = document.createRange(); r.selectNodeContents(body); r.collapse(false);
        window.getSelection().removeAllRanges(); window.getSelection().addRange(r);
      } catch(e) {}
    }, 60);
  }
  var pinBtn = document.getElementById('gkModalPinBtn');
  if (pinBtn) { pinBtn.classList.toggle('pinned', _modal.pinned); pinBtn.title = _modal.pinned ? 'Unpin note' : 'Pin note'; }
  document.getElementById('gkModalMeta').textContent = 'Edited ' + (card.dataset.time || '');
  ov.style.display = 'flex';
  title.addEventListener('input', _onModalChange);
  body.addEventListener('input', _onModalChange);
}

function _onModalChange() { _modal.dirty = true; }

function gkCloseModal() {
  var ov = document.getElementById('gkModalOv');
  if (!ov || ov.style.display === 'none') return;
  if (_modal.dirty && _modal.id) _saveModal();
  ov.style.display = 'none';
  var title = document.getElementById('gkModalTitle');
  var body  = document.getElementById('gkModalBody');
  if (title) title.removeEventListener('input', _onModalChange);
  if (body)  body.removeEventListener('input', _onModalChange);
  _modal.id = null; _modal.dirty = false;
}

function _saveModal() {
  var id      = _modal.id;
  var title   = document.getElementById('gkModalTitle').value.trim();
  var body    = document.getElementById('gkModalBody');
  var content = (_modal.type === 'note') ? (body ? body.textContent.trim() : '') : '';
  if (!title && !content && _modal.type === 'note') return;
  gkPost('/Notes/Update', { id: parseInt(id), title: title, content: content }).catch(function() {});
  var card = document.getElementById('gnc-' + id);
  if (card) {
    card.dataset.title   = title;
    card.dataset.content = content;
    var tEl = card.querySelector('.gk-card-title');
    var cEl = card.querySelector('.gk-card-text');
    if (title) {
      if (!tEl) {
        var d = document.createElement('div'); d.className = 'gk-card-title'; d.textContent = title;
        card.querySelector('.gk-card-body').prepend(d);
      } else { tEl.textContent = title; }
    } else if (tEl) { tEl.remove(); }
    if (cEl) cEl.textContent = content;
  }
}

function gkModalTogglePin() {
  if (!_modal.id) return;
  _modal.pinned = !_modal.pinned;
  var btn = document.getElementById('gkModalPinBtn');
  if (btn) { btn.classList.toggle('pinned', _modal.pinned); btn.title = _modal.pinned ? 'Unpin note' : 'Pin note'; }
  gkTogglePin(_modal.id, _modal.pinned);
}
function gkModalToggleArchive() {
  if (!_modal.id) return;
  var id = _modal.id;
  gkCloseModal();
  gkToggleArchive(id);
}
function gkModalDelete() {
  if (!_modal.id) return;
  var id = _modal.id;
  gkCloseModal();
  gkDeleteNote(id);
}
function gkModalSetColor(color) {
  if (!_modal.id) return;
  _modal.color = color;
  document.getElementById('gkModal').className = 'gk-modal nc-' + color;
  _updateCardColor(_modal.id, color);
}

function _addModalItem(itemId, text, checked, container) {
  var row = document.createElement('div');
  row.className = 'gk-modal-item' + (checked ? ' done' : '');
  row.dataset.itemId = itemId;
  var cb = document.createElement('input'); cb.type = 'checkbox'; cb.checked = !!checked;
  cb.onchange = function() { row.classList.toggle('done', cb.checked); _toggleModalItem(itemId, cb.checked); };
  var inp = document.createElement('input'); inp.type = 'text'; inp.value = text;
  inp.className = 'gk-modal-item-text'; inp.placeholder = 'List item';
  inp.onblur = function() { if (itemId) _updateModalItemText(itemId, inp.value); };
  inp.onkeydown = function(e) { if (e.key === 'Enter') { e.preventDefault(); _modalAddNewItem(); } };
  var del = document.createElement('button'); del.className = 'gk-modal-item-del';
  del.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" fill="currentColor"/></svg>';
  del.onclick = function() { if (itemId) _deleteModalItem(itemId); row.remove(); };
  row.append(cb, inp, del);
  var addBtn = container.querySelector('.gk-modal-add-item');
  if (addBtn) container.insertBefore(row, addBtn);
  else container.append(row);
  return inp;
}
async function _modalAddNewItem() {
  if (!_modal.id) return;
  var data = await gkPost('/Notes/AddItem', { noteId: parseInt(_modal.id), text: '' });
  if (data) {
    var list = document.getElementById('gkModalList');
    var inp = _addModalItem(data.id, data.text, data.isChecked, list);
    if (inp) inp.focus();
  }
}
async function _toggleModalItem(itemId, checked) {
  await gkPost('/Notes/UpdateItem', { id: parseInt(itemId), checked: checked }).catch(function() {});
}
async function _updateModalItemText(itemId, text) {
  await gkPost('/Notes/UpdateItem', { id: parseInt(itemId), text: text }).catch(function() {});
}
async function _deleteModalItem(itemId) {
  await gkPost('/Notes/DeleteItem', { id: parseInt(itemId) }).catch(function() {});
}

var _creatorType  = 'note';
var _creatorColor = 'default';

function gkOpenCreator(type) {
  _creatorType  = type || 'note';
  _creatorColor = 'default';
  var creator = document.getElementById('gkCreator');
  var ta = document.getElementById('gkCreatorTa');
  var cl = document.getElementById('gkCreatorList');
  if (!creator) return;
  creator.classList.add('active');
  creator.className = creator.className.replace(/\bnc-\S+/g, '').trim() + ' active nc-default';
  if (type === 'list') {
    ta.style.display = 'none'; cl.style.display = 'block'; cl.innerHTML = '';
    var inp = _creatorAddItem(cl); if (inp) inp.focus();
  } else {
    ta.style.display = 'block'; cl.style.display = 'none';
    setTimeout(function() { ta.focus(); }, 30);
  }
}

function gkCreatorClose() {
  var creator = document.getElementById('gkCreator');
  if (!creator) return;
  if (creator.classList.contains('active')) _creatorSave();
  creator.classList.remove('active');
  creator.className = creator.className.replace(/\bnc-\S+/g, '').trim();
  var title = document.getElementById('gkCreatorTitle');
  var ta    = document.getElementById('gkCreatorTa');
  var cl    = document.getElementById('gkCreatorList');
  if (title) title.value = '';
  if (ta) { ta.value = ''; ta.style.height = ''; }
  if (cl) cl.innerHTML = '';
  _creatorColor = 'default';
}

async function _creatorSave() {
  var title   = (document.getElementById('gkCreatorTitle').value || '').trim();
  var ta      = document.getElementById('gkCreatorTa');
  var content = _creatorType === 'note' ? (ta.value || '').trim() : '';
  var items   = [];
  if (_creatorType === 'list') {
    document.getElementById('gkCreatorList').querySelectorAll('.gk-cl-item').forEach(function(row) {
      var t = (row.querySelector('.gk-cl-item-txt').value || '').trim();
      if (t) items.push({ text: t, checked: row.querySelector('[type=checkbox]').checked });
    });
  }
  if (!title && !content && items.length === 0) return;
  try {
    var data = await gkPost('/Notes/Create', { title: title, content: content, color: _creatorColor, pinned: false, items: items });
    if (data) _prependCard(data);
    gkToast('Note saved');
  } catch(e) { gkToast('Could not save note'); }
}

function _creatorAddItem(container) {
  var row = document.createElement('div'); row.className = 'gk-cl-item';
  var cb  = document.createElement('input'); cb.type = 'checkbox';
  cb.onchange = function() { row.querySelector('.gk-cl-item-txt').style.textDecoration = cb.checked ? 'line-through' : ''; };
  var inp = document.createElement('input'); inp.type = 'text'; inp.className = 'gk-cl-item-txt'; inp.placeholder = 'List item';
  inp.onkeydown = function(e) { if (e.key === 'Enter') { e.preventDefault(); var ni = _creatorAddItem(container); if (ni) ni.focus(); } };
  var del = document.createElement('button'); del.className = 'gk-cl-item-del';
  del.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" fill="currentColor"/></svg>';
  del.onclick = function() { row.remove(); };
  row.append(cb, inp, del);
  container.append(row);
  return inp;
}

function _autosizeTa(el) {
  el.style.height = 'auto';
  el.style.height = Math.min(el.scrollHeight, 280) + 'px';
}
function _creatorTaKey(e) {
  if (e.key === 'Escape') { e.preventDefault(); gkCreatorClose(); }
}

async function gkTogglePin(id, forcePinned) {
  var card = document.getElementById('gnc-' + id);
  if (!card) return;
  var willPin = (forcePinned !== undefined) ? forcePinned : !card.classList.contains('pinned');
  card.classList.toggle('pinned', willPin);
  var svg = card.querySelector('.gk-card-pin svg');
  if (svg) svg.innerHTML = willPin
    ? '<path d="M14 4v5l2 1v4h-5v6l-1 1-1-1v-6H4v-4l2-1V4h8z" fill="currentColor"/>'
    : '<path d="M16 9V4l1-1H7l1 1v5l-2 2v2h5.2v6l1 1 1-1v-6H18v-2l-2-2z" fill="currentColor"/>';
  await gkPost('/Notes/Update', { id: parseInt(id), pinned: willPin }).catch(function() {});
  var pinnedGrid = document.getElementById('gkPinned');
  var mainGrid   = document.getElementById('gkGrid');
  if (willPin && pinnedGrid) pinnedGrid.insertAdjacentElement('afterbegin', card);
  else if (mainGrid) mainGrid.insertAdjacentElement('afterbegin', card);
}

async function gkToggleArchive(id) {
  var card = document.getElementById('gnc-' + id);
  if (!card) return;
  card.classList.add('gk-card-removing');
  setTimeout(function() { card.remove(); }, 200);
  await gkPost('/Notes/Update', { id: parseInt(id), archived: true }).catch(function() {});
  gkToast('Note archived', async function() {
    await gkPost('/Notes/Update', { id: parseInt(id), archived: false });
    location.reload();
  });
}

async function gkDeleteNote(id) {
  var card = document.getElementById('gnc-' + id);
  if (!card) return;
  card.classList.add('gk-card-removing');
  setTimeout(function() { card.remove(); }, 200);
  await gkPost('/Notes/Delete', { id: parseInt(id) }).catch(function() {});
  gkToast('Note moved to Trash', async function() {
    await gkPost('/Notes/Restore', { id: parseInt(id) });
    location.reload();
  });
}

async function gkToggleItem(itemId, checked) {
  await gkPost('/Notes/UpdateItem', { id: parseInt(itemId), checked: checked }).catch(function() {});
}

function _prependCard(data) {
  var grid = document.getElementById('gkGrid');
  if (!grid) return;
  var card = document.createElement('div');
  card.className = 'gk-card nc-' + (data.color || 'default') + ' gk-card-new';
  card.id = 'gnc-' + data.id;
  card.dataset.id      = data.id;
  card.dataset.color   = data.color || 'default';
  card.dataset.title   = data.title || '';
  card.dataset.content = data.content || '';
  card.dataset.type    = data.noteType || 'note';
  card.dataset.time    = 'just now';
  card.setAttribute('onclick', 'gkOpenNote(' + data.id + ')');
  var inner = '<div class="gk-card-body">';
  if (data.title) inner += '<div class="gk-card-title">' + _esc(data.title) + '</div>';
  if (data.noteType === 'list' && data.items && data.items.length) {
    inner += '<div class="gk-card-list">';
    data.items.forEach(function(it) {
      inner += '<div class="gk-card-list-item' + (it.isChecked ? ' checked' : '') + '"><input type="checkbox"' + (it.isChecked ? ' checked' : '') + ' data-id="' + it.id + '" onclick="event.stopPropagation();gkToggleItem(' + it.id + ',this.checked)"><span>' + _esc(it.text) + '</span></div>';
    });
    inner += '</div>';
  } else if (data.content) {
    inner += '<div class="gk-card-text">' + _esc(data.content) + '</div>';
  }
  inner += '</div>';
  inner += '<button class="gk-card-pin" onclick="event.stopPropagation();gkTogglePin(' + data.id + ')"><svg width="16" height="16" viewBox="0 0 24 24"><path d="M16 9V4l1-1H7l1 1v5l-2 2v2h5.2v6l1 1 1-1v-6H18v-2l-2-2z" fill="currentColor"/></svg></button>';
  inner += '<div class="gk-card-actions" onclick="event.stopPropagation()">';
  inner += '<button class="gk-card-act" onclick="gkToggleArchive(' + data.id + ')" title="Archive"><svg width="16" height="16" viewBox="0 0 24 24"><path d="M20.54 5.23l-1.39-1.68C18.88 3.21 18.47 3 18 3H6c-.47 0-.88.21-1.16.55L3.46 5.23C3.17 5.57 3 6.02 3 6.5V19c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6.5c0-.48-.17-.93-.46-1.27zM12 17.5L6.5 12H10v-2h4v2h3.5L12 17.5zM5.12 5l.81-1h12l.94 1H5.12z" fill="currentColor"/></svg></button>';
  inner += '<button class="gk-card-act" onclick="gkShowColorPicker(' + data.id + ',this)" title="Color"><svg width="16" height="16" viewBox="0 0 24 24"><path d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.26-.38-.61-.38-.99 0-.83.67-1.5 1.5-1.5H16c2.76 0 5-2.24 5-5 0-4.42-4.03-8-9-8zm-5.5 9c-.83 0-1.5-.67-1.5-1.5S5.67 9 6.5 9 8 9.67 8 10.5 7.33 12 6.5 12zm3-4C8.67 8 8 7.33 8 6.5S8.67 5 9.5 5s1.5.67 1.5 1.5S10.33 8 9.5 8zm5 0c-.83 0-1.5-.67-1.5-1.5S13.67 5 14.5 5s1.5.67 1.5 1.5S15.33 8 14.5 8zm3 4c-.83 0-1.5-.67-1.5-1.5S16.67 9 17.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z" fill="currentColor"/></svg></button>';
  inner += '<div class="gk-card-act-spacer"></div>';
  inner += '<button class="gk-card-act del" onclick="gkDeleteNote(' + data.id + ')" title="Delete"><svg width="16" height="16" viewBox="0 0 24 24"><path d="M15 4V3H9v1H4v2h1l1 13c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2l1-13h1V4h-5zm2 15H7l-1-13h10l-1 13z" fill="currentColor"/></svg></button>';
  inner += '</div>';
  card.innerHTML = inner;
  grid.querySelector('.gk-empty') && grid.querySelector('.gk-empty').remove();
  grid.insertAdjacentElement('afterbegin', card);
}

// Color picker override for creator context
var _gkApplyColorBase = typeof gkApplyColor !== 'undefined' ? gkApplyColor : null;
function gkApplyColor(color) {
  var cp = document.getElementById('gkColorPicker');
  if (cp) cp.style.display = 'none';
  if (_cpContext === 'modal') {
    gkModalSetColor(color);
  } else if (_cpContext === 'creator') {
    _creatorColor = color;
    var creator = document.getElementById('gkCreator');
    if (creator) creator.className = creator.className.replace(/\bnc-\S+/g, '').trim() + ' nc-' + color;
  } else if (_cpContext) {
    _updateCardColor(_cpContext, color);
  }
}

// Ctrl+Enter save
document.addEventListener('keydown', function(e) {
  if (e.ctrlKey && e.key === 'Enter') {
    var ov = document.getElementById('gkModalOv');
    if (ov && ov.style.display !== 'none') { gkCloseModal(); return; }
    var creator = document.getElementById('gkCreator');
    if (creator && creator.classList.contains('active')) gkCreatorClose();
  }
});

function _esc(s) {
  if (!s) return '';
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
</script>
}
