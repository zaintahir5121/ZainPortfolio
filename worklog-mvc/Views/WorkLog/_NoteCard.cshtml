@model WorkLogApp.Models.Note
@{
    var colorCls = "nc-" + (Model.Color ?? "default");
}
<div class="gk-card @colorCls@(Model.IsPinned ? " pinned" : "")" id="gkcard-@Model.Id" onclick="gkCardOpen(@Model.Id)">
  <!-- Pin button -->
  <button class="gk-card-pin" onclick="gkCardPin(event,@Model.Id)" title="@(Model.IsPinned ? "Unpin" : "Pin")">
    <svg width="16" height="16" viewBox="0 0 24 24">
      <path d="M12 2l2.4 6.4L21 10l-6.4 2.4L12 19l-2.4-6.6L3 10l6.6-2.6L12 2z"
            stroke="currentColor" stroke-width="1.5"
            fill="@(Model.IsPinned ? "currentColor" : "none")"/>
    </svg>
  </button>

  <div class="gk-card-body">
    @if (!string.IsNullOrEmpty(Model.Title)) {
      <div class="gk-card-title">@Model.Title</div>
    }
    @if (Model.NoteType == "list" && Model.ChecklistItems.Any()) {
      <div class="gk-card-list">
        @foreach (var item in Model.ChecklistItems.Take(6)) {
          <div class="gk-card-list-item @(item.IsChecked ? "checked" : "")">
            <input type="checkbox" @(item.IsChecked ? "checked" : "")
                   onclick="gkCardCheckItem(event,@Model.Id,@item.Id,this)">
            <span>@item.Text</span>
          </div>
        }
        @if (Model.ChecklistItems.Count > 6) {
          <div style="font-size:12px;color:var(--text2);padding:2px 0">+@(Model.ChecklistItems.Count - 6) more</div>
        }
      </div>
    } else if (!string.IsNullOrEmpty(Model.Content)) {
      <div class="gk-card-text">@Model.Content</div>
    }
  </div>

  <div class="gk-card-actions">
    <button class="gk-card-act" onclick="gkColorPickerOpen(event,@Model.Id)" title="Change color">
      <svg width="16" height="16" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" fill="none"/><circle cx="9" cy="10" r="1.5" fill="currentColor"/><circle cx="15" cy="10" r="1.5" fill="currentColor"/><path d="M8.5 15c1 1.5 5.5 1.5 7 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/></svg>
    </button>
    <button class="gk-card-act" onclick="gkCardArchive(event,@Model.Id)" title="Archive">
      <svg width="16" height="16" viewBox="0 0 24 24"><path d="M21 8H3v13h18V8zM3 8l2-4h14l2 4" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M10 13h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    </button>
    <div class="gk-card-act-spacer"></div>
    <button class="gk-card-act del" onclick="gkCardDelete(event,@Model.Id)" title="Delete">
      <svg width="16" height="16" viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
    </button>
  </div>
</div>
