{
  "name": "Keep — Personal Notes",
  "short_name": "Keep",
  "description": "Google Keep-style personal notes. Create, pin, color-code and search your notes anywhere.",
  "start_url": "/Notes",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#ffffff",
  "theme_color": "#fbbc04",
  "orientation": "any",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "screenshots": [
    { "src": "/og-image.png", "sizes": "1200x630", "type": "image/png", "form_factor": "wide" }
  ],
  "shortcuts": [
    {
      "name": "Notes",
      "short_name": "Notes",
      "description": "Your notes board",
      "url": "/Notes",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Archive",
      "short_name": "Archive",
      "description": "Archived notes",
      "url": "/Notes/Archive",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
