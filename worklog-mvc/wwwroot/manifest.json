{
  "name": "WorkLog — Daily Work Journal",
  "short_name": "WorkLog",
  "description": "Free daily work journal and time tracker. Log tasks, export timesheets, track your streak.",
  "start_url": "/Logs/Sticky",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#fefce8",
  "theme_color": "#6366f1",
  "orientation": "any",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "screenshots": [
    { "src": "/og-image.png", "sizes": "1200x630", "type": "image/png", "form_factor": "wide" }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "Full WorkLog dashboard",
      "url": "/Logs",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Day Widget",
      "short_name": "Widget",
      "description": "Compact day-preview widget with log and notes tabs",
      "url": "/Logs/Widget",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
